#include "ncurses-internal.h"
#include <qore/QoreRegexInterface.h>
#include <chrono>

//! Ncurses window
/** Represents a drawable window.

    A Window is the primary drawing surface. Use drawText(), box(), and the
    drawAnsi* methods to render content, and readEvent() to read input.

    @par Example:
    @code{.py}
%modern
%requires ncurses

Ncurses::Session s();

# create a 10x40 window at position (2, 5)
Ncurses::Window w(s, 10, 40, 2, 5);
w.box({"fg": Ncurses::Color::Blue});
w.drawTextInside(0, 0, "Window title", {"fg": Ncurses::Color::Yellow, "attrs": Ncurses::Attr::Bold});
w.refresh();

w.readEvent();
s.close();
    @endcode

    @since %ncurses 1.0
*/
qclass Window [dom=TERMINAL_IO; arg=NcursesWindow* win; ns=Qore::Ncurses];

// ---------------------------------------------
// Window implementation
// ---------------------------------------------

/**
    @param session the session
    @param rows window height
    @param cols window width
    @param y top position
    @param x left position

    @since %ncurses 1.0
*/
//! Creates a new window
/**
    @param session the session
    @param rows window height
    @param cols window width
    @param y top position
    @param x left position

    @since %ncurses 1.0
*/
Window::constructor(Qore::Ncurses::Session[NcursesSession] session, int rows, int cols, int y, int x) [flags=NAMED_ARGS] {
    if (*xsink) {
        return;
    }
    session->checkOpen(xsink);
    if (*xsink) {
        return;
    }
    NcursesCallGuard guard(*session);
    WINDOW* w = newwin(rows, cols, y, x);
    if (!w) {
        xsink->raiseException("NCURSES-ERROR", "newwin() failed");
        return;
    }
    self->setPrivate(CID_WINDOW, new NcursesWindow(*session, w, true));
}

//! Clears the window
/**
    @since %ncurses 1.0
*/
nothing Window::clear() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    wclear(win->win);
    return nothing();
}

//! Erases the window contents
/**
    @since %ncurses 1.0
*/
nothing Window::erase() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    werase(win->win);
    return nothing();
}

//! Refreshes the window
/**
    @since %ncurses 1.0
*/
nothing Window::refresh() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    wrefresh(win->win);
    return nothing();
}

//! Queues the window for refresh
/**
    @since %ncurses 1.0
*/
nothing Window::noutrefresh() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    wnoutrefresh(win->win);
    return nothing();
}

//! Moves the cursor
/**
    @param y row
    @param x column

    @since %ncurses 1.0
*/
nothing Window::moveCursor(int y, int x) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    if (y < 0 || x < 0 || y >= rows || x >= cols
            || wmove(win->win, static_cast<int>(y), static_cast<int>(x)) == ERR) {
        return nothing();
    }
    if (win->session && !win->leave_ok) {
        win->session->nextCursorRequest();
        win->session->cursor_win = win->win;
        win->session->cursor_y = y;
        win->session->cursor_x = x;
        win->session->cursor_set = true;
    }
    return nothing();
}

//! Positions the cursor and returns an ownership token
/** Widgets sharing a window can release their own cursor without clearing a
    newer request from another widget. A later moveCursor(), restoreCursor(),
    or claimCursor() invalidates the previous token.
    @param y row
    @param x column
    @return positive request token, or zero for invalid coordinates or leave-ok mode
    @par Example
    @code{.py}
int request = window.claimCursor(1, 2);
window.releaseCursor(request);
    @endcode
    @since %ncurses 1.0
*/
int Window::claimCursor(int y, int x) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return 0;
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    if (y < 0 || x < 0 || y >= rows || x >= cols || !win->session || win->leave_ok
            || wmove(win->win, static_cast<int>(y), static_cast<int>(x)) == ERR) {
        return 0;
    }
    win->session->cursor_win = win->win;
    win->session->cursor_y = y;
    win->session->cursor_x = x;
    win->session->cursor_set = true;
    return win->session->nextCursorRequest();
}

//! Releases a cursor request only if it is still owned by this window
/** Releasing an old token, zero, or a token after session closure is a no-op.
    This relinquishes positioning; cursor visibility remains session policy.
    @param request token returned by claimCursor()
    @return True if the matching active request was released
    @since %ncurses 1.0
*/
bool Window::releaseCursor(int request) [flags=NAMED_ARGS] {
    NcursesCallGuard guard(win->session);
    if (request <= 0 || !win->session || win->session->closed
            || !win->session->cursor_set || win->session->cursor_win != win->win
            || win->session->cursor_request != request) {
        return false;
    }
    win->session->cursor_set = false;
    win->session->cursor_win = nullptr;
    return true;
}

//! Returns the current cursor position
/**
    @since %ncurses 1.0
*/
hash<Position> Window::cursor() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int y = 0;
    int x = 0;
    getyx(win->win, y, x);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclPosition, xsink), xsink);
    h->setKeyValue("y", y, xsink);
    h->setKeyValue("x", x, xsink);
    return h.release();
}

//! Returns the window size
/**
    @since %ncurses 1.0
*/
hash<Size> Window::size() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclSize, xsink), xsink);
    h->setKeyValue("rows", rows, xsink);
    h->setKeyValue("cols", cols, xsink);
    return h.release();
}

//! Returns the window position
/**
    @since %ncurses 1.0
*/
hash<Position> Window::position() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int y = 0;
    int x = 0;
    getbegyx(win->win, y, x);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclPosition, xsink), xsink);
    h->setKeyValue("y", y, xsink);
    h->setKeyValue("x", x, xsink);
    return h.release();
}

/**
    @param y row
    @param x column
    @param text text to draw
    @param style optional style hash

    @since %ncurses 1.0
*/
//! Draws text at a position
/**
    @param y row
    @param x column
    @param text text to draw
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::drawText(int y, int x, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwaddnstr(win->win, y, x, text->c_str(), text->size());
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws text clipped to window bounds
/**
    @param y row
    @param x column
    @param text text to draw
    @param style optional style hash

    The text is clipped to the visible window region to prevent out-of-bounds
    writes. Coordinates and widths use terminal display cells. Complete
    graphemes outside the window are skipped; a grapheme intersecting either
    clipping edge is replaced by spaces so UTF-8 and combining sequences are
    never split.

    @since %ncurses 1.0
*/
nothing Window::drawTextClipped(int y, int x, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    if (!text || !text->size()) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    if (y < 0 || y >= rows || cols <= 0) {
        return nothing();
    }
    if (x >= cols) {
        return nothing();
    }
    // Clip complete graphemes by terminal cells, not UTF-8 byte offsets. A
    // partially visible grapheme is represented by spaces on either edge.
    QoreRegexInterface graphemes(xsink, "(\\X)", QRE_GLOBAL | QRE_UTF8);
    if (*xsink) {
        return nothing();
    }
    ReferenceHolder<QoreListNode> clusters(graphemes.extractSubstrings(*text, xsink), xsink);
    if (*xsink || !clusters) {
        return nothing();
    }
    QoreString output(QCS_UTF8);
    int64 col = x;
    size_t count = 0;
    ConstListIterator i(*clusters);
    while (i.next()) {
        if (++count % 100 == 0 && qore_check_cancel(xsink, "clipping terminal text")) {
            return nothing();
        }
        const QoreStringNode* cluster = i.getValue().get<const QoreStringNode>();
        assert(cluster);
        int64 width = cluster->getCharWidth(xsink);
        if (*xsink) {
            return nothing();
        }
        int64 end = col + width;
        if (end > 0 && width > 0) {
            if (col >= 0 && end <= cols) {
                output.concat(cluster, xsink);
                if (*xsink) {
                    return nothing();
                }
            } else {
                output.concat(std::string(static_cast<size_t>(std::min<int64>(end, cols)
                    - std::max<int64>(col, 0)), ' ').c_str());
            }
        }
        col = end;
        if (col >= cols) {
            break;
        }
    }
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwaddnstr(win->win, y, static_cast<int>(std::max<int64>(0, x)), output.c_str(), output.size());
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws text clipped to the window's inner content area
/**
    @param y row inside the content area (0 = first row inside the border)
    @param x column inside the content area (0 = first column inside the border)
    @param text text to draw
    @param style optional style hash

    The text is clipped to the area inside a border (excluding rows/cols 0 and
    max-1). This prevents accidental overwriting of box borders.

    @since %ncurses 1.0
*/
nothing Window::drawTextInside(int y, int x, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    if (!text || !text->size()) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    int inner_rows = rows - 2;
    int inner_cols = cols - 2;
    if (inner_rows <= 0 || inner_cols <= 0) {
        return nothing();
    }
    if (y < 0 || y >= inner_rows) {
        return nothing();
    }
    int start = 0;
    int col = x;
    if (col < 0) {
        start = -col;
        col = 0;
    }
    if (col >= inner_cols) {
        return nothing();
    }
    int len = text->size();
    if (start >= len) {
        return nothing();
    }
    int maxlen = inner_cols - col;
    int n = len - start;
    if (n > maxlen) {
        n = maxlen;
    }
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwaddnstr(win->win, y + 1, col + 1, text->c_str() + start, n);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Clears a line inside the window border
/**
    @param y row inside the content area (0 = first row inside the border)
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::clearInsideLine(int y, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    int inner_rows = rows - 2;
    int inner_cols = cols - 2;
    if (inner_rows <= 0 || inner_cols <= 0) {
        return nothing();
    }
    if (y < 0 || y >= inner_rows) {
        return nothing();
    }
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwhline(win->win, y + 1, 1, ' ', inner_cols);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws text inside the window border and clears the rest of the line
/**
    @param y row inside the content area (0 = first row inside the border)
    @param text text to draw
    @param style optional style hash

    The line is cleared before writing to ensure no old text remains.

    @since %ncurses 1.0
*/
nothing Window::drawTextInsideLine(int y, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    int inner_rows = rows - 2;
    int inner_cols = cols - 2;
    if (inner_rows <= 0 || inner_cols <= 0) {
        return nothing();
    }
    if (y < 0 || y >= inner_rows) {
        return nothing();
    }
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwhline(win->win, y + 1, 1, ' ', inner_cols);
    if (text && text->size()) {
        int n = text->size();
        if (n > inner_cols) {
            n = inner_cols;
        }
        mvwaddnstr(win->win, y + 1, 1, text->c_str(), n);
    }
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws ANSI-colored text at a position
/**
    @param y row
    @param x column
    @param text text to draw (may contain ANSI SGR color codes)
    @param style optional base style hash

    @since %ncurses 1.0
*/
nothing Window::drawAnsiText(int y, int x, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    if (style) {
        StyleSpec spec;
        parseStyle(style, spec, xsink);
        if (*xsink) {
            return nothing();
        }
        attr_t old_attr = 0;
        short old_pair = 0;
        applyStyle(win, spec, old_attr, old_pair, xsink);
        if (*xsink) {
            return nothing();
        }
        drawAnsiText(win, y, x, false, false, text, xsink);
        restoreStyle(win, old_attr, old_pair);
    } else {
        drawAnsiText(win, y, x, false, false, text, xsink);
    }
    return nothing();
}

//! Draws ANSI-colored text clipped to the window's inner content area
/**
    @param y row inside the content area (0 = first row inside the border)
    @param x column inside the content area (0 = first column inside the border)
    @param text text to draw (may contain ANSI SGR color codes)
    @param style optional base style hash

    @since %ncurses 1.0
*/
nothing Window::drawAnsiTextInside(int y, int x, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    if (style) {
        StyleSpec spec;
        parseStyle(style, spec, xsink);
        if (*xsink) {
            return nothing();
        }
        attr_t old_attr = 0;
        short old_pair = 0;
        applyStyle(win, spec, old_attr, old_pair, xsink);
        if (*xsink) {
            return nothing();
        }
        drawAnsiText(win, y, x, true, false, text, xsink);
        restoreStyle(win, old_attr, old_pair);
    } else {
        drawAnsiText(win, y, x, true, false, text, xsink);
    }
    return nothing();
}

//! Draws ANSI-colored text inside the window border and clears the rest of the line
/**
    @param y row inside the content area (0 = first row inside the border)
    @param text text to draw (may contain ANSI SGR color codes)
    @param style optional base style hash

    @since %ncurses 1.0
*/
nothing Window::drawAnsiTextInsideLine(int y, string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    if (style) {
        StyleSpec spec;
        parseStyle(style, spec, xsink);
        if (*xsink) {
            return nothing();
        }
        attr_t old_attr = 0;
        short old_pair = 0;
        applyStyle(win, spec, old_attr, old_pair, xsink);
        if (*xsink) {
            return nothing();
        }
        drawAnsiText(win, y, 0, true, true, text, xsink);
        restoreStyle(win, old_attr, old_pair);
    } else {
        drawAnsiText(win, y, 0, true, true, text, xsink);
    }
    return nothing();
}

//! Sets the wrap mode for this window
/**
    @param mode wrap mode

    @since %ncurses 1.0
*/
nothing Window::setWrapMode(enum<WrapMode> mode) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    int64 m = mode.getAsBigInt();
    if (m < 0 || m > 2) {
        xsink->raiseException("NCURSES-ERROR", "invalid wrap mode %d", (int)m);
        return nothing();
    }
    win->wrap_mode = (int)m;
    return nothing();
}

//! Returns the wrap mode for this window
/**
    @return @ref Qore::Ncurses::WrapMode "WrapMode" value

    @since %ncurses 1.0
*/
enum<WrapMode> Window::getWrapMode() [flags=CONSTANT] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    return (int64)win->wrap_mode;
}

//! Sets whether the cursor should be left in this window after refresh
/**
    @param enabled True to disable cursor positioning for this window

    @since %ncurses 1.0
*/
nothing Window::setLeaveOk(bool enabled) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    leaveok(win->win, enabled ? TRUE : FALSE);
    win->leave_ok = enabled;
    if (enabled && win->session && win->session->cursor_win == win->win) {
        win->session->cursor_win = nullptr;
        win->session->cursor_set = false;
    }
    return nothing();
}

//! Saves the current cursor position
/**
    @return hash<@ref Position>

    @since %ncurses 1.0
*/
hash<Position> Window::saveCursor() {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int y = 0;
    int x = 0;
    getyx(win->win, y, x);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclPosition, xsink), xsink);
    h->setKeyValue("y", y, xsink);
    h->setKeyValue("x", x, xsink);
    return h.release();
}

//! Restores a previously saved cursor position
/**
    @param position hash with keys \c y and \c x

    @since %ncurses 1.0
*/
nothing Window::restoreCursor(hash position) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    int64 y = position ? position->getKeyValue("y").getAsBigInt() : 0;
    int64 x = position ? position->getKeyValue("x").getAsBigInt() : 0;
    int rows = 0;
    int cols = 0;
    getmaxyx(win->win, rows, cols);
    if (y < 0 || x < 0 || y >= rows || x >= cols
            || wmove(win->win, static_cast<int>(y), static_cast<int>(x)) == ERR) {
        return nothing();
    }
    if (win->session && !win->leave_ok) {
        win->session->nextCursorRequest();
        win->session->cursor_win = win->win;
        win->session->cursor_y = y;
        win->session->cursor_x = x;
        win->session->cursor_set = true;
    }
    // Queue cursor position even if the window contents are unchanged.
    wnoutrefresh(win->win);
    return nothing();
}

//! Writes text at the current cursor position
/**
    @param text text to write
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::write(string text, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    waddnstr(win->win, text->c_str(), text->size());
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Fills a rectangle
/**
    @param y top row
    @param x left column
    @param rows height
    @param cols width
    @param character optional fill character
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::fillRect(int y, int x, int rows, int cols, *string character, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    chtype c = ' ';
    if (character && character->size() > 0) {
        c = static_cast<chtype>(character->c_str()[0]);
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    for (int r = 0; r < rows; ++r) {
        mvwhline(win->win, y + r, x, c, cols);
    }
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws a box using default border characters
/**
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::box(*hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    ::box(win->win, 0, 0);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws a border with optional characters
/**
    @param left_side left side character
    @param right_side right side character
    @param top_side top side character
    @param bottom_side bottom side character
    @param top_left top-left corner character
    @param top_right top-right corner character
    @param bottom_left bottom-left corner character
    @param bottom_right bottom-right corner character
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::border(*string left_side, *string right_side, *string top_side, *string bottom_side,
        *string top_left, *string top_right, *string bottom_left, *string bottom_right,
        *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    chtype l = left_side && left_side->size() ? left_side->c_str()[0] : 0;
    chtype r = right_side && right_side->size() ? right_side->c_str()[0] : 0;
    chtype t = top_side && top_side->size() ? top_side->c_str()[0] : 0;
    chtype b = bottom_side && bottom_side->size() ? bottom_side->c_str()[0] : 0;
    chtype tlc = top_left && top_left->size() ? top_left->c_str()[0] : 0;
    chtype trc = top_right && top_right->size() ? top_right->c_str()[0] : 0;
    chtype blc = bottom_left && bottom_left->size() ? bottom_left->c_str()[0] : 0;
    chtype brc = bottom_right && bottom_right->size() ? bottom_right->c_str()[0] : 0;
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    wborder(win->win, l, r, t, b, tlc, trc, blc, brc);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws a horizontal line
/**
    @param y row
    @param x column
    @param length length
    @param character optional character
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::drawHLine(int y, int x, int length, *string character, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    chtype c = character && character->size() ? character->c_str()[0] : 0;
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwhline(win->win, y, x, c, length);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Draws a vertical line
/**
    @param y row
    @param x column
    @param length length
    @param character optional character
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::drawVLine(int y, int x, int length, *string character, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    chtype c = character && character->size() ? character->c_str()[0] : 0;
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwvline(win->win, y, x, c, length);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Adds a single character
/**
    @param y row
    @param x column
    @param character character
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::addChar(int y, int x, string character, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    if (!character || !character->size()) {
        return nothing();
    }
    attr_t old_attr = 0;
    short old_pair = 0;
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    mvwaddch(win->win, y, x, character->c_str()[0]);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Moves the window
/**
    @param y new top row
    @param x new left column

    @since %ncurses 1.0
*/
nothing Window::move(int y, int x) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    mvwin(win->win, y, x);
    return nothing();
}

//! Resizes the window
/**
    @param rows new height
    @param cols new width

    @since %ncurses 1.0
*/
nothing Window::resize(int rows, int cols) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    if (wresize(win->win, rows, cols) != OK) {
        xsink->raiseException("NCURSES-ERROR", "wresize() failed");
    }
    return nothing();
}

//! Clears a line
/**
    @param y row
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::clearLine(int y, *hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    attr_t old_attr = 0;
    short old_pair = 0;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    applyStyle(win, spec, old_attr, old_pair, xsink);
    if (*xsink) {
        return nothing();
    }
    wmove(win->win, y, 0);
    wclrtoeol(win->win);
    restoreStyle(win, old_attr, old_pair);
    return nothing();
}

//! Scrolls the window
/**
    @param lines number of lines to scroll

    @since %ncurses 1.0
*/
nothing Window::scroll(int lines) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    wscrl(win->win, lines);
    return nothing();
}

//! Enables or disables scrolling
/**
    @param enabled enable scrolling when true

    @since %ncurses 1.0
*/
nothing Window::enableScroll(bool enabled) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    scrollok(win->win, enabled ? TRUE : FALSE);
    return nothing();
}

//! Enables or disables keypad mode
/**
    @param enabled enable keypad decoding when true

    @since %ncurses 1.0
*/
nothing Window::enableKeypad(bool enabled) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    keypad(win->win, enabled ? TRUE : FALSE);
    return nothing();
}

//! Reads text from the window
/**
    @param y row
    @param x column
    @param length length

    @since %ncurses 1.0
*/
string Window::readText(int y, int x, int length) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    if (length <= 0) {
        return new QoreStringNode();
    }
    std::string buf;
    buf.resize(length + 1);
    mvwinnstr(win->win, y, x, &buf[0], length);
    buf[length] = 0;
    return new QoreStringNode(buf.c_str(), QCS_UTF8);
}

//! Reads multiple lines of text from the window
/**
    @param y start row (default 0)
    @param rows number of rows (default full window)
    @param cols number of columns (default full window)

    @return list of strings (one per row)

    @since %ncurses 1.0
*/
list<string> Window::readLines(*int y, *int rows, *int cols) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    bool has_y = args && args->size() > 0 && !args->retrieveEntry(0).isNothing();
    bool has_rows = args && args->size() > 1 && !args->retrieveEntry(1).isNothing();
    bool has_cols = args && args->size() > 2 && !args->retrieveEntry(2).isNothing();

    int start_y = has_y ? y : 0;
    int max_rows = has_rows ? rows : -1;
    int max_cols = has_cols ? cols : -1;

    NcursesCallGuard guard(win->session);
    int total_rows = 0;
    int total_cols = 0;
    getmaxyx(win->win, total_rows, total_cols);
    if (max_rows < 0 || max_rows > total_rows) {
        max_rows = total_rows;
    }
    if (max_cols < 0 || max_cols > total_cols) {
        max_cols = total_cols;
    }
    if (start_y < 0) {
        start_y = 0;
    }
    if (start_y >= total_rows || max_rows <= 0 || max_cols <= 0) {
        return new QoreListNode(autoTypeInfo);
    }
    int end_row = std::min(total_rows, start_y + max_rows);
    int width = max_cols;
    ReferenceHolder<QoreListNode> out(new QoreListNode(autoTypeInfo), xsink);
    if (*xsink) {
        return nothing();
    }
    std::string buf;
    buf.resize(width + 1);
    for (int row = start_y; row < end_row; ++row) {
        if ((row - start_y) % 10 == 0 && qore_check_cancel(xsink, "reading terminal lines")) {
            return nothing();
        }
        mvwinnstr(win->win, row, 0, &buf[0], width);
        buf[width] = 0;
        out->push(new QoreStringNode(buf.c_str(), QCS_UTF8), xsink);
        if (*xsink) {
            return nothing();
        }
    }
    return out.release();
}

//! Creates a sub-window
/** Derived windows retain their parent storage until they are released.
    Coordinates are local to the parent window.

    @param rows height
    @param cols width
    @param y top row
    @param x left column

    @since %ncurses 1.0
*/
Window Window::subWindow(int rows, int cols, int y, int x) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    WINDOW* w = derwin(win->win, rows, cols, y, x);
    if (!w) {
        xsink->raiseException("NCURSES-ERROR", "derwin() failed");
        return nothing();
    }
    QoreObject* obj = new QoreObject(QC_WINDOW, getProgram(), new NcursesWindow(win->session, w, true, win));
    return obj;
}

//! Reads an input event, including a coalesced Session::wakeup() notification.
/**
    @param timeout_ms total timeout in milliseconds (-1 for infinite, 0 for an immediate read)
    @param poll_ms cancellation fallback interval for Qore versions without cancellable poll (default 25, capped at the Qore I/O cancellation interval)
    @return hash<@ref InputEvent> or @ref nothing on timeout
    @throw NCURSES-ERROR for invalid arguments or a closed session
    @throw NCURSES-INPUT-BUSY if another readEvent() is active on this session
    @throw NCURSES-INPUT-LOCK-ERROR if a blocking wait is attempted inside Session::withLock()
    @throw NCURSES-INPUT-CLOSED if terminal input closes
    @note The ncurses lock is released during idle waits. Escape and multibyte
    decoding retain ncurses's configured escape delay and the bounded continuation delay.
    @since %ncurses 1.0
*/
hash<InputEvent> Window::readEvent(*int timeout_ms, *int poll_ms) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) { return nothing(); }
    bool has_timeout = args && args->size() > 0 && !args->retrieveEntry(0).isNothing();
    bool has_poll = args && args->size() > 1 && !args->retrieveEntry(1).isNothing();
    if ((has_timeout && (timeout_ms < -1 || timeout_ms > std::numeric_limits<int>::max()))
            || (has_poll && (poll_ms <= 0 || poll_ms > std::numeric_limits<int>::max()))) {
        xsink->raiseException("NCURSES-ERROR", "timeout_ms must be -1..INT_MAX and poll_ms must be 1..INT_MAX");
        return nothing();
    }
    int timeout = has_timeout ? static_cast<int>(timeout_ms) : -1;
    int fallback_poll = has_poll ? static_cast<int>(poll_ms) : 25;
    auto started = std::chrono::steady_clock::now();
    NcursesInputReadGuard reader(win->session, xsink);
    if (*xsink) { return nothing(); }
    NcursesPasteKeypadGuard paste_keypad(win->session, win->win);
    while (true) {
        // check for sandbox interrupt between poll cycles
        if (qore_check_cancel(xsink, "reading terminal input")) {
            NcursesCallGuard guard(win->session); win->session->discardPaste();
            return nothing();
        }
        {
        NcursesCallGuard guard(win->session);
        win->session->checkOpen(xsink);
        if (*xsink) { return nothing(); }
        wtimeout(win->win, 0);
        int rc = win->session->readInput(win->win);
        // Input wins over work notifications so a self-posting callback cannot
        // starve keyboard/mouse input. Applications drain work on every iteration.
        if (rc == ERR && win->session->takeWake(xsink)) {
            ReferenceHolder<QoreHashNode> event(new QoreHashNode(hashdeclInputEvent, xsink), xsink);
            event->setKeyValue("type", NC_INPUT_WAKE, xsink);
            if (*xsink) { return nothing(); }
            return event.release();
        }
        if (*xsink) { return nothing(); }
        if (rc == NC_PASTE_BEGIN) {
            win->session->resetPaste(); win->session->paste_active = true; paste_keypad.disable(); continue;
        }
        if (win->session->paste_active && rc >= 0 && rc < 256) {
            bool complete = win->session->consumePasteByte(static_cast<unsigned char>(rc), xsink);
            if (*xsink) { return nothing(); }
            if (!complete) { continue; }
            std::string text; text.swap(win->session->paste_text);
            int error = win->session->paste_error; win->session->resetPaste(); paste_keypad.restore();
            if (error == 2) { continue; }
            if (error == 1) { xsink->raiseException("NCURSES-PASTE-LIMIT", "paste exceeds the configured byte limit"); return nothing(); }
            if (!nc_valid_utf8(text.data(), text.size(), xsink)) {
                if (!*xsink) { xsink->raiseException("NCURSES-PASTE-ERROR", "paste is not valid UTF-8"); }
                return nothing();
            }
            ReferenceHolder<QoreHashNode> event(new QoreHashNode(hashdeclInputEvent, xsink), xsink);
            event->setKeyValue("type", NC_INPUT_PASTE, xsink);
            event->setKeyValue("ch", new QoreStringNode(text.data(), text.size(), QCS_UTF8), xsink);
            if (*xsink) { return nothing(); }
            return event.release();
        }
        if (rc != ERR) {
            ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclInputEvent, xsink), xsink);
            h->setKeyValue("code", rc == NC_INJECTED_MOUSE || rc == NC_BUFFERED_MOUSE ? KEY_MOUSE : rc, xsink);
            if (rc == NC_INJECTED_PASTE) {
                if (win->session->injected_paste.empty()) {
                    xsink->raiseException("NCURSES-ERROR", "injected paste marker has no payload"); return nothing();
                }
                const std::string& text = win->session->injected_paste.back();
                h->setKeyValue("type", NC_INPUT_PASTE, xsink);
                h->setKeyValue("ch", new QoreStringNode(text.data(), text.size(), QCS_UTF8), xsink);
                win->session->injected_paste_bytes -= text.size();
                win->session->injected_paste.pop_back();
            } else if (rc == KEY_MOUSE || rc == NC_INJECTED_MOUSE || rc == NC_BUFFERED_MOUSE) {
                MEVENT ev = {};
                bool have_event;
                if (rc == NC_INJECTED_MOUSE) {
                    if (win->session->injected_mouse.empty()) {
                        xsink->raiseException("NCURSES-ERROR", "injected mouse marker has no event data");
                        return nothing();
                    }
                    ev = win->session->injected_mouse.back();
                    win->session->injected_mouse.pop_back();
                    have_event = true;
                } else if (rc == NC_BUFFERED_MOUSE) {
                    ev = win->session->buffered_mouse;
                    have_event = true;
                } else {
                    have_event = getmouse(&ev) == OK;
                    win->session->pending_native_mouse = have_event;
                }
                if (have_event) {
                    h->setKeyValue("type", NC_INPUT_MOUSE, xsink);
                    ReferenceHolder<QoreHashNode> mh(new QoreHashNode(hashdeclMouseEvent, xsink), xsink);
                    mh->setKeyValue("x", ev.x, xsink);
                    mh->setKeyValue("y", ev.y, xsink);
                    mh->setKeyValue("button_state", (int)ev.bstate, xsink);
                    h->setKeyValue("mouse", mh.release(), xsink);
                } else {
                    h->setKeyValue("type", NC_INPUT_MOUSE, xsink);
                }
            } else if (rc == KEY_RESIZE) {
                h->setKeyValue("type", NC_INPUT_RESIZE, xsink);
            } else if (rc >= KEY_MIN) {
                h->setKeyValue("type", NC_INPUT_KEY, xsink);
                const char* nm = keyname(rc);
                if (nm) {
                    h->setKeyValue("name", new QoreStringNode(nm, QCS_UTF8), xsink);
                }
            } else if (rc == 27) {
                // ESC received: check for Alt+key sequence
                wtimeout(win->win, 0);
                int rc2 = win->session->readInput(win->win);
                if (rc2 != ERR && ((rc2 >= 32 && rc2 < 256 && rc2 != 127) || rc2 == 10 || rc2 == 13)) {
                    // Alt+key event
                    h->setKeyValue("type", NC_INPUT_ALT, xsink);
                    QoreStringNode* ch = win->session->readCharacter(win->win, rc2, xsink);
                    if (*xsink) { return nothing(); }
                    h->setKeyValue("ch", ch, xsink);
                } else {
                    if (rc2 != ERR) {
                        win->session->pushInput(rc2, xsink);
                    }
                    // bare ESC
                    h->setKeyValue("type", NC_INPUT_CHAR, xsink);
                    char buf[2] = {(char)rc, 0};
                    h->setKeyValue("ch", new QoreStringNode(buf, QCS_UTF8), xsink);
                }
            } else {
                h->setKeyValue("type", NC_INPUT_CHAR, xsink);
                QoreStringNode* ch = win->session->readCharacter(win->win, rc == 13 ? 10 : rc, xsink);
                if (*xsink) { return nothing(); }
                h->setKeyValue("ch", ch, xsink);
            }
            if (*xsink) { return nothing(); }
            return h.release();
        }
        } // Release the global ncurses lock before the cancellable wait.
        int remaining = timeout;
        if (timeout >= 0) {
            auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
                std::chrono::steady_clock::now() - started).count();
            if (elapsed >= timeout) { return nothing(); }
            remaining -= static_cast<int>(elapsed);
        }
        if (!win->session->waitForInput(remaining, fallback_poll, xsink)) {
            if (*xsink) { NcursesCallGuard guard(win->session); win->session->discardPaste(); }
            return nothing();
        }
    }
}

//! Sets the background style
/**
    @param style optional style hash

    @since %ncurses 1.0
*/
nothing Window::setBackground(*hash style) [flags=NAMED_ARGS] {
    win->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(win->session);
    StyleSpec spec;
    parseStyle(style, spec, xsink);
    if (*xsink) {
        return nothing();
    }
    int fg = spec.has_fg ? spec.fg : -1;
    int bg = spec.has_bg ? spec.bg : -1;
    short pair = win->session->getColorPair(fg, bg, xsink);
    if (*xsink) {
        return nothing();
    }
    wbkgdset(win->win, COLOR_PAIR(pair) | spec.attrs);
    return nothing();
}
