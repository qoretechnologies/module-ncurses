//! Ncurses session
/** Manages a ncurses screen session.

    A Session owns the terminal state for the lifetime of the ncurses UI.
    Create a Session, obtain the screen Window, draw content, read events,
    and close when done.

    @par Example:
    @code{.py}
%modern
%requires ncurses

# create a session (initializes the terminal)
Ncurses::Session s();
Ncurses::Window w = s.screen();

w.clear();
w.drawText(1, 2, "Hello!", {"fg": Ncurses::Color::Cyan, "attrs": Ncurses::Attr::Bold});
w.refresh();

# wait for a keypress
w.readEvent();

# close the session (restores the terminal)
s.close();
    @endcode

    @since %ncurses 1.0
*/
qclass Session [dom=TERMINAL_IO; arg=NcursesSession* session; ns=Qore::Ncurses];

// ---------------------------------------------
// Session implementation
// ---------------------------------------------

//! Creates a new session
/**
    @param options optional hash of options:
    - \c echo (bool, default false)
    - \c raw (bool, default false)
    - \c cbreak (bool, default true)
    - \c keypad (bool, default true)
    - \c mouse (bool, default true)
    - \c use_colors (bool, default true)
    - \c use_default_colors (bool, default true)
    - \c cursor (int, default 0)
    - \c bracketed_paste (bool, default false) enables terminal paste delimiters; disabled on close
    - \c paste_limit (int, default 1048576) bounds paste bytes; range 1..67108864
    - \c esc_delay (int, default no change) to set the ESC sequence delay in milliseconds
    - \c test_terminal (TestTerminal) for automated tests
    - \c use_tty (bool, default false) to use a dedicated TTY device for ncurses I/O
    - \c tty_path (string, default "/dev/tty") path to the TTY device when \c use_tty is true
    - \c unbuffered_stdio (bool, default true when \c use_tty is true) to disable stdio buffering on
      stdout/stderr when using a dedicated TTY (useful for output capture)

    @since %ncurses 1.0
*/
Session::constructor(*hash options) [flags=NAMED_ARGS] {
    NcursesSession* s = new NcursesSession();

    bool echo_on = false;
    bool raw_on = false;
    bool cbreak_on = true;
    bool keypad_on = true;
    bool mouse_on = true;
    bool colors_on = true;
    bool default_colors_on = true;
    int cursor = 0;
    int esc_delay = -1;
    bool bracketed_paste = false;
    int64 paste_limit = 1048576;
    bool use_tty = false;
    bool unbuffered_stdio = false;
    bool unbuffered_stdio_set = false;
    std::string tty_path = "/dev/tty";

    ReferenceHolder<NcursesTestTerminal> tterm_holder(nullptr, xsink);
    if (options) {
        QoreValue v;
        v = options->getKeyValue("echo");
        if (!v.isNothing()) { echo_on = v.getAsBool(); }
        v = options->getKeyValue("raw");
        if (!v.isNothing()) { raw_on = v.getAsBool(); }
        v = options->getKeyValue("cbreak");
        if (!v.isNothing()) { cbreak_on = v.getAsBool(); }
        v = options->getKeyValue("keypad");
        if (!v.isNothing()) { keypad_on = v.getAsBool(); }
        v = options->getKeyValue("mouse");
        if (!v.isNothing()) { mouse_on = v.getAsBool(); }
        v = options->getKeyValue("use_colors");
        if (!v.isNothing()) { colors_on = v.getAsBool(); }
        v = options->getKeyValue("use_default_colors");
        if (!v.isNothing()) { default_colors_on = v.getAsBool(); }
        v = options->getKeyValue("cursor");
        if (!v.isNothing()) { cursor = v.getAsBigInt(); }
        v = options->getKeyValue("bracketed_paste");
        if (!v.isNothing()) { bracketed_paste = v.getAsBool(); }
        v = options->getKeyValue("paste_limit");
        if (!v.isNothing()) { paste_limit = v.getAsBigInt(); }
        v = options->getKeyValue("esc_delay");
        if (!v.isNothing()) { esc_delay = v.getAsBigInt(); }
        v = options->getKeyValue("use_tty");
        if (!v.isNothing()) { use_tty = v.getAsBool(); }
        v = options->getKeyValue("tty_path");
        if (!v.isNothing()) {
            QoreStringValueHelper str(v);
            tty_path.assign(str->c_str(), str->size());
        }
        v = options->getKeyValue("unbuffered_stdio");
        if (!v.isNothing()) {
            unbuffered_stdio = v.getAsBool();
            unbuffered_stdio_set = true;
        }
        v = options->getKeyValue("test_terminal");
        if (!v.isNothing() && v.getType() == NT_OBJECT) {
            QoreObject* obj = v.get<QoreObject>();
            TryPrivateDataRefHolder<NcursesTestTerminal> t(obj, CID_TESTTERMINAL, xsink);
            if (!*xsink && t) {
                tterm_holder = t.release();
            }
        }
    }

    if (paste_limit < 1 || paste_limit > 67108864) {
        delete s;
        xsink->raiseException("NCURSES-PASTE-LIMIT", "paste_limit must be between 1 and 67108864 bytes"); return;
    }
    if (use_tty && !unbuffered_stdio_set) {
        unbuffered_stdio = true;
    } else if (!use_tty) {
        unbuffered_stdio = false;
    }

    NcursesLockHelper al;

    if (tterm_holder) {
        tterm_holder->ensureOpen(xsink);
        if (*xsink) {
            delete s;
            return;
        }
        FILE* in = fdopen(dup(tterm_holder->slave_fd), "r");
        FILE* out = fdopen(dup(tterm_holder->slave_fd), "w");
        if (!in || !out) {
            if (in) { fclose(in); }
            if (out) { fclose(out); }
            delete s;
            xsink->raiseException("NCURSES-ERROR", "failed to open test terminal streams");
            return;
        }
        s->in_file = in;
        s->out_file = out;
        // the session uses the test terminal's type; the process environment is not changed
        s->screen = nc_newterm(tterm_holder->term.c_str(), out, in);
        if (!s->screen) {
            delete s;
            xsink->raiseException("NCURSES-ERROR", "newterm() failed for terminal type '%s'",
                tterm_holder->term.c_str());
            return;
        }
        s->is_default = false;
        set_term(s->screen);
        s->stdwin = stdscr;
    } else if (use_tty) {
        // check sandbox filesystem access before opening TTY device
        QoreSandboxManagerHelper smh(QoreSandboxManagerHelper::Policy);
        if (smh) {
            if (!smh->checkFilesystemAccess(tty_path.c_str(), QSEC_READ | QSEC_WRITE, xsink)) {
                delete s;
                return;
            }
        }
        FILE* in = fopen(tty_path.c_str(), "r");
        FILE* out = fopen(tty_path.c_str(), "w");
        if (!in || !out) {
            if (in) { fclose(in); }
            if (out) { fclose(out); }
            delete s;
            xsink->raiseException("NCURSES-ERROR", "failed to open tty device '%s'", tty_path.c_str());
            return;
        }
        s->in_file = in;
        s->out_file = out;
        s->screen = nc_newterm(nullptr, out, in);
        if (!s->screen) {
            delete s;
            xsink->raiseException("NCURSES-ERROR", "newterm() failed");
            return;
        }
        s->is_default = false;
        set_term(s->screen);
        s->stdwin = stdscr;
    } else {
        s->screen = nc_newterm(nullptr, stdout, stdin);
        if (!s->screen) {
            delete s;
            xsink->raiseException("NCURSES-ERROR", "newterm() failed");
            return;
        }
        s->is_default = true;
        set_term(s->screen);
        s->stdwin = stdscr;
    }

    if (use_tty && unbuffered_stdio) {
        setvbuf(stdout, nullptr, _IONBF, 0);
        setvbuf(stderr, nullptr, _IONBF, 0);
    }

    if (!s->stdwin) {
        delete s;
        xsink->raiseException("NCURSES-ERROR", "failed to initialize ncurses");
        return;
    }

    s->raw_requested = raw_on; s->cbreak_requested = cbreak_on;
    if (cbreak_on) { cbreak(); }
    if (raw_on) { raw(); }
    if (!echo_on) { noecho(); }
    keypad(s->stdwin, keypad_on ? TRUE : FALSE);

    if (mouse_on) {
        nc_mousemask(ALL_MOUSE_EVENTS);
    }

    if (colors_on && has_colors()) {
        start_color();
        s->colors_enabled = true;
        if (default_colors_on) {
            use_default_colors();
            s->use_default_colors = true;
        }
    }

    if (cursor >= 0) {
        if (curs_set(cursor) != ERR) {
            s->cursor_visibility = cursor;
        }
    }
    if (esc_delay >= 0) {
#ifdef NCURSES_VERSION
        set_escdelay(esc_delay);
#else
#ifdef ESCDELAY
        ESCDELAY = esc_delay;
#endif
#endif
    }

    if (define_key("\x1b[200~", NC_PASTE_BEGIN) == ERR) {
        delete s; xsink->raiseException("NCURSES-ERROR", "cannot register bracketed paste input"); return;
    }
    s->setBracketedPaste(bracketed_paste, static_cast<size_t>(paste_limit), xsink);
    if (*xsink) { delete s; return; }
    self->setPrivate(CID_SESSION, s);

}

//! Configures terminal bracketed paste reporting and the maximum payload size
/** Paste events deliver one complete operation in InputEvent.ch. Partial payloads survive read timeouts.
    Oversized payloads are drained through their closing delimiter and raise NCURSES-PASTE-LIMIT;
    cancelled reads discard the partial paste through that delimiter. flushInput() abandons pending input.
    Enabling paste uses raw input and preserves CR/LF bytes; disabling restores the constructor's raw/cbreak mode.
    Read from a keypad-enabled window (the default screen setting) to recognize the opening delimiter.
    @param enabled enables terminal reporting; close() disables it automatically
    @param max_bytes maximum UTF-8 payload bytes (1..67108864), unchanged when omitted
    @throw NCURSES-PASTE-LIMIT for invalid bounds
    @throw NCURSES-PASTE-ERROR if a native paste is in progress
    @since ncurses 1.0
*/
nothing Session::setBracketedPaste(bool enabled, *int max_bytes) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) { return nothing(); }
    NcursesCallGuard guard(session);
    int64 limit = args->retrieveEntry(1).isNothing() ? static_cast<int64>(session->paste_limit) : max_bytes;
    if (limit < 1 || limit > 67108864) {
        xsink->raiseException("NCURSES-PASTE-LIMIT", "paste limit must be between 1 and 67108864 bytes"); return nothing();
    }
    session->setBracketedPaste(enabled, static_cast<size_t>(limit), xsink);
    return nothing();
}

//! Enables or disables mouse event reporting
/**
    @param enabled true to enable mouse events, false to disable

    @since %ncurses 1.0
*/
nothing Session::setMouse(bool enabled) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    nc_mousemask(enabled ? ALL_MOUSE_EVENTS : 0);
    return nothing();
}

//! Returns a snapshot of bytes waiting in an already-open output-capture pipe
/**
    This nonblocking snapshot lets a capture reader drain a finite prefix even
    while producers continue writing. The caller must own the read side and keep
    it open; do not mix buffered character reads or concurrent readers with this API.
    No path is opened and no data is consumed.
    @param file already-open read end of a pipe or terminal
    @return available byte count at the instant of the query
    @throw NCURSES-CAPTURE-ERROR if the file is closed or does not support FIONREAD
    @since %ncurses 1.0
*/
static int Session::pendingOutputBytes(ReadOnlyFile[File] file) [flags=RET_VALUE_ONLY,NAMED_ARGS;dom=FILESYSTEM] {
    if (*xsink) { return 0; }
    if (!file || !file->isOpen()) {
        xsink->raiseException("NCURSES-CAPTURE-ERROR", "capture input is not open");
        return 0;
    }
#ifdef FIONREAD
    int available = 0;
    while (true) {
        if (qore_check_cancel(xsink, "querying captured output")) { return 0; }
        if (ioctl(file->getFD(), FIONREAD, &available) == 0) { return available > 0 ? available : 0; }
        if (errno != EINTR) {
            xsink->raiseErrnoException("NCURSES-CAPTURE-ERROR", errno, "ioctl(FIONREAD) failed");
            return 0;
        }
    }
#else
    xsink->raiseException("NCURSES-CAPTURE-ERROR", "this platform does not support FIONREAD");
    return 0;
#endif
}

//! Redirects the C stdout stream to the given file
/**
    @param file target file

    @since %ncurses 1.0
*/
nothing Session::redirectStdout(File[File] file) [flags=NAMED_ARGS] {
    if (*xsink) {
        return nothing();
    }
    if (qore_check_cancel(xsink, "redirecting stdout")) {
        return nothing();
    }
    if (!file || !file->isOpen()) {
        xsink->raiseException("NCURSES-ERROR", "cannot redirect stdout: file is not open");
        return nothing();
    }
    int fd = file->getFD();
    if (fd < 0) {
        xsink->raiseException("NCURSES-ERROR", "cannot redirect stdout: invalid file descriptor");
        return nothing();
    }
    // flush any buffered data to the current (old) target before redirecting
    fflush(stdout);
    if (dup2(fd, STDOUT_FILENO) < 0) {
        xsink->raiseErrnoException("NCURSES-ERROR", errno, "dup2() failed redirecting stdout");
        return nothing();
    }
    // set unbuffered mode; fflush above ensures this takes effect even if
    // prior I/O occurred on stdout (setvbuf requires empty buffer on glibc)
    setvbuf(stdout, nullptr, _IONBF, 0);
    return nothing();
}

//! Redirects the C stderr stream to the given file
/**
    @param file target file

    @since %ncurses 1.0
*/
nothing Session::redirectStderr(File[File] file) [flags=NAMED_ARGS] {
    if (*xsink) {
        return nothing();
    }
    if (qore_check_cancel(xsink, "redirecting stderr")) {
        return nothing();
    }
    if (!file || !file->isOpen()) {
        xsink->raiseException("NCURSES-ERROR", "cannot redirect stderr: file is not open");
        return nothing();
    }
    int fd = file->getFD();
    if (fd < 0) {
        xsink->raiseException("NCURSES-ERROR", "cannot redirect stderr: invalid file descriptor");
        return nothing();
    }
    // flush any buffered data to the current (old) target before redirecting
    fflush(stderr);
    if (dup2(fd, STDERR_FILENO) < 0) {
        xsink->raiseErrnoException("NCURSES-ERROR", errno, "dup2() failed redirecting stderr");
        return nothing();
    }
    // set unbuffered mode; fflush above ensures this takes effect
    setvbuf(stderr, nullptr, _IONBF, 0);
    return nothing();
}

//! Flushes any buffered C stdio data on stdout and stderr
/** This ensures that output written via C's \c printf() / \c fputs() (used
    internally by Qore's \c print() builtin) is flushed to the underlying
    file descriptor.  Call this after evaluating user code to ensure all
    output reaches the capture pipe.

    @since %ncurses 1.0
*/
nothing Session::flushStdio() {
    fflush(stdout);
    fflush(stderr);
    return nothing();
}

//! Closes the session
/**
    @since %ncurses 1.0
*/
nothing Session::close() {
    session->close(xsink);
}

//! Returns true if the session is open
/**
    @since %ncurses 1.0
*/
bool Session::isOpen() {
    return session && !session->closed;
}

//! Returns the screen window
/**
    @since %ncurses 1.0
*/
Window Session::screen() {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    QoreObject* obj = new QoreObject(QC_WINDOW, getProgram(), new NcursesWindow(session, session->stdwin, false));
    return obj;
}

//! Returns a text snapshot of the base screen window (not the composed display)
/**
    @param y start row (default 0)
    @param rows number of rows (default full screen)
    @param cols number of columns (default full screen)

    @return list of strings (one per row)

    @since %ncurses 1.0
*/
list<string> Session::snapshot(*int y, *int rows, *int cols) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    bool has_y = args && args->size() > 0 && !args->retrieveEntry(0).isNothing();
    bool has_rows = args && args->size() > 1 && !args->retrieveEntry(1).isNothing();
    bool has_cols = args && args->size() > 2 && !args->retrieveEntry(2).isNothing();

    int start_y = has_y ? y : 0;
    int max_rows = has_rows ? rows : -1;
    int max_cols = has_cols ? cols : -1;

    NcursesCallGuard guard(session);
    int total_rows = 0;
    int total_cols = 0;
    getmaxyx(session->stdwin, total_rows, total_cols);
    if (max_rows < 0 || max_rows > total_rows) {
        max_rows = total_rows;
    }
    if (max_cols < 0 || max_cols > total_cols) {
        max_cols = total_cols;
    }
    if (start_y < 0) {
        start_y = 0;
    }
    if (start_y >= total_rows || max_rows <= 0 || max_cols <= 0) {
        return new QoreListNode(autoTypeInfo);
    }
    int end_row = std::min(total_rows, start_y + max_rows);
    int width = max_cols;
    ReferenceHolder<QoreListNode> out(new QoreListNode(autoTypeInfo), xsink);
    if (*xsink) {
        return nothing();
    }
    std::string buf;
    buf.resize(width + 1);
    for (int row = start_y; row < end_row; ++row) {
        mvwinnstr(session->stdwin, row, 0, &buf[0], width);
        buf[width] = 0;
        out->push(new QoreStringNode(buf.c_str(), QCS_UTF8), xsink);
        if (*xsink) {
            return nothing();
        }
    }
    return out.release();
}

//! Captures the completed composed screen without refreshing or changing live state
/** Call after Application::drawAll(), or updatePanels() followed by doupdate(),
    or a completed @ref Qore::Ncurses::Window::refresh() "Window::refresh()" or
    @ref Qore::Ncurses::Panel::update() "Panel::update()". Pending window or panel changes
    are deliberately excluded. Serialize the returned hash with the json module for
    review artifacts; it contains no timestamps, object references, or frame counters.

    Reads a private copy of ncurses' physical-screen image, including overlapping panels,
    styles, wide-character continuations and the physical cursor. It does not move a live
    window cursor, refresh, read input, invoke callbacks or change panel order. Call on
    the UI thread after completing application work to associate the frame with focus
    and scrolling assertions. It reads the entire screen; there are no crop arguments.

    This is ncurses' record of emitted output, not a query of terminal pixels. Out-of-band
    terminal writes, emulator fonts, palette RGB values, blink phase and terminal-specific
    rendering are outside the contract. Widths follow the active locale/ncurses build;
    combining marks are limited by ncurses' cchar_t capacity. Attributes reflect the
    physical-screen image; supported_attrs reports terminal capabilities. ACS glyphs
    retain their alternate-character-set attribute. Cursor visibility is -1 until a
    supported request is made. Capture before the first completed refresh, or between
    resize and redraw, is not a completed-frame checkpoint.

    @return structured physical screen capture
    @throw NCURSES-ERROR the session is closed or the screen cannot be read
    @since %ncurses 1.0
*/
hash<ScreenCapture> Session::capture() [flags=RET_VALUE_ONLY] {
    return session->capture(xsink);
}

//! Reads the terminal device geometry independently of ncurses' logical viewport
/** Queries the input terminal's current window size without resizing, consuming input
    or delivering a resize event. Logical viewport presets can differ from this size.
    @return current positive terminal rows and columns
    @throw NCURSES-ERROR closed session, unavailable device size, or ioctl failure
    @since %ncurses 1.0
*/
hash<Size> Session::terminalSize() [flags=RET_VALUE_ONLY] {
    NcursesCallGuard guard(session);
    session->checkOpen(xsink);
    if (*xsink) {
        return QoreValue();
    }
    struct winsize size = {};
    while (true) {
        if (qore_check_cancel(xsink, "reading terminal device dimensions")) {
            return QoreValue();
        }
        if (!ioctl(fileno(session->in_file ? session->in_file : stdin), TIOCGWINSZ, &size)) {
            break;
        }
        if (errno != EINTR) {
            xsink->raiseErrnoException("NCURSES-ERROR", errno, "ioctl(TIOCGWINSZ) failed");
            return QoreValue();
        }
    }
    if (!size.ws_row || !size.ws_col) {
        xsink->raiseException("NCURSES-ERROR", "terminal device dimensions are unavailable");
        return QoreValue();
    }
    ReferenceHolder<QoreHashNode> result(new QoreHashNode(hashdeclSize, xsink), xsink);
    if (*xsink || result->setKeyValue("rows", size.ws_row, xsink)
            || result->setKeyValue("cols", size.ws_col, xsink)) {
        return QoreValue();
    }
    return result.release();
}

//! Applies a known terminal geometry synchronously
/** Updates ncurses' screen buffers after the PTY or terminal has changed size.
    Unlike Window::resize(), this resizes the complete physical and virtual screen.
    It does not resize the terminal device itself or invoke application layout. Follow
    it with an InputType::Resize event delivered to Application::processEvent() and
    Application::drawAll() before capturing. Headless callers can first call
    TestTerminal::resize() and then this method, without signals or input polling.

    @param rows positive row count, at most 32767
    @param cols positive column count, at most 32767
    @throw NCURSES-ERROR invalid dimensions, closed session, or ncurses resize failure
    @since %ncurses 1.0
*/
nothing Session::resize(int rows, int cols) [flags=NAMED_ARGS] {
    NcursesCallGuard guard(session);
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    if (rows < 1 || rows > 32767 || cols < 1 || cols > 32767) {
        xsink->raiseException("NCURSES-ERROR", "screen rows and cols must be in 1..32767");
        return nothing();
    }
    if (resizeterm(static_cast<int>(rows), static_cast<int>(cols)) == ERR) {
        xsink->raiseException("NCURSES-ERROR", "resizeterm() failed");
    }
    return nothing();
}

//! Returns true if colors are enabled
/**
    @since %ncurses 1.0
*/
bool Session::supportsColor() {
    return session && session->colors_enabled;
}

//! Sets cursor visibility
/**
    @param visibility one of @ref CursorVisibility values
    @return the previous visibility, or -1 if the terminal does not support the
        requested visibility; callers can save this value to restore a modal's
        previous cursor state

    @since %ncurses 1.0
*/
int Session::setCursor(int visibility) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    int previous = curs_set(visibility);
    if (previous != ERR) {
        session->cursor_visibility = visibility;
    }
    return previous;
}

//! Sets the escape sequence delay
/**
    @param delay_ms delay in milliseconds (values < 0 are treated as 0)
    @return previous delay value if available, otherwise 0

    @since %ncurses 1.0
*/
int Session::setEscDelay(int delay_ms) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return 0;
    }
    if (delay_ms < 0) {
        delay_ms = 0;
    }
    NcursesCallGuard guard(session);
#ifdef NCURSES_VERSION
    return set_escdelay(delay_ms);
#else
#ifdef ESCDELAY
    int old = ESCDELAY;
    ESCDELAY = delay_ms;
    return old;
#else
    return 0;
#endif
#endif
}

//! Returns the maximum number of colors supported by the terminal
/**
    @return the number of colors the terminal supports (typically 8, 256, or more)

    @since %ncurses 1.0
*/
int Session::maxColors() {
    session->checkOpen(xsink);
    if (*xsink) {
        return 0;
    }
    NcursesCallGuard guard(session);
    return COLORS;
}

//! Returns true if the terminal supports color redefinition
/**
    When true, @ref initColor() can be used to redefine color slots with custom RGB values.

    @return true if the terminal supports redefining colors

    @since %ncurses 1.0
*/
bool Session::canChangeColor() {
    session->checkOpen(xsink);
    if (*xsink) {
        return false;
    }
    NcursesCallGuard guard(session);
    return can_change_color();
}

//! Redefines a color slot with custom RGB values
/**
    @param color the color number to redefine (0 to @ref maxColors() - 1)
    @param red red component (0-1000)
    @param green green component (0-1000)
    @param blue blue component (0-1000)

    @throw NCURSES-ERROR if the terminal does not support color redefinition or the color number is out of range

    @note The terminal must support color redefinition (@ref canChangeColor() returns true)

    @since %ncurses 1.0
*/
nothing Session::initColor(int color, int red, int green, int blue) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    if (!can_change_color()) {
        xsink->raiseException("NCURSES-ERROR", "terminal does not support color redefinition");
        return nothing();
    }
    if (color < 0 || color >= COLORS) {
        xsink->raiseException("NCURSES-ERROR", "color number %d out of range (0-%d)", (int)color, COLORS - 1);
        return nothing();
    }
    if (red < 0 || red > 1000 || green < 0 || green > 1000 || blue < 0 || blue > 1000) {
        xsink->raiseException("NCURSES-ERROR", "RGB values must be in range 0-1000");
        return nothing();
    }
    if (init_color(color, red, green, blue) != OK) {
        xsink->raiseException("NCURSES-ERROR", "init_color() failed for color %d", (int)color);
    }
    return nothing();
}

//! Flushes pending input
/**
    @since %ncurses 1.0
*/
nothing Session::flushInput() {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    flushinp();
    session->injected_input.clear(); session->injected_mouse.clear(); session->injected_paste.clear();
    // flushinp clears the input FIFO, not ncurses's separate mouse-event ring.
    // The finite ring cannot grow while this guard is held and no input is read.
    MEVENT discarded;
    while (getmouse(&discarded) == OK) {
    }
    session->pending_native_mouse = false;
    session->injected_paste_bytes = 0; session->resetPaste();
    return nothing();
}

//! Queues panel updates
/** Composes visible panels with the base window. When no visible panel exists,
    stages the base directly, including before libpanel has initialized its screen hook.
    Do not stage the base separately before this call when composing panels: its touched
    lines must remain available to libpanel's overlap propagation.
    @throw NCURSES-ERROR the session is closed or base staging fails
    @since %ncurses 1.0
*/
nothing Session::updatePanels() {
    NcursesCallGuard guard(session);
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    // update_panels() has no stdscr hook until the first native panel is created.
    // With panels, preserve stdscr's touched lines for libpanel's overlap propagation.
    if (!panel_above(nullptr) && wnoutrefresh(session->stdwin) == ERR) {
        xsink->raiseException("NCURSES-ERROR", "cannot stage the base screen");
        return nothing();
    }
    update_panels();
    return nothing();
}

//! Flushes the virtual screen to the terminal
/**
    Applies the most recent cursor position set with @ref Ncurses::Window::moveCursor
    or @ref Ncurses::Window::restoreCursor before updating the terminal.

    @since %ncurses 1.0
*/
nothing Session::doupdate() {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    if (session->cursor_set && session->cursor_win) {
        wmove(session->cursor_win, session->cursor_y, session->cursor_x);
        wnoutrefresh(session->cursor_win);
    }
    doupdate();
    return nothing();
}

//! Emits a terminal beep
/**
    @since %ncurses 1.0
*/
nothing Session::beep() {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    ::beep();
    return nothing();
}

//! Flashes the terminal
/**
    @since %ncurses 1.0
*/
nothing Session::flash() {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    ::flash();
    return nothing();
}

//! Executes a callback with the ncurses lock held
/**
    @param callback callable (closure or call reference)
    @param callback_args optional list of arguments

    @return the callback result

    @note The callback can call \c fork(): the child holds the lock as the callback did and can use the module

    @since %ncurses 1.0
*/
auto Session::withLock(code callback, *list callback_args) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    ReferenceHolder<ResolvedCallReferenceNode> holder(callback->refRefSelf(), xsink);
    if (*xsink) {
        return nothing();
    }
    QoreListNode* arg_list = callback_args ? const_cast<QoreListNode*>(callback_args) : nullptr;
    return holder->execValue(arg_list, xsink);
}

//! Injects input into the ncurses input queue
/**
    @param data input characters to inject

    @since %ncurses 1.0
*/
nothing Session::injectInput(string data) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    NcursesCallGuard guard(session);
    NcursesInputTransaction transaction(session, xsink);
    if (!data || !data->size()) {
        return nothing();
    }
    const char* buf = data->c_str();
    size_t len = data->size();
    for (size_t i = 0; i < len; ++i) {
        if (i % 100 == 0 && qore_check_cancel(xsink, "injecting terminal input")) { return nothing(); }
        if (!session->pushInput(static_cast<unsigned char>(buf[len - 1 - i]), xsink)) { return nothing(); }
    }
    return nothing();
}

//! Injects a single input event into the ncurses input queue
/**
    @param event input event hash (type + payload)
    - type (int) one of @ref InputType values
    - code (int) for Key or Char events
    - ch (string) for Char events
    - mouse (hash) for Mouse events with keys: x, y, button_state

    @since %ncurses 1.0
*/
nothing Session::injectEvent(hash<InputEvent> event) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    if (!event) {
        return nothing();
    }
    int type = NC_INPUT_CHAR;
    bool type_set = false;
    QoreValue vtype = event->getKeyValue("type");
    if (!vtype.isNothing()) {
        type = vtype.getAsBigInt();
        type_set = true;
    }

    QoreValue vcode = event->getKeyValue("code");
    QoreValue vch = event->getKeyValue("ch");
    QoreValue vmouse = event->getKeyValue("mouse");

    if (!type_set) {
        if (!vmouse.isNothing()) {
            type = NC_INPUT_MOUSE;
        } else if (!vcode.isNothing() && vcode.getAsBigInt() >= KEY_MIN) {
            type = NC_INPUT_KEY;
        } else {
            type = NC_INPUT_CHAR;
        }
    }

    NcursesCallGuard guard(session);
    NcursesInputTransaction transaction(session, xsink);
    if (type == NC_INPUT_CHAR) {
        if (!vch.isNothing()) {
            QoreStringValueHelper s(vch);
            if (!s->size()) {
                return nothing();
            }
            const char* buf = s->c_str();
            size_t len = s->size();
            for (size_t i = 0; i < len; ++i) {
                if (i % 100 == 0 && qore_check_cancel(xsink, "injecting terminal input")) { return nothing(); }
                if (!session->pushInput(static_cast<unsigned char>(buf[len - 1 - i]), xsink)) { return nothing(); }
            }
            return nothing();
        }
        if (vcode.isNothing()) {
            xsink->raiseException("NCURSES-ERROR", "injectEvent(): missing 'ch' or 'code' for Char event");
            return nothing();
        }
        int code = vcode.getAsBigInt();
        if (!session->pushInput(code, xsink)) { return nothing(); }
        return nothing();
    } else if (type == NC_INPUT_PASTE) {
        if (vch.isNothing()) { xsink->raiseException("NCURSES-PASTE-ERROR", "missing 'ch' for Paste event"); return nothing(); }
        QoreStringValueHelper text(vch); session->injectPaste(*text, xsink);
        return nothing();
    } else if (type == NC_INPUT_KEY) {
        if (vcode.isNothing()) {
            xsink->raiseException("NCURSES-ERROR", "injectEvent(): missing 'code' for Key event");
            return nothing();
        }
        int code = vcode.getAsBigInt();
        if (!session->pushInput(code, xsink)) { return nothing(); }
        return nothing();
    } else if (type == NC_INPUT_MOUSE) {
        if (vmouse.isNothing() || vmouse.getType() != NT_HASH) {
            xsink->raiseException("NCURSES-ERROR", "injectEvent(): missing 'mouse' hash for Mouse event");
            return nothing();
        }
        QoreHashNode* mh = vmouse.get<QoreHashNode>();
        int mx = 0;
        int my = 0;
        int bs = 0;
        QoreValue vx = mh->getKeyValue("x");
        QoreValue vy = mh->getKeyValue("y");
        QoreValue vbs = mh->getKeyValue("button_state");
        if (!vx.isNothing()) { mx = vx.getAsBigInt(); }
        if (!vy.isNothing()) { my = vy.getAsBigInt(); }
        if (!vbs.isNothing()) { bs = vbs.getAsBigInt(); }
        MEVENT me = {};
        me.x = mx;
        me.y = my;
        me.bstate = (mmask_t)bs;
        session->injectMouse(me, xsink);
        return nothing();
    } else if (type == NC_INPUT_RESIZE) {
        if (!session->pushInput(KEY_RESIZE, xsink)) { return nothing(); }
        return nothing();
    } else if (type == NC_INPUT_ALT) {
        if (vch.isNothing()) {
            xsink->raiseException("NCURSES-ERROR", "injectEvent(): missing 'ch' for Alt event");
            return nothing();
        }
        QoreStringValueHelper s(vch);
        if (!s->size()) {
            xsink->raiseException("NCURSES-ERROR", "injectEvent(): empty 'ch' for Alt event");
            return nothing();
        }
        session->injectAlt(*s, xsink);
        return nothing();
    }

    xsink->raiseException("NCURSES-ERROR", "injectEvent(): unsupported event type %d", type);
    return nothing();
}

//! Injects a list of input events into the ncurses input queue
/**
    @param events list of @ref InputEvent hashes

    @since %ncurses 1.0
*/
nothing Session::injectEvents(list<hash<InputEvent>> events) [flags=NAMED_ARGS] {
    session->checkOpen(xsink);
    if (*xsink) {
        return nothing();
    }
    if (!events) {
        return nothing();
    }
    size_t count = events->size();
    NcursesCallGuard guard(session);
    NcursesInputTransaction transaction(session, xsink);
    for (size_t i = 0; i < count; ++i) {
        if (i % 100 == 0 && qore_check_cancel(xsink, "injecting terminal events")) { return nothing(); }
        size_t idx = count - 1 - i;
        QoreValue v = events->retrieveEntry(idx);
        if (v.isNothing() || v.getType() != NT_HASH) {
            continue;
        }
        QoreHashNode* h = v.get<QoreHashNode>();
        int type = NC_INPUT_CHAR;
        bool type_set = false;
        QoreValue vtype = h->getKeyValue("type");
        if (!vtype.isNothing()) {
            type = vtype.getAsBigInt();
            type_set = true;
        }

        QoreValue vcode = h->getKeyValue("code");
        QoreValue vch = h->getKeyValue("ch");
        QoreValue vmouse = h->getKeyValue("mouse");

        if (!type_set) {
            if (!vmouse.isNothing()) {
                type = NC_INPUT_MOUSE;
            } else if (!vcode.isNothing() && vcode.getAsBigInt() >= KEY_MIN) {
                type = NC_INPUT_KEY;
            } else {
                type = NC_INPUT_CHAR;
            }
        }

        if (type == NC_INPUT_CHAR) {
            if (!vch.isNothing()) {
                QoreStringValueHelper s(vch);
                if (!s->size()) {
                    continue;
                }
                const char* buf = s->c_str();
                size_t len = s->size();
                for (size_t i2 = 0; i2 < len; ++i2) {
                    if (i2 % 100 == 0 && qore_check_cancel(xsink, "injecting terminal input")) { return nothing(); }
                    if (!session->pushInput(static_cast<unsigned char>(buf[len - 1 - i2]), xsink)) { return nothing(); }
                }
            } else if (vcode.isNothing()) {
                xsink->raiseException("NCURSES-ERROR", "injectEvents(): missing 'ch' or 'code' for Char event");
                return nothing();
            } else {
                int code = vcode.getAsBigInt();
                if (!session->pushInput(code, xsink)) { return nothing(); }
            }
        } else if (type == NC_INPUT_PASTE) {
            if (vch.isNothing()) { xsink->raiseException("NCURSES-PASTE-ERROR", "missing 'ch' for Paste event"); return nothing(); }
            QoreStringValueHelper text(vch); session->injectPaste(*text, xsink);
            if (*xsink) { return nothing(); }
        } else if (type == NC_INPUT_KEY) {
            if (vcode.isNothing()) {
                xsink->raiseException("NCURSES-ERROR", "injectEvents(): missing 'code' for Key event");
                return nothing();
            }
            int code = vcode.getAsBigInt();
            if (!session->pushInput(code, xsink)) { return nothing(); }
        } else if (type == NC_INPUT_MOUSE) {
            if (vmouse.isNothing() || vmouse.getType() != NT_HASH) {
                xsink->raiseException("NCURSES-ERROR", "injectEvents(): missing 'mouse' hash for Mouse event");
                return nothing();
            }
            QoreHashNode* mh = vmouse.get<QoreHashNode>();
            int mx = 0;
            int my = 0;
            int bs = 0;
            QoreValue vx = mh->getKeyValue("x");
            QoreValue vy = mh->getKeyValue("y");
            QoreValue vbs = mh->getKeyValue("button_state");
            if (!vx.isNothing()) { mx = vx.getAsBigInt(); }
            if (!vy.isNothing()) { my = vy.getAsBigInt(); }
            if (!vbs.isNothing()) { bs = vbs.getAsBigInt(); }
            MEVENT me = {};
            me.x = mx;
            me.y = my;
            me.bstate = (mmask_t)bs;
            session->injectMouse(me, xsink);
        } else if (type == NC_INPUT_RESIZE) {
            if (!session->pushInput(KEY_RESIZE, xsink)) { return nothing(); }
        } else if (type == NC_INPUT_ALT) {
            if (vch.isNothing()) {
                xsink->raiseException("NCURSES-ERROR", "injectEvents(): missing 'ch' for Alt event");
                return nothing();
            }
            QoreStringValueHelper s2(vch);
            if (!s2->size()) {
                xsink->raiseException("NCURSES-ERROR", "injectEvents(): empty 'ch' for Alt event");
                return nothing();
            }
            session->injectAlt(*s2, xsink);
            if (*xsink) { return nothing(); }
        } else {
            xsink->raiseException("NCURSES-ERROR", "injectEvents(): unsupported event type %d", type);
            return nothing();
        }
        if (*xsink) {
            return nothing();
        }
    }
    return nothing();
}

//! Wakes readEvent() without synthesizing input.
/** Thread-safe and coalescing: a wake before a read is retained until consumed.
    Ready terminal/synthetic input has priority, preventing work notifications from starving input.
    Safe to call from background workers; widgets must still be updated on the UI thread.
    @throw NCURSES-ERROR if the session is closed or the wake channel cannot be used
    @since %ncurses 1.0
*/
nothing Session::wakeup() {
    session->wakeup(xsink);
    return nothing();
}
