#include "ncurses-internal.h"

//! Cursor visibility enum
/** Cursor visibility modes.

    @since %ncurses 1.0
*/
enum Qore::Ncurses::CursorVisibility : int {
    Hidden = 0,
    Normal = 1,
    VeryVisible = 2
};

//! Input event type enum
/** Input event types produced by @ref Qore::Ncurses::Window::readEvent() "Window::readEvent()".

    @since %ncurses 1.0
*/
enum Qore::Ncurses::InputType : int {
    None = 0,
    Char = 1,
    Key = 2,
    Mouse = 3,
    Resize = 4,
    Alt = 5,
    //! A complete bracketed paste; ch contains text, including newlines and controls.
    Paste = 6,
    //! Application work is ready; no keyboard character is synthesized.
    Wake = 7
};

//! Color enum
/** Basic ncurses colors.

    @since %ncurses 1.0
*/
enum Qore::Ncurses::Color : int {
    Default = -1,
    Black = COLOR_BLACK,
    Red = COLOR_RED,
    Green = COLOR_GREEN,
    Yellow = COLOR_YELLOW,
    Blue = COLOR_BLUE,
    Magenta = COLOR_MAGENTA,
    Cyan = COLOR_CYAN,
    White = COLOR_WHITE
};

//! Text attribute enum
/** Text attributes used with @ref Ncurses::Style.

    @since %ncurses 1.0
*/
enum Qore::Ncurses::Attr : int {
    NormalAttr = A_NORMAL,
    Standout = A_STANDOUT,
    Underline = A_UNDERLINE,
    Reverse = A_REVERSE,
    Blink = A_BLINK,
    Dim = A_DIM,
    Bold = A_BOLD
};

//! Text wrapping mode enum
/** Controls how text is wrapped when rendering in panels or windows.

    @since %ncurses 1.0
*/
enum Qore::Ncurses::WrapMode : int {
    //! No wrapping; text is clipped to the line width
    None = 0,
    //! Hard wrap at the line width
    Hard = 1,
    //! Word wrap when possible, otherwise hard wrap
    Word = 2
};

//! Style hashdecl
/** Style definition for text and backgrounds.

    @since %ncurses 1.0
*/
hashdecl Qore::Ncurses::Style {
    //! Foreground color (Ncurses::Color)
    int fg;
    //! Background color (Ncurses::Color)
    int bg;
    //! Bitwise attributes (Ncurses::Attr)
    int attrs;
}

//! Size hashdecl
/** Size hashdecl.

    @since %ncurses 1.0
*/
hashdecl Qore::Ncurses::Size {
    //! Number of rows
    int rows;
    //! Number of columns
    int cols;
}

//! Position hashdecl
/** Position hashdecl.

    @since %ncurses 1.0
*/
hashdecl Qore::Ncurses::Position {
    //! Row (y)
    int y;
    //! Column (x)
    int x;
}

//! One physical screen cell in a completed ncurses frame
/** @since %ncurses 1.0 */
hashdecl Qore::Ncurses::ScreenCell {
    //! UTF-8 spacing character and combining marks; empty for a continuation cell
    string text;
    //! Display columns occupied by a leading cell; zero for a continuation
    int width;
    //! True for a column occupied by the preceding wide character
    bool continuation;
    //! ncurses attribute bits, excluding color-pair bits
    int attrs;
    //! ncurses color-pair identifier (local to this session)
    int pair;
    //! Palette index, or -1 for the terminal default; NOTHING when colors are disabled
    *int fg;
    //! Palette index, or -1 for the terminal default; NOTHING when colors are disabled
    *int bg;
}

//! Cursor state associated with the physical screen
/** @since %ncurses 1.0 */
hashdecl Qore::Ncurses::ScreenCursor {
    //! Zero-based physical screen row, including when the cursor is hidden
    int y;
    //! Zero-based physical screen column, including when the cursor is hidden
    int x;
    //! Last supported CursorVisibility request, or -1 when unknown/unsupported
    int visibility;
}

//! Serializable, observational capture of ncurses' physical screen
/** @since %ncurses 1.0 */
hashdecl Qore::Ncurses::ScreenCapture {
    //! Capture schema version (1)
    int schema;
    //! Physical screen rows
    int rows;
    //! Physical screen columns
    int cols;
    //! Cells in row-major order; cell (y, x) is cells[y * cols + x]
    list<hash<ScreenCell>> cells;
    //! Physical cursor coordinates and visibility
    hash<ScreenCursor> cursor;
    //! Terminal type reported by ncurses
    string terminal;
    //! Whether this session enabled colors
    bool colors_enabled;
    //! Available palette entries (zero when colors are disabled)
    int colors;
    //! Terminal-supported video attribute bits, excluding color-pair bits
    int supported_attrs;
}

//! Mouse event hashdecl
/** Mouse event information.

    @since %ncurses 1.0
*/
hashdecl Qore::Ncurses::MouseEvent {
    //! Column (x)
    int x;
    //! Row (y)
    int y;
    //! Button state mask
    int button_state;
}

//! Input event hashdecl
/** Input event information.

    @since %ncurses 1.0
*/
hashdecl Qore::Ncurses::InputEvent {
    //! Ncurses::InputType
    int type;
    //! Key code for key events
    int code;
    //! Character for Char/Alt events, or complete text for Paste events
    string ch;
    //! Human-readable name for key events
    string name;
    //! Mouse event details (if type == Ncurses::InputType::Mouse)
    hash<MouseEvent> mouse;
}
