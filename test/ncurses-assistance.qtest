#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QUnit
%include "test/TestHarness.qc"
%exec-class AssistanceTest
class AssistanceTest inherits Test {
    constructor() : Test("AssistanceTest", "1.0", \ARGV) {
        addTestCase("ranked filtering and exact quoted mid-token edits", \completion());
        addTestCase("Unicode source ranges reject partial graphemes", \unicodeRanges());
        addTestCase("stale and cancelled requests never replace current assistance", \stale());
        addTestCase("invalid provider responses are atomic and failures preserve editing", \failures());
        addTestCase("diagnostic, signature and action metadata remain typed", \diagnostics());
        addTestCase("actions are one-shot, exception safe and guarded", \actions());
        addTestCase("popup filtering documentation and precise edits restore modal focus", \popup());
        addTestCase("popup anchors clamp across wrap resize and hidden editor geometry", \popupGeometry());
        addTestCase("numeric text identities filters and missing metadata remain precise", \metadata());
        addTestCase("application mouse dispatch switches popup documentation and list navigation", \popupMouse());
        addTestCase("popup action failures retain modal focus and allow retry", \popupFailure());
        addTestCase("outside primary clicks dismiss owned panels and preserve click-through", \outsideDismiss());
        set_return_value(main());
    }
    outsideDismiss() {
        foreach int state in ((Ncurses::BUTTON1_PRESSED, Ncurses::BUTTON1_CLICKED,
                Ncurses::BUTTON1_DOUBLE_CLICKED, Ncurses::BUTTON1_TRIPLE_CLICKED)) {
            NcursesUi::TestHarness th(18, 45); on_exit th.close(); NcursesUi::Application app(th.session()); on_exit app.close();
            NcursesUi::TextEditorWidget editor(); editor.setText("draft"); app.setRoot(editor);
            app.getFocusManager().setFocus(editor); app.drawAll();
            NcursesUi::AssistanceModel model(editor.getBuffer());
            hash<NcursesUi::AssistanceRequest> request = model.beginRequest();
            model.complete(request, <NcursesUi::AssistanceResponse>{"completions": (item("id", "Item"),)});
            NcursesUi::AssistancePopupWidget popup(th.session(), editor, model);
            popup.setMaximumSize(8, 25); popup.positionAtCaret(18, 45); popup.createPanel(); on_exit popup.destroyPanel();
            int dismissed = 0; popup.setOnDismiss(sub () { ++dismissed; app.popModal(); popup.destroyPanel(); });
            app.pushPopup(popup); app.drawAll();
            hash<Ncurses::InputEvent> event = <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
                "mouse": <Ncurses::MouseEvent>{"y": 0, "x": 0, "button_state": Ncurses::BUTTON5_PRESSED}};
            app.processEvent(event); assertTrue(app.getDispatcher().hasModal()); assertEq(0, dismissed);
            event.mouse.button_state = Ncurses::BUTTON1_RELEASED; app.processEvent(event); assertTrue(app.getDispatcher().hasModal());
            event.mouse.button_state = state; app.processEvent(event); app.drawAll();
            assertEq(1, dismissed); assertFalse(app.getDispatcher().hasModal()); assertNothing(popup.getWindow());
            assertFalse(popup.isVisible()); assertNothing(model.getResponse());
            assertFalse(model.complete(request, <NcursesUi::AssistanceResponse>{}));
            assertEq(editor, app.getFocusManager().getCurrentFocus()); assertEq("draft", editor.getText());
            if (state & (Ncurses::BUTTON1_PRESSED | Ncurses::BUTTON1_CLICKED)) { assertEq(0, editor.getBuffer().getCursor()); }
        }
    }
    popupMouse() {
        NcursesUi::TestHarness th(18, 45); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::TextEditorWidget editor(); app.setRoot(editor); app.getFocusManager().setFocus(editor); app.drawAll();
        NcursesUi::AssistanceModel model(editor.getBuffer()); hash<NcursesUi::CompletionItem> completion = item("id", "Item"); completion.documentation = strmul("Documentation line\n", 30);
        model.complete(model.beginRequest(), <NcursesUi::AssistanceResponse>{"completions": (completion, item("next", "Next"))});
        NcursesUi::AssistancePopupWidget popup(th.session(), editor, model); popup.setMaximumSize(10, 30); popup.positionAtCaret(18, 45); popup.createPanel(); on_exit popup.destroyPanel(); app.pushPopup(popup); app.drawAll();
        hash<NcursesUi::Rect> content = popup.contentRect(); int docs_row = content.y + content.rows / 2;
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": <Ncurses::MouseEvent>{"y": docs_row, "x": content.x, "button_state": Ncurses::BUTTON5_PRESSED}});
        assertTrue(popup.getTitle().find("Documentation") >= 0); int before = popup.getDocumentationScrollY(); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_NPAGE"}); assertTrue(popup.getDocumentationScrollY() > before); assertEq(popup, app.getFocusManager().getCurrentFocus());
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": <Ncurses::MouseEvent>{"y": content.y, "x": content.x, "button_state": Ncurses::BUTTON1_CLICKED}}); assertEq(-1, popup.getTitle().find("Documentation"));
        popup.setOnDismiss(sub () { app.popModal(); popup.destroyPanel(); });
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": <Ncurses::MouseEvent>{"y": content.y, "x": content.x, "button_state": Ncurses::BUTTON1_CLICKED | Ncurses::BUTTON1_DOUBLE_CLICKED}}); assertEq("replacement", editor.getText()); assertFalse(app.getDispatcher().hasModal()); app.close();
    }
    popupFailure() {
        NcursesUi::TestHarness th(15, 40); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::TextEditorWidget editor(); app.setRoot(editor); editor.setText("draft"); app.getFocusManager().setFocus(editor); app.drawAll();
        NcursesUi::AssistanceModel model(editor.getBuffer()); model.complete(model.beginRequest(), <NcursesUi::AssistanceResponse>{"actions": (<NcursesUi::AssistanceAction>{"id": "retry", "label": "Retry"},)});
        model.setOnAction(sub (string id) { throw "ACTION-ERROR", "failed"; }); NcursesUi::AssistancePopupWidget popup(th.session(), editor, model); popup.positionAtCaret(15, 40); popup.createPanel(); on_exit popup.destroyPanel(); popup.setOnDismiss(sub () { app.popModal(); popup.destroyPanel(); }); app.pushPopup(popup);
        assertThrows("ACTION-ERROR", sub () { app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_ENTER"}); }); assertTrue(app.getDispatcher().hasModal()); assertEq(popup, app.getFocusManager().getCurrentFocus()); assertEq("draft", editor.getText());
        int calls = 0; model.setOnAction(sub (string id) { assertEq("retry", id); ++calls; }); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_ENTER"}); assertEq(1, calls); assertFalse(app.getDispatcher().hasModal()); assertEq(editor, app.getFocusManager().getCurrentFocus()); app.close();
    }
    metadata() {
        NcursesUi::EditorBuffer editor(); NcursesUi::AssistanceModel model(editor); hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        hash<NcursesUi::CompletionItem> zero = item("0", "Zero"); zero.filter_text = "0";
        assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (zero, item("other", "Other"))})); assertEq(1, model.getCompletions("0").size()); assertEq("0", model.getCompletions("0")[0].id); assertTrue(model.applyCompletion("0"));
        token = model.beginRequest();
        assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (<NcursesUi::CompletionItem>{"id": "missing"},)}); });
        zero.range = <NcursesUi::SourceRange>{}; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (zero,)}); });
        assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"actions": (<NcursesUi::AssistanceAction>{"id": "0", "label": "Zero", "text": "0"},)}); }); assertTrue(model.isPending());
    }
    popup() {
        NcursesUi::TestHarness th(16, 50); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::TextEditorWidget editor(); app.setRoot(editor);
        editor.setText("prefix value suffix"); editor.getBuffer().setCursor(10); app.getFocusManager().setFocus(editor); app.drawAll();
        NcursesUi::AssistanceModel model(editor.getBuffer()); hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        hash<NcursesUi::CompletionItem> completion = item("value", "VALUE"); completion.range = range(7, 12); completion.text = "updated";
        list<string> docs = (); for (int i = 0; i < 30; ++i) { docs += "Documentation " + i; } completion.documentation = join("\n", docs);
        model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (completion, item("other", "Other"))});
        NcursesUi::AssistancePopupWidget popup(th.session(), editor, model); popup.setMaximumSize(10, 30); assertTrue(popup.positionAtCaret(16, 50)); popup.createPanel();
        popup.setOnDismiss(sub () { assertEq(popup, app.popModal()); popup.destroyPanel(); }); app.pushPopup(popup); app.drawAll();
        assertEq(popup, app.getFocusManager().getCurrentFocus()); assertEq(2, popup.getResults().size());
        popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "v"}); assertEq("v", popup.getFilter()); assertEq(1, popup.getResults().size()); assertEq(token.text, editor.getText());
        popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"}); popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_NPAGE"});
        assertTrue(popup.getDocumentationScrollY() > 0); app.drawAll(); assertTrue(popup.getTitle().find("Documentation") >= 0);
        NcursesUi::DialogWidget nested(th.session(), "Nested", "Read more", ("OK",)); nested.setFrameValues(2, 2, 5, 20); nested.createPanel(); app.pushModal(nested); app.drawAll();
        app.popModal(); nested.destroyPanel(); assertEq(popup, app.getFocusManager().getCurrentFocus());
        popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_ENTER"}); app.drawAll();
        assertEq("prefix updated suffix", editor.getText()); assertEq(editor, app.getFocusManager().getCurrentFocus()); assertNothing(popup.getWindow()); assertFalse(popup.isVisible());
        assertTrue(editor.getBuffer().undo()); assertEq(token.text, editor.getText());
    }
    popupGeometry() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close(); NcursesUi::Widget root(); root.setFrameValues(0, 0, 12, 30);
        NcursesUi::TextEditorWidget editor(); editor.setFrameValues(8, 20, 3, 8); root.addChild(editor); editor.setText("界界 abcdef"); editor.setFocused(True); root.drawTree(th.screen());
        NcursesUi::AssistanceModel model(editor.getBuffer()); hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        model.complete(token, <NcursesUi::AssistanceResponse>{"signature": <NcursesUi::SignatureHelp>{"label": "call(first, second)", "parameters": ("first", "second"), "active_parameter": 1, "documentation": "Details"}});
        NcursesUi::AssistancePopupWidget popup(th.session(), editor, model); assertTrue(popup.positionAtCaret(12, 30)); popup.createPanel(); on_exit popup.destroyPanel(); popup.drawTree(th.screen());
        hash<NcursesUi::Rect> frame = popup.getFrame(); assertTrue(frame.y >= 0 && frame.y + frame.rows <= 12); assertTrue(frame.x >= 0 && frame.x + frame.cols <= 30);
        assertTrue(join("\n", popup.getDocumentation()).find("Parameter: second") >= 0); assertFalse(popup.activateSelected());
        assertThrows("ASSISTANCE-SIZE-ERROR", sub () { popup.setMaximumSize(0, 10); });
        NcursesUi::TextEditorWidget other(); assertThrows("ASSISTANCE-EDITOR-ERROR", sub () { new NcursesUi::AssistancePopupWidget(th.session(), other, model); });
        editor.setFrameValues(0, 0, 1, 1); root.drawTree(th.screen()); popup.fitToScreen(1, 1); assertTrue(popup.getFrame().rows <= 1); assertFalse(popup.getHasBorder());
        root.setVisible(False); assertFalse(popup.positionAtCaret(12, 30)); assertFalse(popup.isVisible()); assertNothing(model.getResponse()); assertFalse(model.complete(token, <NcursesUi::AssistanceResponse>{}));
        root.setVisible(True); popup.drawTree(th.screen()); assertFalse(popup.isVisible());
        popup.positionAtCaret(12, 30); editor.getBuffer().insert("x"); popup.drawTree(th.screen()); assertEq(0, popup.getResults().size());
    }
    private hash<NcursesUi::SourceRange> range(int start, int end) { return <NcursesUi::SourceRange>{"start": start, "end": end}; }
    private hash<NcursesUi::CompletionItem> item(string id, string label, int rank = 0) {
        return <NcursesUi::CompletionItem>{"id": id, "label": label, "text": "replacement", "range": range(0, 0), "rank": rank};
    }
    completion() {
        NcursesUi::EditorBuffer editor(); editor.setText("call(\"al pha\", next)"); editor.setCursor(8);
        NcursesUi::AssistanceModel model(editor); hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        hash<NcursesUi::CompletionItem> exact = item("exact", "Alpha", 10); exact.range = range(6, 12); exact.text = "alpha beta"; exact.documentation = "Long docs";
        hash<NcursesUi::CompletionItem> low = item("low", "alphabet", 1); low.filter_text = "different";
        assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (low, exact, item("equal", "Alpha second", 10))}));
        list<hash<NcursesUi::CompletionItem>> ranked = model.getCompletions("ALPHA"); assertEq(2, ranked.size()); assertEq("exact", ranked[0].id); assertEq("equal", ranked[1].id);
        assertEq("low", model.getCompletions("different")[0].id); assertEq(0, model.getCompletions("absent").size());
        assertThrows("ASSISTANCE-ID-ERROR", sub () { model.applyCompletion("missing"); }); assertEq(token.text, editor.getText());
        assertTrue(model.applyCompletion("exact")); assertEq("call(\"alpha beta\", next)", editor.getText()); assertFalse(model.applyCompletion("exact"));
        assertTrue(editor.undo()); assertEq(token.text, editor.getText()); assertEq(8, editor.getCursor()); assertNothing(model.getResponse());
    }
    unicodeRanges() {
        NcursesUi::EditorBuffer editor(); editor.setText("é界👩‍💻x"); NcursesUi::AssistanceModel model(editor);
        hash<NcursesUi::AssistanceRequest> token = model.beginRequest(); hash<NcursesUi::CompletionItem> value = item("unicode", "界");
        value.range = range(1, 3); assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value,)}); });
        value.range = range(2, 4); assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value,)}); });
        value.range = range(2, 6); value.text = "語"; assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value,)}));
        assertTrue(model.applyCompletion("unicode")); assertEq("é語x", editor.getText()); assertTrue(editor.undo()); assertEq(token.text, editor.getText());
    }
    stale() {
        NcursesUi::EditorBuffer editor(); editor.setText("draft"); NcursesUi::AssistanceModel model(editor);
        hash<NcursesUi::AssistanceResponse> response = <NcursesUi::AssistanceResponse>{"completions": (item("id", "Item"),)};
        hash<NcursesUi::AssistanceRequest> first = model.beginRequest(); assertTrue(model.isPending());
        hash<NcursesUi::AssistanceRequest> second = model.beginRequest(); assertFalse(model.complete(first, response)); assertFalse(model.fail(first, "old"));
        assertTrue(model.complete(second, response)); assertFalse(model.isPending()); assertTrue(exists model.getResponse());
        editor.setCursor(2); assertNothing(model.getResponse()); assertFalse(model.applyCompletion("id"));
        first = model.beginRequest(); editor.insert("x"); assertFalse(model.complete(first, response)); assertFalse(model.isPending());
        first = model.beginRequest(); model.cancel(); assertFalse(model.complete(first, response)); assertNothing(model.getError());
        first = model.beginRequest();
        NcursesUi::AssistanceModel original(editor); NcursesUi::AssistanceModel replacement(editor);
        hash<NcursesUi::AssistanceRequest> old_request = original.beginRequest(); hash<NcursesUi::AssistanceRequest> new_request = replacement.beginRequest();
        assertEq(old_request.generation, new_request.generation); assertFalse(replacement.complete(old_request, response)); assertTrue(replacement.complete(new_request, response));
        hash<NcursesUi::AssistanceRequest> forged = first; forged.text = "wrong"; assertFalse(model.complete(forged, response));
        assertTrue(model.fail(first, "failed")); assertEq("failed", model.getError()); assertEq("drxaft", editor.getText());
    }
    failures() {
        NcursesUi::EditorBuffer editor(); editor.setText("draft"); NcursesUi::AssistanceModel model(editor);
        assertFalse(model.request()); model.setProvider(hash<NcursesUi::AssistanceResponse> sub (hash<NcursesUi::AssistanceRequest> request) { throw "PROVIDER-ERROR", "offline"; });
        assertThrows("PROVIDER-ERROR", sub () { model.request(); }); assertEq("offline", model.getError()); assertEq("draft", editor.getText()); assertFalse(model.isPending());
        model.setProvider(hash<NcursesUi::AssistanceResponse> sub (hash<NcursesUi::AssistanceRequest> request) { model.request(); return <NcursesUi::AssistanceResponse>{}; });
        assertThrows("ASSISTANCE-BUSY-ERROR", sub () { model.request(); }); assertEq("draft", editor.getText());
        model.setProvider(hash<NcursesUi::AssistanceResponse> sub (hash<NcursesUi::AssistanceRequest> request) { model.cancel(); return <NcursesUi::AssistanceResponse>{}; }); assertFalse(model.request());
        hash<NcursesUi::AssistanceRequest> token = model.beginRequest(); hash<NcursesUi::CompletionItem> value = item("id", "Item");
        assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value, value)}); });
        foreach hash<NcursesUi::SourceRange> invalid in ((range(-1, 0), range(3, 2), range(0, 99))) {
            value.range = invalid; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value,)}); });
        }
        value.range = range(0, 1); value.text = "\x1b[31m"; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"completions": (value,)}); });
        assertNothing(model.getResponse()); assertTrue(model.isPending()); assertEq("draft", editor.getText());
        assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{})); assertNothing(model.getError());
        model.setProvider(hash<NcursesUi::AssistanceResponse> sub (hash<NcursesUi::AssistanceRequest> request) { return <NcursesUi::AssistanceResponse>{}; }); assertTrue(model.request());
    }
    diagnostics() {
        NcursesUi::EditorBuffer editor(); editor.setText("abc def"); NcursesUi::AssistanceModel model(editor);
        hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        hash<NcursesUi::DiagnosticItem> diagnostic = <NcursesUi::DiagnosticItem>{"id": "d", "message": "Unknown name", "range": range(4, 7)};
        hash<NcursesUi::SignatureHelp> signature = <NcursesUi::SignatureHelp>{"label": "call(name, count)", "parameters": ("name", "count"), "active_parameter": 1};
        hash<NcursesUi::AssistanceResponse> value = <NcursesUi::AssistanceResponse>{"diagnostics": (diagnostic,), "signature": signature};
        value.signature.active_parameter = 2; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, value); }); value.signature = signature;
        value.diagnostics[0].severity = 9; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, value); }); value.diagnostics = (diagnostic, diagnostic);
        assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, value); }); value.diagnostics = (diagnostic,);
        assertTrue(model.complete(token, value)); assertEq("count", model.getResponse().signature.parameters[1]);
        assertThrows("ASSISTANCE-ID-ERROR", sub () { model.selectDiagnostic("missing"); }); assertTrue(model.selectDiagnostic("d")); assertEq("def", editor.selectedText()); assertFalse(model.selectDiagnostic("d"));
    }
    actions() {
        NcursesUi::EditorBuffer editor(); editor.setText("draft"); NcursesUi::AssistanceModel model(editor);
        hash<NcursesUi::AssistanceAction> action = <NcursesUi::AssistanceAction>{"id": "open-docs", "label": "Read help"};
        hash<NcursesUi::AssistanceRequest> token = model.beginRequest();
        assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"actions": (action, action)}); });
        action.text = "unanchored"; assertThrows("ASSISTANCE-DATA-ERROR", sub () { model.complete(token, <NcursesUi::AssistanceResponse>{"actions": (action,)}); }); action.text = "";
        assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{"actions": (action,)})); assertFalse(model.activateAction(action.id));
        model.setOnAction(sub (string id) { throw "ACTION-ERROR", "offline"; }); assertThrows("ACTION-ERROR", sub () { model.activateAction(action.id); }); assertEq("draft", editor.getText()); assertTrue(exists model.getResponse());
        model.setOnAction(sub (string id) { model.cancel(); }); assertThrows("ASSISTANCE-BUSY-ERROR", sub () { model.activateAction(action.id); });
        int calls = 0; model.setOnAction(sub (string id) { assertEq("open-docs", id); ++calls; });
        assertTrue(model.activateAction(action.id)); assertEq(1, calls); assertFalse(model.activateAction(action.id));
        token = model.beginRequest(); action.range = range(0, 5); action.text = "fixed";
        assertTrue(model.complete(token, <NcursesUi::AssistanceResponse>{"actions": (action,)})); assertTrue(model.activateAction(action.id)); assertEq("fixed", editor.getText()); assertEq(1, calls); assertTrue(editor.undo()); assertEq("draft", editor.getText());
    }
}
