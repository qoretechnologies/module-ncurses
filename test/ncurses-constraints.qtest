#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QUnit
%include "test/TestHarness.qc"
%exec-class ConstraintsTest

class FailingPanel inherits NcursesUi::PanelWidget {
    public { bool fail = False; }
    constructor(Ncurses::Session s) : PanelWidget(s) {}
    nothing createPanel() {
        if (fail) { throw "PANEL-TEST", "creation failed"; }
        PanelWidget::createPanel();
    }
}
class ConstraintsTest inherits Test {
    constructor() : Test("ConstraintsTest", "1.0", \ARGV) {
        addTestCase("nested panel clipping preserves open intent and requested geometry", \reviewPanels());
        addTestCase("hit testing and ordinary controls match clipped drawing", \reviewClipping());
        addTestCase("combo pages match its capped dropdown height", \reviewComboPage());
        addTestCase("panel children use screen geometry and window-local drawing", \panel());
        addTestCase("nested panels and overflow preserve borders and input coordinates", \nested());
        addTestCase("overflow clips every edge without changing logical geometry", \clipping());
        addTestCase("derived windows retain shared storage through nested parent destruction", \lifetime());
        addTestCase("panel replacement failure preserves resources and geometry", \panelFailure());
        addTestCase("fixed and minimum layouts fit undersized containers", \box());
        addTestCase("clipped choices and expanding minima use available geometry", \clippedChoices());
        addTestCase("tiny dialogs retain reachable actions and scrollable messages", \dialog());
        addTestCase("active modal resize preserves focus and selection", \resize());
        addTestCase("menu scrolling skips disabled choices and separators", \menu());
        addTestCase("empty and all-disabled menus terminate and recover", \disabledMenu());
        addTestCase("radio keyboard and mouse use visible choices after resize", \radio());
        addTestCase("combo navigation, wheel, choice clicks and closed-row clearing", \combo());
        addTestCase("completion highlight remains visible in a short popup", \completion());
        addTestCase("choice callback errors leave usable controls", \callbacks());
        set_return_value(main());
    }
    private hash<Ncurses::InputEvent> key(string name) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": name};
    }
    private hash<Ncurses::InputEvent> ch(string c) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": c};
    }
    private hash<Ncurses::InputEvent> click(int y, int x, int bs = Ncurses::BUTTON1_CLICKED) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
            "mouse": <Ncurses::MouseEvent>{"y": y, "x": x, "button_state": bs}};
    }
    private nothing bounded(hash<NcursesUi::Rect> r, int rows, int cols) {
        assertTrue(r.y >= 0 && r.x >= 0 && r.rows >= 0 && r.cols >= 0);
        assertTrue(r.y + r.rows <= rows && r.x + r.cols <= cols);
    }
    reviewPanels() {
        NcursesUi::TestHarness th(16, 40); on_exit th.close();
        NcursesUi::PanelWidget outer(th.session()); outer.setFrameValues(2, 3, 10, 28); outer.createPanel();
        on_exit outer.destroyPanel();
        NcursesUi::PanelWidget inner(th.session()); inner.setFrameValues(4, 6, 5, 15); outer.addChild(inner);
        inner.createPanel(); on_exit inner.destroyPanel();
        outer.resize(NcursesUi::Geometry::makeRect(2, 3, 4, 10)); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 1, "cols": 6}, inner.getWindow().size());
        assertEq(NcursesUi::Geometry::makeRect(4, 6, 5, 15), inner.getFrame());
        outer.resize(NcursesUi::Geometry::makeRect(2, 3, 10, 28)); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 5, "cols": 15}, inner.getWindow().size());
        outer.resize(NcursesUi::Geometry::makeRect(2, 3, 2, 3)); outer.drawTree(th.screen());
        assertNothing(inner.getWindow());
        outer.resize(NcursesUi::Geometry::makeRect(2, 3, 10, 28)); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 5, "cols": 15}, inner.getWindow().size());
        inner.setFrameValues(4, 6, 0, 0); outer.drawTree(th.screen()); assertNothing(inner.getWindow());
        inner.setFrameValues(4, 6, 5, 15); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 5, "cols": 15}, inner.getWindow().size());
        outer.setFrameValues(2, 3, 4, 10); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 1, "cols": 6}, inner.getWindow().size());
        outer.setFrameValues(2, 3, 10, 28); outer.drawTree(th.screen());
        assertEq(<Ncurses::Size>{"rows": 5, "cols": 15}, inner.getWindow().size());
        inner.destroyPanel(); outer.drawTree(th.screen()); assertNothing(inner.getWindow());
    }
    reviewClipping() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::Widget parent(); parent.setFrameValues(1, 3, 8, 12);
        parent.setPadding(NcursesUi::Geometry::makeInsets(1, 1, 1, 1));
        NcursesUi::TextInputWidget input(); input.setFrameValues(2, 2, 1, 10); parent.addChild(input);
        assertFalse(input.hitTest(2, 3)); assertTrue(input.hitTest(2, 4));
        NcursesUi::ListWidget list(); list.setItems(({"label": "abcdefghij"},));
        list.setFrameValues(3, 2, 1, 10); parent.addChild(list);
        NcursesUi::CheckboxWidget box("abcdef"); box.setFrameValues(4, 2, 1, 10); parent.addChild(box);
        NcursesUi::StatusBarWidget status(); status.setSegments(({"text": "abcdefghij"},));
        status.setFrameValues(5, 2, 1, 10); parent.addChild(status);
        NcursesUi::MenuBarWidget menu(); menu.addMenu("abc", ());
        menu.setFrameValues(6, 2, 1, 10); parent.addChild(menu);
        parent.drawTree(th.screen());
        assertEq("cdefghij", th.screen().readText(3, 4, 8));
        assertEq("] abcdef", th.screen().readText(4, 4, 8));
        assertEq("cdefghij", th.screen().readText(5, 4, 8));
        assertEq("bc ", th.screen().readText(6, 4, 3));
        NcursesUi::EventDispatcher dispatcher(); dispatcher.setRootScope(parent);
        dispatcher.dispatch(parent, click(4, 3)); assertFalse(box.isChecked());
        dispatcher.dispatch(parent, click(4, 4)); assertTrue(box.isChecked());
    }
    reviewComboPage() {
        list<string> options = (); for (int i = 0; i < 30; ++i) { options += string(i); }
        NcursesUi::ComboBoxWidget combo(options); combo.setFrameValues(0, 0, 20, 20);
        combo.processEvent(key("KEY_DOWN")); combo.processEvent(key("KEY_NPAGE"));
        assertEq(8, combo.getHighlightIndex());
        combo.processEvent(key("KEY_PPAGE")); assertEq(0, combo.getHighlightIndex());
    }
    panel() {
        NcursesUi::TestHarness th(16, 40); on_exit th.close();
        NcursesUi::PanelWidget panel(th.session()); panel.setFrameValues(3, 5, 7, 20); panel.createPanel();
        on_exit panel.destroyPanel();
        NcursesUi::TextInputWidget input(); input.setFrameValues(4, 6, 1, 8); input.setText("child");
        panel.addChild(input); input.setFocused(True); panel.drawTree(th.screen());
        th.session().doupdate();
        assertEq(<Ncurses::Position>{"y": 1, "x": 6}, panel.getWindow().cursor());
        assertEq("child", panel.getWindow().readText(1, 1, 5));
        assertEq(NcursesUi::Geometry::makeRect(4, 6, 1, 8), input.getFrame());
        input.processEvent(click(4, 8)); input.processEvent(ch("X"));
        assertEq("chXild", input.getText());
        NcursesUi::ComboBoxWidget combo(("one", "two", "three"));
        combo.setFrameValues(5, 6, 3, 10); panel.addChild(combo);
        combo.processEvent(key("KEY_DOWN")); combo.processEvent(key("KEY_END"));
        panel.drawTree(th.screen()); assertEq("three", panel.getWindow().readText(4, 1, 5));
        combo.processEvent(click(7, 6)); assertEq("three", combo.getText());
    }
    nested() {
        NcursesUi::TestHarness th(16, 40); on_exit th.close();
        NcursesUi::PanelWidget outer(th.session()); outer.setFrameValues(2, 3, 10, 28); outer.createPanel();
        on_exit outer.destroyPanel();
        NcursesUi::PanelWidget inner(th.session()); inner.setFrameValues(4, 6, 5, 15); outer.addChild(inner);
        inner.createPanel(); on_exit inner.destroyPanel();
        NcursesUi::TextInputWidget input(); input.setFrameValues(5, 7, 1, 20); input.setText("0123456789abcdefghij");
        inner.addChild(input); outer.drawTree(th.screen());
        assertEq("89abcdefghij ", inner.getWindow().readText(1, 1, 13));
        assertEq(20, input.getFrame().cols);
        input.processEvent(click(5, 8)); input.processEvent(ch("X"));
        assertEq("012345678X9abcdefghij", input.getText());
        inner.setVisible(False); outer.drawTree(th.screen());
        inner.setVisible(True); outer.drawTree(th.screen());
        assertTrue(inner.getWindow().readText(1, 1, 13).find("X") >= 0);
    }
    clipping() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::Widget parent(); parent.setFrameValues(2, 3, 4, 8);
        parent.setPadding(NcursesUi::Geometry::makeInsets(1, 1, 1, 1));
        NcursesUi::TextInputWidget input(); input.setFrameValues(3, 2, 1, 10); input.setText("abcdef");
        parent.addChild(input); th.screen().drawText(3, 0, strmul(".", 30));
        parent.drawTree(th.screen());
        assertEq("....cdef  ....................", th.screen().readText(3, 0, 30));
        assertEq(NcursesUi::Geometry::makeRect(3, 2, 1, 10), input.getFrame());
        input.setFocused(True); parent.drawTree(th.screen());
        parent.setFrameValues(2, 3, 0, 0); parent.drawTree(th.screen());
        th.screen().moveCursor(0, 0); th.session().doupdate();
        assertEq(<Ncurses::Position>{"y": 0, "x": 0}, th.screen().cursor());
        parent.setFrameValues(0, 0, -1, -2); assertEq(0, parent.getFrame().rows); assertEq(0, parent.getFrame().cols);
        hash<NcursesUi::Rect> inset = NcursesUi::Geometry::rectInset(NcursesUi::Geometry::makeRect(0, 0, 1, 1),
            NcursesUi::Geometry::makeInsets(9, 9, 9, 9));
        bounded(inset, 1, 1);
    }
    private Ncurses::Window derived(Ncurses::Session session) {
        Ncurses::Window parent(session, 6, 12, 1, 1);
        Ncurses::Window child = parent.subWindow(4, 10, 1, 1);
        return child.subWindow(2, 8, 1, 1);
    }
    lifetime() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        for (int i = 0; i < 20; ++i) {
            Ncurses::Window child = derived(th.session());
            child.drawText(0, 0, "retained");
            assertEq("retained", child.readText(0, 0, 8));
            assertEq(<Ncurses::Position>{"y": 3, "x": 3}, child.position());
            assertThrows("NCURSES-ERROR", sub () { child.subWindow(3, 20, 0, 0); });
        }
    }
    panelFailure() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        FailingPanel p(th.session()); p.setFrameValues(2, 3, 5, 12); p.createPanel(); on_exit p.destroyPanel();
        Ncurses::Window original = p.getWindow(); original.drawText(1, 1, "saved");
        p.fail = True;
        assertThrows("PANEL-TEST", sub () { p.resize(NcursesUi::Geometry::makeRect(1, 1, 6, 20)); });
        assertEq(original, p.getWindow()); assertEq(NcursesUi::Geometry::makeRect(2, 3, 5, 12), p.getFrame());
        assertEq("saved", p.getWindow().readText(1, 1, 5));
        p.fail = False; p.resize(NcursesUi::Geometry::makeRect(1, 1, 6, 20));
        assertEq(<Ncurses::Size>{"rows": 6, "cols": 20}, p.getWindow().size());
        p.resize(NcursesUi::Geometry::makeRect(0, 0, 0, 0)); assertNothing(p.getWindow());
    }
    box() {
        foreach int orientation in ((NcursesUi::Orientation::Vertical, NcursesUi::Orientation::Horizontal)) {
            foreach int size in ((0, 1, 2, 4, 9)) {
                NcursesUi::Widget parent(); parent.setFrameValues(0, 0, size, size);
                NcursesUi::Widget a(); NcursesUi::Widget b();
                foreach NcursesUi::Widget child in ((a, b)) {
                    child.setVSizePolicy(NcursesUi::SizePolicy::Fixed); child.setHSizePolicy(NcursesUi::SizePolicy::Minimum);
                    child.setPreferredSize(4, 4); child.setMinimumSize(3, 3); parent.addChild(child);
                }
                NcursesUi::BoxLayout layout(orientation, 2); layout.apply(parent);
                bounded(a.getFrame(), size, size); bounded(b.getFrame(), size, size);
                NcursesUi::SplitLayout split(orientation); split.setFixedSize(20, 1); split.apply(parent);
                bounded(a.getFrame(), size, size); bounded(b.getFrame(), size, size);
            }
        }
    }
    clippedChoices() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::Widget root(); root.setFrameValues(2, 3, 2, 10);
        NcursesUi::RadioGroupWidget radio(("one", "two", "three", "four"));
        radio.setFrameValues(1, 3, 8, 10); root.addChild(radio);
        radio.processEvent(key("KEY_END")); root.drawTree(th.screen());
        assertEq("( ) four", th.screen().readText(3, 3, 8));
        radio.processEvent(click(2, 3)); assertEq(2, radio.getSelectedIndex());
        root.removeChild(radio);
        NcursesUi::TableWidget table(); table.setColumns(({"key": "v"},));
        table.setRows(({"v": "one"}, {"v": "two"}, {"v": "three"}));
        table.setFrameValues(1, 3, 8, 20); root.addChild(table);
        table.processEvent(key("KEY_END")); root.drawTree(th.screen());
        assertEq("three", th.screen().readText(3, 3, 5));
        table.processEvent(click(3, 3)); assertEq(2, table.getSelectedRow());
        NcursesUi::Widget a(); NcursesUi::Widget b(); NcursesUi::Widget container();
        container.setFrameValues(0, 0, 10, 20); a.setMinimumSize(8, 0);
        container.addChild(a); container.addChild(b); NcursesUi::BoxLayout layout(); layout.apply(container);
        assertEq(9, a.getFrame().rows); assertEq(1, b.getFrame().rows);
    }
    dialog() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close();
        foreach int rows in ((1, 2, 3, 6, 12)) {
            foreach int cols in ((1, 2, 8, 20, 40)) {
                NcursesUi::DialogWidget d(th.session(), "A long title", "first\nsecond\nthird\nfourth", ("OK", "Cancel", "Details"));
                d.centerOn(rows, cols); bounded(d.getFrame(), rows, cols); d.createPanel(); on_exit d.destroyPanel();
                for (int i = 0; i < 3; ++i) {
                    d.drawTree(th.screen());
                    assertEq(i, d.getFocusedButton());
                    assertTrue(d.getButtonRects()[i].cols > 0);
                    assertEq(i, d.processEvent(key("KEY_ENTER")).data.index);
                    d.processEvent(ch("\t"));
                }
            }
        }
        NcursesUi::DialogWidget tiny(th.session(), "Tiny", "abc", ("Yes", "No"));
        tiny.centerOn(1, 1); tiny.createPanel(); on_exit tiny.destroyPanel(); tiny.drawTree(th.screen());
        assertEq("Y", tiny.getWindow().readText(0, 0, 1));
        tiny.processEvent(key("KEY_DOWN")); tiny.drawTree(th.screen());
        assertEq("a", tiny.getWindow().readText(0, 0, 1));
        tiny.processEvent(key("KEY_DOWN")); tiny.drawTree(th.screen());
        assertEq("b", tiny.getWindow().readText(0, 0, 1));
        tiny.processEvent(ch("\t")); tiny.drawTree(th.screen());
        assertEq("N", tiny.getWindow().readText(0, 0, 1));
        NcursesUi::DialogWidget d(th.session(), "Scroll", "first\nsecond\nthird\nfourth");
        d.centerOn(5, 20); d.createPanel(); on_exit d.destroyPanel();
        d.processEvent(key("KEY_NPAGE")); d.drawTree(th.screen());
        assertTrue(d.getWindow().readText(1, 0, 20).find("second") >= 0);
        d.setOnButton(sub (int i, string label) { d.setButtons(()); });
        assertEq("OK", d.processEvent(ch("\r")).data.label);
        assertEq(0, d.getButtons().size());
    }
    resize() {
        NcursesUi::TestHarness th(24, 80); on_exit th.close();
        NcursesUi::Application app(th.session()); NcursesUi::Widget root(); app.setRoot(root);
        NcursesUi::DialogWidget d(th.session(), "Resize", "Message", ("One", "Two", "Three"));
        d.centerOn(24, 80); d.createPanel(); on_exit d.destroyPanel(); app.pushModal(d);
        app.processEvent(ch("\t")); assertEq(1, d.getFocusedButton());
        foreach hash<Ncurses::Size> size in ((<Ncurses::Size>{"rows": 3, "cols": 8}, <Ncurses::Size>{"rows": 24, "cols": 80})) {
            th.screen().resize(size.rows, size.cols);
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
            app.drawAll(); bounded(d.getFrame(), size.rows, size.cols);
            assertEq(1, d.getFocusedButton()); assertEq(d, app.getFocusManager().getCurrentFocus());
            assertTrue(d.getButtonRects()[1].cols > 0);
        }
        app.popModal();
        NcursesUi::PanelWidget panel(th.session()); panel.setFrameValues(8, 20, 6, 20); panel.createPanel();
        on_exit panel.destroyPanel();
        NcursesUi::TextInputWidget input(); input.setFrameValues(9, 21, 1, 12); input.setText("content");
        panel.addChild(input); app.pushModal(panel);
        foreach hash<Ncurses::Size> size in ((<Ncurses::Size>{"rows": 4, "cols": 10}, <Ncurses::Size>{"rows": 24, "cols": 80})) {
            th.screen().resize(size.rows, size.cols);
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize}); app.drawAll();
            bounded(panel.getFrame(), size.rows, size.cols);
            assertEq(panel.getFrame().y + 1, input.getFrame().y);
            assertEq(panel.getFrame().x + 1, input.getFrame().x);
            assertEq(input, app.getFocusManager().getCurrentFocus());
            assertEq("content", input.getText());
        }
        app.popModal();
    }
    private list<hash<auto>> menuItems() {
        return ({"label": "one"}, {"label": "disabled", "enabled": False}, {"separator": True},
            {"label": "four"}, {"label": "five"}, {"label": "six"});
    }
    menu() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::DropdownMenuWidget m(th.session(), menuItems());
        m.positionAt(99, 99, 5, 12); bounded(m.getFrame(), 5, 12); m.createPanel(); on_exit m.destroyPanel();
        m.processEvent(key("KEY_END")); assertEq(5, m.getHighlightIndex()); m.drawTree(th.screen());
        assertTrue(m.getWindow().readText(1, 0, 10).find("six") >= 0);
        m.processEvent(key("KEY_HOME")); assertEq(0, m.getHighlightIndex());
        m.processEvent(key("KEY_DOWN")); assertEq(3, m.getHighlightIndex());
        m.processEvent(key("KEY_UP")); assertEq(0, m.getHighlightIndex());
        m.processEvent(key("KEY_END"));
        string selected; m.setOnSelect(sub (hash<auto> item) { selected = item.label; });
        hash<NcursesUi::Rect> cr = m.contentRect();
        m.processEvent(click(cr.y, cr.x)); assertEq("six", selected);
        m.processEvent(click(cr.y, cr.x, Ncurses::BUTTON4_PRESSED)); assertEq(4, m.getHighlightIndex());
        m.positionAt(-2, -3, 1, 2); bounded(m.getFrame(), 1, 2); m.drawTree(th.screen());
        assertEq("fi", m.getWindow().readText(0, 0, 2));
    }
    disabledMenu() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::DropdownMenuWidget m(th.session(), ()); assertEq(-1, m.getHighlightIndex());
        foreach list<hash<auto>> items in (({"label": "no", "enabled": False},), ({"separator": True},), ()) {
            m.setMenuItems(items);
            foreach string name in (("KEY_UP", "KEY_DOWN", "KEY_HOME", "KEY_END", "KEY_PPAGE", "KEY_NPAGE")) {
                assertTrue(m.processEvent(key(name)).handled); assertEq(-1, m.getHighlightIndex());
            }
        }
        m.setMenuItems(menuItems()); assertEq(0, m.getHighlightIndex());
    }
    radio() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::RadioGroupWidget r(("one", "two", "three", "four", "five"));
        r.setFrameValues(2, 3, 2, 12); r.setFocused(True);
        r.processEvent(key("KEY_END")); r.draw(th.screen());
        assertEq("( ) five", th.screen().readText(3, 3, 8));
        r.processEvent(click(2, 3)); assertEq(3, r.getSelectedIndex());
        r.processEvent(key("KEY_HOME")); assertEq(0, r.getHighlightIndex());
        r.processEvent(key("KEY_NPAGE")); assertEq(2, r.getHighlightIndex());
        r.processEvent(click(2, 3, Ncurses::BUTTON5_PRESSED)); assertEq(3, r.getHighlightIndex());
        r.setFrameValues(2, 3, 1, 12); r.draw(th.screen()); assertEq("(o) four", th.screen().readText(2, 3, 8));
        r.setOptions(()); r.draw(th.screen()); assertEq(strmul(" ", 12), th.screen().readText(2, 3, 12));
        assertEq(-1, r.getSelectedIndex()); assertFalse(r.processEvent(key("KEY_END")).handled);
        r.setOptions(("new",)); assertEq(0, r.getSelectedIndex());
        assertFalse(r.processEvent(click(2, 2)).handled);
    }
    combo() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::ComboBoxWidget c(("one", "two", "three", "four", "five")); c.setFrameValues(2, 3, 3, 12);
        c.processEvent(key("KEY_DOWN")); c.processEvent(key("KEY_END")); c.draw(th.screen());
        assertEq("five", th.screen().readText(4, 3, 4));
        c.processEvent(key("KEY_PPAGE")); assertEq(2, c.getHighlightIndex());
        c.processEvent(click(3, 3, Ncurses::BUTTON5_PRESSED)); assertEq(3, c.getHighlightIndex());
        c.draw(th.screen()); c.processEvent(click(4, 3)); assertEq("four", c.getText());
        c.draw(th.screen()); assertEq(strmul(" ", 12), th.screen().readText(4, 3, 12));
    }
    completion() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::CompletionPopupWidget c(th.session(), menuItems()); c.positionAt(4, 20, 5, 12);
        bounded(c.getFrame(), 5, 12); c.createPanel(); on_exit c.destroyPanel();
        for (int i = 0; i < 5; ++i) { c.processEvent(key("KEY_DOWN")); }
        c.drawTree(th.screen()); assertTrue(c.getWindow().readText(1, 0, 10).find("six") >= 0);
    }
    callbacks() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::RadioGroupWidget r(("one", "two"));
        r.setOnSelect(sub (int i) { throw "CHOICE-TEST", "fail"; }); r.processEvent(key("KEY_END"));
        assertThrows("CHOICE-TEST", sub () { r.processEvent(ch("\r")); }); assertEq(1, r.getSelectedIndex());
        r.setOnSelect(NOTHING); r.processEvent(key("KEY_HOME")); r.processEvent(key("KEY_ENTER")); assertEq(0, r.getSelectedIndex());
        NcursesUi::ComboBoxWidget c(("one", "two")); c.setOnSelect(sub (string value) { throw "CHOICE-TEST", "fail"; });
        c.processEvent(key("KEY_DOWN")); c.processEvent(key("KEY_END"));
        assertThrows("CHOICE-TEST", sub () { c.processEvent(key("KEY_ENTER")); }); assertEq("two", c.getText());
    }
}
