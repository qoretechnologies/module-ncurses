    /** Test F2 mouse toggle pattern. */
    testReplMouseToggle() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;

        bool mouse_enabled = True;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Key && ev.name == "KEY_F(2)") {
                mouse_enabled = !mouse_enabled;
                return <NcursesUi::EventResult>{"handled": True};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_F(2)";
        app.processEvent(ev);
        assertFalse(mouse_enabled);

        app.processEvent(ev);
        assertTrue(mouse_enabled);
    }

    /** Test tick callback pattern for periodic updates. */
    testReplTickCallback() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;

        int tick_count = 0;
        app.addTickCallback(sub () {
            ++tick_count;
            # quit after first tick to exit the run loop
            app.quit();
        });

        # inject an event so readEvent returns immediately, then ticks fire
        th.injectChar("a");
        app.run();

        # tick should have been called at least once from the run loop
        assertTrue(tick_count > 0, "tick callback should have been called at least once");
    }

