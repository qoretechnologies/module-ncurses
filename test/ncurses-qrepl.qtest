    /** Test QoreRepl prompt changes. */
    testReplPromptUpdate() {
        QoreRepl::QoreRepl repl();

        string prompt1 = repl.getPrompt();
        assertTrue(prompt1.size() > 0);

        # after eval, prompt should still be valid
        repl.eval("1");
        string prompt2 = repl.getPrompt();
        assertTrue(prompt2.size() > 0);
    }

    /** Test QoreRepl eval returns NOTHING for continuation input. */
    testReplEvalContinuation() {
        QoreRepl::QoreRepl repl();

        # incomplete statement should return NOTHING (continuation)
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "continuation input should return NOTHING");

        # prompt should change to indicate continuation
        string continuation_prompt = repl.getPrompt();
        assertTrue(continuation_prompt.size() > 0);

        # complete the statement
        *hash<auto> result2 = repl.eval("}");
        # this should complete - result exists now
        assertTrue(exists result2, "completing continuation should return a result");
    }

    /** Test exec_line pattern handles NOTHING from eval correctly.

        Simulates the exec_line() function's handling of *hash<auto> result
        to verify the RUNTIME-TYPE-ERROR fix.
    */
    testReplExecLineHandlesNothingResult() {
        QoreRepl::QoreRepl repl();

        # test the exact pattern from exec_line()
        *hash<auto> result;
        try {
            result = repl.eval("if (True) {");
        } catch (hash<ExceptionInfo> ex) {
            fail("eval should not throw for continuation: " + ex.err);
        }

        # result should be NOTHING for continuation
        assertFalse(exists result, "continuation should yield NOTHING");

        # verify we can handle the NOTHING case without errors
        if (!exists result) {
            string prompt = repl.getPrompt();
            assertTrue(prompt.size() > 0, "prompt should be available after continuation");
        }

        # complete and verify normal result
        *hash<auto> result2 = repl.eval("}");
        assertTrue(exists result2, "completed continuation should yield a result");
    }
%endif

