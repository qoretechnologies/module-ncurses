    /** Test empty input creates new prompt line. */
    testReplEmptyInput() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::LineListContent content = repl.output_content;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # add initial prompt
        content.appendLine("qore> ");
        int initial_lines = content.lineCount();

        bool enter_handled = False;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ev.ch == "\n") {
                enter_handled = True;
                # empty submit: start new prompt line
                if (buffer.getText() == "") {
                    content.appendLine("qore> ");
                }
                return <NcursesUi::EventResult>{"handled": True};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # press Enter with empty buffer
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);

        assertTrue(enter_handled);
        assertEq(initial_lines + 1, content.lineCount());
    }

    /** Test Ctrl key bindings via global handler with InputBuffer. */
    testReplInlineCtrlKeys() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # set up inline input handler
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char) {
                string ch = ev.ch ?? "";
                if (ord(ch) == 0x01) {
                    buffer.moveHome();
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (ord(ch) == 0x05) {
                    buffer.moveEnd();
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (ord(ch) == 0x15) {
                    buffer.killToStart();
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (ord(ch) >= 32) {
                    buffer.insertChar(ch);
                    return <NcursesUi::EventResult>{"handled": True};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # type "hello world"
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        foreach string ch in ("h", "e", "l", "l", "o", " ", "w", "o", "r", "l", "d") {
            ev.ch = ch;
            app.processEvent(ev);
        }
        assertEq("hello world", buffer.getText());

        # Ctrl+A (go to beginning)
        ev.ch = chr(0x01);
        app.processEvent(ev);
        assertEq(0, buffer.getCursor());

        # Ctrl+E (go to end)
        ev.ch = chr(0x05);
        app.processEvent(ev);
        assertEq(11, buffer.getCursor());

        # Ctrl+U (kill to start)
        ev.ch = chr(0x15);
        app.processEvent(ev);
        assertEq("", buffer.getText());
    }

    /** Test layout adjusts after simulated resize. */
    testReplLayoutWithResize() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::Widget root = repl.root;
        NcursesUi::ScrollableWidget ow = repl.output_widget;

        # initial output widget height (22 = 24 - menu_bar - status_bar)
        int initial_output_rows = ow.getFrame().rows;
        assertEq(22, initial_output_rows);

        # simulate resize event
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Resize;
        app.processEvent(ev);

        # root should still fill screen (terminal size hasn't actually changed)
        assertEq(term_rows, root.getFrame().rows);
        assertEq(term_cols, root.getFrame().cols);
    }

