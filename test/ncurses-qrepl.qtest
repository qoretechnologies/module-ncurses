    /** Test inline prompt line is updated when typing. */
    testInlinePromptLineUpdate() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::LineListContent content = repl.output_content;
        NcursesUi::ScrollableWidget ow = repl.output_widget;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # add initial prompt line (simulating new_prompt_line())
        string prompt = "qore> ";
        content.appendLine(prompt);
        int prompt_idx = content.lineCount() - 1;

        # simulate typing by updating buffer and setLine
        buffer.insertChar("x");
        content.setLine(prompt_idx, prompt + buffer.getText());
        assertEq("qore> x", content.getLines()[prompt_idx]);

        buffer.insertChar("y");
        content.setLine(prompt_idx, prompt + buffer.getText());
        assertEq("qore> xy", content.getLines()[prompt_idx]);

        # set cursor position
        int cursor_col = prompt.length() + buffer.getCursor();
        ow.setCursorLine(prompt_idx, cursor_col);
        *hash<auto> cp = ow.getCursorPos();
        assertTrue(exists cp);
        assertEq(prompt_idx, cp.line);
        assertEq(8, cp.col);  # "qore> " (6) + cursor at end of "xy" (2)
    }

    /** Test inserting output before the live prompt line. */
    testInlinePromptInsertBeforePrompt() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::LineListContent content = repl.output_content;

        # simulate: welcome message + prompt
        content.appendLine("Welcome");
        content.appendLine("qore> ");
        int prompt_idx = 1;

        # insert output before the prompt (like captured stdout)
        content.insertLine(prompt_idx, "captured output");
        prompt_idx += 1;  # prompt shifted down

        list<string> lines = content.getLines();
        assertEq(3, content.lineCount());
        assertEq("Welcome", lines[0]);
        assertEq("captured output", lines[1]);
        assertEq("qore> ", lines[2]);
        assertEq(2, prompt_idx);
    }

    /** Test cursor positioning on the inline prompt line. */
    testInlineCursorPositioning() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::ScrollableWidget ow = repl.output_widget;
        NcursesUi::LineListContent content = repl.output_content;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # add prompt
        content.appendLine("qore> ");
        int prompt_idx = 0;

        # type some text
        buffer.insertChar("h");
        buffer.insertChar("i");

        # cursor at end (position 2)
        int cursor_col = 6 + buffer.getCursor();  # "qore> " = 6 chars
        ow.setCursorLine(prompt_idx, cursor_col);

        *hash<auto> cp = ow.getCursorPos();
        assertEq(0, cp.line);
        assertEq(8, cp.col);  # 6 + 2

        # move cursor left
        buffer.moveLeft();
        cursor_col = 6 + buffer.getCursor();
        ow.setCursorLine(prompt_idx, cursor_col);

        cp = ow.getCursorPos();
        assertEq(7, cp.col);  # 6 + 1

        # move to home
        buffer.moveHome();
        cursor_col = 6 + buffer.getCursor();
        ow.setCursorLine(prompt_idx, cursor_col);

        cp = ow.getCursorPos();
        assertEq(6, cp.col);  # 6 + 0

        # draw should not crash
        content.setLine(prompt_idx, "qore> " + buffer.getText());
        ow.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        ow.draw(th.session().screen());
        th.session().doupdate();
    }

    /** Test that events reach modal when global key handler is active.

        When a modal is open, the global key handler should return
        handled=False so events are routed to the modal widget.
    */
    testReplModalPassthrough() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # set up global handler that passes through when modal is open (like qrepl)
        bool global_handled_enter = False;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            # modal pass-through: if a modal is open, don't intercept
            if (app.getDispatcher().hasModal()) {
                return <NcursesUi::EventResult>{"handled": False};
            }
            if (ev.type == Ncurses::InputType::Char && ev.ch == "\n") {
                global_handled_enter = True;
                return <NcursesUi::EventResult>{"handled": True};
            }
            if (ev.type == Ncurses::InputType::Key) {
                string name = ev.name ?? "";
                if (name == "KEY_UP" || name == "KEY_DOWN") {
                    return <NcursesUi::EventResult>{"handled": True};
                }
            }
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") >= 32) {
                buffer.insertChar(ev.ch);
                return <NcursesUi::EventResult>{"handled": True};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # push a dialog as modal
        NcursesUi::DialogWidget dlg(th.session(), "Test", "msg", ("OK", "Cancel"));
        dlg.centerOn(term_rows, term_cols);
        int button_pressed = -1;
        dlg.setOnButton(sub (int idx, string label) {
            button_pressed = idx;
            app.popModal();
        });
        bool dismissed = False;
        dlg.setOnDismiss(sub () {
            dismissed = True;
            app.popModal();
        });
        app.pushModal(dlg);
        assertTrue(app.getDispatcher().hasModal());

        # Enter should reach the modal dialog (not be consumed by global handler)
        global_handled_enter = False;
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);

        assertFalse(global_handled_enter, "global handler should NOT have consumed Enter");
        assertEq(0, button_pressed, "modal dialog should have received Enter (button 0 = OK)");
        assertFalse(app.getDispatcher().hasModal(), "modal should be popped after button press");
    }

    /** Test that Alt+key opens the matching menu via the global key handler. */
    testReplAltKeyOpensMenu() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;

        # add menus like qrepl
        menu_bar.setApplication(app);
        menu_bar.addMenu("File", (
            {"label": "Browse...", "command": "browse", "hotkey": "Alt+B"},
        ));
        menu_bar.addMenu("Edit", (
            {"label": "Clear", "command": "clear"},
        ));
        menu_bar.addMenu("Help", (
            {"label": "Help", "command": "/help", "hotkey": "Alt+H"},
        ));

        # set up global handler with Alt routing (like qrepl)
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (app.getDispatcher().hasModal()) {
                return <NcursesUi::EventResult>{"handled": False};
            }
            if (ev.type == Ncurses::InputType::Alt) {
                string ch = ev.ch ?? "";
                if (ch != "" && menu_bar.processAltKey(ch)) {
                    return <NcursesUi::EventResult>{"handled": True, "action": "open_menu"};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # send Alt+F event
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Alt;
        ev.ch = "f";
        app.processEvent(ev);

        assertEq(0, menu_bar.getActiveMenu());
        assertTrue(menu_bar.isDropdownOpen());
        menu_bar.closeMenu();

        # send Alt+H event
        ev.ch = "h";
        app.processEvent(ev);
        assertEq(2, menu_bar.getActiveMenu());
        assertTrue(menu_bar.isDropdownOpen());
        menu_bar.closeMenu();

        # send Alt+Z (no match) - menu should not open
        ev.ch = "z";
        app.processEvent(ev);
        assertEq(-1, menu_bar.getActiveMenu());
        assertFalse(menu_bar.isDropdownOpen());
    }

    /** Helper: simulates qrepl's output capture pipeline in-process.

        Uses a Mutex, capture_tail, pending_output, and eval_complete flag
        to exercise the same logic as qrepl's enqueue_output_chunk +
        output_capture_thread timeout path.
    */
    private hash<auto> makeCaptureState() {
        return {
            "mutex": new Mutex(),
            "capture_tail": "",
            "pending_output": new list<string>(),
            "eval_complete": False,
        };
    }

    /** Mirror of qrepl's enqueue_output_chunk: splits chunk into
        complete lines (pending_output) and an incomplete tail (capture_tail).
        Also flushes immediately if eval_complete is already set.
    */
    private nothing enqueue_chunk(reference<hash<auto>> state, string chunk) {
        state.mutex.lock();
        on_exit state.mutex.unlock();

        string full = string(state.capture_tail) + chunk;
        list<string> lines = full.split("\n");

        if (full.size() > 0 && full.substr(-1) == "\n") {
            foreach string line in (lines) {
                if (line != "") {
                    state.pending_output += line;
                }
            }
            state.capture_tail = "";
        } else {
            for (int i = 0; i < lines.size() - 1; ++i) {
                if (lines[i] != "") {
                    state.pending_output += lines[i];
                }
            }
            state.capture_tail = lines[lines.size() - 1];
        }

        # if eval already completed and we have unterminated data, flush immediately
        if (state.eval_complete && string(state.capture_tail) != "") {
            state.pending_output += string(state.capture_tail)
                + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
            state.capture_tail = "";
            state.eval_complete = False;
        }
    }

    /** Mirror of qrepl's capture thread timeout path: checks eval_complete
        and flushes capture_tail with the reverse-video % indicator.
        Only clears eval_complete when there is actual data to flush.
    */
    private nothing flush_if_eval_complete(reference<hash<auto>> state) {
        state.mutex.lock();
        on_exit state.mutex.unlock();

        if (state.eval_complete && string(state.capture_tail) != "") {
            state.pending_output += string(state.capture_tail)
                + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
            state.capture_tail = "";
            state.eval_complete = False;
        }
        # NOTE: don't clear eval_complete when capture_tail is empty;
        # pipe data may not have arrived yet
    }

    /** Mirror of qrepl's clear_eval_complete: clears flag before starting eval. */
    private nothing clear_eval(reference<hash<auto>> state) {
        state.mutex.lock();
        on_exit state.mutex.unlock();
        state.eval_complete = False;
    }

    /** Mirror of qrepl's signal_eval_complete. */
    private nothing signal_eval(reference<hash<auto>> state) {
        state.mutex.lock();
        on_exit state.mutex.unlock();
        state.eval_complete = True;
    }

    /** Test: newline-terminated output goes to pending_output without indicator. */
    testCaptureNewlineTerminated() {
        hash<auto> st = makeCaptureState();

        # simulate: printf("hello\n") → pipe sends "hello\n"
        enqueue_chunk(\st, "hello\n");
        assertEq(("hello",), st.pending_output);
        assertEq("", st.capture_tail);

        # signal eval complete and flush — no tail, so no indicator
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertEq(("hello",), st.pending_output, "no indicator for newline-terminated output");
        assertTrue(st.eval_complete, "eval_complete stays set when no tail to flush");
    }

    /** Test: unterminated output gets reverse-video % indicator after eval. */
    testCaptureNoNewlineIndicator() {
        hash<auto> st = makeCaptureState();

        # simulate: print("hi") → pipe sends "hi" (no newline)
        enqueue_chunk(\st, "hi");
        assertEq(0, st.pending_output.size(), "no complete lines yet");
        assertEq("hi", st.capture_tail);

        # signal eval complete
        signal_eval(\st);
        assertTrue(st.eval_complete);

        # capture thread timeout flushes with indicator
        flush_if_eval_complete(\st);
        assertEq(1, st.pending_output.size());
        string result = st.pending_output[0];
        assertTrue(result.find("hi") == 0, "should start with 'hi'");
        assertTrue(result.find("%") > 0, "should contain % indicator");
        # verify ANSI reverse-video SGR codes
        assertTrue(result.find(chr(0x1b) + "[7m%") >= 0, "should have reverse-video % indicator");
        assertTrue(result.find(chr(0x1b) + "[0m") >= 0, "should have SGR reset");
        assertEq("", st.capture_tail, "capture_tail should be cleared");
        assertFalse(st.eval_complete, "eval_complete should be cleared");
    }

    /** Test: mixed output with complete lines and an unterminated tail. */
    testCaptureMixedOutput() {
        hash<auto> st = makeCaptureState();

        # simulate: printf("line1\nline2\npartial") → pipe sends all at once
        enqueue_chunk(\st, "line1\nline2\npartial");
        assertEq(("line1", "line2"), st.pending_output);
        assertEq("partial", st.capture_tail);

        # signal eval complete and flush
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertEq(3, st.pending_output.size());
        assertEq("line1", st.pending_output[0]);
        assertEq("line2", st.pending_output[1]);
        assertTrue(st.pending_output[2].find("partial") == 0);
        assertTrue(st.pending_output[2].find(chr(0x1b) + "[7m%") >= 0,
            "partial tail should get % indicator");
    }

    /** Test: multiple chunks assembling into complete lines. */
    testCaptureMultipleChunks() {
        hash<auto> st = makeCaptureState();

        # first chunk: incomplete
        enqueue_chunk(\st, "hel");
        assertEq(0, st.pending_output.size());
        assertEq("hel", st.capture_tail);

        # second chunk completes the line
        enqueue_chunk(\st, "lo\n");
        assertEq(("hello",), st.pending_output);
        assertEq("", st.capture_tail);

        # third chunk: another incomplete
        enqueue_chunk(\st, "world");
        assertEq(("hello",), st.pending_output);
        assertEq("world", st.capture_tail);

        # eval complete → flush
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertEq(2, st.pending_output.size());
        assertEq("hello", st.pending_output[0]);
        assertTrue(st.pending_output[1].find("world") == 0);
        assertTrue(st.pending_output[1].find(chr(0x1b) + "[7m%") >= 0);
    }

    /** Test: eval_complete with empty tail does NOT produce indicator. */
    testCaptureEvalCompleteNoTail() {
        hash<auto> st = makeCaptureState();

        # output with newline — capture_tail stays empty
        enqueue_chunk(\st, "done\n");
        assertEq(("done",), st.pending_output);
        assertEq("", st.capture_tail);

        # signal eval and flush — no tail, so eval_complete stays set
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertEq(("done",), st.pending_output, "no extra output for empty tail");
        assertTrue(st.eval_complete, "eval_complete stays set when no tail to flush");
    }

    /** Test: race condition — eval_complete set before pipe data arrives.
        Simulates: timeout fires with eval_complete=True but capture_tail="",
        then data arrives later. The data should still be flushed.
    */
    testCaptureRaceEvalBeforeData() {
        hash<auto> st = makeCaptureState();

        # eval completes, signal sent
        signal_eval(\st);
        assertTrue(st.eval_complete);

        # timeout fires — no data yet, eval_complete should NOT be cleared
        flush_if_eval_complete(\st);
        assertTrue(st.eval_complete, "eval_complete must stay set when no data yet");
        assertEq(0, st.pending_output.size(), "no output yet");

        # data finally arrives from pipe (unterminated)
        # enqueue_chunk should immediately flush since eval_complete is True
        enqueue_chunk(\st, "hi");
        assertEq(1, st.pending_output.size(), "data should be flushed immediately");
        assertTrue(st.pending_output[0].find("hi") == 0, "should start with 'hi'");
        assertTrue(st.pending_output[0].find(chr(0x1b) + "[7m%") >= 0,
            "should have reverse-video % indicator");
        assertEq("", st.capture_tail, "capture_tail should be cleared");
        assertFalse(st.eval_complete, "eval_complete cleared after flush");
    }

    /** Test: immediate flush in enqueue_chunk when eval_complete is already set. */
    testCaptureImmediateFlushInEnqueue() {
        hash<auto> st = makeCaptureState();

        # eval completes first, then data arrives
        signal_eval(\st);

        # data with newline-terminated part + unterminated tail
        enqueue_chunk(\st, "line1\ntail");
        assertEq(2, st.pending_output.size(), "complete line + flushed tail");
        assertEq("line1", st.pending_output[0]);
        assertTrue(st.pending_output[1].find("tail") == 0);
        assertTrue(st.pending_output[1].find(chr(0x1b) + "[7m%") >= 0,
            "tail should have indicator");
        assertFalse(st.eval_complete, "eval_complete cleared after immediate flush");
    }

    /** Test: clear_eval prevents premature flushing during next eval. */
    testCaptureClearEvalBetweenEvals() {
        hash<auto> st = makeCaptureState();

        # first eval: no output, eval_complete stays True
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertTrue(st.eval_complete, "stays set with no output");

        # before second eval, clear the flag
        clear_eval(\st);
        assertFalse(st.eval_complete, "cleared before new eval");

        # second eval produces unterminated output mid-eval
        enqueue_chunk(\st, "partial");
        assertEq("partial", st.capture_tail, "held in tail during eval");
        assertEq(0, st.pending_output.size(), "not flushed during eval");

        # timeout during eval — should NOT flush since eval_complete is False
        flush_if_eval_complete(\st);
        assertEq(0, st.pending_output.size(), "still not flushed");
        assertEq("partial", st.capture_tail, "still in tail");

        # eval completes
        signal_eval(\st);
        flush_if_eval_complete(\st);
        assertEq(1, st.pending_output.size(), "flushed after eval complete");
        assertTrue(st.pending_output[0].find("partial") == 0);
        assertTrue(st.pending_output[0].find(chr(0x1b) + "[7m%") >= 0);
    }

    /** Test: direct pipe I/O — write to pipe, read back. */
    testRealPipeDirectIO() {
        hash<PipeInfo> pipe = File::getPipe();

        # write data directly
        pipe.write.write("hello\n");
        *binary b = pipe.read.readShortBinary(4096, 2000);
        assertTrue(exists b, "should have read data from pipe");
        assertEq("hello\n", binary_to_string(b));

        # write without newline
        pipe.write.write("hi");
        *binary b2 = pipe.read.readShortBinary(4096, 2000);
        assertTrue(exists b2, "should have read unterminated data from pipe");
        assertEq("hi", binary_to_string(b2));

        pipe.write.close();
        pipe.read.close();
    }

    /** Test: real capture thread with pipe — newline-terminated output. */
    testRealPipeCaptureThread() {
        hash<PipeInfo> pipe = File::getPipe();
        Mutex mutex();
        Condition cond();
        list<string> pending = ();
        string tail = "";
        bool eval_done = False;
        bool running = True;
        Counter latch(1);

        # start capture thread (mirrors qrepl logic — FILE-READ-TIMEOUT is the timeout path)
        background sub () {
            while (running) {
                try {
                    *binary b = pipe.read.readShortBinary(4096, 200);
                    if (exists b && length(b) > 0) {
                        string chunk = binary_to_string(b);
                        mutex.lock();
                        on_exit mutex.unlock();
                        string full = tail + chunk;
                        list<string> lines = full.split("\n");
                        if (full.size() > 0 && full.substr(-1) == "\n") {
                            foreach string line in (lines) {
                                if (line != "") {
                                    pending += line;
                                }
                            }
                            tail = "";
                        } else {
                            for (int i = 0; i < lines.size() - 1; ++i) {
                                if (lines[i] != "") {
                                    pending += lines[i];
                                }
                            }
                            tail = lines[lines.size() - 1];
                        }
                        if (eval_done && tail != "") {
                            pending += tail + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                            tail = "";
                            eval_done = False;
                            latch.dec();
                        }
                        cond.broadcast();
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "FILE-READ-TIMEOUT") {
                        # timeout — check if eval completed with unterminated output
                        mutex.lock();
                        on_exit mutex.unlock();
                        if (eval_done && tail != "") {
                            pending += tail + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                            tail = "";
                            eval_done = False;
                            latch.dec();
                        }
                        continue;
                    }
                    if (running) {
                        break;
                    }
                }
            }
        }();

        # simulate: printf("hello world\n") via pipe
        pipe.write.write("hello world\n");

        # signal eval complete
        mutex.lock();
        eval_done = True;
        mutex.unlock();

        # wait for capture to process using condition variable
        mutex.lock();
        while (pending.size() == 0) {
            cond.wait(mutex, 5000);
        }
        mutex.unlock();

        running = False;
        pipe.write.close();

        mutex.lock();
        on_exit mutex.unlock();
        assertEq(1, pending.size(), "should have captured one line");
        assertEq("hello world", pending[0]);
    }

    /** Test: real capture thread with pipe — unterminated output (the print("hi") scenario). */
    testRealPipeNoNewlineCapture() {
        hash<PipeInfo> pipe = File::getPipe();
        Mutex mutex();
        list<string> pending = ();
        string tail = "";
        bool eval_done = False;
        bool running = True;
        Counter latch(1);

        # start capture thread (mirrors qrepl logic — FILE-READ-TIMEOUT is the timeout path)
        background sub () {
            while (running) {
                try {
                    *binary b = pipe.read.readShortBinary(4096, 200);
                    if (exists b && length(b) > 0) {
                        string chunk = binary_to_string(b);
                        mutex.lock();
                        on_exit mutex.unlock();
                        string full = tail + chunk;
                        list<string> lines = full.split("\n");
                        if (full.size() > 0 && full.substr(-1) == "\n") {
                            foreach string line in (lines) {
                                if (line != "") {
                                    pending += line;
                                }
                            }
                            tail = "";
                        } else {
                            for (int i = 0; i < lines.size() - 1; ++i) {
                                if (lines[i] != "") {
                                    pending += lines[i];
                                }
                            }
                            tail = lines[lines.size() - 1];
                        }
                        # immediate flush if eval already done
                        if (eval_done && tail != "") {
                            pending += tail + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                            tail = "";
                            eval_done = False;
                            latch.dec();
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "FILE-READ-TIMEOUT") {
                        # timeout — check if eval completed with unterminated output
                        mutex.lock();
                        on_exit mutex.unlock();
                        if (eval_done && tail != "") {
                            pending += tail + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                            tail = "";
                            eval_done = False;
                            latch.dec();
                        }
                        # NOTE: don't clear eval_done when tail is empty
                        continue;
                    }
                    if (running) {
                        break;
                    }
                }
            }
        }();

        # simulate: print("hi") — write without newline
        pipe.write.write("hi");

        # signal eval complete
        mutex.lock();
        eval_done = True;
        mutex.unlock();

        # wait for capture thread to flush (uses Counter as deterministic latch)
        int rc = latch.waitForZero(5000);
        assertEq(0, rc, "capture thread should have flushed within 5s");

        running = False;
        pipe.write.close();

        mutex.lock();
        on_exit mutex.unlock();
        assertEq(1, pending.size(), "should have captured unterminated output");
        assertTrue(pending[0].find("hi") == 0, "should start with 'hi'");
        assertTrue(pending[0].find(chr(0x1b) + "[7m%") >= 0,
            "should have reverse-video % indicator");
    }

    /** Test: stdout.redirect() to pipe — verify data reaches pipe via stdout.write(). */
    testStdoutRedirectPipeCapture() {
        hash<PipeInfo> pipe = File::getPipe();

        # save original stdout
        File saved();
        saved.open("/proc/self/fd/1", O_WRONLY);

        # redirect stdout to pipe (dup2)
        stdout.redirect(pipe.write);

        # write via Qore File::write (direct syscall to fd, no C stdio buffering)
        int written = stdout.write("redirect_test\n");
        assertEq(14, written, "stdout.write should succeed");

        # restore stdout BEFORE reading (so test output goes to terminal)
        stdout.redirect(saved);

        # read from pipe — data should be there
        *binary b = pipe.read.readShortBinary(4096, 2000);
        assertTrue(exists b, "data written via stdout should reach pipe after redirect");
        assertEq("redirect_test\n", binary_to_string(b));

        pipe.write.close();
        pipe.read.close();
    }

%ifndef NO_QORE_REPL
    /** Test: QoreRepl eval('print("hi")') output reaches pipe via redirect.
        This tests the EXACT path that qrepl uses — including C-level fflush/setvbuf
        via Session::redirectStdout + flushStdio.
    */
    testReplEvalPrintCapture() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();
        Ncurses::Session sess = th.session();

        hash<PipeInfo> pipe = File::getPipe();

        # save original stdout/stderr
        File saved_stdout();
        saved_stdout.open("/proc/self/fd/1", O_WRONLY);
        File saved_stderr();
        saved_stderr.open("/proc/self/fd/2", O_WRONLY);

        # redirect at BOTH Qore level (dup2) and C level (fflush + dup2 + setvbuf)
        stdout.redirect(pipe.write);
        stderr.redirect(pipe.write);
        sess.redirectStdout(pipe.write);
        sess.redirectStderr(pipe.write);

        QoreRepl::QoreRepl repl();
        *hash<auto> result;
        try {
            result = repl.eval('print("hello_from_repl")');
        } catch (hash<ExceptionInfo> ex) {
            # ignore eval errors
        }

        # flush C stdio buffer BEFORE restoring stdout — critical!
        sess.flushStdio();

        # restore before assertions (so test output goes to terminal)
        stdout.redirect(saved_stdout);
        stderr.redirect(saved_stderr);
        sess.redirectStdout(saved_stdout);
        sess.redirectStderr(saved_stderr);

        # read from pipe
        *binary b = pipe.read.readShortBinary(4096, 2000);

        pipe.write.close();
        pipe.read.close();

        assertTrue(exists b, "print() output inside repl.eval should reach pipe");
        string captured = binary_to_string(b);
        assertTrue(captured.find("hello_from_repl") >= 0,
            "captured data should contain 'hello_from_repl', got: " + captured);
    }
%endif

    /** Test clear_output resets and adds new prompt line. */
    testClearOutputWithInlinePrompt() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::LineListContent content = repl.output_content;
        NcursesUi::ScrollableWidget ow = repl.output_widget;

        # add some content + prompt
        content.appendLine("line 1");
        content.appendLine("line 2");
        content.appendLine("qore> ");
        assertEq(3, content.lineCount());

        # simulate clear_output
        content.clear();
        ow.setScrollY(0);
        assertEq(0, content.lineCount());

        # add new prompt
        content.appendLine("qore> ");
        assertEq(1, content.lineCount());
        assertEq("qore> ", content.getLines()[0]);
    }

    # ==================== Phase 1: Auto-Indent and Auto-Dedent Tests ====================

%ifndef NO_QORE_REPL
    /** Test auto-indent: after opening { continuation, getIndentLevel() returns > 0. */
    testAutoIndentOnContinuation() {
        QoreRepl::QoreRepl repl();

        # incomplete statement with opening brace
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "continuation input should return NOTHING");

        # repl should indicate more input needed
        assertTrue(repl.needsMoreInput(), "repl should need more input after '{'");

        # indent level should be > 0
        int indent = repl.getIndentLevel();
        assertTrue(indent > 0, sprintf("indent level should be > 0 after '{', got %d", indent));

        # complete the statement
        *hash<auto> result2 = repl.eval("}");
        assertTrue(exists result2, "completing continuation should return a result");
    }
%endif

    /** Test autoDedent: removes one indent level when buffer is whitespace + }. */
    testAutoDedentOnCloseBrace() {
        NcursesReplUi::InputBuffer buf();

        # simulate auto-indented buffer with "    }"
        buf.setText("        }");  # 8 spaces (2 indent levels) + }
        assertTrue(buf.autoDedent("    "), "autoDedent should return True");
        assertEq("    }", buf.getText(), "one indent level should be removed");
        assertEq(5, buf.getCursor(), "cursor should be at end after dedent");

        # dedent again
        assertTrue(buf.autoDedent("    "), "second autoDedent should succeed");
        assertEq("}", buf.getText(), "second indent level should be removed");
        assertEq(1, buf.getCursor(), "cursor should be at end");

        # no more to dedent
        assertFalse(buf.autoDedent("    "), "autoDedent with no indent prefix should return False");
        assertEq("}", buf.getText(), "text should be unchanged");
    }

    /** Test autoDedent has no effect when } is mid-expression. */
    testAutoDedentNoEffectMidExpression() {
        NcursesReplUi::InputBuffer buf();

        # "foo }" - not just whitespace + }
        buf.setText("foo }");
        assertFalse(buf.autoDedent("    "), "autoDedent should not affect mid-expression }");
        assertEq("foo }", buf.getText());

        # "    x}" - has non-whitespace before }
        buf.setText("    x}");
        assertFalse(buf.autoDedent("    "), "autoDedent should not affect line with content before }");
        assertEq("    x}", buf.getText());

        # empty buffer
        buf.reset();
        assertFalse(buf.autoDedent("    "), "autoDedent on empty buffer should return False");

        # just whitespace, no }
        buf.setText("    ");
        assertFalse(buf.autoDedent("    "), "autoDedent without } should return False");
    }

    # ==================== Phase 2: Word Navigation Tests ====================

    /** Test moveWordLeft skips to previous word start. */
    testMoveWordLeft() {
        NcursesReplUi::InputBuffer buf();
        buf.setText("hello world foo");

        # cursor at end (position 15)
        assertEq(15, buf.getCursor());

        # move word left: should skip "foo" backward to position 12
        buf.moveWordLeft();
        assertEq(12, buf.getCursor());

        # move word left: should skip "world" backward to position 6
        buf.moveWordLeft();
        assertEq(6, buf.getCursor());

        # move word left: should skip "hello" backward to position 0
        buf.moveWordLeft();
        assertEq(0, buf.getCursor());

        # move word left at position 0: no change
        buf.moveWordLeft();
        assertEq(0, buf.getCursor());
    }

    /** Test moveWordRight skips to next word end. */
    testMoveWordRight() {
        NcursesReplUi::InputBuffer buf();
        buf.setText("hello world foo");
        buf.setCursor(0);

        # move word right: should skip "hello" + space to position 6
        buf.moveWordRight();
        assertEq(6, buf.getCursor());

        # move word right: should skip "world" + space to position 12
        buf.moveWordRight();
        assertEq(12, buf.getCursor());

        # move word right: should skip "foo" to position 15 (end)
        buf.moveWordRight();
        assertEq(15, buf.getCursor());

        # move word right at end: no change
        buf.moveWordRight();
        assertEq(15, buf.getCursor());
    }

    /** Test deleteWordForward deletes to next word boundary. */
    testDeleteWordForward() {
        NcursesReplUi::InputBuffer buf();
        buf.setText("hello world foo");
        buf.setCursor(0);

        # delete word forward: should delete "hello " → "world foo"
        buf.deleteWordForward();
        assertEq("world foo", buf.getText());
        assertEq(0, buf.getCursor());

        # delete word forward again: should delete "world " → "foo"
        buf.deleteWordForward();
        assertEq("foo", buf.getText());

        # delete word forward: should delete "foo" → ""
        buf.deleteWordForward();
        assertEq("", buf.getText());
    }

    /** Test moveWordLeft at boundaries (start, single word, whitespace-only). */
    testMoveWordLeftAtBoundaries() {
        NcursesReplUi::InputBuffer buf();

        # single word
        buf.setText("hello");
        buf.moveWordLeft();
        assertEq(0, buf.getCursor());

        # whitespace-only
        buf.setText("   ");
        buf.moveWordLeft();
        assertEq(0, buf.getCursor());

        # cursor in middle of word
        buf.setText("hello world");
        buf.setCursor(8);  # in "world"
        buf.moveWordLeft();
        assertEq(6, buf.getCursor());  # start of "world"

        # multiple spaces between words
        buf.setText("a   b");
        buf.moveWordLeft();  # cursor at 5, should go to start of "b"
        assertEq(4, buf.getCursor());
        buf.moveWordLeft();  # should go to start of "a"
        assertEq(0, buf.getCursor());
    }

    /** Test moveWordRight at boundaries. */
    testMoveWordRightAtBoundaries() {
        NcursesReplUi::InputBuffer buf();

        # empty
        buf.reset();
        buf.moveWordRight();
        assertEq(0, buf.getCursor());

        # single word
        buf.setText("hello");
        buf.setCursor(0);
        buf.moveWordRight();
        assertEq(5, buf.getCursor());

        # cursor in middle of word
        buf.setText("hello world");
        buf.setCursor(3);  # in "hello"
        buf.moveWordRight();
        assertEq(6, buf.getCursor());  # end of "hello" + space

        # trailing spaces
        buf.setText("hello   ");
        buf.setCursor(0);
        buf.moveWordRight();
        assertEq(8, buf.getCursor());  # skip "hello" + trailing spaces
    }

    /** Test deleteWordForward at end of buffer is no-op. */
    testDeleteWordForwardAtEnd() {
        NcursesReplUi::InputBuffer buf();
        buf.setText("hello");
        # cursor at end
        buf.deleteWordForward();
        assertEq("hello", buf.getText());
        assertEq(5, buf.getCursor());

        # empty buffer
        buf.reset();
        buf.deleteWordForward();
        assertEq("", buf.getText());
    }

    /** Test Alt+B no longer opens file browser (now uses Alt+O). */
    testAltBNoLongerOpensBrowser() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;
        NcursesReplUi::InputBuffer buffer = repl.buffer;

        # add menus with new hotkey (Alt+O for browse)
        menu_bar.setApplication(app);
        menu_bar.addMenu("File", (
            {"label": "Browse...", "command": "file_browser", "hotkey": "Alt+O"},
        ));

        # build alt_commands map
        hash<string, string> alt_commands = {};
        foreach hash<auto> menu in (menu_bar.getMenus()) {
            foreach hash<auto> item in (menu.items) {
                if (item.separator) {
                    continue;
                }
                *string hotkey = item.hotkey;
                if (exists hotkey && hotkey.size() > 0) {
                    string hk_char = hotkey.substr(-1).lwr();
                    alt_commands{hk_char} = item.command;
                }
            }
        }

        # set up global handler that routes Alt+B to word-left
        bool word_left_called = False;
        string last_cmd = "";
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (app.getDispatcher().hasModal()) {
                return <NcursesUi::EventResult>{"handled": False};
            }
            if (ev.type == Ncurses::InputType::Alt) {
                string ch = ev.ch ?? "";
                if (ch != "") {
                    string lch = ch.lwr();
                    if (lch == "b") {
                        buffer.moveWordLeft();
                        word_left_called = True;
                        return <NcursesUi::EventResult>{"handled": True};
                    }
                    *string cmd = alt_commands{lch};
                    if (exists cmd) {
                        last_cmd = cmd;
                        return <NcursesUi::EventResult>{"handled": True, "action": "menu_command"};
                    }
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # type some text first
        buffer.setText("hello world");

        # send Alt+B - should call moveWordLeft, NOT file_browser
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Alt;
        ev.ch = "b";
        app.processEvent(ev);

        assertTrue(word_left_called, "Alt+B should trigger moveWordLeft");
        assertEq("", last_cmd, "Alt+B should NOT trigger file_browser command");
        assertEq(6, buffer.getCursor(), "cursor should be at word boundary");

        # verify Alt+O does trigger file browser
        ev.ch = "o";
        app.processEvent(ev);
        assertEq("file_browser", last_cmd, "Alt+O should trigger file_browser");
    }

    # ==================== Phase 3: Tab Code Completion Tests ====================

%ifndef NO_QORE_REPL
    /** Test Tab completion returns valid results with expected structure. */
    testTabCompletionSingle() {
        QoreRepl::QoreRepl repl();
        # "printf" should return completions including "printf"
        *list<hash<auto>> completions;
        try {
            completions = repl.getCompletionDetails("printf");
        } catch (hash<ExceptionInfo> ex) {
            # completion API not available
            testSkip("QoreRepl::getCompletionDetails not available");
            return;
        }
        if (!exists completions || completions.size() == 0) {
            testSkip("no completions returned for 'printf'");
            return;
        }
        # verify completions contain "printf" with expected structure
        assertTrue(completions.size() >= 1,
            sprintf("should have at least 1 completion for 'printf', got %d", completions.size()));
        # find the printf entry
        bool found_printf = False;
        foreach hash<auto> item in (completions) {
            assertTrue(exists item.label, "completion item should have a label");
            if (item.label == "printf") {
                found_printf = True;
                assertTrue(item.isCallable, "printf should be callable");
            }
        }
        assertTrue(found_printf, "completions for 'printf' should include 'printf'");
    }

    /** Test Tab with multiple completions returns them. */
    testTabCompletionMultiple() {
        QoreRepl::QoreRepl repl();
        *list<hash<auto>> completions;
        try {
            completions = repl.getCompletionDetails("pri");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("QoreRepl::getCompletionDetails not available");
            return;
        }
        if (!exists completions) {
            testSkip("no completions returned for 'pri'");
            return;
        }
        # "pri" should match print, printf, println, etc.
        assertTrue(completions.size() >= 1,
            sprintf("should have completions for 'pri', got %d", completions.size()));
    }

    /** Test Tab with empty input does not crash. */
    testTabCompletionEmpty() {
        QoreRepl::QoreRepl repl();
        *list<hash<auto>> completions;
        try {
            completions = repl.getCompletionDetails("");
        } catch (hash<ExceptionInfo> ex) {
            # expected - empty input may throw; verify it's a known error type
            assertTrue(exists ex.err, "exception should have an error code");
            return;
        }
        # either NOTHING or a list is acceptable for empty input
        if (exists completions) {
            assertTrue(completions.size() >= 0,
                "completions for empty input should be a valid list");
        } else {
            assertFalse(exists completions,
                "NOTHING is an acceptable result for empty input");
        }
    }
%endif

    /** Test CompletionPopupWidget construction and navigation. */
    testCompletionPopupWidget() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        list<hash<auto>> items = (
            {"label": "print", "kind": "function", "isCallable": True},
            {"label": "printf", "kind": "function", "isCallable": True},
            {"label": "println", "kind": "function", "isCallable": True},
        );

        NcursesUi::CompletionPopupWidget popup(th.session(), items);
        assertEq(3, popup.getItems().size());
        assertEq(0, popup.getHighlightIndex());

        # position and create panel
        popup.positionAt(10, 5, term_rows, term_cols);
        popup.createPanel();

        # draw should not crash
        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.pushModal(popup);
        app.drawAll();

        # navigate down
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        popup.processEvent(ev);
        assertEq(1, popup.getHighlightIndex());

        ev.name = "KEY_DOWN";
        popup.processEvent(ev);
        assertEq(2, popup.getHighlightIndex());

        # navigate up
        ev.name = "KEY_UP";
        popup.processEvent(ev);
        assertEq(1, popup.getHighlightIndex());

        # select on Enter
        hash<auto> selected;
        popup.setOnSelect(sub (hash<auto> item) {
            selected = item;
        });

        hash<Ncurses::InputEvent> enter_ev();
        enter_ev.type = Ncurses::InputType::Char;
        enter_ev.ch = "\n";
        popup.processEvent(enter_ev);

        assertTrue(exists selected, "Enter should select an item");
        assertEq("printf", selected.label, "selected item should be 'printf'");

        app.popModal();
        popup.destroyPanel();
    }

    /** Test CompletionPopupWidget dismisses on Escape. */
    testCompletionPopupDismissOnEscape() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        list<hash<auto>> items = (
            {"label": "foo"},
            {"label": "bar"},
        );

        NcursesUi::CompletionPopupWidget popup(th.session(), items);
        popup.positionAt(5, 5, term_rows, term_cols);
        popup.createPanel();

        bool dismissed = False;
        popup.setOnDismiss(sub () {
            dismissed = True;
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        popup.processEvent(ev);

        assertTrue(dismissed, "Escape should dismiss the completion popup");

        popup.destroyPanel();
    }

    /** Test CompletionPopupWidget kind indicators. */
    testCompletionPopupKindIndicator() {
        assertEq("f", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "function"}));
        assertEq("f", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "method"}));
        assertEq("c", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "class"}));
        assertEq("n", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "namespace"}));
        assertEq("v", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "variable"}));
        assertEq("k", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "constant"}));
        assertEq("m", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "module"}));
        assertEq("h", NcursesUi::CompletionPopupWidget::kindIndicator({"kind": "hashdecl"}));
        assertEq("f", NcursesUi::CompletionPopupWidget::kindIndicator({"isCallable": True}));
        assertEq(" ", NcursesUi::CompletionPopupWidget::kindIndicator({}));
    }

    # ==================== Phase 4: History Persistence Tests ====================

    /** Test History.load() reads lines from file. */
    testHistoryLoad() {
        NcursesReplUi::History hist();
        string path = (ENV.TMPDIR ?? "/tmp") + "/test-history-load-" + string(getpid());
        on_exit {
            try { unlink(path); } catch () {}
        }

        # write a test file
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write("line1\n");
        f.write("line2\n");
        f.write("line3\n");
        f.close();

        hist.load(path);
        assertEq(3, hist.size());

        # verify order by navigating history
        *string prev = hist.prev();
        assertEq("line3", prev);
        prev = hist.prev();
        assertEq("line2", prev);
        prev = hist.prev();
        assertEq("line1", prev);
    }

    /** Test History.save() writes lines to file. */
    testHistorySave() {
        NcursesReplUi::History hist();
        hist.add("save1");
        hist.add("save2");
        hist.add("save3");

        string path = (ENV.TMPDIR ?? "/tmp") + "/test-history-save-" + string(getpid());
        on_exit {
            try { unlink(path); } catch () {}
        }

        hist.save(path);

        # read back and verify
        ReadOnlyFile f(path);
        string content = f.read(-1);
        list<string> lines = content.split("\n");
        # filter empty lines from trailing newline
        list<string> non_empty = ();
        foreach string line in (lines) {
            if (line != "") {
                non_empty += line;
            }
        }
        assertEq(3, non_empty.size());
        assertEq("save1", non_empty[0]);
        assertEq("save2", non_empty[1]);
        assertEq("save3", non_empty[2]);

        # verify file permissions (mode 0600)
        *hash<StatInfo> st = hstat(path);
        assertTrue(exists st, "hstat should succeed on saved file");
        int mode = st.mode & 0777;
        assertEq(0600, mode, sprintf("file should have mode 0600, got %o", mode));
    }

    /** Test History max length trimming. */
    testHistoryMaxLength() {
        NcursesReplUi::History hist();
        hist.setMaxLength(3);
        assertEq(3, hist.getMaxLength());

        hist.add("a");
        hist.add("b");
        hist.add("c");
        assertEq(3, hist.size());

        # adding a 4th should trim the oldest
        hist.add("d");
        assertEq(3, hist.size());

        # verify oldest was trimmed
        list<string> items = hist.getItems();
        assertEq("b", items[0]);
        assertEq("c", items[1]);
        assertEq("d", items[2]);

        # setMaxLength to smaller value should trim immediately
        hist.setMaxLength(2);
        assertEq(2, hist.size());
        items = hist.getItems();
        assertEq("c", items[0]);
        assertEq("d", items[1]);
    }

    /** Test History.load() on nonexistent file doesn't crash. */
    testHistoryLoadNonexistent() {
        NcursesReplUi::History hist();
        string path = (ENV.TMPDIR ?? "/tmp") + "/nonexistent-history-" + string(getpid());

        # should not throw
        hist.load(path);
        assertEq(0, hist.size());
    }

    /** Test History round-trip: save then load preserves entries. */
    testHistoryRoundTrip() {
        string path = (ENV.TMPDIR ?? "/tmp") + "/test-history-roundtrip-" + string(getpid());
        on_exit {
            try { unlink(path); } catch () {}
        }

        # save
        NcursesReplUi::History hist1();
        hist1.add("alpha");
        hist1.add("beta");
        hist1.add("gamma");
        hist1.save(path);

        # load into fresh history
        NcursesReplUi::History hist2();
        hist2.load(path);
        assertEq(3, hist2.size());

        # verify entries match
        list<string> items = hist2.getItems();
        assertEq("alpha", items[0]);
        assertEq("beta", items[1]);
        assertEq("gamma", items[2]);

        # verify navigation works
        *string prev = hist2.prev();
        assertEq("gamma", prev);
        prev = hist2.prev();
        assertEq("beta", prev);
        prev = hist2.prev();
        assertEq("alpha", prev);
    }
}
