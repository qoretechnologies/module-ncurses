#!/usr/bin/env qore

%modern
%requires ncurses
%requires NcursesUi
%requires NcursesReplUi
%requires QUnit
%try-module QoreRepl
%define NO_QORE_REPL
%endtry

%include "test/TestHarness.qc"

%exec-class NcursesQreplTest

/** Tests for qrepl application scenarios.

    These tests verify the UI layout and interaction patterns used by qrepl,
    using TestHarness with TestTerminal for deterministic testing.

    The qrepl uses an inline terminal prompt architecture where the prompt
    is the last line of the ScrollableWidget content, and all keyboard
    input is handled via the global key handler using InputBuffer/History.

    @since ncurses 2.0
*/
class NcursesQreplTest inherits QUnit::Test {
    constructor() : QUnit::Test("NcursesQreplTest", "1.0") {
        addTestCase("testReplLayout", \testReplLayout());
        addTestCase("testReplOutputScrolling", \testReplOutputScrolling());
        addTestCase("testReplInlineInputSubmit", \testReplInlineInputSubmit());
        addTestCase("testReplMenuBarSetup", \testReplMenuBarSetup());
        addTestCase("testReplStatusBarUpdate", \testReplStatusBarUpdate());
        addTestCase("testStatusBarFixedWidthLabel", \testStatusBarFixedWidthLabel());
        addTestCase("testReplInlineHistory", \testReplInlineHistory());
        addTestCase("testReplEscapeClosesModal", \testReplEscapeClosesModal());
        addTestCase("testReplEscapeClosesDropdown", \testReplEscapeClosesDropdown());
        addTestCase("testReplEscapeShowsQuitDialog", \testReplEscapeShowsQuitDialog());
        addTestCase("testReplEscapeDebugStatus", \testReplEscapeDebugStatus());
        addTestCase("testReplRedraw", \testReplRedraw());
        addTestCase("testReplOutputCapture", \testReplOutputCapture());
        addTestCase("testReplFocusOnOutput", \testReplFocusOnOutput());
%ifndef NO_QORE_REPL
        addTestCase("testReplEvalSimpleExpr", \testReplEvalSimpleExpr());
        addTestCase("testReplEvalError", \testReplEvalError());
        addTestCase("testReplPromptUpdate", \testReplPromptUpdate());
        addTestCase("testReplEvalContinuation", \testReplEvalContinuation());
        addTestCase("testReplExecLineHandlesNothingResult", \testReplExecLineHandlesNothingResult());
        addTestCase("testReplHelpOutputMultiLine", \testReplHelpOutputMultiLine());
%endif
        addTestCase("testReplMenuCommandExec", \testReplMenuCommandExec());
        addTestCase("testReplMouseToggle", \testReplMouseToggle());
        addTestCase("testReplTickCallback", \testReplTickCallback());
        addTestCase("testReplOutputMultiLine", \testReplOutputMultiLine());
        addTestCase("testReplEmptyInput", \testReplEmptyInput());
        addTestCase("testReplInlineCtrlKeys", \testReplInlineCtrlKeys());
        addTestCase("testReplLayoutWithResize", \testReplLayoutWithResize());
        addTestCase("testDarkThemeMenuBarStyle", \testDarkThemeMenuBarStyle());
        addTestCase("testDarkThemeStatusBarStyle", \testDarkThemeStatusBarStyle());
        addTestCase("testDarkThemeDropdownStyle", \testDarkThemeDropdownStyle());
        addTestCase("testDarkThemeDialogStyle", \testDarkThemeDialogStyle());
        addTestCase("testDropdownSeparatorUsesACSLine", \testDropdownSeparatorUsesACSLine());
        addTestCase("testQuitDialogVisualFlow", \testQuitDialogVisualFlow());
        addTestCase("testCtrlQShowsQuitDialog", \testCtrlQShowsQuitDialog());
        addTestCase("testInlinePromptLineUpdate", \testInlinePromptLineUpdate());
        addTestCase("testInlinePromptInsertBeforePrompt", \testInlinePromptInsertBeforePrompt());
        addTestCase("testInlineCursorPositioning", \testInlineCursorPositioning());
        addTestCase("testClearOutputWithInlinePrompt", \testClearOutputWithInlinePrompt());
        addTestCase("testReplModalPassthrough", \testReplModalPassthrough());
        addTestCase("testReplAltKeyOpensMenu", \testReplAltKeyOpensMenu());
        addTestCase("testCaptureNewlineTerminated", \testCaptureNewlineTerminated());
        addTestCase("testCaptureNoNewlineIndicator", \testCaptureNoNewlineIndicator());
        addTestCase("testCaptureMixedOutput", \testCaptureMixedOutput());
        addTestCase("testCaptureMultipleChunks", \testCaptureMultipleChunks());
        addTestCase("testCaptureEvalCompleteNoTail", \testCaptureEvalCompleteNoTail());
        addTestCase("testCaptureRaceEvalBeforeData", \testCaptureRaceEvalBeforeData());
        addTestCase("testCaptureImmediateFlushInEnqueue", \testCaptureImmediateFlushInEnqueue());
        addTestCase("testCaptureClearEvalBetweenEvals", \testCaptureClearEvalBetweenEvals());
        addTestCase("testRealPipeDirectIO", \testRealPipeDirectIO());
        addTestCase("testRealPipeCaptureThread", \testRealPipeCaptureThread());
        addTestCase("testRealPipeNoNewlineCapture", \testRealPipeNoNewlineCapture());
        addTestCase("testStdoutRedirectPipeCapture", \testStdoutRedirectPipeCapture());
%ifndef NO_QORE_REPL
        addTestCase("testReplEvalPrintCapture", \testReplEvalPrintCapture());
        addTestCase("testAutoIndentOnContinuation", \testAutoIndentOnContinuation());
%endif
        addTestCase("testAutoDedentOnCloseBrace", \testAutoDedentOnCloseBrace());
        addTestCase("testAutoDedentNoEffectMidExpression", \testAutoDedentNoEffectMidExpression());
        addTestCase("testMoveWordLeft", \testMoveWordLeft());
        addTestCase("testMoveWordRight", \testMoveWordRight());
        addTestCase("testDeleteWordForward", \testDeleteWordForward());
        addTestCase("testMoveWordLeftAtBoundaries", \testMoveWordLeftAtBoundaries());
        addTestCase("testMoveWordRightAtBoundaries", \testMoveWordRightAtBoundaries());
        addTestCase("testDeleteWordForwardAtEnd", \testDeleteWordForwardAtEnd());
        addTestCase("testAltBNoLongerOpensBrowser", \testAltBNoLongerOpensBrowser());
%ifndef NO_QORE_REPL
        addTestCase("testTabCompletionSingle", \testTabCompletionSingle());
        addTestCase("testTabCompletionMultiple", \testTabCompletionMultiple());
        addTestCase("testTabCompletionEmpty", \testTabCompletionEmpty());
%endif
        addTestCase("testCompletionPopupWidget", \testCompletionPopupWidget());
        addTestCase("testCompletionPopupDismissOnEscape", \testCompletionPopupDismissOnEscape());
        addTestCase("testCompletionPopupKindIndicator", \testCompletionPopupKindIndicator());
        addTestCase("testHistoryLoad", \testHistoryLoad());
        addTestCase("testHistorySave", \testHistorySave());
        addTestCase("testHistoryMaxLength", \testHistoryMaxLength());
        addTestCase("testHistoryLoadNonexistent", \testHistoryLoadNonexistent());
        addTestCase("testHistoryRoundTrip", \testHistoryRoundTrip());

        set_return_value(main());
    }

    private {
        #! standard terminal size for REPL tests
        int term_rows = 24;
        int term_cols = 80;
    }

    /** Helper: build a REPL-like layout matching the new qrepl inline prompt structure.

        Layout: menu_bar + output_widget (with inline prompt) + status_bar.
        No separate TextInputWidget - input is handled via InputBuffer in the global handler.
    */
    private hash<auto> buildReplLayout(NcursesUi::TestHarness th) {
        NcursesUi::Application app(th.session());

        NcursesUi::Widget root();
        NcursesUi::MenuBarWidget menu_bar();
        NcursesUi::ScrollableWidget output_widget();
        NcursesUi::LineListContent output_content();
        NcursesUi::StatusBarWidget status_bar();

        # inline input state
        NcursesReplUi::InputBuffer buffer();
        NcursesReplUi::History history();

        output_widget.setContent(output_content);
        output_widget.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        status_bar.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        status_bar.setMinimumSize(1, 1);
        status_bar.setPreferredSize(1, 0);

        menu_bar.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu_bar.setMinimumSize(1, 1);
        menu_bar.setPreferredSize(1, 0);

        root.addChild(menu_bar);
        root.addChild(output_widget);
        root.addChild(status_bar);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(output_widget);

        return {
            "app": app,
            "root": root,
            "menu_bar": menu_bar,
            "output_widget": output_widget,
            "output_content": output_content,
            "status_bar": status_bar,
            "buffer": buffer,
            "history": history,
        };
    }

    /** Test that the REPL layout has correct widget arrangement. */
    testReplLayout() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Widget root = repl.root;

        # root fills screen
        assertEq(term_rows, root.getFrame().rows);
        assertEq(term_cols, root.getFrame().cols);

        # 3 children: menu_bar, output, status_bar (no separate input widget)
        assertEq(3, root.getChildren().size());

        # menu bar gets 1 row at top
        NcursesUi::MenuBarWidget mb = repl.menu_bar;
        assertEq(1, mb.getFrame().rows);
        assertEq(term_cols, mb.getFrame().cols);
        assertEq(0, mb.getFrame().y);

        # status bar gets 1 row at bottom
        NcursesUi::StatusBarWidget sb = repl.status_bar;
        assertEq(1, sb.getFrame().rows);
        assertEq(term_cols, sb.getFrame().cols);
        assertEq(term_rows - 1, sb.getFrame().y);

        # output gets remaining rows (24 - 2 fixed = 22)
        NcursesUi::ScrollableWidget ow = repl.output_widget;
        assertEq(22, ow.getFrame().rows);
        assertEq(term_cols, ow.getFrame().cols);
    }

    /** Test scrolling when output exceeds visible area. */
    testReplOutputScrolling() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::ScrollableWidget ow = repl.output_widget;
        NcursesUi::LineListContent content = repl.output_content;

        # add more lines than visible (22 visible rows)
        for (int i = 0; i < 50; ++i) {
            content.appendLine(sprintf("Line %d", i));
        }

        assertEq(50, content.totalRows());

        # scroll to end
        ow.scrollTo(NcursesUi::ScrollDirection::End);
        assertTrue(ow.getScrollY() > 0);

        # scroll back to top
        ow.scrollTo(NcursesUi::ScrollDirection::Home);
        assertEq(0, ow.getScrollY());
    }

    /** Test inline input: typing and submitting via global key handler. */
    testReplInlineInputSubmit() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::LineListContent content = repl.output_content;
        NcursesReplUi::InputBuffer buffer = repl.buffer;
        NcursesReplUi::History history = repl.history;

        # add initial prompt line
        string prompt = "qore> ";
        content.appendLine(prompt);
        int prompt_idx = content.lineCount() - 1;

        bool submit_called = False;
        string submitted_text = "";

        # set up global handler like qrepl
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char) {
                string ch = ev.ch ?? "";
                if (ch == "\n") {
                    submitted_text = buffer.getText();
                    submit_called = True;
                    buffer.reset();
                    history.add(submitted_text);
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (ord(ch) >= 32) {
                    buffer.insertChar(ch);
                    content.setLine(prompt_idx, prompt + buffer.getText());
                    return <NcursesUi::EventResult>{"handled": True};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # type "1 + 2"
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        foreach string ch in ("1", " ", "+", " ", "2") {
            ev.ch = ch;
            app.processEvent(ev);
        }

        # verify buffer updated
        assertEq("1 + 2", buffer.getText());

        # verify prompt line updated
        list<string> lines = content.getLines();
        assertEq("qore> 1 + 2", lines[prompt_idx]);

        # submit
        ev.ch = "\n";
        app.processEvent(ev);

        assertTrue(submit_called);
        assertEq("1 + 2", submitted_text);
        assertEq("", buffer.getText());
    }

    /** Test menu bar setup with REPL-style menus (File/Edit/View/Help). */
    testReplMenuBarSetup() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::MenuBarWidget mb = repl.menu_bar;

        # add menus like qrepl
        mb.addMenu("File", (
            {"label": "Browse...", "command": "file_browser"},
            {"label": "Load...", "command": "/load"},
            {"label": "Save...", "command": "/save"},
            {"separator": True},
            {"label": "Pwd", "command": "/pwd"},
            {"separator": True},
            {"label": "Quit", "command": "/quit"},
        ));
        mb.addMenu("Edit", (
            {"label": "Clear Output", "command": "clear_output"},
            {"label": "Reset", "command": "/reset"},
        ));
        mb.addMenu("View", (
            {"label": "Variables", "command": "/vars"},
            {"label": "Functions", "command": "/functions"},
            {"label": "Classes", "command": "/classes"},
            {"label": "Namespaces", "command": "/namespaces"},
            {"label": "Modules", "command": "/modules"},
            {"separator": True},
            {"label": "History", "command": "/history"},
            {"label": "Timing", "command": "/timing"},
        ));
        mb.addMenu("Help", (
            {"label": "Help", "command": "/help"},
        ));

        assertEq(4, mb.getMenus().size());
        assertEq("File", mb.getMenus()[0].label);
        assertEq("Edit", mb.getMenus()[1].label);
        assertEq("View", mb.getMenus()[2].label);
        assertEq("Help", mb.getMenus()[3].label);
    }

    /** Test status bar update with styled segments. */
    testReplStatusBarUpdate() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::StatusBarWidget sb = repl.status_bar;
        NcursesUi::Application app = repl.app;

        # update like qrepl does (status label padded to fixed width 17)
        list<hash<auto>> segs = (
            {"text": " Ready           ", "style": {"fg": Ncurses::Color::Green, "bg": Ncurses::Color::Blue,
                "attrs": Ncurses::Attr::Bold}},
            {"text": " REPL ", "style": {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue}},
            {"text": " Lines: 0 ", "style": {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue}},
            {"text": "17:00:00 ", "align": "right",
                "style": {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue}},
            {"text": "Mouse:ON  ", "align": "right",
                "style": {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue}},
        );
        sb.setSegments(segs);

        # should not crash and status bar has 1 row
        assertEq(1, sb.getFrame().rows);

        # draw to verify rendering works
        app.drawAll();
    }

    /** Test status bar labels are padded to fixed width. */
    testStatusBarFixedWidthLabel() {
        # all status values should produce a string of width 17
        list<string> statuses = ("OK", "Ready", "Cleared", "Error", "Evaluating...", "Exit", "...",
            "ESC!", "Ctrl+Q!");
        foreach string status in (statuses) {
            string padded = pad_status_label(status);
            assertEq(17, padded.length(),
                sprintf("pad_status_label('%s') should be 17 chars, got %d: '%s'",
                    status, padded.length(), padded));
            # should start with space + label
            assertTrue(padded.substr(0, 1) == " ",
                sprintf("padded label should start with space: '%s'", padded));
            assertTrue(padded.find(status) >= 0,
                sprintf("padded label should contain '%s': '%s'", status, padded));
        }

        # exact longest label should not be truncated
        string longest = pad_status_label("Evaluating...");
        assertEq(" Evaluating... ", longest.substr(0, 15));
        assertEq(17, longest.length());
    }

    /** Helper: pad status label (mirrors qrepl's static method for testing). */
    private static string pad_status_label(string label, int width = 17) {
        string text = " " + label + " ";
        if (text.length() < width) {
            text += strmul(" ", width - text.length());
        }
        return text;
    }

    /** Test inline history navigation via global key handler. */
    testReplInlineHistory() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesReplUi::InputBuffer buffer = repl.buffer;
        NcursesReplUi::History history = repl.history;
        NcursesUi::LineListContent content = repl.output_content;

        # add initial prompt line
        content.appendLine("qore> ");
        int prompt_idx = 0;

        # set up global handler with history support
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char) {
                string ch = ev.ch ?? "";
                if (ch == "\n") {
                    string text = buffer.getText();
                    if (text != "") {
                        history.add(text);
                    }
                    buffer.reset();
                    content.appendLine("qore> ");
                    prompt_idx = content.lineCount() - 1;
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (ord(ch) >= 32) {
                    buffer.insertChar(ch);
                    content.setLine(prompt_idx, "qore> " + buffer.getText());
                    return <NcursesUi::EventResult>{"handled": True};
                }
            } else if (ev.type == Ncurses::InputType::Key) {
                string name = ev.name ?? "";
                if (name == "KEY_UP") {
                    *string prev = history.prev();
                    if (exists prev) {
                        buffer.setText(prev);
                        content.setLine(prompt_idx, "qore> " + buffer.getText());
                    }
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (name == "KEY_DOWN") {
                    *string nxt = history.next();
                    if (exists nxt) {
                        buffer.setText(nxt);
                        content.setLine(prompt_idx, "qore> " + buffer.getText());
                    }
                    return <NcursesUi::EventResult>{"handled": True};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;

        # type and submit "hello"
        foreach string ch in ("h", "e", "l", "l", "o") {
            ev.ch = ch;
            app.processEvent(ev);
        }
        ev.ch = "\n";
        app.processEvent(ev);

        # type and submit "world"
        foreach string ch in ("w", "o", "r", "l", "d") {
            ev.ch = ch;
            app.processEvent(ev);
        }
        ev.ch = "\n";
        app.processEvent(ev);

        assertEq(2, history.size());

        # press Up to get "world" back
        hash<Ncurses::InputEvent> key_ev();
        key_ev.type = Ncurses::InputType::Key;
        key_ev.name = "KEY_UP";
        app.processEvent(key_ev);
        assertEq("world", buffer.getText());

        # press Up again to get "hello"
        app.processEvent(key_ev);
        assertEq("hello", buffer.getText());

        # press Down to get "world" back
        key_ev.name = "KEY_DOWN";
        app.processEvent(key_ev);
        assertEq("world", buffer.getText());
    }

    /** Test Escape passes through when a modal is open (lets modal handle it). */
    testReplEscapeClosesModal() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;

        # set up escape handler like qrepl does
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                # if a modal is open, let the dispatcher handle it
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # push a dialog as modal
        NcursesUi::DialogWidget dlg(th.session(), "Test", "msg");
        dlg.centerOn(term_rows, term_cols);
        bool dismissed = False;
        dlg.setOnDismiss(sub () {
            dismissed = True;
            app.popModal();
        });
        app.pushModal(dlg);
        assertTrue(app.getDispatcher().hasModal());

        # Escape should be passed through to the modal dialog, which dismisses
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        assertTrue(dismissed);
        assertFalse(app.getDispatcher().hasModal());
    }

    /** Test Escape closes dropdown menu when open. */
    testReplEscapeClosesDropdown() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;

        # add a menu
        menu_bar.addMenu("File", (
            {"label": "Open", "command": "open"},
        ));

        bool close_menu_handled = False;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                if (menu_bar.isDropdownOpen()) {
                    menu_bar.closeMenu();
                    close_menu_handled = True;
                    return <NcursesUi::EventResult>{"handled": True, "action": "close_menu"};
                }
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # open dropdown
        menu_bar.openMenu(0);
        assertTrue(menu_bar.isDropdownOpen());

        # Escape should close the dropdown
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        assertTrue(close_menu_handled);
        assertFalse(menu_bar.isDropdownOpen());
    }

    /** Test Escape with nothing open shows quit dialog action. */
    testReplEscapeShowsQuitDialog() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;

        string last_action;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                if (menu_bar.isDropdownOpen()) {
                    menu_bar.closeMenu();
                    last_action = "close_menu";
                    return <NcursesUi::EventResult>{"handled": True, "action": "close_menu"};
                }
                last_action = "quit_dialog";
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # no modal, no dropdown - Escape should trigger quit dialog
        assertFalse(app.getDispatcher().hasModal());
        assertFalse(menu_bar.isDropdownOpen());

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        assertEq("quit_dialog", last_action);
    }

    /** Test Escape updates status bar to "ESC!" for debugging. */
    testReplEscapeDebugStatus() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;

        string last_status = "Ready";
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char) {
                string ch = ev.ch ?? "";
                if (ord(ch) == 0x1b) {
                    if (app.getDispatcher().hasModal()) {
                        return <NcursesUi::EventResult>{"handled": False};
                    }
                    last_status = "ESC!";
                    return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
                } else if (ord(ch) == 0x11) {
                    if (app.getDispatcher().hasModal()) {
                        return <NcursesUi::EventResult>{"handled": False};
                    }
                    last_status = "Ctrl+Q!";
                    return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # Escape should set status to "ESC!"
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);
        assertEq("ESC!", last_status);

        # Ctrl+Q should set status to "Ctrl+Q!"
        last_status = "Ready";
        ev.ch = chr(0x11);
        app.processEvent(ev);
        assertEq("Ctrl+Q!", last_status);
    }

    /** Test Ctrl+L triggers full redraw. */
    testReplRedraw() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::Widget root = repl.root;

        bool redraw_requested = False;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x0c) {
                root.markDirty();
                redraw_requested = True;
                return <NcursesUi::EventResult>{"handled": True};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x0c);
        app.processEvent(ev);

        assertTrue(redraw_requested);
        assertTrue(root.isDirty());
    }

