        assertEq(0, dd.getHighlightIndex(), "first item should be highlighted");

        # verify both items are visible in panel
        assertTrue(all_text.find("Open") >= 0, "dropdown should show 'Open'");
        assertTrue(all_text.find("Save") >= 0, "dropdown should show 'Save'");

        mb.closeMenu();
