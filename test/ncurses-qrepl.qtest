    /** Test complete quit dialog visual flow with TestTerminal. */
    testQuitDialogVisualFlow() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;

        bool quit_called = False;

        # set up global key handler like qrepl
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                if (menu_bar.isDropdownOpen()) {
                    menu_bar.closeMenu();
                    return <NcursesUi::EventResult>{"handled": True, "action": "close_menu"};
                }
                # show quit dialog
                NcursesUi::DialogWidget dlg = NcursesUi::DialogWidget::confirm(
                    th.session(), "Quit", "Exit the REPL?",
                    sub (int idx, string label) {
                        if (idx == 0) {
                            app.popModal();
                            dlg.destroyPanel();
                            quit_called = True;
                        } else {
                            app.popModal();
                            dlg.destroyPanel();
                        }
                    });
                dlg.setOnDismiss(sub () {
                    app.popModal();
                    dlg.destroyPanel();
                });
                hash<Ncurses::Size> sz = th.session().screen().size();
                dlg.centerOn(sz.rows, sz.cols);
                dlg.createPanel();
                app.pushModal(dlg);
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;

        # Step 1: Escape with nothing open -> quit dialog appears
        ev.ch = chr(0x1b);
        app.processEvent(ev);
        assertTrue(app.getDispatcher().hasModal(), "quit dialog should be modal");

        # draw and verify dialog is visible
        app.drawAll();
        *NcursesUi::Widget modal = app.getDispatcher().topModal();
        assertTrue(exists modal, "modal dialog should exist");
        NcursesUi::DialogWidget dlg2 = modal;
        Ncurses::Window pw = dlg2.getWindow();
        hash<Ncurses::Size> pw_sz = pw.size();
        string all_text = "";
        for (int r = 0; r < pw_sz.rows; ++r) {
            all_text += pw.readText(r, 0, pw_sz.cols);
        }
        assertTrue(all_text.find("Exit the REPL") >= 0, "dialog should show quit message");
        assertTrue(all_text.find("OK") >= 0, "dialog should show OK button");
        assertTrue(all_text.find("Cancel") >= 0, "dialog should show Cancel button");

        # Step 2: Escape on dialog -> dismisses it
        ev.ch = chr(0x1b);
        app.processEvent(ev);
        assertFalse(app.getDispatcher().hasModal(), "dialog should be dismissed by Escape");
        assertFalse(quit_called, "should NOT have quit");

        # Step 3: Escape again -> new dialog appears
        ev.ch = chr(0x1b);
        app.processEvent(ev);
        assertTrue(app.getDispatcher().hasModal(), "new quit dialog should appear");

        # Step 4: Enter on dialog -> OK -> quits
        ev.ch = "\n";
        app.processEvent(ev);
        assertTrue(quit_called, "Enter on quit dialog should quit");
        assertFalse(app.getDispatcher().hasModal(), "dialog should be dismissed after quit");
    }

    /** Test Ctrl+Q shows quit dialog (alternative to Escape). */
    testCtrlQShowsQuitDialog() {
        NcursesUi::TestHarness th(term_rows, term_cols);
        on_exit th.close();

        hash<auto> repl = buildReplLayout(th);
        NcursesUi::Application app = repl.app;
        NcursesUi::MenuBarWidget menu_bar = repl.menu_bar;

        bool quit_dialog_shown = False;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char) {
                string ch = ev.ch ?? "";
                if (ord(ch) == 0x1b || ord(ch) == 0x11) {
                    if (app.getDispatcher().hasModal()) {
                        return <NcursesUi::EventResult>{"handled": False};
                    }
                    if (ord(ch) == 0x1b && menu_bar.isDropdownOpen()) {
                        menu_bar.closeMenu();
                        return <NcursesUi::EventResult>{"handled": True, "action": "close_menu"};
                    }
                    quit_dialog_shown = True;
                    return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
                }
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # Ctrl+Q with no modals open
        assertFalse(app.getDispatcher().hasModal());

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x11);  # Ctrl+Q
        app.processEvent(ev);

        assertTrue(quit_dialog_shown, "Ctrl+Q should trigger quit dialog");
    }

