# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QUnit
%include "test/TestHarness.qc"
%exec-class PresentationTest
class CaptureFailureButton inherits NcursesUi::ButtonWidget {
    constructor() : ButtonWidget("Run") {}
    nothing onMouseCaptureLost() {
        bool held = isPressed(); ButtonWidget::onMouseCaptureLost();
        if (held) { throw "CAPTURE-CANCEL-ERROR", "Cancellation callback failed"; }
    }
}
class CaptureRestoreInput inherits NcursesUi::TextInputWidget {
    public { bool reject_focus = False; }
    nothing onFocusIn() { if (reject_focus) { throw "CAPTURE-RESTORE-ERROR", "Restoration callback failed"; } }
}
class PresentationTest inherits Test {
    constructor() : Test("PresentationTest", "1.0", \ARGV) {
        addTestCase("all panel edge combinations preserve independent padding and painted bounds", \edges());
        addTestCase("panel title close target and tiny resize remain consistent", \titles());
        addTestCase("button press release feedback capture cancellation and callback failure", \button());
        addTestCase("described choices separate headings descriptions and focus from selection", \choices());
        addTestCase("native rapid mouse gestures drain before their following keyboard input", \nativeMouse());
        addTestCase("application close releases the terminal when capture cancellation throws", \captureFailure());
        addTestCase("modal removal completes when capture loss and focus restoration fail", \modalCaptureFailure());
        set_return_value(main());
    }
    captureFailure() {
        NcursesUi::TestHarness th(8, 32); on_exit th.close();
        NcursesUi::Application app(th.session()); on_exit app.close();
        CaptureFailureButton button(); button.setOnActivate(sub (string id) {}); app.setRoot(button); app.drawAll();
        app.processEvent(mouse(0, 3, Ncurses::BUTTON1_PRESSED)); assertTrue(button.isPressed());
        assertThrows("CAPTURE-CANCEL-ERROR", sub () { app.close(); });
        assertFalse(button.isPressed()); assertFalse(th.session().isOpen());
        app.getDispatcher().cancelMouseCapture();
    }
    modalCaptureFailure() {
        foreach bool remove_owned in ((False, True)) {
            foreach bool fail_restore in ((False, True)) {
                NcursesUi::TestHarness th(8, 32); on_exit th.close(); NcursesUi::Application app(th.session()); on_exit app.close();
                CaptureRestoreInput editor(); app.setRoot(editor); app.getFocusManager().setFocus(editor);
                NcursesUi::PanelWidget panel(th.session()); panel.setHasBorder(False); panel.setFrameValues(0, 0, 4, 20);
                CaptureFailureButton button(); button.setOnActivate(sub (string id) {}); button.setFrameValues(0, 0, 1, 10); panel.addChild(button);
                panel.createPanel(); on_exit panel.destroyPanel(); app.pushModal(panel); app.drawAll();
                app.processEvent(mouse(0, 3, Ncurses::BUTTON1_PRESSED)); assertTrue(button.isPressed());
                editor.reject_focus = fail_restore;
                assertThrows("CAPTURE-CANCEL-ERROR", sub () {
                    on_exit panel.destroyPanel();
                    if (remove_owned) { app.removeModal(panel); } else { app.popModal(); }
                });
                assertFalse(app.getDispatcher().hasModal()); assertNothing(panel.getWindow()); assertFalse(button.isPressed());
                assertEq(editor, app.getFocusManager().getScope());
                if (fail_restore) { assertNothing(app.getFocusManager().getCurrentFocus()); }
                else { assertEq(editor, app.getFocusManager().getCurrentFocus()); }
                app.getDispatcher().cancelMouseCapture(); assertNothing(app.popModal());
                editor.reject_focus = False; app.getFocusManager().setFocus(editor);
                app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "x"}); assertEq("x", editor.getText());
            }
        }
    }
    nativeMouse() {
        Ncurses::TestTerminal terminal(8, 32);
        Ncurses::Session session({"test_terminal": terminal, "mouse": True, "raw": True}); on_exit session.close();
        NcursesUi::Application app(session); on_exit app.close();
        NcursesUi::ButtonWidget button("Run"); int count = 0;
        button.setOnActivate(sub (string id) { ++count; }); app.setRoot(button); app.drawAll();
        foreach string ending in (("x", "界", "\eOA", "\e")) {
            terminal.writeInput("\e[<0;4;1M\e[<0;4;1m" + ending);
            hash<Ncurses::InputEvent> event = session.screen().readEvent(1000, 5);
            assertEq(Ncurses::InputType::Mouse, event.type); app.processEvent(event);
            # ncurses may deliver a composed click or separate press/release events.
            while (True) {
                event = session.screen().readEvent(1000, 5); assertTrue(!!event);
                if (event.type != Ncurses::InputType::Mouse) { break; }
                app.processEvent(event);
            }
            assertFalse(button.isPressed());
            assertEq(ending == "\eOA" ? Ncurses::InputType::Key : Ncurses::InputType::Char, event.type);
            if (ending != "\eOA") { assertEq(ending, event.ch); }
        }
        assertEq(4, count);
        terminal.writeInput("\e[<0;4;1M\e[<0;4;4mx");
        while (True) {
            hash<Ncurses::InputEvent> event = session.screen().readEvent(1000, 5); assertTrue(!!event);
            if (event.type != Ncurses::InputType::Mouse) { assertEq("x", event.ch); break; }
            app.processEvent(event);
        }
        assertFalse(button.isPressed()); assertEq(4, count);
        # Flush must discard both the keyboard FIFO and any native mouse remainder.
        terminal.writeInput("\e[<0;4;1M\e[<0;4;1mx");
        assertEq(Ncurses::InputType::Mouse, session.screen().readEvent(1000, 5).type);
        session.flushInput(); assertNothing(session.screen().readEvent(0, 1));
        session.injectInput("z"); assertEq("z", session.screen().readEvent(0, 1).ch);
        assertNothing(session.screen().readEvent(0, 1));
        # A second session has an independent native event queue.
        Ncurses::TestTerminal other_terminal(8, 32); Ncurses::Session other({"test_terminal": other_terminal}); on_exit other.close();
        other.injectInput("a"); assertEq("a", other.screen().readEvent(0, 1).ch); assertNothing(session.screen().readEvent(0, 1));
    }
    choices() {
        NcursesUi::TestHarness th(16, 60); on_exit th.close();
        NcursesUi::DescribedChoiceWidget choice((
            <NcursesUi::ChoiceItem>{"value": "preview", "label": "Preview", "description": "Inspect proposed changes.", "recommendation": "Recommended first", "default_value": True},
            <NcursesUi::ChoiceItem>{"value": "execute", "label": "Execute", "description": "Apply reviewed changes."},
            <NcursesUi::ChoiceItem>{"value": "off", "label": "Unavailable", "description": "Connect a service first.", "disabled": True}));
        choice.setFrameValues(0, 0, 16, 60); choice.setFocused(True); choice.drawTree(th.screen()); th.refresh();
        hash<Ncurses::ScreenCapture> first = th.session().capture();
        assertEq("● Preview", trim(th.screen().readText(0, 0, 20)));
        assertEq("  Inspect proposed changes.", th.screen().readText(1, 0, 27));
        assertEq(strmul(" ", 60), th.screen().readText(3, 0, 60));
        assertTrue(!!(first.cells[0].attrs & Ncurses::Attr::Bold));
        assertTrue(!!(first.cells[0].attrs & Ncurses::Attr::Reverse));
        assertFalse(!!(first.cells[60].attrs & Ncurses::Attr::Reverse));
        assertTrue(!!(first.cells[7 * 60].attrs & Ncurses::Attr::Dim));
        choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_DOWN"});
        assertEq(1, choice.getHighlightIndex()); assertEq("preview", choice.getSelection().value);
        choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": " "});
        assertEq("execute", choice.getSelection().value);
        choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_DOWN"});
        assertEq(1, choice.getHighlightIndex());
        choice.setFrameValues(0, 0, 4, 12); choice.drawTree(th.screen(), True); th.refresh();
        assertTrue(choice.getScrollY() > 0); assertTrue(join("", th.screen().readLines(0, 4, 12)).find("Execute") >= 0);
        choice.setFrameValues(0, 0, 16, 60); choice.setFocused(False); choice.drawTree(th.screen(), True); th.refresh();
        foreach hash<Ncurses::ScreenCell> cell in (th.session().capture().cells) { assertFalse(!!(cell.attrs & Ncurses::Attr::Reverse)); }
    }
    private hash<Ncurses::InputEvent> mouse(int y, int x, int state) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
            "mouse": <Ncurses::MouseEvent>{"y": y, "x": x, "button_state": state}};
    }
    button() {
        NcursesUi::TestHarness th(10, 30); on_exit th.close();
        NcursesUi::Application app(th.session()); on_exit app.close(); NcursesUi::Widget root();
        NcursesUi::ButtonWidget button("Run"); button.setFrameValues(1, 2, 1, 9); root.addChild(button);
        NcursesUi::ButtonWidget other("Other"); other.setFrameValues(3, 2, 1, 12); root.addChild(other);
        int count = 0; int other_count = 0;
        button.setOnActivate(sub (string id) { ++count; }); other.setOnActivate(sub (string id) { ++other_count; });
        app.setRoot(root); app.drawAll();
        hash<Ncurses::InputEvent> press = mouse(1, 4, Ncurses::BUTTON1_PRESSED);
        hash<Ncurses::InputEvent> release = mouse(1, 4, Ncurses::BUTTON1_RELEASED);
        app.processEvent(press); app.drawAll(); assertTrue(button.isPressed()); assertEq(0, count);
        assertEq("< Run >", th.screen().readText(1, 2, 7));
        assertTrue(!!(th.session().capture().cells[34].attrs & Ncurses::Attr::Underline));
        app.processEvent(release); app.drawAll(); assertFalse(button.isPressed()); assertEq(1, count);
        assertEq("[ Run ]", th.screen().readText(1, 2, 7));
        app.processEvent(release); assertEq(1, count);
        app.processEvent(press); app.processEvent(mouse(3, 4, Ncurses::BUTTON1_RELEASED));
        assertFalse(button.isPressed()); assertEq(1, count); assertEq(0, other_count);
        app.processEvent(press); button.setEnabled(False); app.processEvent(release);
        assertFalse(button.isPressed()); assertEq(1, count); button.setEnabled(True); app.drawAll();
        app.processEvent(press); root.removeChild(button); app.processEvent(release);
        assertFalse(button.isPressed()); assertEq(1, count); root.addChild(button); app.drawAll();
        app.processEvent(press); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        assertFalse(button.isPressed()); app.processEvent(release); assertEq(1, count);
        app.processEvent(press); app.pushModal(other); assertFalse(button.isPressed()); app.popModal();
        button.setOnActivate(sub (string id) { throw "BUTTON-RELEASE-ERROR", "retry"; });
        app.drawAll(); app.processEvent(press);
        assertThrows("BUTTON-RELEASE-ERROR", sub () { app.processEvent(release); });
        assertFalse(button.isPressed()); assertFalse(button.isBusy());
        button.setOnActivate(sub (string id) { ++count; });
        app.processEvent(mouse(1, 4, Ncurses::BUTTON1_CLICKED)); assertEq(2, count);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": " "}); assertEq(3, count);
        app.processEvent(press); app.setRoot(new NcursesUi::Widget()); assertFalse(button.isPressed());
    }
    edges() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close();
        NcursesUi::PanelWidget panel(th.session()); panel.setFrameValues(2, 3, 8, 30);
        panel.setPadding(NcursesUi::Geometry::makeInsets(1, 2, 3, 4)); panel.createPanel(); on_exit panel.destroyPanel();
        for (int mask = 0; mask <= 15; ++mask) {
            panel.setBorderEdges(mask); panel.drawTree(th.screen(), True);
            int top = mask & NcursesUi::BorderEdges::Top ? 1 : 0;
            int bottom = mask & NcursesUi::BorderEdges::Bottom ? 1 : 0;
            int left = mask & NcursesUi::BorderEdges::Left ? 1 : 0;
            int right = mask & NcursesUi::BorderEdges::Right ? 1 : 0;
            assertEq(mask, panel.getBorderEdges()); assertEq(mask != 0, panel.getHasBorder());
            assertEq(NcursesUi::Geometry::makeRect(3 + top, 6 + left, 5 - top - bottom, 23 - left - right), panel.contentRect());
            assertEq(left ? "x" : " ", panel.getWindow().readText(3, 0, 1));
            assertEq(right ? "x" : " ", panel.getWindow().readText(3, 29, 1));
            assertEq(top ? "q" : " ", panel.getWindow().readText(0, 10, 1));
            assertEq(bottom ? "q" : " ", panel.getWindow().readText(7, 10, 1));
            assertEq(top ? (left ? "l" : "q") : (left ? "x" : " "), panel.getWindow().readText(0, 0, 1));
            assertEq(bottom ? (right ? "j" : "q") : (right ? "x" : " "), panel.getWindow().readText(7, 29, 1));
        }
        panel.setHasBorder(False); assertEq(NcursesUi::Geometry::makeRect(3, 6, 5, 23), panel.contentRect());
        panel.setHasBorder(True); assertEq(NcursesUi::Geometry::makeRect(4, 7, 3, 21), panel.contentRect());
        assertThrows("PANEL-BORDER-ERROR", sub () { panel.setBorderEdges(-1); });
        assertThrows("PANEL-BORDER-ERROR", sub () { panel.setBorderEdges(16); });
        assertEq(NcursesUi::BorderEdges::All, panel.getBorderEdges());
    }
    titles() {
        NcursesUi::TestHarness th(10, 30); on_exit th.close();
        NcursesUi::PanelWidget panel(th.session(), "A long title 界é"); panel.setClosable(True);
        panel.setFrameValues(1, 2, 6, 12); panel.createPanel(); on_exit panel.destroyPanel();
        foreach int mask in ((NcursesUi::BorderEdges::All, NcursesUi::BorderEdges::Horizontal)) {
            panel.setBorderEdges(mask); panel.setCenterTitle(True); panel.drawTree(th.screen(), True);
            int x = mask == NcursesUi::BorderEdges::All ? 7 : 8;
            assertEq("[X]", panel.getWindow().readText(0, x, 3));
            assertTrue(panel.isCloseHit(2 + x, 1)); assertFalse(panel.isCloseHit(1 + x, 1));
            assertFalse(panel.isCloseHit(5 + x, 1)); assertFalse(panel.isCloseHit(2 + x, 2));
            panel.setBorderEdges(NcursesUi::BorderEdges::Bottom); assertFalse(panel.isCloseHit(2 + x, 1));
            panel.drawTree(th.screen(), True); assertEq(strmul(" ", 12), panel.getWindow().readText(0, 0, 12));
        }
        panel.setBorderEdges(NcursesUi::BorderEdges::All);
        panel.resize(NcursesUi::Geometry::makeRect(1, 2, 1, 2)); panel.drawTree(th.screen(), True);
        assertFalse(panel.isCloseHit(2, 1)); assertEq(0, panel.contentRect().rows); assertEq(0, panel.contentRect().cols);
        panel.resize(NcursesUi::Geometry::makeRect(1, 2, 6, 12)); panel.drawTree(th.screen(), True);
        assertTrue(panel.isCloseHit(9, 1));
    }
}
