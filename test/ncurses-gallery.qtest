#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesQore
%requires NcursesUi
%try-module astparser >= 3.0
%define NoAstparser
%endtry
%ifndef NoAstparser
%requires QoreRepl
%requires QUnit
%include "test/TestHarness.qc"
%include "examples/gallery/Registry.qc"
%include "examples/gallery/Catalog.qc"
%include "examples/gallery/Variants.qc"
%include "examples/gallery/CodeSupport.qc"
%include "examples/gallery/Fixture.qc"
%include "examples/gallery/Runner.qc"
%include "examples/gallery/Gallery.qc"
%exec-class GalleryTest
class CodeFocusEditor inherits NcursesUi::TextEditorWidget {
    public { bool reject_focus = False; }
    nothing onFocusIn() {
        if (reject_focus) { throw "CODE-FOCUS-ERROR", "Cannot restore focus"; }
        TextEditorWidget::onFocusIn();
    }
}
class GalleryTest inherits Test {
    constructor() : Test("GalleryTest", "1.0", \ARGV) {
        foreach hash<NcursesGallery::Story> story in (NcursesGallery::Registry::stories()) {
            addTestCase("story " + story.id, storyTest(story));
        }
        addTestCase("compact file panes and dialog retain usable content and actions", \compact());
        addTestCase("real code highlighting completion hints undo and cancellation", \codeEditor());
        addTestCase("code popup cleanup survives failing focus restoration", \codeFailure());
        addTestCase("resizing open code assistance dismisses and restores editing", \codeResize());
        addTestCase("nested gallery overlays survive assistance anchor loss", \codeNestedResize());
        addTestCase("compact content excludes panel chrome and unrelated editing cursors", \visibleContent());
        addTestCase("story selection search and errors", \registry());
        addTestCase("reset removes modal state and restores deterministic fixtures", \reset());
        addTestCase("failed callbacks propagate and cleanup permits the next story", \failure());
        addTestCase("keyboard navigation search direct selection reset help and inspection", \navigation());
        addTestCase("gallery works at constrained size and resets after resize", \geometry());
        addTestCase("reset disposes queued work and owned subscriptions", \queuedReset());
        addTestCase("assistance selected result reflects navigation filtering and cancellation", \assistanceSelection());
        addTestCase("registered geometry and equal-size device changes are respected", \deviceGeometry());
        addTestCase("nonmodal cursor follows final focus during capture and native event loops", \cursorPolicy());
        addTestCase("full application stories retain their bindings and release the embedded layout", \appRouting());
        addTestCase("interactive gallery captures evaluated output and restores streams", \galleryCapture());
        addTestCase("application gallery protects running work and keeps search shortcuts", \appBusy());
        set_return_value(main());
    }
    private code<nothing()> storyTest(hash<NcursesGallery::Story> story) { return sub () { runStory(story); }; }
    cursorPolicy() {
        Ncurses::TestTerminal terminal(24, 80); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Gallery gallery(app, "form.default"); on_exit gallery.close();
        assertEq(1, gallery.current().capture().frame.cursor.visibility);
        app.getSession().injectInput("\t\t\x11"); app.run();
        assertEq(cast<NcursesUi::FormWidget>(gallery.current().control()).getControl("enabled"), app.getFocusManager().getCurrentFocus());
        assertEq(0, app.getSession().capture().cursor.visibility);
        gallery.reset(); assertEq(1, gallery.current().capture().frame.cursor.visibility);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"});
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"});
        assertEq(0, gallery.current().capture().frame.cursor.visibility);
        gallery.select("form.loading"); assertEq(0, gallery.current().capture().frame.cursor.visibility);
        gallery.select("text-editor.disabled"); assertEq(0, gallery.current().capture().frame.cursor.visibility);
        gallery.close();
        # Removed tick callbacks must not reference the closed runner on another loop.
        app.setRoot(new NcursesUi::Widget()); app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> event) {
            app.quit(); return <NcursesUi::EventResult>{"handled": True};
        });
        app.getSession().injectInput("q"); app.run(); assertFalse(app.isRunning());
    }
    private nothing runStory(hash<NcursesGallery::Story> story) {
            Ncurses::TestTerminal terminal(story.geometry.rows, story.geometry.cols);
            Ncurses::Session session({"test_terminal": terminal}); on_exit session.close();
            NcursesUi::Application app(session); on_exit app.close();
            NcursesGallery::Runner runner(app, story.id); on_exit runner.close();
            hash<auto> initial = runner.capture("reset");
            foreach hash<NcursesGallery::Step> step in (story.steps) {
                hash<auto> frame = runner.step(); assertEq(step.checkpoint, frame.checkpoint);
                assertEq(story.id, frame.story); assertEq(frame.frame, session.capture());
                assertEq(frame.state, runner.inspect());
            }
            assertThrows("GALLERY-STEP-ERROR", sub () { runner.step(); });
            runner.reset(); assertEq(initial, runner.capture("reset"));
    }
    compact() {
        Ncurses::TestTerminal terminal(8, 30); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "file-browser.default"); on_exit runner.close();
        NcursesUi::FileBrowserWidget browser = cast<NcursesUi::FileBrowserWidget>(runner.control());
        list<NcursesUi::Widget> panes = browser.getChildren();
        assertEq(30, panes[0].getFrame().cols); assertTrue(panes[0].getFrame().rows > 0); assertEq(0, panes[1].getFrame().rows);
        hash<auto> selected = browser.getSelectedFile();
        app.processEvent(NcursesGallery::Registry::key("KEY_F(7)")); runner.capture();
        assertEq(1, browser.getFocusedPane()); assertEq(0, panes[0].getFrame().rows); assertEq(30, panes[1].getFrame().cols);
        assertTrue(panes[1].getFrame().rows > 0); assertEq(selected, browser.getSelectedFile());
        app.processEvent(NcursesGallery::Registry::key("KEY_F(7)")); runner.capture();
        assertEq(0, browser.getFocusedPane()); assertTrue(panes[0].getFrame().rows > 0);
        terminal.resize(12, 80); app.getSession().resize(12, 80); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize}); runner.capture();
        assertTrue(panes[0].getFrame().rows > 0); assertTrue(panes[1].getFrame().rows > 0);
        assertEq(selected, browser.getSelectedFile());
        foreach int width in ((40, 47, 48)) {
            terminal.resize(8, width); app.getSession().resize(8, width);
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize}); runner.capture();
            assertEq(width >= 48, panes[1].getFrame().rows > 0);
            if (width < 48) { assertEq(width, panes[0].getFrame().cols); }
        }
        runner.close();
        terminal.resize(8, 40); app.getSession().resize(8, 40);
        NcursesGallery::Runner compact_dialog(app, "dialog.default");
        NcursesGallery::Runner::verify(compact_dialog.capture(), {"contains": "preserved."});
        compact_dialog.close();
        terminal.resize(4, 24); app.getSession().resize(4, 24);
        NcursesGallery::Runner dialog(app, "dialog.default"); on_exit dialog.close();
        NcursesGallery::Runner::verify(dialog.capture(), {"contains": "Apply the reviewed"});
        NcursesGallery::Runner::verify(dialog.capture(), {"contains": "[ Apply ]"});
        app.processEvent(NcursesGallery::Registry::key("KEY_ENTER"));
        assertFalse(dialog.capture().state.modal); assertEq(1, dialog.inspect().activations);
    }
    codeEditor() {
        NcursesGallery::CodeSupport support();
        foreach string source in (("", "int answer = 42;", "# 界é\nstring name = \"value\";", "printf(\"unfinished", "throw \"DO-NOT-EXECUTE\", \"draft\";")) {
            string highlighted = support.highlight(source);
            assertEq(source, NcursesUi::TerminalText::plainAnsi(highlighted));
            if (source.find("int answer") == 0) { assertTrue(highlighted.find("\e[1;36m") >= 0); assertTrue(highlighted.find("\e[33m42") >= 0); }
        }
        assertTrue(support.hint("printf(").find("fmt") >= 0); assertEq("", support.hint(""));
        NcursesUi::EditorBuffer buffer(); buffer.setText("pri");
        NcursesUi::AssistanceModel model(buffer);
        hash<NcursesUi::AssistanceRequest> request = model.beginRequest();
        hash<NcursesUi::AssistanceResponse> response = support.complete(request);
        assertEq("print", response.completions[0].label); assertEq("printf", response.completions[1].label);
        assertEq(<NcursesUi::SourceRange>{"start": 0, "end": 3}, response.completions[1].range);
        assertTrue(model.complete(request, response)); assertTrue(model.applyCompletion("printf"));
        assertEq("printf(", buffer.getText()); buffer.undo(); assertEq("pri", buffer.getText());
        foreach hash<auto> example in (({"text": "printf", "expected": "printf("},
                {"text": "printf(\"value\")", "expected": "printf(\"value\")"},
                {"text": "printf \t (\"value\")", "expected": "printf \t (\"value\")"},
                {"text": "pri_suffix + tail", "expected": "printf( + tail"},
                {"text": "# 界é\npri_suffix", "expected": "# 界é\nprintf("})) {
            buffer.setText(example.text); int start = example.text.find("pri"); buffer.setCursor(start + 3);
            request = model.beginRequest(); response = support.complete(request);
            assertTrue(model.complete(request, response)); assertTrue(model.applyCompletion("printf"));
            assertEq(example.expected, buffer.getText()); buffer.undo(); assertEq(example.text, buffer.getText());
        }
        buffer.setText("nonexistent_unique_symbol_abc"); request = model.beginRequest(); assertEq((), support.complete(request).completions);
        Ncurses::TestTerminal terminal(20, 100); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "text-editor.code"); on_exit runner.close();
        string original = runner.inspect().text;
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); assertTrue(runner.capture().state.modal);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\e"});
        assertFalse(runner.capture().state.modal); assertEq(original, runner.inspect().text); assertEq("TextEditorWidget", runner.inspect().focus);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); runner.capture();
        NcursesUi::PanelWidget old_popup = cast<NcursesUi::PanelWidget>(app.getDispatcher().topModal());
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
            "mouse": <Ncurses::MouseEvent>{"y": 0, "x": 99, "button_state": Ncurses::BUTTON1_PRESSED}});
        assertFalse(runner.capture().state.modal); assertNothing(old_popup.getWindow());
        assertFalse(old_popup.isVisible()); assertEq("TextEditorWidget", runner.inspect().focus); assertEq(original, runner.inspect().text);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); runner.reset(); assertFalse(runner.capture().state.modal);
        terminal.resize(1, 1); app.getSession().resize(1, 1); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); runner.capture(); runner.close(); assertFalse(app.getDispatcher().hasModal());
    }
    codeResize() {
        Ncurses::TestTerminal terminal(20, 100); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "text-editor.code"); on_exit runner.close();
        string original = runner.inspect().text;
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); assertTrue(runner.capture().state.modal);
        NcursesUi::PanelWidget popup = cast<NcursesUi::PanelWidget>(app.getDispatcher().topModal());
        terminal.resize(1, 1); app.getSession().resize(1, 1); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        assertFalse(runner.capture().state.modal); assertNothing(popup.getWindow()); assertFalse(popup.isVisible());
        assertEq("TextEditorWidget", runner.inspect().focus); assertEq(original, runner.inspect().text);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "x"});
        assertEq(original + "x", runner.capture().state.text);
        terminal.resize(20, 100); app.getSession().resize(20, 100); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); assertTrue(runner.capture().state.modal);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\e"});
        assertFalse(runner.capture().state.modal); assertEq("TextEditorWidget", runner.inspect().focus);
        assertEq(original + "x", runner.inspect().text);
    }
    codeNestedResize() {
        foreach string story in (("text-editor.code", "assistance-popup.default")) {
            Ncurses::TestTerminal terminal(20, 100); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
            NcursesGallery::Gallery gallery(app, story); on_exit gallery.close();
            if (story == "text-editor.code") { app.processEvent(NcursesGallery::Registry::key("KEY_F(8)")); }
            gallery.current().capture();
            NcursesUi::PanelWidget assistance = cast<NcursesUi::PanelWidget>(app.getDispatcher().topModal());
            app.processEvent(NcursesGallery::Registry::key("KEY_F(1)"));
            NcursesUi::Widget help = app.getDispatcher().topModal();
            assertTrue(assistance != help); assertEq(2, app.getDispatcher().getModalStack().size());
            terminal.resize(1, 1); app.getSession().resize(1, 1); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
            app.drawAll(); assertEq((help,), app.getDispatcher().getModalStack());
            assertNothing(assistance.getWindow()); assertFalse(assistance.isVisible());
            assertTrue(help.containsWidget(app.getFocusManager().getCurrentFocus()));
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\e"});
            assertFalse(app.getDispatcher().hasModal());
            assertEq("TextEditorWidget", gallery.current().inspect().focus);
            string original = gallery.current().inspect().text;
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "x"});
            assertTrue(original != gallery.current().capture().state.text);
        }
    }
    visibleContent() {
        NcursesUi::TestHarness th(8, 30); on_exit th.close();
        NcursesUi::PanelWidget panel(th.session(), "Only chrome"); panel.setFrameValues(0, 0, 6, 20);
        panel.createPanel(); on_exit panel.destroyPanel(); panel.drawTree(th.screen()); th.refresh();
        hash<Ncurses::ScreenCapture> frame = th.session().capture();
        assertFalse(NcursesGallery::Runner::hasVisibleContent(panel, NOTHING, frame));
        NcursesUi::TextEditorWidget background_editor(); background_editor.setFrameValues(0, 0, 8, 30);
        frame.cursor.visibility = 1; frame.cursor.y = 2; frame.cursor.x = 2;
        assertFalse(NcursesGallery::Runner::hasVisibleContent(panel, background_editor, frame));
        assertThrows("GALLERY-EXPECTATION-ERROR", sub () {
            NcursesGallery::Runner::verify({"story": "negative", "checkpoint": "border-only",
                "state": {"visible_content": NcursesGallery::Runner::hasVisibleContent(panel, background_editor, frame)}, "frame": frame}, {"visible_content": True});
        });
        NcursesUi::LabelWidget label("Actual content"); label.setFrameValues(1, 1, 1, 16); panel.addChild(label);
        panel.drawTree(th.screen(), True); th.refresh(); assertTrue(NcursesGallery::Runner::hasVisibleContent(panel, NOTHING, th.session().capture()));
        label.setFrameValues(7, 1, 1, 16); panel.drawTree(th.screen(), True); th.refresh();
        assertFalse(NcursesGallery::Runner::hasVisibleContent(panel, NOTHING, th.session().capture()));
        panel.destroyPanel(); th.screen().erase(); background_editor.setFocused(True); background_editor.drawTree(th.screen(), True); th.refresh();
        frame = th.session().capture(); frame.cursor.visibility = 1; frame.cursor.y = 0; frame.cursor.x = 0;
        assertTrue(NcursesGallery::Runner::hasVisibleContent(background_editor, background_editor, frame));
        assertFalse(NcursesGallery::Runner::hasVisibleContent(label, background_editor, frame));
    }
    codeFailure() {
        Ncurses::TestTerminal terminal(12, 64); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        CodeFocusEditor editor(); editor.setText("pri");
        NcursesGallery::CodePreview preview(app, editor); on_exit { editor.reject_focus = False; preview.close(); }
        app.setRoot(preview); app.getFocusManager().setFocus(editor); app.drawAll(); preview.request();
        NcursesUi::PanelWidget popup = cast<NcursesUi::PanelWidget>(app.getDispatcher().topModal());
        assertTrue(!!popup.getWindow()); editor.reject_focus = True;
        assertThrows("CODE-FOCUS-ERROR", sub () { preview.close(); });
        assertFalse(app.getDispatcher().hasModal()); assertNothing(popup.getWindow());
        editor.reject_focus = False; app.getFocusManager().setFocus(editor); editor.setText("int answer = 42;"); app.drawAll();
        foreach hash<Ncurses::ScreenCell> cell in (app.getSession().capture().cells[0 .. 15]) {
            assertFalse(!!(cell.attrs & Ncurses::Attr::Bold));
        }
        preview.close(); assertEq("int answer = 42;", editor.getText());
    }
    registry() {
        assertEq("table.scrolling", NcursesGallery::Registry::search("TABLE")[0].id);
        assertEq(0, NcursesGallery::Registry::search("unmatched").size());
        hash<string, bool> widgets = {};
        foreach hash<NcursesGallery::Story> story in (NcursesGallery::Registry::search("")) { if (!story.application) { widgets{story.widget} = True; } }
        assertEq(27, widgets.size());
        list<hash<NcursesGallery::Story>> copy = NcursesGallery::Registry::stories(); copy[0].id = "changed.id";
        assertEq("text-editor.boundaries", NcursesGallery::Registry::stories()[0].id);
        assertThrows("GALLERY-STORY-ERROR", sub () { NcursesGallery::Registry::find("../bad"); });
        Ncurses::TestTerminal terminal(10, 32); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        assertThrows("GALLERY-STORY-ERROR", sub () { NcursesGallery::Runner bad(app, "unknown"); });
        assertTrue(app.getSession().isOpen());
    }
    reset() {
        Ncurses::TestTerminal terminal(10, 32); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "completion-popup.overlap"); on_exit runner.close();
        hash<auto> before = runner.step(); runner.step(); runner.step(); assertFalse(app.getDispatcher().hasModal());
        runner.reset(); assertEq(before, runner.step());
        runner.close(); runner.close(); assertFalse(app.getDispatcher().hasModal());
        assertNothing(app.getFocusManager().getCurrentFocus());
        assertThrows("GALLERY-CLOSED-ERROR", sub () { runner.capture(); });
        NcursesGallery::Runner next(app, "table.scrolling"); on_exit next.close();
        assertEq("TableWidget", next.step().state.focus);
        hash<auto> changed = next.capture(); changed.state.selected = 99;
        assertThrows("GALLERY-EXPECTATION-ERROR", sub () { NcursesGallery::Runner::verify(changed, {"selected": 0}); });
    }
    failure() {
        Ncurses::TestTerminal terminal(10, 32); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "table.scrolling"); on_exit runner.close();
        NcursesUi::TableWidget table = cast<NcursesUi::TableWidget>(runner.control());
        table.setOnSelect(sub (int index) { throw "GALLERY-CALLBACK-ERROR", string(index); });
        runner.step(); assertThrows("GALLERY-CALLBACK-ERROR", sub () { runner.step(); });
        runner.reset(); assertEq(0, runner.step().state.selected); assertEq(23, runner.step().state.selected);
        runner.close(); NcursesGallery::Gallery gallery(app, "table.scrolling");
        gallery.showNavigation(); app.close(); gallery.close(); assertNothing(gallery.navigation());
    }
    queuedReset() {
        Ncurses::TestTerminal terminal(10, 32); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "table.scrolling"); on_exit runner.close();
        int deliveries = 0;
        NcursesUi::UiEventScope scope = app.createEventScope(sub (auto payload) { ++deliveries; }, runner.control());
        on_exit scope.close();
        int tick = app.addOwnedTickCallback(sub () { ++deliveries; }, runner.control());
        assertTrue(scope.post("obsolete")); runner.reset();
        assertEq(0, app.processPending()); assertEq(0, deliveries);
        assertFalse(scope.post("late")); assertFalse(app.removeTickCallback(tick));
        assertEq(0, runner.step().state.selected);
    }
    assistanceSelection() {
        Ncurses::TestTerminal terminal(16, 64); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Runner runner(app, "assistance-popup.default"); on_exit runner.close();
        NcursesUi::AssistancePopupWidget popup = cast<NcursesUi::AssistancePopupWidget>(runner.control());
        assertEq("name", popup.getSelectedResult().id);
        app.processEvent(NcursesGallery::Registry::key("KEY_DOWN"));
        assertEq("signature", popup.getSelectedResult().kind);
        popup.setFilter("no-match"); assertEq("signature", popup.getSelectedResult().kind);
        popup.dismiss(); assertNothing(popup.getSelectedResult());
        assertEq("TextEditorWidget", runner.inspect().focus);
    }
    navigation() {
        Ncurses::TestTerminal terminal(18, 70); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Gallery gallery(app, "text-editor.boundaries"); on_exit gallery.close();
        app.processEvent(NcursesGallery::Registry::key("KEY_F(2)"));
        assertEq(gallery.navigation().query, app.getFocusManager().getCurrentFocus());
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Paste, "ch": "table.scrolling"}); app.drawAll();
        assertEq(1, gallery.navigation().choices.getItems().size());
        app.processEvent(NcursesGallery::Registry::key("KEY_ENTER")); app.drawAll();
        assertEq("table.scrolling", gallery.current().story().id); assertFalse(app.getDispatcher().hasModal());
        app.processEvent(NcursesGallery::Registry::key("KEY_END")); assertEq(23, gallery.current().inspect().selected);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(5)")); assertTrue(app.getDispatcher().hasModal());
        gallery.closeOverlay(); assertEq(23, gallery.current().inspect().selected);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(3)")); assertEq(0, gallery.current().inspect().selected);
        assertThrows("GALLERY-STORY-ERROR", sub () { gallery.select("missing"); }); assertEq("table.scrolling", gallery.current().story().id);
        foreach string command in (("KEY_F(1)", "KEY_F(6)")) {
            app.processEvent(NcursesGallery::Registry::key(command)); assertTrue(app.getDispatcher().hasModal());
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\e"}); app.drawAll();
            assertFalse(app.getDispatcher().hasModal()); assertEq("TableWidget", gallery.current().inspect().focus);
        }
        gallery.showNavigation(); app.processEvent(NcursesGallery::Registry::key("KEY_F(6)"));
        string inspection;
        foreach hash<Ncurses::ScreenCell> cell in (app.getSession().capture().cells) { inspection += cell.text; }
        assertTrue(inspection.find("Focus: TableWidget") >= 0);
        gallery.closeOverlay();
        gallery.showNavigation(); gallery.navigation().query.setText("unmatched"); gallery.navigation().filter("unmatched");
        assertEq(0, gallery.navigation().choices.getItems().size());
        app.processEvent(NcursesGallery::Registry::key("KEY_ENTER")); assertTrue(app.getDispatcher().hasModal());
        gallery.closeOverlay(); gallery.select("completion-popup.overlap");
        gallery.showNavigation(); gallery.closeOverlay(); assertEq("CompletionPopupWidget", gallery.current().inspect().focus);
        gallery.close(); assertFalse(app.getDispatcher().hasModal());
    }
    geometry() {
        Ncurses::TestTerminal terminal(8, 32); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Gallery gallery(app, "table.scrolling"); on_exit gallery.close();
        hash<auto> before = gallery.current().capture(); gallery.cycleSize(); gallery.cycleSize();
        assertEq(12, app.getSession().capture().cols); assertEq(4, app.getSession().capture().rows);
        gallery.showNavigation(); app.drawAll(); assertEq(32, app.getSession().capture().cols);
        gallery.reset(); assertEq(before, gallery.current().capture());
        gallery.cycleSize(); assertEq(32, app.getSession().screen().size().cols);
        gallery.cycleSize(); assertEq(12, app.getSession().screen().size().cols);
        terminal.resize(1, 1); terminal.resize(1, 1); app.getSession().resize(1, 1); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        gallery.showNavigation(); app.drawAll(); assertEq(1, app.getSession().capture().cells.size());
        gallery.closeOverlay(); gallery.reset(); assertEq(1, gallery.current().capture().frame.cols);
        gallery.select("text-editor.boundaries"); assertEq(1, gallery.current().capture().frame.rows);
        terminal.resize(8, 32); app.getSession().resize(8, 32); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        gallery.select("table.scrolling"); assertEq(before, gallery.current().capture());
    }
    deviceGeometry() {
        Ncurses::TestTerminal terminal(24, 80); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Gallery gallery(app, "text-editor.boundaries"); on_exit gallery.close();
        assertEq(4, gallery.current().capture().frame.rows); assertEq(8, gallery.current().capture().frame.cols);
        assertEq("initial", gallery.current().step().checkpoint);
        gallery.reset(); assertEq("initial", gallery.current().step().checkpoint);
        gallery.select("table.constrained"); assertEq(8, gallery.current().capture().frame.rows);
        assertEq(40, gallery.current().capture().frame.cols);
        gallery.cycleSize(); assertEq(40, app.getSession().screen().size().cols);
        terminal.resize(10, 40); app.getSession().resize(10, 40);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Resize});
        gallery.reset(); gallery.cycleSize(); gallery.cycleSize(); gallery.cycleSize();
        assertEq(<Ncurses::Size>{"rows": 10, "cols": 40}, app.getSession().screen().size());
        gallery.select("assistance-popup.empty");
        NcursesUi::AssistancePopupWidget popup = cast<NcursesUi::AssistancePopupWidget>(gallery.current().control());
        assertEq((), popup.getResults()); assertNothing(popup.getSelectedResult());
        assertEq(("No assistance available",), popup.getDocumentation());
    }
    galleryCapture() {
        Ncurses::TestTerminal terminal(16, 72); NcursesUi::Application app({"test_terminal": terminal}); on_exit app.close();
        NcursesGallery::Gallery gallery(app, "qrepl.default", True); on_exit gallery.close();
        foreach string ch in (("\x15", "stdout.write(\"gallery-\" + \"capture\\n\"); stderr.write(\"captured-\" + \"stderr\\n\");", "\n")) {
            if (ch.length() > 1) {
                for (int i = 0; i < ch.length(); ++i) { string character = ch.substr(i, 1); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": character}); }
            } else { app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": ch}); }
        }
        gallery.current().settle(); hash<auto> artifact = gallery.current().capture();
        string text = join("", map $1.text, artifact.frame.cells);
        assertTrue(text.find("gallery-capture") >= 0, text);
        assertTrue(text.find("captured-stderr") >= 0, text);
        assertFalse(artifact.state.evaluating); gallery.reset();
        assertFalse(join("", map $1.text, gallery.current().capture().frame.cells).find("gallery-capture") >= 0);
        gallery.select("label.default"); assertEq("LabelWidget", gallery.current().control().className());
    }
    appRouting() {
        NcursesUi::TestHarness th(20, 80); on_exit th.close(); NcursesUi::Application app(th.session());
        NcursesGallery::Gallery gallery(app, "qrepl.default"); on_exit gallery.close();
        app.processEvent(NcursesGallery::Registry::key("KEY_F(6)")); assertEq("TranscriptWidget", gallery.current().inspect().focus);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(6)")); assertEq("TextEditorWidget", gallery.current().inspect().focus);
        app.processEvent(NcursesGallery::Registry::key("KEY_F(1)")); assertTrue(app.getDispatcher().hasModal());
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\e"});
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Alt, "ch": "2"}); assertTrue(!!gallery.navigation()); gallery.closeOverlay();
        gallery.select("table.scrolling"); app.processEvent(NcursesGallery::Registry::key("KEY_END")); assertEq(23, gallery.current().inspect().selected);
        gallery.select("qrepl.completion"); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"}); assertTrue(app.getDispatcher().hasModal());
        gallery.reset(); assertFalse(app.getDispatcher().hasModal()); assertEq("pri", gallery.current().inspect().text);
        foreach string story in (("qrepl.completion", "qrepl.files", "qrepl.default")) {
            gallery.select(story);
            foreach hash<NcursesGallery::Step> step in (gallery.current().story().steps) {
                assertEq(step.checkpoint, gallery.current().step().checkpoint);
            }
        }
        assertEq("", gallery.current().inspect().text); assertFalse(gallery.current().inspect().empty);
        NcursesUi::TranscriptWidget output = cast<NcursesUi::TranscriptWidget>(app.getRoot().getChildren()[1]);
        NcursesUi::TextEditorWidget editor = cast<NcursesUi::TextEditorWidget>(app.getRoot().getChildren()[2]);
        output.clear(); assertTrue(gallery.current().inspect().empty);
        editor.setText("6 * 7"); assertFalse(gallery.current().inspect().empty);
        editor.setText(""); output.appendLine("42"); assertFalse(gallery.current().inspect().empty);
    }
    appBusy() {
        NcursesUi::TestHarness th(16, 72); on_exit th.close(); NcursesUi::Application app(th.session());
        NcursesGallery::Gallery gallery(app, "qrepl.default");
        hash<PipeInfo> gate = File::getPipe(); bool released = False;
        on_exit { if (!released) { gate.write.write("release\n"); } gallery.close(); gate.write.close(); gate.read.close(); }
        NcursesUi::TextEditorWidget editor = cast<NcursesUi::TextEditorWidget>(app.getFocusManager().getCurrentFocus());
        editor.setText("keep this draft");
        NcursesUi::TranscriptWidget output = cast<NcursesUi::TranscriptWidget>(app.getRoot().getChildren()[1]);
        output.appendLine("match one");
        for (int i = 0; i < 20; ++i) { output.appendLine("between"); }
        output.appendLine("match two"); output.setSearch("match"); output.findNext(); output.findNext();
        int last_match_scroll = output.getScrollY();
        app.processEvent(NcursesGallery::Registry::key("KEY_F(15)"));
        assertEq(editor, app.getFocusManager().getCurrentFocus()); assertEq("keep this draft", editor.getText());
        assertTrue(output.getScrollY() < last_match_scroll);
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Alt, "ch": "1"});
        string help = join("", map $1.text, gallery.current().capture().frame.cells);
        assertTrue(help.find("Alt-6 Inspect") >= 0);
        assertTrue(help.find("Escape: close this help.") >= 0);
        NcursesUi::Widget help_modal = app.getDispatcher().topModal();
        for (int fn = 1; fn <= 6; ++fn) {
            app.processEvent(NcursesGallery::Registry::key("KEY_F(" + fn + ")"));
            assertEq(help_modal, app.getDispatcher().topModal()); assertEq("keep this draft", editor.getText());
        }
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\x11"});
        assertFalse(app.getDispatcher().hasModal());
        assertThrows("GALLERY-EXPECTATION-ERROR", sub () { gallery.current().step(); });
        gallery.reset(); editor = cast<NcursesUi::TextEditorWidget>(app.getFocusManager().getCurrentFocus());
        editor.setText(sprintf("ReadOnlyFile gate(\"/proc/self/fd/%d\"); gate.readLine();", gate.read.getPollableDescriptor()));
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\n"});
        assertTrue(gallery.current().isEvaluating());
        assertThrows("GALLERY-BUSY", sub () { gallery.reset(); });
        assertThrows("GALLERY-BUSY", sub () { gallery.current().reset(); });
        assertThrows("GALLERY-BUSY", sub () { gallery.current().step(); });
        assertThrows("GALLERY-BUSY", sub () { gallery.select("label.default"); });
        assertEq("qrepl.default", gallery.current().story().id);
        foreach string shortcut in (("3", "5")) {
            app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Alt, "ch": shortcut});
            assertTrue(app.getDispatcher().hasModal());
            assertTrue(join("", map $1.text, gallery.current().capture().frame.cells).find("Evaluation is still running") >= 0);
            gallery.closeOverlay(); assertTrue(gallery.current().isEvaluating());
        }
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Alt, "ch": "2"});
        assertTrue(!!gallery.navigation()); NcursesGallery::Picker picker = gallery.navigation();
        app.processEvent(NcursesGallery::Registry::key("KEY_F(3)")); assertEq(picker, gallery.navigation());
        gallery.navigation().query.setText("label.default");
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\n"});
        assertFalse(!!gallery.navigation()); assertEq("qrepl.default", gallery.current().story().id);
        gallery.closeOverlay(); editor.setText("new draft");
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "!"});
        assertEq("new draft!", editor.getText());
        app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Alt, "ch": "4"});
        assertEq(40, gallery.current().capture().frame.cols); assertTrue(gallery.current().isEvaluating());
        gate.write.write("release\n"); released = True; gallery.current().settle();
        assertFalse(gallery.current().isEvaluating()); assertEq("new draft!", editor.getText());
        gallery.reset(); assertEq("6 * 7", gallery.current().inspect().text);
        gallery.select("label.default"); assertEq("LabelWidget", gallery.current().control().className());
    }

}

%else
throw "GALLERY-DEPENDENCY-ERROR", "Gallery code stories require astparser >= 3.0 and QoreRepl";
%endif
