#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QUnit
%include "test/TestHarness.qc"
%exec-class TableTest

class TableTest inherits Test {
    constructor() : Test("TableTest", "1.0", \ARGV) {
        addTestCase("empty row identities and resized column navigation", \reviewSelection());
        addTestCase("numeric and stable typed ordering", \numeric());
        addTestCase("null, text, date and custom ordering", \types());
        addTestCase("selected identity survives sort and refresh", \identity());
        addTestCase("filtering, empty views and row actions", \filtering());
        addTestCase("header, padding, scrolled mouse and wheel coordinates", \mouse());
        addTestCase("keyboard and primary activation variants", \activation());
        addTestCase("resize, zero area and fixed column clipping", \drawing());
        addTestCase("data and comparator errors preserve the previous view", \rollback());
        addTestCase("callback exceptions leave coherent state", \callbacks());
        addTestCase("duplicate and invalid column or row identities", \validation());
        set_return_value(main());
    }
    private NcursesUi::TableWidget table() {
        NcursesUi::TableWidget t();
        t.setFrameValues(2, 3, 4, 12);
        t.setColumns(({"key": "v", "header": "Value"},));
        return t;
    }
    private hash<Ncurses::InputEvent> key(string name) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": name};
    }
    private hash<Ncurses::InputEvent> mouseEvent(int y, int x, int buttons = Ncurses::BUTTON1_CLICKED) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
            "mouse": <Ncurses::MouseEvent>{"y": y, "x": x, "button_state": buttons}};
    }
    reviewSelection() {
        NcursesUi::TableWidget t = table(); t.setRows(({}, {"v": 1}));
        int count = 0; t.setOnActivate(sub (hash<auto> row) { assertEq({}, row); ++count; });
        t.setOnAction(sub (string action, hash<auto> row) { assertEq({}, row); ++count; });
        t.processEvent(key("KEY_ENTER")); assertTrue(t.activateAction("inspect")); assertEq(2, count);
        t.setSortColumn("v", False); assertEq({}, t.getSelectedRowData()); assertEq(1, t.getSelectedRow());
        t.setOnActivate(NOTHING); t.setOnAction(NOTHING);
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        t.setFrameValues(1, 1, 3, 20); t.setColumns(({"key": "a", "width": 8}, {"key": "b", "width": 8}));
        t.setRows(({"a": "AAAAAAAA", "b": "BBBBBBBB"},)); t.setSelectedColumn(1); t.draw(th.screen());
        t.setFrameValues(1, 1, 3, 4); t.draw(th.screen());
        assertEq("BBBB", th.screen().readText(2, 1, 4));
    }
    numeric() {
        NcursesUi::TableWidget t = table();
        t.setColumns(({"key": "v", "type": "number"},));
        t.setRows(({"v": 10.5, "id": "a"}, {"v": "2.5", "id": "b"},
            {"v": -0.5, "id": "c"}, {"v": 2, "id": "d"},
            {"v": number("2.5"), "id": "e"}, {"v": NOTHING, "id": "f"}));
        t.setSortColumn("v");
        assertEq(("f", "c", "d", "b", "e", "a"), map $1.id, t.getRows());
        t.setSortColumn("v", False);
        assertEq(("a", "b", "e", "d", "c", "f"), map $1.id, t.getRows());
        t.setColumns(({"key": "v"},));
        t.setRows(({"v": 10.5}, {"v": 2.5}, {"v": -9}, {"v": number("0.125")}));
        t.setSortColumn("v");
        assertEq((-9, number("0.125"), 2.5, 10.5), map $1.v, t.getRows());
    }
    types() {
        NcursesUi::TableWidget t = table();
        date first = 2026-01-01; date second = 2026-11-06;
        t.setRows(({"v": "Z"}, {"v": second}, {"v": 10}, {"v": NOTHING}, {"v": first}, {"v": "A"}));
        t.setSortColumn("v");
        assertEq((NOTHING, 10, first, second, "A", "Z"), map $1.v, t.getRows());
        t.setColumns(({"key": "v", "type": "string"},));
        t.setRows(({"v": 2}, {"v": 10}));
        assertEq(10, t.getRows()[0].v);
        t.setColumns(({"key": "v"},));
        t.setComparator(int sub (auto a, auto b) { return b <=> a; });
        assertEq(10, t.getRows()[0].v);
        t.setComparator(NOTHING);
        assertEq(2, t.getRows()[0].v);
        t.setRows(({"v": second}, {"v": first}));
        t.setColumns(({"key": "v", "type": "date"},));
        assertEq(first, t.getRows()[0].v);
    }
    identity() {
        NcursesUi::TableWidget t = table();
        t.setRowKey("id");
        t.setRows(({"id": "a", "v": 3}, {"id": "b", "v": 2}, {"id": "c", "v": 1}));
        list<int> events = ();
        t.setOnSelect(sub (int index) { events += index; });
        t.setSortColumn("v");
        assertEq(2, t.getSelectedRow()); assertEq("a", t.getSelectedRowData().id);
        assertEq((2,), events);
        t.setRows(({"id": "a", "v": 0}, {"id": "b", "v": 9}));
        assertEq(0, t.getSelectedRow()); assertEq("a", t.getSelectedRowData().id);
        t.setRows(({"id": "b", "v": 9},));
        assertEq("b", t.getSelectedRowData().id);
        t.setRows(()); assertEq(-1, t.getSelectedRow()); assertNothing(t.getSelectedRowData());
        assertEq((2, 0, 0, -1), events);
    }
    filtering() {
        NcursesUi::TableWidget t = table();
        t.setRows(({"v": "Alpha"}, {"v": "Beta"}, {"v": "Gamma"}));
        t.setSelectedRow(1); t.setFilter("BE");
        assertEq(({"v": "Beta"},), t.getRows());
        string action; string value;
        t.setOnAction(sub (string id, hash<auto> row) { action = id; value = row.v; });
        assertTrue(t.activateAction("inspect")); assertEq("inspect", action); assertEq("Beta", value);
        t.setFilter("missing"); assertEq(-1, t.getSelectedRow()); assertFalse(t.activateAction("inspect"));
        assertFalse(t.processEvent(key("KEY_DOWN")).handled);
        t.setFilter(""); assertEq(0, t.getSelectedRow()); assertEq(3, t.getRows().size());
        t.setOnAction(NOTHING); assertFalse(t.activateAction("inspect"));
    }
    mouse() {
        NcursesUi::TableWidget t = table();
        t.setRows(({"v": 0}, {"v": 1}, {"v": 2}, {"v": 3}, {"v": 4}, {"v": 5}));
        list<int> events = (); t.setOnSelect(sub (int i) { events += i; });
        assertFalse(t.processEvent(mouseEvent(2, 4)).handled);
        assertFalse(t.processEvent(mouseEvent(4, 2)).handled);
        assertTrue(t.processEvent(mouseEvent(4, 4)).handled); assertEq(1, t.getSelectedRow());
        t.processEvent(key("KEY_END")); assertEq(5, t.getSelectedRow());
        t.processEvent(mouseEvent(3, 4)); assertEq(3, t.getSelectedRow());
        t.processEvent(mouseEvent(3, 4, Ncurses::BUTTON5_PRESSED)); assertEq(4, t.getSelectedRow());
        t.processEvent(mouseEvent(3, 4, Ncurses::BUTTON4_PRESSED)); assertEq(3, t.getSelectedRow());
        assertEq((1, 5, 3, 4, 3), events);
        t.setShowHeader(False); t.setSelectedRow(0);
        t.processEvent(mouseEvent(3, 4)); assertEq(1, t.getSelectedRow());
        t.setPadding(NcursesUi::Geometry::makeInsets(1, 1, 1, 1));
        assertFalse(t.processEvent(mouseEvent(2, 3)).handled);
        t.processEvent(mouseEvent(4, 4)); assertEq(1, t.getSelectedRow());
        t.setEnabled(False); assertFalse(t.processEvent(mouseEvent(3, 4)).handled);
    }
    activation() {
        NcursesUi::TableWidget t = table(); t.setRows(({"v": 1},));
        int count = 0; t.setOnActivate(sub (hash<auto> row) { assertEq(1, row.v); ++count; });
        assertEq("activate", t.processEvent(key("KEY_ENTER")).action);
        foreach string ch in (("\r", "\n")) {
            assertEq("activate", t.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": ch}).action);
        }
        assertEq("activate", t.processEvent(mouseEvent(3, 4, Ncurses::BUTTON1_DOUBLE_CLICKED)).action);
        assertEq(4, count);
        assertTrue(t.processEvent(mouseEvent(3, 4, Ncurses::BUTTON1_TRIPLE_CLICKED)).handled);
        assertTrue(t.processEvent(mouseEvent(3, 4, Ncurses::BUTTON1_PRESSED)).handled);
        assertEq(4, count);
    }
    drawing() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close();
        NcursesUi::TableWidget t = table();
        t.setColumns(({"key": "a", "header": "First", "width": 8}, {"key": "b", "header": "Second", "width": 8}));
        t.setRows(({"a": "abcdefgh", "b": "ijklmnop"},));
        th.screen().drawText(3, 0, strmul(".", 30));
        t.draw(th.screen()); assertEq("abcdefghijkl", th.screen().readText(3, 3, 12));
        assertEq("...", th.screen().readText(3, 15, 3));
        t.processEvent(key("KEY_RIGHT")); t.draw(th.screen());
        assertEq(1, t.getSelectedColumn()); assertEq("efghijklmnop", th.screen().readText(3, 3, 12));
        t.setFrameValues(2, 3, 1, 3); t.setSelectedColumn(1); t.draw(th.screen());
        assertEq("Sec", th.screen().readText(2, 3, 3));
        t.setFrameValues(2, 3, 0, 0); t.draw(th.screen());
        assertFalse(t.processEvent(mouseEvent(2, 3)).handled);
        t.setFrameValues(2, 3, 4, 20); t.draw(th.screen());
        assertEq("abcdefghijklmnop", th.screen().readText(3, 3, 16));
        t.setRows(()); t.draw(th.screen()); assertEq(strmul(" ", 20), th.screen().readText(3, 3, 20));
    }
    rollback() {
        NcursesUi::TableWidget t = table(); t.setColumns(({"key": "v", "type": "number"},));
        t.setRows(({"v": 2}, {"v": 1})); t.setSortColumn("v");
        assertThrows("TABLE-VALUE-ERROR", sub () { t.setRows(({"v": "x"},)); });
        assertEq((1, 2), map $1.v, t.getRows());
        assertThrows("TEST-COMPARATOR", sub () {
            t.setComparator(int sub (auto a, auto b) { throw "TEST-COMPARATOR", "fail"; });
        });
        t.setSortColumn("v", False); assertEq(2, t.getRows()[0].v);
        assertThrows("TABLE-UPDATE-ERROR", sub () {
            t.setComparator(int sub (auto a, auto b) { t.setRows(()); return 0; });
        });
        assertEq((2, 1), map $1.v, t.getRows());
        t.setSortColumn("v"); assertEq(1, t.getRows()[0].v);
        assertThrows("TABLE-VALUE-ERROR", sub () { t.setColumns(({"key": "v", "type": "date"},)); });
        assertEq("number", t.getColumns()[0].type);
        assertThrows("TABLE-COLUMN-ERROR", sub () { t.setSortColumn("absent"); });
        assertEq(1, t.getRows()[0].v);
    }
    callbacks() {
        NcursesUi::TableWidget t = table(); t.setRows(({"v": 1}, {"v": 2}));
        t.setOnSelect(sub (int i) { throw "TEST-CALLBACK", "fail"; });
        assertThrows("TEST-CALLBACK", sub () { t.setSelectedRow(1); });
        assertEq(1, t.getSelectedRow());
        assertThrows("TEST-CALLBACK", sub () { t.setFilter("absent"); });
        assertEq(-1, t.getSelectedRow()); assertEq("absent", t.getFilter());
        t.setOnSelect(NOTHING); t.setFilter(""); assertEq(2, t.getRows().size());
        t.setOnActivate(sub (hash<auto> row) { throw "TEST-CALLBACK", "fail"; });
        assertThrows("TEST-CALLBACK", sub () { t.processEvent(key("KEY_ENTER")); });
        assertEq(0, t.getSelectedRow());
        t.setOnAction(sub (string id, hash<auto> row) { throw "TEST-CALLBACK", "fail"; });
        assertThrows("TEST-CALLBACK", sub () { t.activateAction("inspect"); });
    }
    validation() {
        NcursesUi::TableWidget t = table(); t.setRowKey("id");
        t.setRows(({"id": "a", "v": 1},));
        assertThrows("TABLE-IDENTITY-ERROR", sub () { t.setRows(({"id": "a"}, {"id": "a"})); });
        assertThrows("TABLE-IDENTITY-ERROR", sub () { t.setRows(({"v": 2},)); });
        assertThrows("TABLE-IDENTITY-ERROR", sub () { t.setRows(({"id": (1, 2)},)); });
        assertEq("a", t.getSelectedRowData().id);
        assertThrows("TABLE-COLUMN-ERROR", sub () { t.setColumns(({"key": "v"}, {"key": "v"})); });
        assertThrows("TABLE-COLUMN-ERROR", sub () { t.setColumns(({"key": "v", "width": -1},)); });
        assertThrows("TABLE-COLUMN-ERROR", sub () { t.setColumns(({"key": "v", "type": "invalid"},)); });
        assertEq(1, t.getColumns().size());
        assertThrows("TABLE-IDENTITY-ERROR", sub () { t.setRowKey(""); });
        t.setRowKey(NOTHING); t.setRows(({"v": 1}, {"v": 2})); t.setSelectedRow(1);
        t.setSortColumn("v", False); assertEq(2, t.getSelectedRowData().v); assertEq(0, t.getSelectedRow());
        t.setColumns(()); assertEq((1, 2), map $1.v, t.getRows());
        assertEq(1, t.getSelectedRow());
    }
}
