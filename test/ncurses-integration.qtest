    /** Test that a dropdown panel window contains actual menu item text after drawAll(). */
    testDropdownPanelRendersContent() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
            {"label": "Save As", "command": "save_as"},
            {"label": "Quit", "command": "quit"},
        ));

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open the File menu dropdown
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertTrue(app.getDispatcher().hasModal());

        # draw everything (this is where the bug was: modal not drawn -> blank panel)
        app.drawAll();

        # get the dropdown's panel window and verify menu item text is rendered
        list<NcursesUi::Widget> modals = app.getDispatcher().getModalStack();
        assertEq(1, modals.size());
        NcursesUi::DropdownMenuWidget dd = modals[0];
        *Ncurses::Window pw = dd.getWindow();
        assertTrue(exists pw);

        # read the full panel window content
        hash<Ncurses::Size> sz = pw.size();
        string all_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            all_text += pw.readText(r, 0, sz.cols);
        }

        # verify actual menu item labels appear in the panel (not blank)
        assertTrue(all_text.find("Open") >= 0,
            "dropdown panel should contain 'Open' but got: " + all_text);
        assertTrue(all_text.find("Save As") >= 0,
            "dropdown panel should contain 'Save As' but got: " + all_text);
        assertTrue(all_text.find("Quit") >= 0,
            "dropdown panel should contain 'Quit' but got: " + all_text);

        # navigate down to "Save As" and verify highlight moves
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        assertEq(1, dd.getHighlightIndex());

        # select via Enter and verify command fires
        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("save_as", fired_cmd);
        assertFalse(menu.isDropdownOpen());
    }

    /** Test that a dialog panel window renders message text and button labels. */
    testDialogPanelRendersContent() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        app.setRoot(root);

        # create a confirmation dialog
        NcursesUi::DialogWidget dlg(th.session(), "Confirm Delete",
            "Are you sure you want to delete this file?\nThis cannot be undone.",
            ("Delete", "Cancel"));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        app.pushModal(dlg);

        # draw
        app.drawAll();

        # read the dialog's panel window
        *Ncurses::Window pw = dlg.getWindow();
        assertTrue(exists pw);

        hash<Ncurses::Size> sz = pw.size();
        string all_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            all_text += pw.readText(r, 0, sz.cols);
        }

        # verify title, message, and button labels
        assertTrue(all_text.find("Confirm Delete") >= 0,
            "dialog should contain title 'Confirm Delete' but got: " + all_text);
        assertTrue(all_text.find("Are you sure") >= 0,
            "dialog should contain message text but got: " + all_text);
        assertTrue(all_text.find("cannot be undone") >= 0,
            "dialog should contain second line but got: " + all_text);
        assertTrue(all_text.find("Delete") >= 0,
            "dialog should contain 'Delete' button but got: " + all_text);
        assertTrue(all_text.find("Cancel") >= 0,
            "dialog should contain 'Cancel' button but got: " + all_text);

        # Tab to Cancel button, verify focus moves
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        app.processEvent(ev);
        assertEq(1, dlg.getFocusedButton());

        # press Enter on Cancel
        int pressed_idx = -1;
        string pressed_label;
        dlg.setOnButton(sub (int idx, string label) {
            pressed_idx = idx;
            pressed_label = label;
        });
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq(1, pressed_idx);
        assertEq("Cancel", pressed_label);

        # clean up
        app.popModal();
        dlg.destroyPanel();
    }

    /** Test EventDispatcher getModalStack returns correct stack. */
    testGetModalStack() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        app.setRoot(root);
        NcursesUi::EventDispatcher disp = app.getDispatcher();

        # empty initially
        assertEq(0, disp.getModalStack().size());

        # push a modal
        NcursesUi::DialogWidget dlg1(th.session(), "Dlg1", "msg1");
        dlg1.centerOn(24, 80);
        app.pushModal(dlg1);
        assertEq(1, disp.getModalStack().size());

        # push another
        NcursesUi::DialogWidget dlg2(th.session(), "Dlg2", "msg2");
        dlg2.centerOn(24, 80);
        app.pushModal(dlg2);
        assertEq(2, disp.getModalStack().size());

        # pop
        app.popModal();
        assertEq(1, disp.getModalStack().size());

        app.popModal();
        assertEq(0, disp.getModalStack().size());
    }

