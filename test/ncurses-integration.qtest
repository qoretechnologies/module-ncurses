    testMultiWidgetEventRouting() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::TextInputWidget input_w(">>> ");
        NcursesUi::ListWidget list_w();
        list_w.setItems((
            {"label": "Item A"},
            {"label": "Item B"},
        ));

        root.addChild(input_w);
        root.addChild(list_w);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # focus input, type
        app.getFocusManager().setFocus(input_w);
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "x";
        app.processEvent(ev);
        assertEq("x", input_w.getText());
        # list should not have changed
        assertEq(0, list_w.getSelectedIndex());

        # tab to list
        ev.ch = "\t";
        app.processEvent(ev);
        assertTrue(app.getFocusManager().getCurrentFocus() == list_w);

        # navigate list
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        assertEq(1, list_w.getSelectedIndex());
        # input should not have changed
        assertEq("x", input_w.getText());
    }

    /** Test that drawAll() draws modal widgets from the modal stack. */
    testModalDrawnInDrawAll() {
