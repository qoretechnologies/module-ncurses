        # scroll to end
        sw.scrollTo(NcursesUi::ScrollDirection::End);
        sw.draw(th.session().screen());
        th.session().doupdate();
        row0 = th.session().screen().readText(0, 0, 20);
        assertTrue(row0.find("Line 15") >= 0);
    }

