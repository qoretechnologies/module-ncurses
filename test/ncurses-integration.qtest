    /** Test full REPL-like layout renders all components visually. */
    testFullReplLayoutRendering() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        # menu bar
        NcursesUi::MenuBarWidget menu();
        menu.addMenu("File", ({"label": "Quit", "command": "quit"},));
        menu.addMenu("Help", ({"label": "About", "command": "about"},));
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);

        # output area
        NcursesUi::ScrollableWidget output();
        NcursesUi::LineListContent output_content();
        output_content.appendLine("Welcome to the REPL");
        output_content.appendLine("Type expressions to evaluate");
        output.setContent(output_content);
        output.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        # input
        NcursesUi::TextInputWidget input_widget("qore> ");
        input_widget.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        input_widget.setPreferredSize(1, 0);

        # status bar
        NcursesUi::StatusBarWidget status();
        status.setSegments((
            {"text": "Ready"},
            {"text": "Mouse:ON"},
            {"text": "14:30:00", "align": "right"},
        ));
        status.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        status.setPreferredSize(1, 0);

        root.addChild(menu);
        root.addChild(output);
        root.addChild(input_widget);
        root.addChild(status);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        app.drawAll();

        Ncurses::Window scr = th.session().screen();

        # verify menu bar renders with both labels
        string menu_row = scr.readText(0, 0, 80);
        assertTrue(menu_row.find("File") >= 0, "menu bar should show 'File'");
        assertTrue(menu_row.find("Help") >= 0, "menu bar should show 'Help'");

        # verify output area renders welcome text
        string out_row1 = scr.readText(1, 0, 80);
        assertTrue(out_row1.find("Welcome to the REPL") >= 0,
            "output should show welcome text but got: " + out_row1);

        # verify input prompt renders
        string input_row = scr.readText(22, 0, 80);
        assertTrue(input_row.find("qore>") >= 0,
            "input should show prompt but got: " + input_row);

        # verify status bar renders all segments with spacing
        string status_row = scr.readText(23, 0, 80);
        assertTrue(status_row.find("Ready") >= 0, "status bar should show 'Ready'");
        assertTrue(status_row.find("Mouse:ON") >= 0, "status bar should show 'Mouse:ON'");
        assertTrue(status_row.find("14:30:00") >= 0, "status bar should show time");

        # verify spacing: "Ready" and "Mouse:ON" should not be adjacent
        int ready_end = status_row.find("Ready") + 5;
        int mouse_start = status_row.find("Mouse:ON");
        assertTrue(mouse_start > ready_end,
            sprintf("segments should have spacing: Ready ends at %d, Mouse:ON at %d",
                ready_end, mouse_start));
    }

    /** Test dropdown navigation updates highlight visually. */
    testDropdownNavigationVisual() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("Actions", (
            {"label": "Run", "command": "run"},
            {"label": "Debug", "command": "debug"},
            {"label": "Profile", "command": "profile"},
        ));

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open the menu
        menu.openMenu(0);
        app.drawAll();

        # get dropdown reference
        list<NcursesUi::Widget> modals = app.getDispatcher().getModalStack();
        assertEq(1, modals.size());
        NcursesUi::DropdownMenuWidget dd = modals[0];

        # initial highlight should be on "Run" (index 0)
        assertEq(0, dd.getHighlightIndex());

        # verify all items rendered
        *Ncurses::Window pw = dd.getWindow();
        assertTrue(exists pw);
        hash<Ncurses::Size> sz = pw.size();
        string all_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            all_text += pw.readText(r, 0, sz.cols);
        }
        assertTrue(all_text.find("Run") >= 0);
        assertTrue(all_text.find("Debug") >= 0);
        assertTrue(all_text.find("Profile") >= 0);

        # navigate down twice to "Profile"
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        assertEq(1, dd.getHighlightIndex());
        app.processEvent(ev);
        assertEq(2, dd.getHighlightIndex());

        # navigate back up to "Debug"
        ev.name = "KEY_UP";
        app.processEvent(ev);
        assertEq(1, dd.getHighlightIndex());

        # select "Debug" via Enter
        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("debug", fired_cmd);
        assertFalse(menu.isDropdownOpen());
        assertFalse(app.getDispatcher().hasModal());
    }

    /** Test Escape closes dropdown and removes panel visually. */
    testEscapeClosesDropdownVisual() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
        ));

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # open dropdown
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertTrue(app.getDispatcher().hasModal());

        # draw - dropdown should appear
        app.drawAll();

        # verify dropdown content is rendered
        list<NcursesUi::Widget> modals = app.getDispatcher().getModalStack();
        NcursesUi::DropdownMenuWidget dd = modals[0];
        *Ncurses::Window pw = dd.getWindow();
        assertTrue(exists pw);

        # Escape via the dropdown (modal dispatches to it)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        # dropdown should be closed
        assertFalse(menu.isDropdownOpen());
        assertFalse(app.getDispatcher().hasModal());

        # draw again - dropdown panel should be gone
        app.drawAll();

        # verify the screen area where dropdown was is now clear
        # (just the menu bar at row 0, rest should be empty)
        string row2 = th.session().screen().readText(2, 0, 20);
        # should NOT contain "Open" on the screen anymore
        assertFalse(row2.find("Open") >= 0,
            "dropdown should be gone but row 2 still shows: " + row2);
    }

    /** Test Escape with no modal/dropdown shows quit dialog visually. */
    testEscapeShowsQuitDialogVisual() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # simulate the qrepl escape handler that shows a quit dialog
        *NcursesUi::DialogWidget quit_dlg;
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                if (menu.isDropdownOpen()) {
                    menu.closeMenu();
                    return <NcursesUi::EventResult>{"handled": True};
                }
                # show quit dialog
                quit_dlg = NcursesUi::DialogWidget::confirm(
                    th.session(), "Quit", "Exit the REPL?",
                    sub (int idx, string label) {
                        if (idx == 0) {
                            app.popModal();
                            quit_dlg.destroyPanel();
                            app.quit();
                        } else {
                            app.popModal();
                            quit_dlg.destroyPanel();
                        }
                    });
                quit_dlg.setOnDismiss(sub () {
                    app.popModal();
                    quit_dlg.destroyPanel();
                });
                quit_dlg.centerOn(24, 80);
                quit_dlg.createPanel();
                app.pushModal(quit_dlg);
                return <NcursesUi::EventResult>{"handled": True};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        # press Escape with nothing open
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        # quit dialog should be shown
        assertTrue(app.getDispatcher().hasModal());
        assertTrue(exists quit_dlg);

        # draw and verify dialog content
        app.drawAll();

        *Ncurses::Window pw = quit_dlg.getWindow();
        assertTrue(exists pw);
        hash<Ncurses::Size> sz = pw.size();
        string all_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            all_text += pw.readText(r, 0, sz.cols);
        }
        assertTrue(all_text.find("Quit") >= 0,
            "quit dialog should show title but got: " + all_text);
        assertTrue(all_text.find("Exit the REPL") >= 0,
            "quit dialog should show message but got: " + all_text);
        assertTrue(all_text.find("OK") >= 0,
            "quit dialog should show OK button but got: " + all_text);
        assertTrue(all_text.find("Cancel") >= 0,
            "quit dialog should show Cancel button but got: " + all_text);

        # press Escape on the dialog to dismiss it
        app.processEvent(ev);

        # dialog should be gone (on_dismiss pops the modal)
        # Note: DialogWidget returns action "dismiss" on Escape but doesn't auto-pop
        # The global handler passes through to modal, which is the dialog
        # Dialog's processEvent returns {handled: True, action: "dismiss"}
        # We need to verify the dialog handled it
        assertFalse(app.getDispatcher().hasModal());

        # press Escape again - should show a new quit dialog
        app.processEvent(ev);
        assertTrue(app.getDispatcher().hasModal());

        # this time press Enter on OK to quit
        ev.ch = "\n";
        app.processEvent(ev);
        assertFalse(app.isRunning());
    }

    /** Test stacked modals render in correct order. */
    testStackedModalsRender() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        app.setRoot(root);

        # first dialog
        NcursesUi::DialogWidget dlg1(th.session(), "First Dialog", "First message", ("OK",));
        dlg1.centerOn(24, 80);
        dlg1.createPanel();
        app.pushModal(dlg1);

        # second dialog (smaller, on top)
        NcursesUi::DialogWidget dlg2(th.session(), "Second Dialog", "Second message", ("Yes", "No"));
        dlg2.setFrame(NcursesUi::Geometry::makeRect(2, 2, 7, 30));
        dlg2.createPanel();
        app.pushModal(dlg2);

        # draw everything
        app.drawAll();

        # both panel windows should have content
        *Ncurses::Window pw1 = dlg1.getWindow();
        *Ncurses::Window pw2 = dlg2.getWindow();
        assertTrue(exists pw1);
        assertTrue(exists pw2);

        # verify first dialog content
        hash<Ncurses::Size> sz1 = pw1.size();
        string text1 = "";
        for (int r = 0; r < sz1.rows; ++r) {
            text1 += pw1.readText(r, 0, sz1.cols);
        }
        assertTrue(text1.find("First Dialog") >= 0);
        assertTrue(text1.find("First message") >= 0);

        # verify second dialog content
        hash<Ncurses::Size> sz2 = pw2.size();
        string text2 = "";
        for (int r = 0; r < sz2.rows; ++r) {
            text2 += pw2.readText(r, 0, sz2.cols);
        }
        assertTrue(text2.find("Second Dialog") >= 0);
        assertTrue(text2.find("Second message") >= 0);
        assertTrue(text2.find("Yes") >= 0);
        assertTrue(text2.find("No") >= 0);

        # events should go to the topmost modal (dlg2)
        assertEq(2, app.getDispatcher().getModalStack().size());
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        app.processEvent(ev);
        # dlg2 should have button focus moved
        assertEq(1, dlg2.getFocusedButton());
        # dlg1 should be unchanged
        assertEq(0, dlg1.getFocusedButton());

        # clean up
        app.popModal();
        dlg2.destroyPanel();
        app.popModal();
        dlg1.destroyPanel();
    }

    /** Test MenuBar renders multiple menu labels at correct positions. */
    testMenuBarRendersLabels() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.addMenu("File", ({"label": "New", "command": "new"},));
        menu.addMenu("Edit", ({"label": "Copy", "command": "copy"},));
        menu.addMenu("View", ({"label": "Zoom", "command": "zoom"},));
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        app.drawAll();

        string menu_row = th.session().screen().readText(0, 0, 80);
        assertTrue(menu_row.find("File") >= 0);
        assertTrue(menu_row.find("Edit") >= 0);
        assertTrue(menu_row.find("View") >= 0);

        # verify order: File < Edit < View
        int file_pos = menu_row.find("File");
        int edit_pos = menu_row.find("Edit");
        int view_pos = menu_row.find("View");
        assertTrue(file_pos < edit_pos, "File should appear before Edit");
        assertTrue(edit_pos < view_pos, "Edit should appear before View");
    }

    /** Test StatusBar renders spaced segments in a full app. */
    testStatusBarRendersInApp() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::StatusBarWidget sb();
        sb.setSegments((
            {"text": "Ready"},
            {"text": "Ln 42"},
            {"text": "Col 7"},
            {"text": "UTF-8", "align": "right"},
            {"text": "LF", "align": "right"},
        ));
        sb.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        sb.setPreferredSize(1, 0);

        root.addChild(sb);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        app.drawAll();

        # status bar on first row since it's the only child
        string row = th.session().screen().readText(0, 0, 80);
        assertTrue(row.find("Ready") >= 0);
        assertTrue(row.find("Ln 42") >= 0);
        assertTrue(row.find("Col 7") >= 0);
        assertTrue(row.find("UTF-8") >= 0);
        assertTrue(row.find("LF") >= 0);

        # verify left segments are spaced
        int ready_end = row.find("Ready") + 5;
        int ln_start = row.find("Ln 42");
        assertTrue(ln_start > ready_end,
            sprintf("Ready (end %d) should have spacing before Ln 42 (start %d)", ready_end, ln_start));

        int ln_end = row.find("Ln 42") + 5;
        int col_start = row.find("Col 7");
        assertTrue(col_start > ln_end,
            sprintf("Ln 42 (end %d) should have spacing before Col 7 (start %d)", ln_end, col_start));

        # verify right segments are at the right end
        int utf8_pos = row.find("UTF-8");
        int lf_pos = row.find("LF");
        assertTrue(utf8_pos < lf_pos, "UTF-8 should be left of LF");
        assertTrue(lf_pos > 70, sprintf("LF should be near right edge but at %d", lf_pos));
    }

    /** Test TableWidget renders headers and data rows visually. */
    testTableRendersVisually() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::TableWidget tw();
        tw.setColumns((
            {"key": "name", "header": "Name"},
            {"key": "size", "header": "Size", "width": 10},
        ));
        tw.setRows((
            {"name": "hello.q", "size": "1.2K"},
            {"name": "world.q", "size": "3.4K"},
        ));

        app.setRoot(tw);
        app.drawAll();

        Ncurses::Window scr = th.session().screen();

        # header row
        string header = scr.readText(0, 0, 80);
        assertTrue(header.find("Name") >= 0, "table should render 'Name' header");
        assertTrue(header.find("Size") >= 0, "table should render 'Size' header");

        # data rows
        string row1 = scr.readText(1, 0, 80);
        assertTrue(row1.find("hello.q") >= 0, "table should render first row");
        string row2 = scr.readText(2, 0, 80);
        assertTrue(row2.find("world.q") >= 0, "table should render second row");
    }

    /** Test TextInputWidget renders prompt and typed text in a full app. */
    testTextInputRendersVisually() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::TextInputWidget ti(">>> ");
        ti.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        ti.setPreferredSize(1, 0);

        NcursesUi::Widget root();
        root.addChild(ti);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(ti);

        # type some text
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        foreach string ch in (("p", "r", "i", "n", "t", "(", "4", "2", ")")) {
            ev.ch = ch;
            app.processEvent(ev);
        }

        app.drawAll();

        string row = th.session().screen().readText(0, 0, 40);
        assertTrue(row.find(">>>") >= 0, "should show prompt but got: " + row);
        assertTrue(row.find("print(42)") >= 0, "should show typed text but got: " + row);
    }

    /** Test ListWidget renders selected item with highlight. */
    testListRendersSelection() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::ListWidget lw();
        lw.setItems((
            {"label": "Apple"},
            {"label": "Banana"},
            {"label": "Cherry"},
            {"label": "Date"},
        ));

        app.setRoot(lw);
        app.getFocusManager().setFocus(lw);

        # move to "Cherry" (index 2)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        app.processEvent(ev);
        assertEq(2, lw.getSelectedIndex());

        app.drawAll();

        Ncurses::Window scr = th.session().screen();

        # all items should be visible
        string row0 = scr.readText(0, 0, 40);
        assertTrue(row0.find("Apple") >= 0);
        string row1 = scr.readText(1, 0, 40);
        assertTrue(row1.find("Banana") >= 0);
        string row2 = scr.readText(2, 0, 40);
        assertTrue(row2.find("Cherry") >= 0);
        string row3 = scr.readText(3, 0, 40);
        assertTrue(row3.find("Date") >= 0);
    }

    /** Test CheckboxWidget renders toggle state in a full app. */
    testCheckboxRendersInApp() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::CheckboxWidget cb1("Enable Debug", False);
        NcursesUi::CheckboxWidget cb2("Verbose Output", True);
        cb1.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        cb1.setPreferredSize(1, 0);
        cb2.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        cb2.setPreferredSize(1, 0);

        root.addChild(cb1);
        root.addChild(cb2);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        app.drawAll();

        Ncurses::Window scr = th.session().screen();

        string row0 = scr.readText(0, 0, 40);
        assertTrue(row0.find("[ ]") >= 0, "unchecked should show [ ] but got: " + row0);
        assertTrue(row0.find("Enable Debug") >= 0);

        string row1 = scr.readText(1, 0, 40);
        assertTrue(row1.find("[X]") >= 0, "checked should show [X] but got: " + row1);
        assertTrue(row1.find("Verbose Output") >= 0);

        # toggle cb1 via keyboard
        app.getFocusManager().setFocus(cb1);
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        app.processEvent(ev);
        assertTrue(cb1.isChecked());

        app.drawAll();

        row0 = scr.readText(0, 0, 40);
        assertTrue(row0.find("[X]") >= 0, "toggled should show [X] but got: " + row0);
    }

    /** Test clicking outside a dropdown closes it. */
    testClickOutsideDropdownCloses() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
        ));

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # open dropdown
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertTrue(app.getDispatcher().hasModal());

        app.drawAll();

        # click in empty area (row 10, col 40 - well outside dropdown)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.y = 10;
        mouse.x = 40;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;
        app.processEvent(ev);

        # dropdown should be closed
        assertFalse(menu.isDropdownOpen(),
            "clicking outside dropdown should close it");
        assertFalse(app.getDispatcher().hasModal(),
            "modal should be removed after click outside");
    }

    /** Test clicking another menu item while dropdown is open switches to that menu. */
    testClickAnotherMenuSwitchesDropdown() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
        ));
        menu.addMenu("Edit", (
            {"label": "Copy", "command": "copy"},
        ));
        menu.addMenu("Help", (
            {"label": "About", "command": "about"},
        ));

        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open File menu
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertEq(0, menu.getActiveMenu());
        assertTrue(app.getDispatcher().hasModal());

        app.drawAll();

        # verify dropdown content shows "Open"
        list<NcursesUi::Widget> modals = app.getDispatcher().getModalStack();
        assertEq(1, modals.size());
        NcursesUi::DropdownMenuWidget dd1 = modals[0];
        *Ncurses::Window pw = dd1.getWindow();
        assertTrue(exists pw);
        hash<Ncurses::Size> sz = pw.size();
        string dd1_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            dd1_text += pw.readText(r, 0, sz.cols);
        }
        assertTrue(dd1_text.find("Open") >= 0, "File dropdown should show 'Open'");

        # now click on "Edit" menu label (row 0, x = position of Edit label)
        # "File" = " File " = 6 chars, "Edit" starts at x=6
        int edit_x = menu.menuXPosition(1) + 1;  # +1 for the space before label
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.y = 0;
        mouse.x = edit_x;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;
        app.processEvent(ev);

        # the File dropdown should close and Edit should open
        assertTrue(menu.isDropdownOpen(),
            "Edit dropdown should now be open");
        assertEq(1, menu.getActiveMenu(),
            "active menu should be Edit (index 1)");
        assertTrue(app.getDispatcher().hasModal(),
            "should have a modal for Edit dropdown");

        # draw and verify the Edit dropdown content
        app.drawAll();

        modals = app.getDispatcher().getModalStack();
        assertEq(1, modals.size());
        NcursesUi::DropdownMenuWidget dd2 = modals[0];
        pw = dd2.getWindow();
        assertTrue(exists pw);
        sz = pw.size();
        string dd2_text = "";
        for (int r = 0; r < sz.rows; ++r) {
            dd2_text += pw.readText(r, 0, sz.cols);
        }
        assertTrue(dd2_text.find("Copy") >= 0,
            "Edit dropdown should show 'Copy' but got: " + dd2_text);

        # select the item
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("copy", fired_cmd);
        assertFalse(menu.isDropdownOpen());
    }

    /** Test Escape closes dropdown via modal event dispatch. */
    testEscapeClosesDropdownViaModal() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));

        # set up a global key handler similar to qrepl
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            if (ev.type == Ncurses::InputType::Char && ord(ev.ch ?? "") == 0x1b) {
                if (app.getDispatcher().hasModal()) {
                    return <NcursesUi::EventResult>{"handled": False};
                }
                if (menu.isDropdownOpen()) {
                    menu.closeMenu();
                    return <NcursesUi::EventResult>{"handled": True};
                }
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            }
            return <NcursesUi::EventResult>{"handled": False};
        });

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # open dropdown
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertTrue(app.getDispatcher().hasModal());

        app.drawAll();

        # verify dropdown content
        list<NcursesUi::Widget> modals = app.getDispatcher().getModalStack();
        NcursesUi::DropdownMenuWidget dd = modals[0];
        *Ncurses::Window pw = dd.getWindow();
        assertTrue(exists pw);

        # press Escape
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);

        # dropdown should be closed
        assertFalse(menu.isDropdownOpen(),
            "Escape should close the dropdown");
        assertFalse(app.getDispatcher().hasModal(),
            "modal should be removed after Escape");

        # draw and verify dropdown is gone
        app.drawAll();

        # the menu bar should still be visible
        string menu_row = th.session().screen().readText(0, 0, 40);
        assertTrue(menu_row.find("File") >= 0, "menu bar should still show");
    }

    /** Test that dialog cursor is on the focused button, not on the prompt line. */
    testDialogCursorPosition() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        # REPL-like layout with input on row 22
        NcursesUi::ScrollableWidget output();
        NcursesUi::LineListContent content();
        content.appendLine("Welcome");
        output.setContent(content);
        output.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        NcursesUi::TextInputWidget input_w(">>> ");
        input_w.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        input_w.setPreferredSize(1, 0);

        root.addChild(output);
        root.addChild(input_w);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(input_w);

        # draw initial state - cursor should be at the prompt
        app.drawAll();
        Ncurses::Window scr = th.session().screen();
        hash<Ncurses::Position> pos1 = scr.cursor();
        # input is on the last row (row 23)
        assertEq(23, pos1.y);

        # now show a dialog
        NcursesUi::DialogWidget dlg(th.session(), "Quit", "Exit?", ("OK", "Cancel"));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        app.pushModal(dlg);

        # draw with dialog - cursor should move to the dialog button
        app.drawAll();
        hash<Ncurses::Position> pos2 = scr.cursor();
        # cursor should NOT be on the prompt row (23)
        assertTrue(pos2.y != 23,
            sprintf("cursor should be on dialog button (row %d), not on prompt row 23", pos2.y));

        # cursor should be within the dialog frame
        hash<NcursesUi::Rect> f = dlg.getFrame();
        assertTrue(pos2.y >= f.y && pos2.y < f.y + f.rows,
            sprintf("cursor row %d should be within dialog frame (y=%d, rows=%d)",
                pos2.y, f.y, f.rows));
        assertTrue(pos2.x >= f.x && pos2.x < f.x + f.cols,
            sprintf("cursor col %d should be within dialog frame (x=%d, cols=%d)",
                pos2.x, f.x, f.cols));

        # Tab to Cancel button, redraw, verify cursor moves
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        app.processEvent(ev);
        assertEq(1, dlg.getFocusedButton());

        app.drawAll();
        hash<Ncurses::Position> pos3 = scr.cursor();
        # cursor should have moved right (Cancel button is right of OK)
        assertTrue(pos3.x > pos2.x,
            sprintf("cursor should move right for Cancel (x=%d vs OK x=%d)", pos3.x, pos2.x));

        # clean up
        app.popModal();
        dlg.destroyPanel();
    }
}
