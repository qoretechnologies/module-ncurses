#!/usr/bin/env qore

%requires ncurses
%requires NcursesUi
%requires NcursesReplUi
%requires QUnit

%modern

%include "test/TestHarness.qc"

%exec-class NcursesIntegrationTest

class NcursesIntegrationTest inherits Test {
    constructor() : Test("NcursesIntegrationTest", "1.0") {
        addTestCase("Full app lifecycle with widget tree", \testFullAppLifecycle());
        addTestCase("Application with scrollable output", \testAppScrollableOutput());
        addTestCase("Application with text input and submit", \testAppTextInputSubmit());
        addTestCase("Application with list selection", \testAppListSelection());
        addTestCase("Application with dialog modal", \testAppDialogModal());
        addTestCase("Application layout with menu + output + input + status", \testReplLikeLayout());
        addTestCase("Event routing: focus traversal + input", \testEventRoutingFocus());
        addTestCase("Scrollable widget in layout", \testScrollableInLayout());
        addTestCase("Checkbox and RadioGroup in form", \testFormWidgets());
        addTestCase("Table with sorting and navigation", \testTableIntegration());
        addTestCase("ComboBox typing and filtering", \testComboBoxIntegration());
        addTestCase("MenuBar + dropdown workflow", \testMenuBarDropdownWorkflow());
        addTestCase("MenuBar dropdown with Application", \testMenuBarDropdownWithApp());
        addTestCase("MenuBar dropdown Left/Right navigation", \testMenuBarDropdownLeftRight());
        addTestCase("Nested widget tree drawing", \testNestedWidgetTreeDrawing());
        addTestCase("Resize event propagation", \testResizeEventPropagation());
        addTestCase("Widget visibility toggle", \testWidgetVisibilityToggle());
        addTestCase("StatusBar update cycle", \testStatusBarUpdateCycle());
        addTestCase("LineListContent with ANSI colors", \testAnsiColorContent());
        addTestCase("Scroll and draw combined", \testScrollAndDrawCombined());
        addTestCase("Empty states don't crash", \testEmptyStates());
        addTestCase("Multiple widgets handle different events", \testMultiWidgetEventRouting());
        addTestCase("Modal widgets drawn in drawAll", \testModalDrawnInDrawAll());
        addTestCase("EventDispatcher getModalStack", \testGetModalStack());
        addTestCase("Dropdown panel renders menu item text", \testDropdownPanelRendersContent());
        addTestCase("Dialog panel renders message and buttons", \testDialogPanelRendersContent());
        addTestCase("FileBrowser panel renders directory listing", \testFileBrowserPanelRendersContent());
        addTestCase("Full REPL layout renders all components", \testFullReplLayoutRendering());
        addTestCase("Dropdown navigate and verify content updates", \testDropdownNavigationVisual());
        addTestCase("Escape closes dropdown visually", \testEscapeClosesDropdownVisual());
        addTestCase("Escape shows quit dialog visually", \testEscapeShowsQuitDialogVisual());
        addTestCase("Stacked modals render in correct order", \testStackedModalsRender());
        addTestCase("MenuBar renders multiple menu labels", \testMenuBarRendersLabels());
        addTestCase("StatusBar renders spaced segments in app", \testStatusBarRendersInApp());
        addTestCase("Table renders headers and rows visually", \testTableRendersVisually());
        addTestCase("TextInput renders prompt and typed text", \testTextInputRendersVisually());
        addTestCase("ListWidget renders selected item highlight", \testListRendersSelection());
        addTestCase("CheckboxWidget renders toggle state in app", \testCheckboxRendersInApp());
        addTestCase("Click outside dropdown closes it", \testClickOutsideDropdownCloses());
        addTestCase("Click another menu switches dropdown", \testClickAnotherMenuSwitchesDropdown());
        addTestCase("Escape closes dropdown via modal dispatch", \testEscapeClosesDropdownViaModal());
        addTestCase("Dialog cursor on focused button not prompt", \testDialogCursorPosition());

        set_return_value(main());
    }

    testFullAppLifecycle() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        NcursesUi::Widget child1();
        NcursesUi::Widget child2();
        root.addChild(child1);
        root.addChild(child2);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        assertEq(24, root.getFrame().rows);
        assertEq(80, root.getFrame().cols);
        assertEq(12, child1.getFrame().rows);
        assertEq(12, child2.getFrame().rows);

        app.drawAll();
        app.close();
        assertFalse(app.isRunning());
    }

    testAppScrollableOutput() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::ScrollableWidget sw();
        NcursesUi::LineListContent content();

        for (int i = 0; i < 100; ++i) {
            content.appendLine(sprintf("Output line %d", i));
        }
        sw.setContent(content);
        app.setRoot(sw);

        # draw and verify
        app.drawAll();

        # scroll down via event
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_NPAGE";
        hash<NcursesUi::EventResult> result = app.processEvent(ev);
        assertTrue(result.handled);
        assertTrue(sw.getScrollY() > 0);

        # verify content after scroll
        app.drawAll();
        string row0 = th.session().screen().readText(0, 0, 40);
        # should not show "Output line 0" anymore
        assertFalse(row0.find("Output line 0") >= 0);
    }

    testAppTextInputSubmit() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::TextInputWidget ti(">>> ");
        ti.setFocused(True);

        string submitted;
        ti.setOnSubmit(sub (string text) { submitted = text; });

        app.setRoot(ti);
        app.getFocusManager().setFocus(ti);

        # type "hello"
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        foreach string ch in (("h", "e", "l", "l", "o")) {
            ev.ch = ch;
            app.processEvent(ev);
        }
        assertEq("hello", ti.getText());

        # submit
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("hello", submitted);
        assertEq("", ti.getText());
    }

    testAppListSelection() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::ListWidget lw();
        lw.setItems((
            {"label": "Apple"},
            {"label": "Banana"},
            {"label": "Cherry"},
        ));

        *hash<auto> activated;
        lw.setOnActivate(sub (hash<auto> item) { activated = item; });

        app.setRoot(lw);
        app.getFocusManager().setFocus(lw);

        # navigate down twice
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        app.processEvent(ev);
        assertEq(2, lw.getSelectedIndex());
        assertEq("Cherry", lw.getSelectedItem().label);

        # activate
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("Cherry", activated.label);
    }

    testAppDialogModal() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        app.setRoot(root);

        NcursesUi::DialogWidget dlg(th.session(), "Confirm", "Are you sure?", ("Yes", "No"));
        dlg.centerOn(24, 80);

        int pressed_idx = -1;
        dlg.setOnButton(sub (int idx, string label) { pressed_idx = idx; });

        app.pushModal(dlg);

        # Tab to "No" button, then Enter
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        app.processEvent(ev);
        assertEq(1, dlg.getFocusedButton());

        ev.ch = "\n";
        app.processEvent(ev);
        assertEq(1, pressed_idx);

        app.popModal();
    }

    testReplLikeLayout() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        # menu bar (fixed 1 row)
        NcursesUi::MenuBarWidget menu();
        menu.addMenu("File", ({"label": "Quit", "command": "quit"},));
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);

        # output (expanding)
        NcursesUi::ScrollableWidget output();
        NcursesUi::LineListContent output_content();
        output_content.appendLine("Welcome");
        output.setContent(output_content);
        output.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        # input (fixed 1 row)
        NcursesUi::TextInputWidget input_widget(">>> ");
        input_widget.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        input_widget.setPreferredSize(1, 0);

        # status (fixed 1 row)
        NcursesUi::StatusBarWidget status();
        status.setSegments(({"text": "Ready"},));
        status.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        status.setPreferredSize(1, 0);

        root.addChild(menu);
        root.addChild(output);
        root.addChild(input_widget);
        root.addChild(status);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # verify layout
        assertEq(1, menu.getFrame().rows);
        assertEq(1, input_widget.getFrame().rows);
        assertEq(1, status.getFrame().rows);
        # output gets remaining: 24 - 3 = 21 rows
        assertEq(21, output.getFrame().rows);
        assertEq(80, output.getFrame().cols);

        # draw everything
        app.drawAll();

        # verify text appears
        string menu_row = th.session().screen().readText(0, 0, 40);
        assertTrue(menu_row.find("File") >= 0);
    }

    testEventRoutingFocus() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::CheckboxWidget cb1("Option A");
        NcursesUi::CheckboxWidget cb2("Option B");

        root.addChild(cb1);
        root.addChild(cb2);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # Tab should focus cb1
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        app.processEvent(ev);
        assertTrue(app.getFocusManager().getCurrentFocus() == cb1);

        # Tab to cb2
        app.processEvent(ev);
        assertTrue(app.getFocusManager().getCurrentFocus() == cb2);

        # Space to toggle cb2
        ev.ch = " ";
        app.processEvent(ev);
        assertTrue(cb2.isChecked());
        assertFalse(cb1.isChecked());
    }

    testScrollableInLayout() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::ScrollableWidget sw();
        NcursesUi::LineListContent content();
        for (int i = 0; i < 50; ++i) {
            content.appendLine(sprintf("Line %02d", i));
        }
        sw.setContent(content);
        sw.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        NcursesUi::Widget footer();
        footer.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        footer.setPreferredSize(2, 0);

        root.addChild(sw);
        root.addChild(footer);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # sw should get 22 rows (24 - 2)
        assertEq(22, sw.getFrame().rows);

        # scroll to end
        sw.scrollTo(NcursesUi::ScrollDirection::End);
        assertTrue(sw.getScrollY() > 0);

        # draw
        app.drawAll();

        # first visible line should not be "Line 00"
        string row0 = th.session().screen().readText(0, 0, 20);
        assertFalse(row0.find("Line 00") >= 0);
    }

    testFormWidgets() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::CheckboxWidget cb("Enable");
        NcursesUi::RadioGroupWidget rg(("Low", "Medium", "High"), 1);

        root.addChild(cb);
        root.addChild(rg);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # focus cb and toggle
        app.getFocusManager().setFocus(cb);
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        app.processEvent(ev);
        assertTrue(cb.isChecked());

        # focus rg, navigate and select
        app.getFocusManager().setFocus(rg);
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        assertEq(2, rg.getHighlightIndex());

        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        app.processEvent(ev);
        assertEq(2, rg.getSelectedIndex());
        assertEq("High", rg.getSelectedOption());

        # draw all
        app.drawAll();
    }

    testTableIntegration() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::TableWidget tw();
        tw.setColumns((
            {"key": "name", "header": "Name"},
            {"key": "type", "header": "Type", "width": 10},
            {"key": "size", "header": "Size", "width": 10, "align": "right"},
        ));
        tw.setRows((
            {"name": "alpha.q", "type": "qore", "size": 1024},
            {"name": "beta.q", "type": "qore", "size": 512},
            {"name": "gamma.cc", "type": "c++", "size": 8192},
            {"name": "delta.py", "type": "python", "size": 2048},
        ));

        app.setRoot(tw);
        app.getFocusManager().setFocus(tw);

        # sort by name ascending
        tw.setSortColumn("name", True);
        assertEq("alpha.q", tw.getRows()[0].name);

        # navigate and activate
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        app.processEvent(ev);
        app.processEvent(ev);

        assertEq(2, tw.getSelectedRow());

        app.drawAll();
        string header = th.session().screen().readText(0, 0, 40);
        assertTrue(header.find("Name") >= 0);
    }

    testComboBoxIntegration() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::ComboBoxWidget cb(("apple", "apricot", "banana", "blueberry", "cherry"));
        app.setRoot(cb);
        app.getFocusManager().setFocus(cb);

        # type "ap" to filter to apple, apricot
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "a";
        app.processEvent(ev);
        ev.ch = "p";
        app.processEvent(ev);

        assertEq("ap", cb.getText());
        assertTrue(cb.isDropdownOpen());
        # filtered should contain apple, apricot
        list<string> filtered = cb.getFilteredOptions();
        assertEq(2, filtered.size());

        # select first option
        ev.ch = "\n";
        app.processEvent(ev);
        assertEq("apple", cb.getText());
        assertFalse(cb.isDropdownOpen());
    }

    testMenuBarDropdownWorkflow() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));
        menu.addMenu("Edit", (
            {"label": "Copy", "command": "copy"},
        ));

        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });

        root.addChild(menu);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open File menu (without app, no dropdown panel)
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertEq(0, menu.getActiveMenu());

        # navigate to Edit via menu bar processEvent (no modal)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_RIGHT";
        menu.processEvent(ev);
        assertEq(1, menu.getActiveMenu());

        # fire command
        menu.fireCommand("copy");
        assertEq("copy", fired_cmd);
        assertFalse(menu.isDropdownOpen());
    }

    testMenuBarDropdownWithApp() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));
        menu.addMenu("Edit", (
            {"label": "Copy", "command": "copy"},
        ));

        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open File menu - should create dropdown panel as modal
        menu.openMenu(0);
        assertTrue(menu.isDropdownOpen());
        assertEq(0, menu.getActiveMenu());
        assertTrue(app.getDispatcher().hasModal());

        # draw to verify no crash
        app.drawAll();

        # select first item via Enter (goes to modal dropdown)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        app.processEvent(ev);

        # command should have fired
        assertEq("open", fired_cmd);
        assertFalse(menu.isDropdownOpen());
        assertFalse(app.getDispatcher().hasModal());
    }

    testMenuBarDropdownLeftRight() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        NcursesUi::MenuBarWidget menu();
        menu.setApplication(app);
        menu.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        menu.setPreferredSize(1, 0);
        menu.addMenu("File", (
            {"label": "Open", "command": "open"},
        ));
        menu.addMenu("Edit", (
            {"label": "Copy", "command": "copy"},
        ));
        menu.addMenu("Help", (
            {"label": "About", "command": "about"},
        ));

        string fired_cmd;
        menu.setOnCommand(sub (string cmd) { fired_cmd = cmd; });

        root.addChild(menu);
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);
        app.getFocusManager().setFocus(menu);

        # open File menu
        menu.openMenu(0);
        assertTrue(app.getDispatcher().hasModal());
        assertEq(0, menu.getActiveMenu());

        # Right arrow switches to Edit (goes through modal dropdown -> on_navigate)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_RIGHT";
        app.processEvent(ev);
        assertEq(1, menu.getActiveMenu());
        assertTrue(menu.isDropdownOpen());
        assertTrue(app.getDispatcher().hasModal());

        # Right again to Help
        app.processEvent(ev);
        assertEq(2, menu.getActiveMenu());

        # Right at end wraps to File
        app.processEvent(ev);
        assertEq(0, menu.getActiveMenu());

        # Left wraps to Help
        ev.name = "KEY_LEFT";
        app.processEvent(ev);
        assertEq(2, menu.getActiveMenu());

        # Left to Edit
        app.processEvent(ev);
        assertEq(1, menu.getActiveMenu());

        # Left to File
        app.processEvent(ev);
        assertEq(0, menu.getActiveMenu());

        # Escape closes dropdown
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        app.processEvent(ev);
        assertFalse(menu.isDropdownOpen());
        assertFalse(app.getDispatcher().hasModal());
    }

    testNestedWidgetTreeDrawing() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();

        # use direct children so BoxLayout assigns frames
        NcursesUi::CheckboxWidget cb1("Top checkbox");
        NcursesUi::CheckboxWidget cb2("Bottom checkbox");
        root.addChild(cb1);
        root.addChild(cb2);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # both checkboxes should have frames from layout
        assertTrue(cb1.getFrame().rows > 0);
        assertTrue(cb2.getFrame().rows > 0);

        app.drawAll();

        # verify tree structure is intact
        assertEq(2, root.getChildren().size());
        assertTrue(exists cb1.getParent());
        assertTrue(exists cb2.getParent());

        # both should have been assigned space by vertical layout
        assertEq(80, cb1.getFrame().cols);
        assertEq(80, cb2.getFrame().cols);
    }

    testResizeEventPropagation() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::Application app(th.session());
        NcursesUi::Widget root();
        NcursesUi::Widget top();
        NcursesUi::Widget bottom();
        root.addChild(top);
        root.addChild(bottom);

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # initial layout
        assertEq(12, top.getFrame().rows);
        assertEq(12, bottom.getFrame().rows);

        # simulate resize
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Resize;
        hash<NcursesUi::EventResult> result = app.processEvent(ev);
        assertTrue(result.handled);

        # root should still fill screen
        assertEq(24, root.getFrame().rows);
        assertEq(80, root.getFrame().cols);
    }

    testWidgetVisibilityToggle() {
        NcursesUi::Widget root();
        NcursesUi::Widget a();
        NcursesUi::Widget b();
        NcursesUi::Widget c();
        a.setVSizePolicy(NcursesUi::SizePolicy::Expanding);
        b.setVSizePolicy(NcursesUi::SizePolicy::Expanding);
        c.setVSizePolicy(NcursesUi::SizePolicy::Expanding);

        root.addChild(a);
        root.addChild(b);
        root.addChild(c);
        root.setFrame(NcursesUi::Geometry::makeRect(0, 0, 30, 80));

        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        layout.apply(root);

        # 3 equal children = 10 each
        assertEq(10, a.getFrame().rows);
        assertEq(10, b.getFrame().rows);
        assertEq(10, c.getFrame().rows);

        # hide b, re-layout
        b.setVisible(False);
        layout.apply(root);

        # now 2 children share 30 rows = 15 each
        assertEq(15, a.getFrame().rows);
        assertEq(15, c.getFrame().rows);

        # show b again
        b.setVisible(True);
        layout.apply(root);
        assertEq(10, a.getFrame().rows);
    }

    testStatusBarUpdateCycle() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::StatusBarWidget sb();
        sb.setFrame(NcursesUi::Geometry::makeRect(23, 0, 1, 80));

        # first update
        sb.setSegments((
            {"text": "Ready"},
            {"text": "12:00:00", "align": "right"},
        ));
        sb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(23, 0, 80);
        assertTrue(row.find("Ready") >= 0);
        assertTrue(row.find("12:00:00") >= 0);

        # second update
        sb.setSegments((
            {"text": "Error", "style": {"fg": Ncurses::Color::Red, "attrs": Ncurses::Attr::Reverse}},
            {"text": "12:00:01", "align": "right"},
        ));
        sb.draw(th.session().screen());
        th.session().doupdate();

        row = th.session().screen().readText(23, 0, 80);
        assertTrue(row.find("Error") >= 0);
        assertTrue(row.find("12:00:01") >= 0);
    }

    testAnsiColorContent() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::ScrollableWidget sw();
        sw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));

        NcursesUi::LineListContent content();
        content.appendLine(chr(0x1b) + "[31mRed text" + chr(0x1b) + "[0m");
        content.appendLine(chr(0x1b) + "[32mGreen text" + chr(0x1b) + "[0m");
        content.appendLine("Plain text");
        sw.setContent(content);

        # width should be based on visible text, not ANSI codes
        assertEq(10, content.totalCols());  # "Green text" or "Plain text" = 10
        assertEq(3, content.totalRows());

        # draw should not crash
        sw.draw(th.session().screen());
        th.session().doupdate();

        string row2 = th.session().screen().readText(2, 0, 20);
        assertTrue(row2.find("Plain text") >= 0);
    }

    testScrollAndDrawCombined() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::ScrollableWidget sw();
        sw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));

