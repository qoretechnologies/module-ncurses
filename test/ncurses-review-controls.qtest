#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QoreHistory
%requires QUnit
%include "test/TestHarness.qc"
%exec-class ReviewControlsTest
class ReviewControlsTest inherits Test {
    constructor() : Test("ReviewControlsTest", "1.0", \ARGV) {
        addTestCase("choices reveal defaults replacements and resized highlights", \choiceReveal());
        addTestCase("completed choices retain read-only scroll navigation", \completedScroll());
        addTestCase("choice scrollbar clicks use shared scrolling", \choiceScrollbar());
        addTestCase("ancestor clipping synchronizes form values and schema", \clippedForm());
        addTestCase("explicitly unset choices stay unset when controls are created", \unsetChoice());
        addTestCase("explicit same-value writes replace invalid drafts only for that field", \explicitWrites());
        addTestCase("tree width changes retain selected row visibility", \treeResize());
        addTestCase("replaced scalar branches allow parent navigation", \treeScalar());
        addTestCase("password submit mode transitions never expose history or failed drafts", \passwordHistory());
        addTestCase("form focus scrolls within ancestor and target-window clipping", \clippedFocus());
        addTestCase("form completion reveals the receipt from an early field", \formReceipt());
        addTestCase("untouched required Boolean stays unset until an explicit edit", \unsetBoolean());
        addTestCase("tree indentation and branch hit testing use clipped viewport width", \treeClipped());
        addTestCase("document replacement and transcript clear reset horizontal scroll", \horizontalReset());
        addTestCase("custom choice paint preserves manual scrolling until editing resumes", \customScroll());
        addTestCase("form submission rollback snapshots imported model values", \formRollback());
        addTestCase("tree rebuild notifies selection changes exactly once after commit", \treeNotifications());
        set_return_value(main());
    }
    horizontalReset() {
        NcursesUi::TestHarness th(6, 25); on_exit th.close(); NcursesUi::CodeViewWidget code(strmul("x", 60) + "needle"); code.setFrameValues(0, 0, 3, 20); code.setSearch("needle"); code.findNext(); assertTrue(code.getScrollX() > 0);
        code.setText("START " + strmul("y", 80)); assertEq(0, code.getScrollX()); code.drawTree(th.screen()); assertEq("START", th.screen().readText(0, 0, 5));
        NcursesUi::TranscriptWidget transcript(); transcript.setFrameValues(0, 0, 3, 20); transcript.setWordWrap(False); transcript.appendLine(strmul("z", 80)); transcript.scrollTo(NcursesUi::ScrollDirection::Right, 40); assertTrue(transcript.getScrollX() > 0); transcript.clear(); assertEq(0, transcript.getScrollX()); assertEq(0, transcript.getScrollY());
    }
    customScroll() {
        NcursesUi::TestHarness th(8, 30); on_exit th.close(); NcursesUi::DescribedChoiceWidget choice(options()); choice.setCustomAllowed(True); choice.setCustomText("draft"); choice.setFrameValues(0, 0, 3, 20); choice.setFocused(True); choice.drawTree(th.screen());
        assertTrue(choice.getScrollY() > 0); choice.processEvent(key("KEY_PPAGE")); int scroll = choice.getScrollY(); choice.drawTree(th.screen()); assertEq(scroll, choice.getScrollY());
        choice.processEvent(click(0, choice.getViewportRect().cols)); choice.drawTree(th.screen()); assertEq(0, choice.getScrollY());
        choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "x"}); choice.drawTree(th.screen()); assertTrue(choice.getScrollY() > 0); assertEq("draftx", choice.getSelection().value);
    }
    formRollback() {
        NcursesUi::TestHarness th(10, 30); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::FormModel model(fields()); NcursesUi::FormWidget form(model); app.setRoot(form); form.setFocusManager(app.getFocusManager());
        NcursesUi::TextInputWidget count = cast<NcursesUi::TextInputWidget>(form.getControl("count")); app.getFocusManager().setFocus(count); app.drawAll();
        form.setOnSubmit(auto sub (hash<auto> values) { assertEq(9, values.count); throw "SUBMIT-ERROR", "rejected"; }); model.setValue("count", 9);
        assertThrows("SUBMIT-ERROR", sub () { app.processEvent(key("KEY_ENTER")); }); assertEq("9", count.getText()); app.drawAll(); assertEq("9", count.getText()); assertEq(9, model.getValue("count"));
        form.setOnSubmit(auto sub (hash<auto> values) { return values; }); assertTrue(form.submit()); assertEq(9, model.getResult().count);
        model.reset(); model.setValue("count", NOTHING); app.drawAll(); count.setText("0"); assertTrue(form.submit()); assertEq(0, model.getResult().count); assertTrue(exists model.getResult().count);
    }
    treeNotifications() {
        NcursesUi::TreeWidget tree({"branch": {"child": 1}, "name": "value"}); list<*string> selections = ();
        tree.setOnSelect(sub (*hash<NcursesUi::TreeEntry> entry) { selections += entry ? entry.path : NOTHING; }); tree.selectPath("/name"); selections = ();
        tree.setFilter("no matches"); assertEq((NOTHING,), selections); assertNothing(tree.getSelectedPath()); tree.setFilter(""); assertEq((NOTHING, ""), selections);
        tree.selectPath("/branch/child"); selections = (); tree.setExpanded("/branch", False); assertEq(("/branch",), selections); tree.setExpanded("/branch", False); assertEq(1, selections.size());
        tree.setData({"branch": 42}); assertEq(("/branch", "/branch"), selections); assertEq(42, tree.getSelectedEntry().value);
        tree.setOnSelect(sub (*hash<NcursesUi::TreeEntry> entry) { throw "SELECTION-ERROR", "handler failed"; }); assertThrows("SELECTION-ERROR", sub () { tree.setFilter("none"); }); assertNothing(tree.getSelectedPath()); assertEq((), tree.getVisiblePaths());
    }
    formReceipt() {
        NcursesUi::TestHarness th(4, 24); on_exit th.close(); NcursesUi::Application app(th.session());
        NcursesUi::FormModel model(fields()); NcursesUi::FormWidget form(model); app.setRoot(form); form.setFocusManager(app.getFocusManager());
        form.setOnSubmit(auto sub (hash<auto> values) { return values; }); app.getFocusManager().setFocus(form.getControl("count")); app.drawAll();
        assertEq(0, form.getScrollY()); app.processEvent(key("KEY_ENTER")); app.drawAll();
        assertEq(NcursesUi::ActionState::Completed, model.getState()); assertTrue(form.getScrollY() > 0);
        assertTrue(join("\n", th.screen().readLines()).find("Submitted") >= 0); assertFalse(form.isDirty()); assertFalse(form.submit());
    }
    unsetBoolean() {
        list<hash<NcursesUi::FormField>> schema = (<NcursesUi::FormField>{"name": "flag", "label": "Required Boolean", "type": NcursesUi::FieldType::Boolean, "required": True},);
        NcursesUi::FormModel model(schema); NcursesUi::FormWidget form(model); int calls = 0;
        form.setOnSubmit(auto sub (hash<auto> values) { ++calls; return values; });
        assertFalse(form.submit()); assertNothing(model.getValue("flag")); assertEq(0, calls);
        NcursesUi::CheckboxWidget checkbox = cast<NcursesUi::CheckboxWidget>(form.getControl("flag"));
        checkbox.setChecked(False); assertTrue(form.submit()); assertEq(False, model.getResult().flag); assertEq(1, calls);
        model.reset(); model.setValue("flag", NOTHING); assertFalse(form.submit()); assertNothing(model.getValue("flag"));
        checkbox.toggle(); checkbox.toggle(); assertEq(False, model.getValue("flag")); assertTrue(form.submit()); assertEq(2, calls);
        model.reset(); model.setValue("flag", False); assertTrue(form.submit()); assertEq(False, model.getResult().flag);
        NcursesUi::FormModel optional((<NcursesUi::FormField>{"name": "flag", "label": "Optional", "type": NcursesUi::FieldType::Boolean},));
        NcursesUi::FormWidget optional_form(optional); optional_form.setOnSubmit(auto sub (hash<auto> values) { return values; }); assertTrue(optional_form.submit()); assertNothing(optional.getResult().flag);
    }
    treeClipped() {
        NcursesUi::TestHarness th(12, 100); on_exit th.close(); NcursesUi::Widget parent(); parent.setFrameValues(0, 0, 3, 6);
        NcursesUi::TreeWidget tree({"a": {"b": {"c": {"d": {"Z": {"leaf": 42}}}}}}); tree.setFrameValues(0, 0, 10, 100); parent.addChild(tree); tree.selectPath("/a/b/c/d/Z"); parent.drawTree(th.screen());
        hash<NcursesUi::Rect> view = tree.getViewportRect(); int row = 5 - tree.getScrollY();
        assertTrue(th.screen().readText(row, 0, 20).find("Z") >= 0); int column = min(10, max(0, view.cols / 3));
        tree.processEvent(click(row, column)); assertTrue(tree.isExpanded("/a/b/c/d/Z")); parent.drawTree(th.screen());
        parent.setFrameValues(0, 0, 3, 5); parent.drawTree(th.screen()); assertTrue(th.screen().readText(5 - tree.getScrollY(), 0, 20).find("Z") >= 0);
        parent.setFrameValues(0, 0, 3, 2); parent.drawTree(th.screen()); assertEq("Z", th.screen().readText(5 - tree.getScrollY(), 0, 1));
        tree.processEvent(click(5 - tree.getScrollY(), 0)); assertFalse(tree.isExpanded("/a/b/c/d/Z"));
        NcursesUi::TreeWidget separate({"a": {"b": {"c": {"Z": 42}}}}); separate.setFrameValues(0, 0, 10, 100); separate.selectPath("/a/b/c/Z");
        Ncurses::Window small(th.session(), 2, 6, 0, 0); separate.drawTree(small); assertTrue(small.readText(4 - separate.getScrollY(), 0, 20).find("Z") >= 0); assertFalse(separate.isDirty());
    }
    passwordHistory() {
        QoreHistory::History history(); history.add("safe command"); NcursesUi::TextInputWidget input(); input.setHistory(history);
        input.setPassword(True); input.setText("private password"); input.setOnSubmit(sub (string value) { input.setPassword(False); input.setText("next prompt"); });
        input.processEvent(key("KEY_ENTER")); input.processEvent(key("KEY_UP")); assertEq("safe command", input.getText());
        input.setPassword(True); input.setText("failed password"); input.setOnSubmit(sub (string value) { input.setPassword(False); throw "PASSWORD-ERROR", "rejected"; });
        assertThrows("PASSWORD-ERROR", sub () { input.processEvent(key("KEY_ENTER")); }); assertTrue(input.isPassword()); assertEq("failed password", input.getText());
        input.processEvent(key("KEY_UP")); assertEq("failed password", input.getText());
        input.setOnSubmit(sub (string value) { input.setText("new password"); }); input.processEvent(key("KEY_ENTER")); assertTrue(input.isPassword());
        input.setPassword(False); input.setText("ordinary command"); input.setOnSubmit(NOTHING); input.processEvent(key("KEY_ENTER")); input.processEvent(key("KEY_UP")); assertEq("ordinary command", input.getText());
    }
    clippedFocus() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::Widget root(); app.setRoot(root);
        NcursesUi::Widget container(); container.setFrameValues(1, 2, 3, 20); root.addChild(container);
        NcursesUi::FormModel model(fields()); NcursesUi::FormWidget form(model); form.setFrameValues(1, 2, 10, 20); container.addChild(form); form.setFocusManager(app.getFocusManager());
        app.getFocusManager().setFocus(form.getControl("other")); app.drawAll(); assertTrue(form.getControl("other").visibleRect().rows > 0);
        container.setFrameValues(1, 2, 1, 12); app.drawAll(); assertEq(1, form.getControl("other").visibleRect().rows); assertEq(12, form.getControl("other").getFrame().cols);
        container.setFrameValues(3, 2, 2, 12); app.drawAll(); assertTrue(form.getControl("other").visibleRect().rows > 0); assertTrue(form.getControl("other").getFrame().y >= 3);
        container.setFrameValues(1, 2, 8, 20); app.drawAll();
        form.setOnSubmit(auto sub (hash<auto> values) { return values; }); cast<NcursesUi::TextInputWidget>(form.getControl("count")).setText("bad");
        assertFalse(form.submit()); app.drawAll(); assertEq(form.getControl("count"), app.getFocusManager().getCurrentFocus()); assertTrue(form.getControl("count").visibleRect().rows > 0);
        NcursesUi::FormModel separate_model(fields()); NcursesUi::FormWidget separate(separate_model); separate.setFrameValues(0, 0, 10, 20); separate.getControl("other").setFocused(True);
        Ncurses::Window small(th.session(), 2, 10, 0, 0); separate.drawTree(small); assertTrue(separate.getControl("other").getFrame().y < 2); assertEq(10, separate.getControl("other").getFrame().cols);
    }
    private hash<Ncurses::InputEvent> key(string value) { return <Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": value}; }
    private hash<Ncurses::InputEvent> click(int y, int x) { return <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": <Ncurses::MouseEvent>{"y": y, "x": x, "button_state": Ncurses::BUTTON1_CLICKED}}; }
    private list<hash<NcursesUi::ChoiceItem>> options() {
        list<hash<NcursesUi::ChoiceItem>> result = ();
        for (int i = 0; i < 12; ++i) { result += <NcursesUi::ChoiceItem>{"value": string(i), "label": "Option " + i, "default_value": i == 11}; }
        return result;
    }
    private list<hash<NcursesUi::FormField>> fields() { return (
        <NcursesUi::FormField>{"name": "count", "label": "Count", "type": NcursesUi::FieldType::Integer, "default_value": 3},
        <NcursesUi::FormField>{"name": "other", "label": "Other", "type": NcursesUi::FieldType::Integer, "default_value": 4},
        <NcursesUi::FormField>{"name": "choice", "label": "Choice", "type": NcursesUi::FieldType::Choice, "required": True, "choices": options()}
    ); }
    choiceReveal() {
        NcursesUi::TestHarness th(10, 30); on_exit th.close(); NcursesUi::DescribedChoiceWidget choice(options()); choice.setFrameValues(0, 0, 3, 20); choice.setFocused(True);
        choice.drawTree(th.screen()); assertTrue(choice.getScrollY() >= 9); assertTrue(th.screen().readText(2, 0, 19).find("Option 11") >= 0);
        choice.processEvent(key("KEY_PPAGE")); int manually = choice.getScrollY(); choice.drawTree(th.screen()); assertEq(manually, choice.getScrollY());
        choice.setFrameValues(0, 0, 1, 15); choice.drawTree(th.screen()); assertEq(11, choice.getScrollY());
        choice.setItems((<NcursesUi::ChoiceItem>{"value": "first", "label": "First"}, <NcursesUi::ChoiceItem>{"value": "new", "label": "New", "default_value": True}));
        choice.drawTree(th.screen()); assertEq(1, choice.getScrollY()); assertEq("new", choice.getSelection().value);
        choice.setFocused(False); choice.scrollTo(NcursesUi::ScrollDirection::Home); choice.setFocused(True); choice.drawTree(th.screen()); assertEq(1, choice.getScrollY());
    }
    completedScroll() {
        NcursesUi::TestHarness th(8, 30); on_exit th.close(); NcursesUi::DescribedChoiceWidget choice(options()); choice.setFrameValues(0, 0, 3, 20);
        choice.setOnSubmit(sub (hash<NcursesUi::ChoiceSelection> result) {}); assertTrue(choice.submit());
        choice.processEvent(key("KEY_HOME")); choice.drawTree(th.screen()); assertEq(0, choice.getScrollY());
        choice.processEvent(key("KEY_NPAGE")); choice.drawTree(th.screen()); assertTrue(choice.getScrollY() > 0);
        choice.processEvent(key("KEY_END")); choice.drawTree(th.screen()); assertTrue(th.screen().readText(2, 0, 19).find("Submitted") >= 0);
        assertEq("11", choice.getSelection().value); assertFalse(choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"}).handled);
        choice.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": " "}); assertEq("11", choice.getSelection().value); assertFalse(choice.submit());
    }
    choiceScrollbar() {
        NcursesUi::TestHarness th(8, 30); on_exit th.close(); NcursesUi::DescribedChoiceWidget choice(options()); choice.setFrameValues(0, 0, 4, 20);
        choice.drawTree(th.screen()); hash<NcursesUi::Rect> view = choice.getViewportRect(); choice.processEvent(click(3, view.x + view.cols));
        assertTrue(choice.getScrollY() > 0); assertEq("11", choice.getSelection().value);
        choice.drawTree(th.screen()); choice.processEvent(click(0, view.x + view.cols)); assertEq(0, choice.getScrollY());
    }
    clippedForm() {
        NcursesUi::TestHarness th(10, 30); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::Widget root(); app.setRoot(root);
        NcursesUi::Widget container(); container.setFrameValues(0, 0, 10, 30); root.addChild(container);
        NcursesUi::FormModel model(fields()); NcursesUi::FormWidget form(model); form.setFrameValues(0, 0, 10, 30); container.addChild(form); app.drawAll();
        container.setVisible(False); model.setValue("count", 9); app.drawAll(); assertFalse(root.isDirty()); container.setVisible(True); app.drawAll();
        assertEq("9", cast<NcursesUi::TextInputWidget>(form.getControl("count")).getText());
        container.translate(20, 0); model.setFields((<NcursesUi::FormField>{"name": "new", "label": "New", "default_value": "changed"},)); app.drawAll(); assertFalse(root.isDirty());
        container.translate(-20, 0); app.drawAll(); assertTrue(th.screen().readText(1, 0, 20).find("changed") >= 0); assertFalse(root.isDirty());
    }
    unsetChoice() {
        NcursesUi::FormModel model(fields()); model.setValue("choice", NOTHING); NcursesUi::FormWidget form(model);
        assertNothing(cast<NcursesUi::DescribedChoiceWidget>(form.getControl("choice")).getSelection());
        int calls = 0; form.setOnSubmit(auto sub (hash<auto> values) { ++calls; return values; }); assertFalse(form.submit()); assertEq(0, calls); assertNothing(model.getValue("choice")); assertEq("choice", model.firstInvalid());
    }
    explicitWrites() {
        NcursesUi::TestHarness th(12, 30); on_exit th.close(); NcursesUi::Application app(th.session()); NcursesUi::FormModel model(fields()); NcursesUi::FormWidget form(model); app.setRoot(form);
        form.setOnSubmit(auto sub (hash<auto> values) { return values; });
        NcursesUi::TextInputWidget count = cast<NcursesUi::TextInputWidget>(form.getControl("count")); NcursesUi::TextInputWidget other = cast<NcursesUi::TextInputWidget>(form.getControl("other"));
        count.setText("bad"); other.setText("also bad"); assertFalse(form.submit()); app.drawAll(); assertEq("bad", count.getText()); assertEq("also bad", other.getText());
        model.setValue("count", 3); app.drawAll(); assertEq("3", count.getText()); assertEq("also bad", other.getText()); assertFalse(form.submit()); assertEq("other", model.firstInvalid());
        model.setValue("other", 4); assertTrue(form.submit()); assertEq(3, model.getResult().count); assertEq(4, model.getResult().other);
    }
    treeResize() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close(); list<string> values = (); for (int i = 0; i < 30; ++i) { values += "value " + i; }
        NcursesUi::TreeWidget tree(values); tree.setFrameValues(0, 0, 4, 30); tree.selectPath("/25"); tree.drawTree(th.screen()); assertTrue(tree.getScrollY() > 0);
        tree.setFrameValues(0, 0, 3, 20); tree.drawTree(th.screen()); assertTrue(tree.getScrollY() >= 24); assertTrue(th.screen().readText(2, 0, 19).find("25") >= 0); assertEq("/25", tree.getSelectedPath());
        tree.setFrameValues(0, 0, 1, 20); tree.drawTree(th.screen()); assertEq(26, tree.getScrollY()); assertTrue(th.screen().readText(0, 0, 19).find("25") >= 0);
    }
    treeScalar() {
        NcursesUi::TreeWidget tree({"branch": {"child": 1}}); tree.setFrameValues(0, 0, 5, 20); tree.setExpanded("/branch", True); tree.selectPath("/branch");
        tree.setData({"branch": 1}); assertFalse(tree.getSelectedEntry().branch); tree.processEvent(key("KEY_LEFT")); assertEq("", tree.getSelectedPath());
        tree.setData({"branch": {"child": 2}}); assertFalse(tree.isExpanded("/branch"));
    }
}
