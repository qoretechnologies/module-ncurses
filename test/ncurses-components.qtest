        string temp_dir = "/tmp/fb_dir_prev_" + string(getpid());
        mkdir(temp_dir, 0755);
        mkdir(temp_dir + "/subdir", 0755);
        on_exit {
            unlink(temp_dir + "/subdir/inner.txt");
            rmdir(temp_dir + "/subdir");
            unlink(temp_dir + "/afile.txt");
            rmdir(temp_dir);
        }

        # create a file in temp_dir and a file in subdir
        File f();
        f.open(temp_dir + "/afile.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write("test\n");
        f.close();

        File f2();
        f2.open(temp_dir + "/subdir/inner.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f2.write("inner\n");
        f2.close();

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();

        # find "subdir" in the list
        int idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "subdir") {
                idx = i;
                break;
            }
        }
        assertTrue(idx >= 0, "subdir should be in file list");

        # select the directory
        fl.setSelectedIndex(idx);

        # preview should show directory contents (not be empty)
        NcursesUi::LineListContent pc = fb.getPreviewContent();
        assertTrue(pc.lineCount() >= 1, "directory preview should have content");

        # should show inner.txt
