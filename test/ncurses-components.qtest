        NcursesUi::MenuBarWidget mb();
        mb.addMenu("File", ());

        assertFalse(mb.isDropdownOpen());
        mb.openMenu(0);
        assertTrue(mb.isDropdownOpen());
        assertEq(0, mb.getActiveMenu());

        mb.closeMenu();
        assertFalse(mb.isDropdownOpen());
        assertEq(-1, mb.getActiveMenu());
