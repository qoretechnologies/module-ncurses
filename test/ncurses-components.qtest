    testMenuBarStyleSetters() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::MenuBarWidget mb();
        mb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 80));
        mb.addMenu("File", ());

        # set custom bar style
        hash<auto> custom_bar = {"attrs": Ncurses::Attr::Reverse, "fg": Ncurses::Color::Blue};
        mb.setBarStyle(custom_bar);
        mb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find("File") >= 0);

        # set custom active style
        hash<auto> custom_active = {"attrs": Ncurses::Attr::Bold, "fg": Ncurses::Color::Red};
        mb.setActiveStyle(custom_active);
        mb.openMenu(0);
        mb.draw(th.session().screen());
        th.session().doupdate();

        row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find("File") >= 0);
    }

    testMenuBarAltKey() {
        NcursesUi::MenuBarWidget mb();
        mb.addMenu("File", ());
        mb.addMenu("Edit", ());
        mb.addMenu("Help", ());

        # processAltKey("f") opens File menu (case-insensitive)
        assertTrue(mb.processAltKey("f"));
        assertEq(0, mb.getActiveMenu());
        assertTrue(mb.isDropdownOpen());

        mb.closeMenu();

        # uppercase also works
        assertTrue(mb.processAltKey("F"));
        assertEq(0, mb.getActiveMenu());
        mb.closeMenu();

        # "e" opens Edit
        assertTrue(mb.processAltKey("e"));
        assertEq(1, mb.getActiveMenu());
        mb.closeMenu();

        # "h" opens Help
        assertTrue(mb.processAltKey("h"));
        assertEq(2, mb.getActiveMenu());
        mb.closeMenu();

        # "z" matches nothing
        assertFalse(mb.processAltKey("z"));
        assertEq(-1, mb.getActiveMenu());

        # Alt event in processEvent
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Alt;
        ev.ch = "f";
        hash<NcursesUi::EventResult> result = mb.processEvent(ev);
        assertTrue(result.handled);
        assertEq("open_menu", result.action);
        assertEq(0, mb.getActiveMenu());
        mb.closeMenu();

        # Alt event with no match
        ev.ch = "z";
        result = mb.processEvent(ev);
        assertFalse(result.handled);
    }

