    testListEnsureVisible() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 3, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 10; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);

        # select item beyond viewport
        lw.setSelectedIndex(8);
        assertEq(8, lw.getSelectedIndex());
        # scroll should have adjusted
        assertTrue(lw.getScrollOffset() > 0);
    }

    testListDraw() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 30));
        lw.setItems((
            {"label": "First"},
            {"label": "Second"},
            {"label": "Third"},
        ));
        lw.draw(th.session().screen());
        th.session().doupdate();

        string row0 = th.session().screen().readText(0, 0, 30);
        assertTrue(row0.find("First") >= 0);
        string row1 = th.session().screen().readText(1, 0, 30);
        assertTrue(row1.find("Second") >= 0);
    }

    # ---- TextInputWidget ----

    testTextInputInit() {
        NcursesUi::TextInputWidget ti(">>> ");
        assertEq(">>> ", ti.getPrompt());
        assertEq("", ti.getText());
        assertEq(0, ti.getCursorPos());
        assertTrue(ti.isFocusable());
    }

    testTextInputType() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));

        # type characters
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "H";
        ti.processEvent(ev);
        ev.ch = "i";
        ti.processEvent(ev);
        assertEq("Hi", ti.getText());
        assertEq(2, ti.getCursorPos());
    }

    testTextInputBackspace() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        ti.setText("Hello");
        assertEq(5, ti.getCursorPos());

        # backspace via char
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x7f);
        ti.processEvent(ev);
        assertEq("Hell", ti.getText());

        # backspace via key
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_BACKSPACE";
        ti.processEvent(ev);
        assertEq("Hel", ti.getText());
    }

    testTextInputCursor() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        ti.setText("Hello");

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;

        # Home
        ev.name = "KEY_HOME";
        ti.processEvent(ev);
        assertEq(0, ti.getCursorPos());

        # End
        ev.name = "KEY_END";
        ti.processEvent(ev);
        assertEq(5, ti.getCursorPos());

        # Left
        ev.name = "KEY_LEFT";
        ti.processEvent(ev);
        assertEq(4, ti.getCursorPos());

        # Right
        ev.name = "KEY_RIGHT";
        ti.processEvent(ev);
        assertEq(5, ti.getCursorPos());
    }

    testTextInputSubmit() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));

        string submitted;
        ti.setOnSubmit(sub (string text) { submitted = text; });

        # type and submit
        ti.setText("test input");
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        hash<NcursesUi::EventResult> result = ti.processEvent(ev);
        assertTrue(result.handled);
        assertEq("submit", result.action);
        assertEq("test input", submitted);
        # buffer should be cleared after submit
        assertEq("", ti.getText());
    }

    testTextInputCtrlKeys() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));

        # Ctrl+A (home)
        ti.setText("Hello World");
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x01);
        ti.processEvent(ev);
        assertEq(0, ti.getCursorPos());

        # Ctrl+E (end)
        ev.ch = chr(0x05);
        ti.processEvent(ev);
        assertEq(11, ti.getCursorPos());

        # Ctrl+K (kill to end)
        ti.setText("Hello World");
        ev.ch = chr(0x01);  # home first
        ti.processEvent(ev);
        # move to position 5 (after "Hello")
        ev.ch = chr(0x06);  # Ctrl+F
        for (int i = 0; i < 5; ++i) {
            ti.processEvent(ev);
        }
        ev.ch = chr(0x0b);  # Ctrl+K
        ti.processEvent(ev);
        assertEq("Hello", ti.getText());

        # Ctrl+U (kill to start)
        ti.setText("Hello World");
        ev.ch = chr(0x15);
        ti.processEvent(ev);
        assertEq("", ti.getText());
    }

    testTextInputHistory() {
        NcursesUi::TextInputWidget ti();
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        NcursesReplUi::History hist();
        ti.setHistory(hist);

        # submit two entries
        ti.setText("first");
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        ti.processEvent(ev);

        ti.setText("second");
        ti.processEvent(ev);

        # Up should recall "second"
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_UP";
        ti.processEvent(ev);
        assertEq("second", ti.getText());

        # Up again should recall "first"
        ti.processEvent(ev);
        assertEq("first", ti.getText());

        # Down should go back to "second"
        ev.name = "KEY_DOWN";
        ti.processEvent(ev);
        assertEq("second", ti.getText());
    }

    testTextInputDraw() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::TextInputWidget ti(">>> ");
        ti.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        ti.setText("hello");
        ti.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find(">>>") >= 0);
        assertTrue(row.find("hello") >= 0);
    }

    # ---- DialogWidget ----

    testDialogCreation() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test Dialog", "Hello World", ("OK", "Cancel"));
        assertEq(2, dlg.getButtons().size());
        assertEq("OK", dlg.getButtons()[0]);
        assertEq("Cancel", dlg.getButtons()[1]);
        assertEq(0, dlg.getFocusedButton());
    }

    testDialogButtonNav() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test", "msg", ("A", "B", "C"));
        assertEq(0, dlg.getFocusedButton());

        # Tab
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\t";
        dlg.processEvent(ev);
        assertEq(1, dlg.getFocusedButton());

        dlg.processEvent(ev);
        assertEq(2, dlg.getFocusedButton());

        # wrap around
        dlg.processEvent(ev);
        assertEq(0, dlg.getFocusedButton());

        # Arrow right
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_RIGHT";
        dlg.processEvent(ev);
        assertEq(1, dlg.getFocusedButton());

        # Arrow left
        ev.name = "KEY_LEFT";
        dlg.processEvent(ev);
        assertEq(0, dlg.getFocusedButton());
    }

