    testDropdownSeparator() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "A", "command": "a"},
            {"separator": True},
            {"label": "B", "command": "b"},
        ));

        # initial highlight should be on A (index 0)
        assertEq(0, dd.getHighlightIndex());

        # move down should skip separator
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        dd.processEvent(ev);
        assertEq(2, dd.getHighlightIndex());  # skips separator at index 1
    }

    testDropdownDisabled() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "A", "command": "a"},
            {"label": "B", "command": "b", "enabled": False},
            {"label": "C", "command": "c"},
        ));

        # move down should skip disabled item
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        dd.processEvent(ev);
        assertEq(2, dd.getHighlightIndex());  # skips disabled B at index 1
    }

    testDropdownPositioning() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "Open File", "command": "open"},
            {"label": "Save File", "command": "save"},
            {"label": "Close", "command": "close"},
        ));

        dd.positionAt(0, 0, 24, 80);
        hash<NcursesUi::Rect> frame = dd.getFrame();
        assertTrue(frame.rows > 0);
        assertTrue(frame.cols > 0);
        assertEq(1, frame.y);  # below anchor
    }

    testDropdownLeftRight() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "A", "command": "a"},
            {"label": "B", "command": "b"},
        ));

        string nav_direction;
        dd.setOnNavigate(sub (string dir) { nav_direction = dir; });

        # Left
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_LEFT";
        hash<NcursesUi::EventResult> result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("navigate_left", result.action);
        assertEq("left", nav_direction);

        # Right
        ev.name = "KEY_RIGHT";
        result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("navigate_right", result.action);
        assertEq("right", nav_direction);
    }

    testDropdownTabNavigation() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "A", "command": "a"},
            {"label": "B", "command": "b"},
        ));

        string nav_direction;
        dd.setOnNavigate(sub (string dir) { nav_direction = dir; });

        # Tab -> navigate right
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x09);
        hash<NcursesUi::EventResult> result = dd.processEvent(ev);
        assertTrue(result.handled, "Tab handled");
        assertEq("navigate_right", result.action);
        assertEq("right", nav_direction);

        # Shift+Tab -> navigate left
        ev = <Ncurses::InputEvent>{};
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_BTAB";
        result = dd.processEvent(ev);
        assertTrue(result.handled, "Shift+Tab handled");
        assertEq("navigate_left", result.action);
        assertEq("left", nav_direction);
    }

    testDropdownHotkey() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "Browse...", "command": "browse", "hotkey": "Alt+B"},
            {"separator": True},
            {"label": "Quit", "command": "quit", "hotkey": "Alt+Q"},
        ));

        *hash<auto> selected_item;
        dd.setOnSelect(sub (hash<auto> item) { selected_item = item; });

        # press "b" - matches "Alt+B" hotkey on Browse
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "b";
        hash<NcursesUi::EventResult> result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("select", result.action);
        assertEq("browse", selected_item.command);

        # press "q" - matches "Alt+Q" hotkey on Quit
        selected_item = NOTHING;
        ev.ch = "q";
        result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("quit", selected_item.command);

        # case-insensitive
        selected_item = NOTHING;
        ev.ch = "B";
        result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("browse", selected_item.command);

        # no match
        ev.ch = "z";
        result = dd.processEvent(ev);
        assertFalse(result.handled);
    }

    testDropdownHotkeyHint() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        list<hash<auto>> items = (
            {"label": "Browse...", "command": "browse", "hotkey": "Alt+B"},
            {"label": "Quit", "command": "quit", "hotkey": "Alt+Q"},
        );
        NcursesUi::DropdownMenuWidget dd(th.session(), items);

        # position the dropdown - should account for hotkey width
        dd.positionAt(0, 0, 24, 80);
        dd.createPanel();
        Ncurses::Window pw = dd.getWindow();
        dd.draw(pw);
        pw.noutrefresh();
        th.session().updatePanels();
        th.session().doupdate();

        # read the dropdown content from the panel window using local content rect
        hash<NcursesUi::Rect> lcr = dd.localContentRect();
        string line0 = pw.readText(lcr.y, lcr.x, lcr.cols);
        assertTrue(line0.find("Alt+B") >= 0, "hotkey hint 'Alt+B' should appear in first item");
        assertTrue(line0.find("Browse...") >= 0, "label should appear");

        string line1 = pw.readText(lcr.y + 1, lcr.x, lcr.cols);
        assertTrue(line1.find("Alt+Q") >= 0, "hotkey hint 'Alt+Q' should appear in second item");

        dd.destroyPanel();
    }

    testDropdownAltKey() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DropdownMenuWidget dd(th.session(), (
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));

        # verify Alt events are handled (consumed) even without callback
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Alt;
        ev.ch = "f";
        hash<NcursesUi::EventResult> result = dd.processEvent(ev);
        assertTrue(result.handled, "Alt events should be captured by dropdown");

        # set up Alt+key callback
        *string alt_received;
        dd.setOnAltKey(bool sub (string ch) {
            alt_received = ch;
            return True;
        });

        # Alt+key should trigger the callback
        result = dd.processEvent(ev);
        assertTrue(result.handled);
        assertEq("alt_switch", result.action);
        assertEq("f", alt_received);

        # callback returning False should still capture the event
        dd.setOnAltKey(bool sub (string ch) {
            return False;
        });
        hash<Ncurses::InputEvent> ev2();
        ev2.type = Ncurses::InputType::Alt;
        ev2.ch = "z";
        result = dd.processEvent(ev2);
        assertTrue(result.handled, "Alt should be captured even if callback returns False");
    }

