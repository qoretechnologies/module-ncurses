    # ---- ComboBoxWidget ----

    testComboBoxInit() {
        NcursesUi::ComboBoxWidget cb(("Apple", "Banana", "Cherry"));
        assertEq("", cb.getText());
        assertFalse(cb.isDropdownOpen());
        assertEq(3, cb.getOptions().size());
        assertTrue(cb.isFocusable());
    }

    testComboBoxTyping() {
        NcursesUi::ComboBoxWidget cb(("Apple", "Banana", "Cherry"));
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 30));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "B";
        cb.processEvent(ev);
        assertEq("B", cb.getText());
        assertTrue(cb.isDropdownOpen());

        ev.ch = "a";
        cb.processEvent(ev);
        assertEq("Ba", cb.getText());
    }

    testComboBoxFilter() {
        NcursesUi::ComboBoxWidget cb(("Apple", "Banana", "Cherry", "Blueberry"));
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 30));

        # type "b" - should filter to Banana, Blueberry
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "b";
        cb.processEvent(ev);

        list<string> filtered = cb.getFilteredOptions();
        assertEq(2, filtered.size());
        assertTrue(filtered[0] == "Banana" || filtered[0] == "Blueberry");
    }

    testComboBoxSelection() {
        NcursesUi::ComboBoxWidget cb(("Apple", "Banana", "Cherry"));
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 30));

        string selected;
        cb.setOnSelect(sub (string s) { selected = s; });

        # open dropdown
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        cb.processEvent(ev);  # opens dropdown, highlight 0

        # move to Banana
        cb.processEvent(ev);  # highlight 1

        # select
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        cb.processEvent(ev);

        assertEq("Banana", cb.getText());
        assertEq("Banana", selected);
        assertFalse(cb.isDropdownOpen());
    }

    testComboBoxEscape() {
        NcursesUi::ComboBoxWidget cb(("Apple", "Banana"));
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 30));

        # open dropdown
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        cb.processEvent(ev);
        assertTrue(cb.isDropdownOpen());

        # escape closes
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);
        cb.processEvent(ev);
        assertFalse(cb.isDropdownOpen());
    }

    # ---- ListWidget setSelectedIndex/wheel ----

    testListSetSelectedIndexCallback() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "A"},
            {"label": "B"},
            {"label": "C"},
        ));

        int callback_idx = -1;
        lw.setOnSelect(sub (int idx) { callback_idx = idx; });

        # setSelectedIndex to different index should fire on_select
        lw.setSelectedIndex(2);
        assertEq(2, callback_idx);

        # setSelectedIndex to same index should NOT fire on_select
        callback_idx = -1;
        lw.setSelectedIndex(2);
        assertEq(-1, callback_idx);

        # setSelectedIndex to different index again
        lw.setSelectedIndex(0);
        assertEq(0, callback_idx);

        # HOME/END (which use setSelectedIndex) should also fire
        callback_idx = -1;
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_END";
        lw.processEvent(ev);
        assertEq(2, callback_idx);
    }

    testListMouseClickCallback() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "A"},
            {"label": "B"},
            {"label": "C"},
        ));

        int callback_idx = -1;
        lw.setOnSelect(sub (int idx) { callback_idx = idx; });

        # click on item C (row 2)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        lw.processEvent(ev);
        assertEq(2, lw.getSelectedIndex());
        assertEq(2, callback_idx);
    }

    testListWheelMovesSelection() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);
        lw.setWheelMovesSelection(True);
        assertTrue(lw.getWheelMovesSelection());

        # wheel down should move selection, not scroll
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;
        mouse.button_state = Ncurses::BUTTON5_PRESSED;
        ev.mouse = mouse;

        lw.processEvent(ev);
        assertEq(1, lw.getSelectedIndex());

        # wheel up should move selection back
        mouse.button_state = Ncurses::BUTTON4_PRESSED;
        ev.mouse = mouse;
        lw.processEvent(ev);
        assertEq(0, lw.getSelectedIndex());
    }

    testListWheelDefaultScrolls() {
        NcursesUi::ListWidget lw();
        # default flag should be False
        assertFalse(lw.getWheelMovesSelection());

        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);

        # wheel down with default (False) should scroll, not move selection
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;
        mouse.button_state = Ncurses::BUTTON5_PRESSED;
        ev.mouse = mouse;

        lw.processEvent(ev);
        assertEq(0, lw.getSelectedIndex());  # selection unchanged
        assertEq(3, lw.getScrollOffset());  # scroll changed
    }

    # ---- FileBrowserWidget ----

    testFileBrowserCreation() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");
        assertEq("/tmp", fb.getCurrentDir());
        assertFalse(fb.isShowHidden());
        assertTrue(fb.getFileList().getItems().size() >= 1);  # at least ".."

        # should have both children: file_list and preview_widget
        assertEq(2, fb.getChildren().size());

        # should be closable by default
        assertTrue(fb.isClosable());

        # focused pane starts at 0 (file list)
        assertEq(0, fb.getFocusedPane());

        # title should include directory
        assertTrue(fb.getTitle().find("File Browser") >= 0);
        assertTrue(fb.getTitle().find("/tmp") >= 0);
    }

    testFileBrowserHidden() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");
        int count_without = fb.getFileList().getItems().size();

        fb.toggleHidden();
        assertTrue(fb.isShowHidden());
        int count_with = fb.getFileList().getItems().size();
        assertTrue(count_with >= count_without);
    }

    /** Test split layout with file list and preview pane. */
    testFileBrowserSplitLayout() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");
        fb.setFrame(NcursesUi::Geometry::makeRect(2, 5, 20, 70));
        fb.createPanel();

        # draw to set child frames
        fb.drawTree(th.screen());
        th.refresh();

        # file list and preview should have frames set
        NcursesUi::ListWidget fl = fb.getFileList();
        NcursesUi::ScrollableWidget pw = fb.getPreviewWidget();

        hash<NcursesUi::Rect> lf = fl.getFrame();
        hash<NcursesUi::Rect> pf = pw.getFrame();

        # both should have positive dimensions
        assertTrue(lf.rows > 0, "file list should have rows");
        assertTrue(lf.cols > 0, "file list should have cols");
        assertTrue(pf.rows > 0, "preview should have rows");
        assertTrue(pf.cols > 0, "preview should have cols");

        # file list should be left, preview right
        assertTrue(pf.x > lf.x, "preview should be to the right of file list");

        # combined width should fit in content area (minus borders and divider)
        assertTrue(lf.cols + pf.cols + 1 <= 68, "panes should fit in content area");

        fb.destroyPanel();
    }

    /** Test file preview loads content for selected file. */
    testFileBrowserPreview() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        # use the project's test directory which has known files
        string test_dir = getcwd() + "/test";
        if (!is_dir(test_dir)) {
            test_dir = "/tmp";
        }

        NcursesUi::FileBrowserWidget fb(th.session(), test_dir);

        # preview should start empty
        NcursesUi::LineListContent pc = fb.getPreviewContent();
        assertEq(0, pc.lineCount());

        # navigate selection to a file (skip ".." at index 0)
        NcursesUi::ListWidget fl = fb.getFileList();
        if (fl.getItems().size() > 1) {
            # find a file (not directory)
            for (int i = 0; i < fl.getItems().size(); ++i) {
                if (!fl.getItems()[i].is_dir) {
                    fl.setSelectedIndex(i);
                    # setSelectedIndex now fires on_select, which triggers preview loading
                    break;
                }
            }
        }

        # preview widget should exist
        assertTrue(exists fb.getPreviewWidget());
    }

    /** Test Tab toggles focus between file list and preview pane. */
    testFileBrowserTabNavigation() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        # create a temp directory structure for testing
        string temp_dir = "/tmp/fb_tab_" + string(getpid());
        string sub_dir = temp_dir + "/subdir";
        mkdir(temp_dir, 0755);
        mkdir(sub_dir, 0755);
        on_exit {
            rmdir(sub_dir);
            rmdir(temp_dir);
        }

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        assertEq(0, fb.getFocusedPane());
        string original_dir = fb.getCurrentDir();

        # select the subdir entry
        NcursesUi::ListWidget fl = fb.getFileList();
        int sub_idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "subdir") {
                sub_idx = i;
                break;
            }
        }
        assertTrue(sub_idx >= 0, "subdir should be in listing");
        fl.setSelectedIndex(sub_idx);

        # Tab should navigate into the subdir
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x09);  # Tab
        hash<NcursesUi::EventResult> result = fb.processEvent(ev);
        assertTrue(result.handled);
        assertEq("navigate_forward", result.action);
        assertEq(realpath(sub_dir), fb.getCurrentDir());

        # history should contain the original dir
        assertEq(1, fb.getDirHistory().size());

        # Shift+Tab should navigate back
        hash<Ncurses::InputEvent> ev2();
        ev2.type = Ncurses::InputType::Key;
        ev2.name = "KEY_BTAB";
        result = fb.processEvent(ev2);
        assertTrue(result.handled);
        assertEq("navigate_back", result.action);
        assertEq(original_dir, fb.getCurrentDir());

        # history should be empty now
        assertEq(0, fb.getDirHistory().size());

        # Shift+Tab with empty history should still be handled
        result = fb.processEvent(ev2);
        assertTrue(result.handled);
        assertEq("navigate_back", result.action);

        # Tab on a non-directory item should not navigate
        # select a non-dir entry if available, or just verify it's handled
        result = fb.processEvent(ev);
        assertTrue(result.handled, "Tab on non-dir should still be handled");
    }

    /** Test Qore file activation calls on_load callback. */
    testFileBrowserQoreLoad() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        # create a temp Qore file for testing
        string temp_dir = "/tmp/fb_test_" + string(getpid());
        mkdir(temp_dir, 0755);
        on_exit {
            unlink(temp_dir + "/test.qr");
            rmdir(temp_dir);
        }
        File f();
        f.open(temp_dir + "/test.qr", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write("# test qore file\n");
        f.close();

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);

        *hash<auto> loaded_item;
        fb.setOnLoad(sub (hash<auto> item) {
            loaded_item = item;
        });

        # find the .qr file in the list
        NcursesUi::ListWidget fl = fb.getFileList();
        int qr_idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "test.qr") {
                qr_idx = i;
                break;
            }
        }
        assertTrue(qr_idx >= 0, "test.qr should be in file list");

        # select and activate
        fl.setSelectedIndex(qr_idx);

        # simulate Enter on the file list
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        fb.processEvent(ev);

        assertTrue(exists loaded_item, "on_load should have been called");
        assertEq("test.qr", loaded_item.label);
        assertTrue(loaded_item.path.find("test.qr") >= 0);
    }

    /** Test Escape calls on_dismiss callback. */
    testFileBrowserDismiss() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");

        bool dismissed = False;
        fb.setOnDismiss(sub () {
            dismissed = True;
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = chr(0x1b);  # Escape
        hash<NcursesUi::EventResult> result = fb.processEvent(ev);
        assertTrue(result.handled);
        assertEq("close", result.action);
        assertTrue(dismissed);
    }

    /** Test status line text updates based on selection. */
    testFileBrowserStatusLine() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");

        # status text should contain keyboard hints
        string status = fb.getStatusText();
        assertTrue(status.find("Esc:Close") >= 0, "status should contain Esc hint");
        assertTrue(status.find(".:Hidden") >= 0, "status should contain . hint");

        # for directory selection, should have Enter/Tab:Open
        *hash<auto> item = fb.getSelectedFile();
        if (item && item.is_dir) {
            assertTrue(status.find("Enter/Tab:Open") >= 0, "status should contain Enter/Tab:Open for dirs");
        }

        # S-Tab:Back should only appear when there's history
        assertFalse(status.find("S-Tab:Back") >= 0, "no S-Tab when no history");
    }

    /** Test isQoreFile identifies Qore source file extensions. */
    testFileBrowserIsQoreFile() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");

        assertTrue(fb.isQoreFile("test.q"));
        assertTrue(fb.isQoreFile("mod.qm"));
        assertTrue(fb.isQoreFile("class.qc"));
        assertTrue(fb.isQoreFile("script.qr"));
        assertTrue(fb.isQoreFile("suite.qtest"));
        assertFalse(fb.isQoreFile("readme.md"));
        assertFalse(fb.isQoreFile("main.cpp"));
        assertFalse(fb.isQoreFile("data.json"));
        assertFalse(fb.isQoreFile("q"));  # too short
    }

    /** Test '.' key toggles hidden files. */
    testFileBrowserDotToggle() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::FileBrowserWidget fb(th.session(), "/tmp");
        assertFalse(fb.isShowHidden());

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = ".";
        hash<NcursesUi::EventResult> result = fb.processEvent(ev);
        assertTrue(result.handled);
        assertTrue(fb.isShowHidden());

        # toggle back
        result = fb.processEvent(ev);
        assertTrue(result.handled);
        assertFalse(fb.isShowHidden());
    }

    /** Test identifyFileType returns "binary" for known binary extensions. */
    testFileBrowserBinaryExtension() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        # create a temp dir with files of binary extensions
        string temp_dir = "/tmp/fb_binary_ext_" + string(getpid());
        mkdir(temp_dir, 0755);
        on_exit {
            unlink(temp_dir + "/test.o");
            unlink(temp_dir + "/image.png");
            unlink(temp_dir + "/archive.gz");
            unlink(temp_dir + "/doc.pdf");
            unlink(temp_dir + "/video.mp4");
            unlink(temp_dir + "/normal.txt");
            unlink(temp_dir + "/script.qr");
            rmdir(temp_dir);
        }

        # create dummy files
        list<string> binary_names = ("test.o", "image.png", "archive.gz", "doc.pdf", "video.mp4");
        foreach string name in (binary_names) {
            File f();
            f.open(temp_dir + "/" + name, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write("data\n");
            f.close();
        }
        list<string> text_names = ("normal.txt", "script.qr");
        foreach string name in (text_names) {
            File f();
            f.open(temp_dir + "/" + name, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write("text data\n");
            f.close();
        }

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();
        list<hash<auto>> items = fl.getItems();

        # verify binary files have type "binary"
        foreach hash<auto> item in (items) {
            if (item.label == "test.o" || item.label == "image.png" || item.label == "archive.gz"
                    || item.label == "doc.pdf" || item.label == "video.mp4") {
                assertEq("binary", item.type, sprintf("'%s' should be type 'binary'", item.label));
            } else if (item.label == "normal.txt") {
                assertEq("text", item.type, "'normal.txt' should be type 'text'");
            } else if (item.label == "script.qr") {
                assertEq("qore", item.type, "'script.qr' should be type 'qore'");
            }
        }
    }

    /** Test binary files show "(Binary file)" in preview, not raw content. */
    testFileBrowserBinaryPreview() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        string temp_dir = "/tmp/fb_binary_prev_" + string(getpid());
        mkdir(temp_dir, 0755);
        on_exit {
            unlink(temp_dir + "/test.o");
            rmdir(temp_dir);
        }

        # create a file with binary extension
        File f();
        f.open(temp_dir + "/test.o", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write("binary content here\n");
        f.close();

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();

        # find test.o in the list
        int idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "test.o") {
                idx = i;
                break;
            }
        }
        assertTrue(idx >= 0, "test.o should be in file list");

        # select the binary file
        fl.setSelectedIndex(idx);

        # preview should show binary message
        NcursesUi::LineListContent pc = fb.getPreviewContent();
        assertTrue(pc.lineCount() >= 1, "preview should have content");
        assertEq("(Binary file)", pc.getLines()[0]);
    }

    /** Test files without binary extension but with null bytes are detected as binary. */
    testFileBrowserBinaryContentDetection() {
        NcursesUi::TestHarness th(24, 80);
