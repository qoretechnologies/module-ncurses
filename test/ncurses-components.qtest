    /** Test directory preview respects show_hidden flag. */
    testFileBrowserDirectoryPreviewHidden() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        string temp_dir = "/tmp/fb_dir_hidden_" + string(getpid());
        mkdir(temp_dir, 0755);
        mkdir(temp_dir + "/testdir", 0755);
        on_exit {
            unlink(temp_dir + "/testdir/.hidden");
            unlink(temp_dir + "/testdir/visible.txt");
            rmdir(temp_dir + "/testdir");
            rmdir(temp_dir);
        }

        # create a hidden and visible file in testdir
        File f();
        f.open(temp_dir + "/testdir/.hidden", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write("hidden\n");
        f.close();

        File f2();
        f2.open(temp_dir + "/testdir/visible.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f2.write("visible\n");
        f2.close();

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();

        # find "testdir" in the list
        int idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "testdir") {
                idx = i;
                break;
            }
        }
        assertTrue(idx >= 0, "testdir should be in file list");

        # select the directory (hidden files should be hidden by default)
        fl.setSelectedIndex(idx);

        NcursesUi::LineListContent pc = fb.getPreviewContent();
        # should show visible.txt but not .hidden
        bool found_visible = False;
        bool found_hidden = False;
        for (int i = 0; i < pc.lineCount(); ++i) {
            string line = pc.getLines()[i];
            if (line.find("visible.txt") >= 0) {
                found_visible = True;
            }
            if (line.find(".hidden") >= 0) {
                found_hidden = True;
            }
        }
        assertTrue(found_visible, "should show visible.txt");
        assertFalse(found_hidden, "should NOT show .hidden when show_hidden is False");

        # toggle hidden files on and re-find the directory (listing is refreshed)
        fb.toggleHidden();
        idx = -1;
        for (int i = 0; i < fl.getItems().size(); ++i) {
            if (fl.getItems()[i].label == "testdir") {
                idx = i;
                break;
            }
        }
        assertTrue(idx >= 0, "testdir should still be in file list after toggleHidden");
        # force re-selection by moving away first (setSelectedIndex ignores same index)
        fl.setSelectedIndex(idx == 0 ? 1 : 0);
        fl.setSelectedIndex(idx);

        pc = fb.getPreviewContent();
        found_hidden = False;
        for (int i = 0; i < pc.lineCount(); ++i) {
            if (pc.getLines()[i].find(".hidden") >= 0) {
                found_hidden = True;
                break;
            }
        }
        assertTrue(found_hidden, "should show .hidden when show_hidden is True");
    }

    /** Test ListWidget custom render item style callback. */
    testListWidgetRenderItemStyle() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 30));
        lw.setItems((
            {"label": "Dir Entry", "is_dir": True},
            {"label": "File Entry", "is_dir": False},
        ));

        # set custom style callback
        bool callback_called = False;
        list<hash<auto>> style_calls = ();
        lw.setRenderItemStyle(hash<auto> sub (hash<auto> item, int idx, bool selected) {
            callback_called = True;
            style_calls += {"label": item.label, "idx": idx, "selected": selected};
            if (item.is_dir) {
                return {"fg": Ncurses::Color::Cyan};
            }
            return {};
        });

        # draw triggers the callback
        lw.draw(th.session().screen());
        th.session().doupdate();

        assertTrue(callback_called, "render_item_style callback should be called during draw");
        assertTrue(style_calls.size() >= 2, "callback should be called for each visible item");

        # first item is selected (index 0)
        assertEq("Dir Entry", style_calls[0].label);
        assertEq(0, style_calls[0].idx);
        assertTrue(style_calls[0].selected);

        # second item is not selected
        assertEq("File Entry", style_calls[1].label);
        assertEq(1, style_calls[1].idx);
        assertFalse(style_calls[1].selected);
    }

    testListWidgetScrollbarClick() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 30));

        # 20 items in 5-row viewport = scrollbar shown
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %02d", i)};
        }
        lw.setItems(items);
        assertEq(0, lw.getScrollOffset());

        # click on scrollbar column (col 29) at bottom row (row 4)
        hash<Ncurses::MouseEvent> mouse({"x": 29, "y": 4, "button_state": Ncurses::BUTTON1_CLICKED});
        hash<Ncurses::InputEvent> ev({"type": Ncurses::InputType::Mouse, "mouse": mouse});
        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
        assertTrue(result.handled, "scrollbar click handled");
        assertTrue(lw.getScrollOffset() > 0, "scrollbar click scrolled down");

        # click on scrollbar at top row (row 0)
        mouse = <Ncurses::MouseEvent>{"x": 29, "y": 0, "button_state": Ncurses::BUTTON1_CLICKED};
        ev = <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": mouse};
        result = lw.processEvent(ev);
        assertTrue(result.handled, "scrollbar top click handled");
        assertEq(0, lw.getScrollOffset(), "scrollbar top click scrolls to top");

        # click on content area (col 28, not scrollbar) selects item, not scrollbar
        mouse = <Ncurses::MouseEvent>{"x": 28, "y": 2, "button_state": Ncurses::BUTTON1_CLICKED};
        ev = <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": mouse};
        result = lw.processEvent(ev);
        assertTrue(result.handled, "content click handled");
        assertEq(2, lw.getSelectedIndex(), "click on content selects item");

        # no scrollbar when items fit - click on col 29 not handled as scrollbar
        lw.setItems(({"label": "A"}, {"label": "B"}));
        mouse = <Ncurses::MouseEvent>{"x": 29, "y": 0, "button_state": Ncurses::BUTTON1_CLICKED};
        ev = <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse, "mouse": mouse};
        result = lw.processEvent(ev);
        # should select item at row 0 (no scrollbar, so col 29 is content area)
        assertTrue(result.handled, "click handled when no scrollbar");
        assertEq(0, lw.getSelectedIndex());
    }

    /** Test FileBrowserWidget applies colorized styles to entries. */
    testFileBrowserColorizedEntries() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        string temp_dir = "/tmp/fb_color_" + string(getpid());
        mkdir(temp_dir, 0755);
        mkdir(temp_dir + "/mydir", 0755);
        on_exit {
            unlink(temp_dir + "/test.qr");
            unlink(temp_dir + "/test.o");
            unlink(temp_dir + "/test.txt");
            rmdir(temp_dir + "/mydir");
            rmdir(temp_dir);
        }

        # create test files
        list<string> filenames = ("test.qr", "test.o", "test.txt");
        foreach string name in (filenames) {
            File f();
            f.open(temp_dir + "/" + name, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write("data\n");
            f.close();
        }

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();
        list<hash<auto>> items = fl.getItems();

        # verify items have correct types for coloring
        foreach hash<auto> item in (items) {
            if (item.label == "mydir") {
                assertTrue(item.is_dir, "mydir should be a directory");
                assertEq("dir", item.type);
            } else if (item.label == "test.qr") {
                assertEq("qore", item.type, "test.qr should be type 'qore'");
            } else if (item.label == "test.o") {
                assertEq("binary", item.type, "test.o should be type 'binary'");
            } else if (item.label == "test.txt") {
                assertEq("text", item.type, "test.txt should be type 'text'");
            }
        }

        # verify the style callback is set by drawing
        fb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 20, 70));
        fb.createPanel();
        fb.drawTree(th.screen());
        th.refresh();

        # if we got here without error, the style callback is working
        fb.destroyPanel();
    }
}
