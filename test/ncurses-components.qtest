        # create a file without binary extension but with null bytes
        File f();
        f.open(temp_dir + "/sneaky_binary", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(<48656c6c6f00576f726c64>);  # "Hello\0World" in hex
        f.close();

        NcursesUi::FileBrowserWidget fb(th.session(), temp_dir);
        NcursesUi::ListWidget fl = fb.getFileList();

        # find sneaky_binary in the list
