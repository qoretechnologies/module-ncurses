    # ---- CheckboxWidget ----

    testCheckboxInit() {
        NcursesUi::CheckboxWidget cb("Enable logging");
        assertFalse(cb.isChecked());
        assertEq("Enable logging", cb.getLabel());
        assertTrue(cb.isFocusable());

        NcursesUi::CheckboxWidget cb2("Active", True);
        assertTrue(cb2.isChecked());
    }

    testCheckboxToggle() {
        NcursesUi::CheckboxWidget cb("Test");
        assertFalse(cb.isChecked());

        bool callback_value;
        cb.setOnToggle(sub (bool v) { callback_value = v; });

        cb.toggle();
        assertTrue(cb.isChecked());
        assertTrue(callback_value);

        cb.toggle();
        assertFalse(cb.isChecked());
        assertFalse(callback_value);
    }

    testCheckboxKeyboard() {
        NcursesUi::CheckboxWidget cb("Test");

        # Space toggles
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        hash<NcursesUi::EventResult> result = cb.processEvent(ev);
        assertTrue(result.handled);
        assertEq("toggle", result.action);
        assertTrue(cb.isChecked());

        # Enter toggles
        ev.ch = "\n";
        result = cb.processEvent(ev);
        assertTrue(result.handled);
        assertFalse(cb.isChecked());

        # Other chars not handled
        ev.ch = "x";
        result = cb.processEvent(ev);
        assertFalse(result.handled);
    }

    testCheckboxMouse() {
        NcursesUi::CheckboxWidget cb("Test");
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 20));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 0;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = cb.processEvent(ev);
        assertTrue(result.handled);
        assertTrue(cb.isChecked());
    }

    testCheckboxDraw() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::CheckboxWidget cb("Debug mode");
        cb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 30));
        cb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find("[ ]") >= 0);
        assertTrue(row.find("Debug mode") >= 0);

        cb.toggle();
        cb.draw(th.session().screen());
        th.session().doupdate();

        row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find("[X]") >= 0);
    }

    # ---- RadioGroupWidget ----

    testRadioGroupInit() {
        NcursesUi::RadioGroupWidget rg(("Option A", "Option B", "Option C"));
        assertEq(0, rg.getSelectedIndex());
        assertEq("Option A", rg.getSelectedOption());
        assertEq(0, rg.getHighlightIndex());
        assertTrue(rg.isFocusable());

        NcursesUi::RadioGroupWidget rg2(("X", "Y", "Z"), 2);
        assertEq(2, rg2.getSelectedIndex());
        assertEq("Z", rg2.getSelectedOption());
    }

    testRadioGroupKeyNav() {
        NcursesUi::RadioGroupWidget rg(("A", "B", "C"));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";

        hash<NcursesUi::EventResult> result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq(1, rg.getHighlightIndex());

        result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq(2, rg.getHighlightIndex());

        # should not go past end
        result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq(2, rg.getHighlightIndex());

        # up
        ev.name = "KEY_UP";
        result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq(1, rg.getHighlightIndex());
    }

    testRadioGroupSelection() {
        NcursesUi::RadioGroupWidget rg(("A", "B", "C"));
        int selected_idx = -1;
        rg.setOnSelect(sub (int idx) { selected_idx = idx; });

        # navigate to B
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        rg.processEvent(ev);

        # select with Space
        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        hash<NcursesUi::EventResult> result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq("select", result.action);
        assertEq(1, rg.getSelectedIndex());
        assertEq("B", rg.getSelectedOption());
        assertEq(1, selected_idx);
    }

    testRadioGroupMouse() {
        NcursesUi::RadioGroupWidget rg(("A", "B", "C"));
        rg.setFrame(NcursesUi::Geometry::makeRect(0, 0, 3, 20));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;  # click on C (row 2)
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = rg.processEvent(ev);
        assertTrue(result.handled);
        assertEq(2, rg.getSelectedIndex());
        assertEq("C", rg.getSelectedOption());
    }

    testRadioGroupEmpty() {
        NcursesUi::RadioGroupWidget rg(());

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = " ";
        hash<NcursesUi::EventResult> result = rg.processEvent(ev);
        assertFalse(result.handled);
    }

    testRadioGroupDraw() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::RadioGroupWidget rg(("Alpha", "Beta"), 0);
        rg.setFrame(NcursesUi::Geometry::makeRect(0, 0, 2, 20));
        rg.draw(th.session().screen());
        th.session().doupdate();

        string row0 = th.session().screen().readText(0, 0, 20);
        assertTrue(row0.find("(o)") >= 0);
        assertTrue(row0.find("Alpha") >= 0);

        string row1 = th.session().screen().readText(1, 0, 20);
        assertTrue(row1.find("( )") >= 0);
        assertTrue(row1.find("Beta") >= 0);
    }

    # ---- StatusBarWidget ----

    testStatusBarSegments() {
        NcursesUi::StatusBarWidget sb();
        assertEq(0, sb.getSegments().size());

        list<hash<auto>> segs = (
            {"text": "Ready", "align": "left"},
            {"text": "Line 1", "align": "right"},
        );
        sb.setSegments(segs);
        assertEq(2, sb.getSegments().size());
    }

    testStatusBarDraw() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::StatusBarWidget sb();
        sb.setFrame(NcursesUi::Geometry::makeRect(23, 0, 1, 80));
        sb.setSegments((
            {"text": "STATUS"},
        ));
        sb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(23, 0, 20);
        assertTrue(row.find("STATUS") >= 0);
    }

    testStatusBarRightAlign() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::StatusBarWidget sb();
        sb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        sb.setSegments((
            {"text": "LEFT"},
            {"text": "RIGHT", "align": "right"},
        ));
        sb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 40);
        assertTrue(row.find("LEFT") >= 0);
        assertTrue(row.find("RIGHT") >= 0);
        # RIGHT should be at the end
        int right_pos = row.find("RIGHT");
        int left_pos = row.find("LEFT");
        assertTrue(right_pos > left_pos);
    }

    testStatusBarSpacing() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::StatusBarWidget sb();
        sb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));

        # default spacing is 1
        assertEq(1, sb.getSegmentSpacing());

        # set segments and draw with default spacing
        sb.setSegments((
            {"text": "AAA"},
            {"text": "BBB"},
        ));
        sb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 10);
        # with spacing=1, there should be a gap between AAA and BBB
        # "AAA BBB" (space between)
        assertTrue(row.find("AAA") >= 0);
        assertTrue(row.find("BBB") >= 0);
        int aaa_pos = row.find("AAA");
        int bbb_pos = row.find("BBB");
        # BBB starts at AAA_pos + 3 (len) + 1 (spacing) = AAA_pos + 4
        assertEq(aaa_pos + 4, bbb_pos);

        # custom spacing
        sb.setSegmentSpacing(3);
        assertEq(3, sb.getSegmentSpacing());
        sb.draw(th.session().screen());
        th.session().doupdate();

        row = th.session().screen().readText(0, 0, 15);
        aaa_pos = row.find("AAA");
        bbb_pos = row.find("BBB");
        # BBB starts at AAA_pos + 3 + 3 = AAA_pos + 6
        assertEq(aaa_pos + 6, bbb_pos);

        # zero spacing
        sb.setSegmentSpacing(0);
        sb.draw(th.session().screen());
        th.session().doupdate();

        row = th.session().screen().readText(0, 0, 10);
        aaa_pos = row.find("AAA");
        bbb_pos = row.find("BBB");
        assertEq(aaa_pos + 3, bbb_pos);
    }

    testStatusBarDefaultStyle() {
        NcursesUi::StatusBarWidget sb();
        # default segment spacing should be 1
        assertEq(1, sb.getSegmentSpacing());

        # draw with default bg_style should not crash
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        sb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 40));
        sb.setSegments(({"text": "Test"},));
        sb.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 10);
        assertTrue(row.find("Test") >= 0);
    }

    # ---- ListWidget ----

    testListInit() {
        NcursesUi::ListWidget lw();
        assertTrue(lw.isFocusable());
        assertEq(-1, lw.getSelectedIndex());
        assertEq(0, lw.getItems().size());
        assertFalse(exists lw.getSelectedItem());
    }

    testListSetItems() {
        NcursesUi::ListWidget lw();
        lw.setItems((
            {"label": "Apple"},
            {"label": "Banana"},
            {"label": "Cherry"},
        ));
        assertEq(3, lw.getItems().size());
        assertEq(0, lw.getSelectedIndex());
        assertEq("Apple", lw.getSelectedItem().label);
    }

    testListKeyNav() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "A"},
            {"label": "B"},
            {"label": "C"},
        ));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
        assertTrue(result.handled);
        assertEq(1, lw.getSelectedIndex());

        result = lw.processEvent(ev);
        assertEq(2, lw.getSelectedIndex());

        # clamp at end
        result = lw.processEvent(ev);
        assertEq(2, lw.getSelectedIndex());

        # up
        ev.name = "KEY_UP";
        result = lw.processEvent(ev);
        assertEq(1, lw.getSelectedIndex());
    }

    testListPageNav() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_NPAGE";
        lw.processEvent(ev);
        assertEq(5, lw.getSelectedIndex());

        ev.name = "KEY_PPAGE";
        lw.processEvent(ev);
        assertEq(0, lw.getSelectedIndex());
    }

    testListHomeEnd() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_END";
        lw.processEvent(ev);
        assertEq(19, lw.getSelectedIndex());

        ev.name = "KEY_HOME";
        lw.processEvent(ev);
        assertEq(0, lw.getSelectedIndex());
    }

    testListActivate() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));

        *hash<auto> activated_item;
        lw.setOnActivate(sub (hash<auto> item) {
            activated_item = item;
        });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Char;
        ev.ch = "\n";
        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
        assertTrue(result.handled);
        assertEq("activate", result.action);
        assertEq("open", activated_item.command);
    }

    testListMouseClick() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "A"},
            {"label": "B"},
            {"label": "C"},
        ));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;  # click on C
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
        assertTrue(result.handled);
        assertEq(2, lw.getSelectedIndex());
    }

    testListMouseWheel() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 5, 40));
        list<hash<auto>> items = ();
        for (int i = 0; i < 20; ++i) {
            items += {"label": sprintf("Item %d", i)};
        }
        lw.setItems(items);

        # wheel down
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 5;
        mouse.y = 2;
        mouse.button_state = Ncurses::BUTTON5_PRESSED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
        assertTrue(result.handled);
        assertEq(3, lw.getScrollOffset());

        # wheel up
        mouse.button_state = Ncurses::BUTTON4_PRESSED;
        ev.mouse = mouse;
        result = lw.processEvent(ev);
        assertTrue(result.handled);
        assertEq(0, lw.getScrollOffset());
    }

    testListSelectCallback() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems((
            {"label": "A"},
            {"label": "B"},
        ));

        int callback_idx = -1;
        lw.setOnSelect(sub (int idx) { callback_idx = idx; });

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        lw.processEvent(ev);
        assertEq(1, callback_idx);
    }

    testListCustomRender() {
        NcursesUi::ListWidget lw();
        lw.setRenderItem(string sub (hash<auto> item, int idx, bool selected) {
            return sprintf("[%d] %s", idx, item.label);
        });

        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));
        lw.setItems(({"label": "Test"},));

        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();
        lw.draw(th.session().screen());
        th.session().doupdate();

        string row = th.session().screen().readText(0, 0, 20);
        assertTrue(row.find("[0] Test") >= 0);
    }

    testListEmpty() {
        NcursesUi::ListWidget lw();
        lw.setFrame(NcursesUi::Geometry::makeRect(0, 0, 10, 40));

        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_DOWN";
        hash<NcursesUi::EventResult> result = lw.processEvent(ev);
