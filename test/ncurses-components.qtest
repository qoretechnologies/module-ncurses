    testDialogCenteredTitle() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Quit", "Exit?", ("OK",));
        # dialog should have center_title enabled by default
        assertTrue(dlg.getCenterTitle());

        dlg.centerOn(24, 80);
        dlg.createPanel();
        dlg.drawTree(th.screen());
        th.refresh();

        # read the title row from the panel window
        Ncurses::Window pw = dlg.getWindow();
        hash<Ncurses::Size> sz = pw.size();
        string title_row = pw.readText(0, 0, sz.cols);
        int title_pos = title_row.find("Quit");
        assertTrue(title_pos >= 0, "title should be present: " + title_row);
        # centered: " Quit " is 6 chars, in a 24+ col dialog, pos should be > 5
        assertTrue(title_pos > 5, sprintf("title 'Quit' should be centered (pos %d), got: '%s'",
            title_pos, title_row));
        dlg.destroyPanel();
    }

    testDialogCenteredMessage() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test", "Hi", ("OK",));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        dlg.drawTree(th.screen());
        th.refresh();

        # read content rows from the panel window
        Ncurses::Window pw = dlg.getWindow();
        hash<Ncurses::Size> sz = pw.size();
        # message "Hi" (2 chars) should be centered in the content area
        # find it in the panel content
        string all_text = "";
        for (int r = 1; r < sz.rows - 1; ++r) {
            string row = pw.readText(r, 0, sz.cols);
            if (row.find("Hi") >= 0) {
                int hi_pos = row.find("Hi");
                # in a 24+ col dialog, "Hi" should not be at position 1 (left edge of content)
                assertTrue(hi_pos > 3, sprintf("message 'Hi' should be centered (pos %d) in row: '%s'",
                    hi_pos, row));
                all_text = row;
                break;
            }
        }
        assertTrue(all_text.length() > 0, "message 'Hi' should be found in dialog");
        dlg.destroyPanel();
    }

    testDialogCenteredButtons() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test", "Message", ("OK", "Cancel"));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        dlg.drawTree(th.screen());
        th.refresh();

        Ncurses::Window pw = dlg.getWindow();
        hash<Ncurses::Size> sz = pw.size();
        # find the button row
        bool found_buttons = False;
        for (int r = 1; r < sz.rows - 1; ++r) {
            string row = pw.readText(r, 0, sz.cols);
            if (row.find("[ OK ]") >= 0) {
                int ok_pos = row.find("[ OK ]");
                # buttons should not start at the left edge
                assertTrue(ok_pos > 2, sprintf("buttons should be centered (OK at pos %d): '%s'",
                    ok_pos, row));
                # Cancel should also be present
                assertTrue(row.find("[ Cancel ]") >= 0, "Cancel button should be present: " + row);
                found_buttons = True;
                break;
            }
        }
        assertTrue(found_buttons, "buttons should be found in dialog panel");
        dlg.destroyPanel();
    }

    testDialogMouseClick() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test", "Click me", ("OK", "Cancel"));
        dlg.centerOn(24, 80);
        dlg.createPanel();

        int pressed_idx = -1;
        string pressed_label;
        dlg.setOnButton(sub (int idx, string label) {
            pressed_idx = idx;
            pressed_label = label;
        });

        # draw via drawTree to populate button_rects correctly
        dlg.drawTree(th.screen());
        th.refresh();

        # get button rects
        list<hash<NcursesUi::Rect>> rects = dlg.getButtonRects();
        assertEq(2, rects.size());

        # simulate clicking on the Cancel button (second button)
        hash<NcursesUi::Rect> f = dlg.getFrame();
        hash<NcursesUi::Rect> cancel_rect = rects[1];
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = f.x + cancel_rect.x + 2;  # +2 for "[ "
        mouse.y = f.y + cancel_rect.y;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = dlg.processEvent(ev);
        assertTrue(result.handled);
        assertEq("button", result.action);
        assertEq(1, pressed_idx);
        assertEq("Cancel", pressed_label);

        dlg.destroyPanel();
    }

    testDialogMouseNonButton() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Test", "msg", ("OK",));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        dlg.drawTree(th.screen());

        # click inside dialog but not on button (message area)
        hash<NcursesUi::Rect> f = dlg.getFrame();
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = f.x + 2;
        mouse.y = f.y + 2;  # message area
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = dlg.processEvent(ev);
        assertTrue(result.handled);
        assertFalse(exists result.action);  # consumed but no action

        dlg.destroyPanel();
    }

    testDialogPadding() {
        NcursesUi::TestHarness th(24, 80);
        on_exit th.close();

        NcursesUi::DialogWidget dlg(th.session(), "Pad", "X", ("OK",));
        dlg.centerOn(24, 80);
        dlg.createPanel();
        dlg.drawTree(th.screen());
        th.refresh();

        # dialog with 1-line message should have height >= 7
        # (border 2 + pad_top 1 + msg 1 + gap 1 + buttons 1 + pad_bottom 1 = 7)
        hash<NcursesUi::Rect> f = dlg.getFrame();
        assertTrue(f.rows >= 7, sprintf("dialog height should be >= 7 (got %d)", f.rows));

        # dialog width should be >= 24
        assertTrue(f.cols >= 24, sprintf("dialog width should be >= 24 (got %d)", f.cols));

        # message "X" should NOT be on row 1 (directly below border) - should be on row 2 (after padding)
        Ncurses::Window pw = dlg.getWindow();
        string row1 = pw.readText(1, 0, f.cols);
        string row2 = pw.readText(2, 0, f.cols);
        # row1 should be blank (top padding)
        assertFalse(row1.find("X") >= 0,
            sprintf("row 1 should be blank (top padding) but got: '%s'", row1));
        # row2 should contain the message
        assertTrue(row2.find("X") >= 0,
            sprintf("row 2 should contain message 'X' but got: '%s'", row2));

        dlg.destroyPanel();
    }

    # ---- MenuBarWidget ----

    testMenuBarAdd() {
        NcursesUi::MenuBarWidget mb();
        mb.addMenu("File", (
            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));
        mb.addMenu("Edit", (
            {"label": "Copy", "command": "copy"},
        ));
        assertEq(2, mb.getMenus().size());
        assertEq("File", mb.getMenus()[0].label);
        assertEq("Edit", mb.getMenus()[1].label);
    }

    testMenuBarKeyNav() {
        NcursesUi::MenuBarWidget mb();
        mb.addMenu("File", ());
        mb.addMenu("Edit", ());
        mb.addMenu("Help", ());

        # initially no active menu
        assertEq(-1, mb.getActiveMenu());

        # open first menu
        mb.openMenu(0);
        assertEq(0, mb.getActiveMenu());

        # navigate right
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Key;
        ev.name = "KEY_RIGHT";
        mb.processEvent(ev);
        assertEq(1, mb.getActiveMenu());

        mb.processEvent(ev);
        assertEq(2, mb.getActiveMenu());

        # clamp at end
        mb.processEvent(ev);
        assertEq(2, mb.getActiveMenu());

        # left
        ev.name = "KEY_LEFT";
        mb.processEvent(ev);
        assertEq(1, mb.getActiveMenu());
    }

    testMenuBarMouse() {
        NcursesUi::MenuBarWidget mb();
        mb.setFrame(NcursesUi::Geometry::makeRect(0, 0, 1, 80));
        mb.addMenu("File", ());
        mb.addMenu("Edit", ());

        # click on "File" (at x=0..5)
        hash<Ncurses::InputEvent> ev();
        ev.type = Ncurses::InputType::Mouse;
        hash<Ncurses::MouseEvent> mouse();
        mouse.x = 2;
        mouse.y = 0;
        mouse.button_state = Ncurses::BUTTON1_CLICKED;
        ev.mouse = mouse;

        hash<NcursesUi::EventResult> result = mb.processEvent(ev);
        assertTrue(result.handled);
        assertEq("open_menu", result.action);
        assertEq(0, mb.getActiveMenu());
    }

