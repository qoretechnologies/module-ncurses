            {"label": "Open", "command": "open"},
            {"label": "Save", "command": "save"},
        ));

        *hash<auto> selected_item;
        dd.setOnSelect(sub (hash<auto> item) { selected_item = item; });

        hash<Ncurses::InputEvent> ev();
