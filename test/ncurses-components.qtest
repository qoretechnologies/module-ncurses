#!/usr/bin/env qore

%requires ncurses
%requires NcursesUi
%requires NcursesReplUi
%requires QUnit

%modern

%exec-class NcursesComponentsTest

class NcursesComponentsTest inherits Test {
    constructor() : Test("NcursesComponentsTest", "1.0") {
        # CheckboxWidget tests
        addTestCase("CheckboxWidget initial state", \testCheckboxInit());
        addTestCase("CheckboxWidget toggle", \testCheckboxToggle());
        addTestCase("CheckboxWidget keyboard toggle", \testCheckboxKeyboard());
        addTestCase("CheckboxWidget mouse toggle", \testCheckboxMouse());
        addTestCase("CheckboxWidget draw", \testCheckboxDraw());

        # RadioGroupWidget tests
        addTestCase("RadioGroupWidget initial state", \testRadioGroupInit());
        addTestCase("RadioGroupWidget keyboard navigation", \testRadioGroupKeyNav());
        addTestCase("RadioGroupWidget selection", \testRadioGroupSelection());
        addTestCase("RadioGroupWidget mouse click", \testRadioGroupMouse());
        addTestCase("RadioGroupWidget empty options", \testRadioGroupEmpty());
        addTestCase("RadioGroupWidget draw", \testRadioGroupDraw());

        # StatusBarWidget tests
        addTestCase("StatusBarWidget segments", \testStatusBarSegments());
        addTestCase("StatusBarWidget draw", \testStatusBarDraw());
        addTestCase("StatusBarWidget right align", \testStatusBarRightAlign());
        addTestCase("StatusBarWidget segment spacing", \testStatusBarSpacing());
        addTestCase("StatusBarWidget default style is dim", \testStatusBarDefaultStyle());

        # ListWidget tests
        addTestCase("ListWidget initial state", \testListInit());
        addTestCase("ListWidget set items", \testListSetItems());
        addTestCase("ListWidget keyboard nav", \testListKeyNav());
        addTestCase("ListWidget page nav", \testListPageNav());
        addTestCase("ListWidget Home/End", \testListHomeEnd());
        addTestCase("ListWidget Enter activates", \testListActivate());
        addTestCase("ListWidget mouse click", \testListMouseClick());
        addTestCase("ListWidget mouse wheel", \testListMouseWheel());
        addTestCase("ListWidget selection callback", \testListSelectCallback());
        addTestCase("ListWidget custom render", \testListCustomRender());
        addTestCase("ListWidget empty", \testListEmpty());
        addTestCase("ListWidget ensure visible", \testListEnsureVisible());
        addTestCase("ListWidget draw", \testListDraw());

        # TextInputWidget tests
        addTestCase("TextInputWidget initial state", \testTextInputInit());
        addTestCase("TextInputWidget type chars", \testTextInputType());
        addTestCase("TextInputWidget backspace", \testTextInputBackspace());
        addTestCase("TextInputWidget cursor movement", \testTextInputCursor());
        addTestCase("TextInputWidget submit", \testTextInputSubmit());
        addTestCase("TextInputWidget ctrl keys", \testTextInputCtrlKeys());
        addTestCase("TextInputWidget history", \testTextInputHistory());
        addTestCase("TextInputWidget draw", \testTextInputDraw());

        # DialogWidget tests
        addTestCase("DialogWidget creation", \testDialogCreation());
        addTestCase("DialogWidget button nav", \testDialogButtonNav());
        addTestCase("DialogWidget Enter confirms", \testDialogEnter());
        addTestCase("DialogWidget Escape dismisses", \testDialogEscape());
        addTestCase("DialogWidget factory confirm", \testDialogFactoryConfirm());
        addTestCase("DialogWidget factory error", \testDialogFactoryError());
        addTestCase("DialogWidget centered title", \testDialogCenteredTitle());
        addTestCase("DialogWidget centered message", \testDialogCenteredMessage());
        addTestCase("DialogWidget centered buttons", \testDialogCenteredButtons());
        addTestCase("DialogWidget mouse click on buttons", \testDialogMouseClick());
        addTestCase("DialogWidget mouse click non-button area", \testDialogMouseNonButton());
        addTestCase("DialogWidget padding", \testDialogPadding());

        # MenuBarWidget tests
        addTestCase("MenuBarWidget add menus", \testMenuBarAdd());
        addTestCase("MenuBarWidget keyboard nav", \testMenuBarKeyNav());
        addTestCase("MenuBarWidget mouse click", \testMenuBarMouse());
        addTestCase("MenuBarWidget open/close", \testMenuBarOpenClose());
        addTestCase("MenuBarWidget draw", \testMenuBarDraw());
        addTestCase("MenuBarWidget style setters", \testMenuBarStyleSetters());

        # MenuBarWidget Alt key tests
        addTestCase("MenuBarWidget Alt key opens menu", \testMenuBarAltKey());

        # DropdownMenuWidget tests
        addTestCase("DropdownMenuWidget creation", \testDropdownCreation());
        addTestCase("DropdownMenuWidget keyboard nav", \testDropdownKeyNav());
        addTestCase("DropdownMenuWidget selection", \testDropdownSelection());
        addTestCase("DropdownMenuWidget escape", \testDropdownEscape());
        addTestCase("DropdownMenuWidget separator skip", \testDropdownSeparator());
        addTestCase("DropdownMenuWidget disabled skip", \testDropdownDisabled());
        addTestCase("DropdownMenuWidget positioning", \testDropdownPositioning());
        addTestCase("DropdownMenuWidget left/right navigation", \testDropdownLeftRight());
        addTestCase("DropdownMenuWidget tab/shift-tab navigation", \testDropdownTabNavigation());
        addTestCase("DropdownMenuWidget hotkey", \testDropdownHotkey());
        addTestCase("DropdownMenuWidget hotkey hint rendering", \testDropdownHotkeyHint());
        addTestCase("DropdownMenuWidget Alt+key callback", \testDropdownAltKey());

        # TableWidget tests
        addTestCase("TableWidget initial state", \testTableInit());
        addTestCase("TableWidget set data", \testTableSetData());
        addTestCase("TableWidget keyboard nav", \testTableKeyNav());
        addTestCase("TableWidget sorting", \testTableSorting());
        addTestCase("TableWidget activation", \testTableActivation());
