#!/usr/bin/env qore

%prepend-module-path "${SCRIPT_DIR}/../build"

%requires ncurses
%requires QUnit
%requires Util

%modern

%exec-class NcursesTest

class NcursesTest inherits Test {
    constructor() : Test("NcursesTest", "2.0") {
        addTestCase("session open/close", \testSessionLifecycle());
        addTestCase("window draw and read", \testDrawAndRead());
        addTestCase("drawTextInside respects borders", \testDrawTextInside());
        addTestCase("drawTextInsideLine clears", \testDrawTextInsideLine());
        addTestCase("drawAnsiTextInsideLine renders", \testDrawAnsiTextInsideLine());
        addTestCase("input event (char)", \testInputChar());
        addTestCase("readLines snapshot", \testReadLinesSnapshot());
        addTestCase("session snapshot", \testSessionSnapshot());
        addTestCase("injectEvent key", \testInjectEventKey());
        addTestCase("injectEvent mouse", \testInjectEventMouse());
        addTestCase("injectEvents list order", \testInjectEventsList());
        addTestCase("withLock executes", \testWithLock());
        addTestCase("readEvent timeout", \testReadTimeout());
        addTestCase("readEvent invalid poll", \testReadInvalidPoll());
        addTestCase("noutrefresh and doupdate", \testNoutrefreshDoupdate());
        addTestCase("session use_tty unbuffered", \testUseTty());
        addTestCase("injectEvent Alt", \testInjectEventAlt());
        addTestCase("readEvent bare Esc", \testReadEventBareEsc());
        addTestCase("named arguments", \testNamedArguments());
        addTestCase("Unicode ANSI width and wrapping",
            \testUnicodeAnsiWidthAndWrapping());

        set_return_value(main());
    }

    private Ncurses::Session makeSession(Ncurses::TestTerminal tt) {
        return new Ncurses::Session({
            "test_terminal": tt,
            "echo": False,
            "raw": True,
            "cbreak": False,
            "keypad": True,
            "mouse": False,
            "use_colors": True,
            "use_default_colors": True,
            "cursor": 0
        });
    }

    testSessionLifecycle() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        assertTrue(s.isOpen());
        s.close();
        assertFalse(s.isOpen());
    }

    testDrawAndRead() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.drawText(1, 2, "abc", {"fg": Ncurses::Color::Cyan});
            w.refresh();
            string val = w.readText(1, 2, 3);
            assertEq("abc", val);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testInputChar() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            s.injectInput("x");
            auto ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Char, ev.type);
            assertEq("x", ev.ch);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testReadLinesSnapshot() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(6, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.drawText(0, 0, "HELLO", {});
            w.drawText(1, 0, "WORLD", {});
            w.refresh();
            list<string> lines = w.readLines(0, 2, 10);
            assertEq(2, lines.size());
            assertEq("HELLO     ", lines[0]);
            assertEq("WORLD     ", lines[1]);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testSessionSnapshot() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(6, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.drawText(0, 0, "HELLO", {});
            w.drawText(1, 0, "WORLD", {});
            w.refresh();
            list<string> lines = s.snapshot(0, 2, 10);
            assertEq(2, lines.size());
            assertEq("HELLO     ", lines[0]);
            assertEq("WORLD     ", lines[1]);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testInjectEventKey() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            hash<Ncurses::InputEvent> ev_in();
            ev_in{"type"} = Ncurses::InputType::Key;
            ev_in{"code"} = Ncurses::KEY_UP;
            s.injectEvent(ev_in);
            auto ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Key, ev.type);
            assertEq(Ncurses::KEY_UP, ev.code);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testInjectEventMouse() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            s.setMouse(True);
            Ncurses::Window w = s.screen();
            hash<Ncurses::MouseEvent> mouse_ev();
            mouse_ev{"x"} = 5;
            mouse_ev{"y"} = 6;
            mouse_ev{"button_state"} = Ncurses::BUTTON1_CLICKED;
            hash<Ncurses::InputEvent> ev_in();
            ev_in{"type"} = Ncurses::InputType::Mouse;
            ev_in{"mouse"} = mouse_ev;
            s.injectEvent(ev_in);
            auto ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Mouse, ev.type);
            assertEq(5, ev.mouse.x);
            assertEq(6, ev.mouse.y);
            assertTrue((ev.mouse.button_state & Ncurses::BUTTON1_CLICKED) != 0);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testInjectEventsList() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            hash<Ncurses::InputEvent> ev_a();
            ev_a{"type"} = Ncurses::InputType::Char;
            ev_a{"ch"} = "a";
            hash<Ncurses::InputEvent> ev_b();
            ev_b{"type"} = Ncurses::InputType::Char;
            ev_b{"ch"} = "b";
            list<hash<Ncurses::InputEvent>> events = (ev_a, ev_b);
            s.injectEvents(events);
            auto ev1 = w.readEvent(500, 25);
            auto ev2 = w.readEvent(500, 25);
            assertTrue(exists ev1);
            assertTrue(exists ev2);
            assertEq("a", ev1.ch);
            assertEq("b", ev2.ch);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testDrawTextInsideLine() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(6, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.box({"fg": Ncurses::Color::Blue});
            w.drawTextInsideLine(0, "abcdef");
            w.drawTextInsideLine(0, "x");
            w.refresh();
            string first = w.readText(1, 1, 1);
            string second = w.readText(1, 2, 1);
            assertEq("x", first);
            assertEq(" ", second);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testDrawAnsiTextInsideLine() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(6, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.box({"fg": Ncurses::Color::Blue});
            string esc = chr(27);
            w.drawAnsiTextInsideLine(0, esc + "[31mRED" + esc + "[0m");
            w.refresh();
            string val = w.readText(1, 1, 3);
            assertEq("RED", val);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testDrawTextInside() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(10, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.box({"fg": Ncurses::Color::Blue});
            w.drawTextInside(0, 0, "X");
            w.refresh();
            string inside = w.readText(1, 1, 1);
            string left_border = w.readText(1, 0, 1);
            string right_border = w.readText(1, 19, 1);
            assertEq("X", inside);
            assertTrue(left_border != "X");
            assertTrue(right_border != "X");
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testWithLock() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            int called = 0;
            s.withLock(sub () { called++; });
            assertEq(1, called);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testReadTimeout() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            auto ev = w.readEvent(50, 25);
            assertFalse(exists ev);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testReadInvalidPoll() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            try {
                w.readEvent(100, 0);
                fail("Expected NCURSES-ERROR exception");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("NCURSES-ERROR", ex.err);
            }
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testNoutrefreshDoupdate() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(10, 20, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            w.clear();
            w.drawTextInside(0, 0, "x");
            w.noutrefresh();
            s.updatePanels();
            s.doupdate();
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testInjectEventAlt() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            # inject Alt+f event
            hash<Ncurses::InputEvent> ev_in();
            ev_in{"type"} = Ncurses::InputType::Alt;
            ev_in{"ch"} = "f";
            s.injectEvent(ev_in);
            auto ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Alt, ev.type);
            assertEq("f", ev.ch);

            # test Alt+F (uppercase)
            ev_in{"ch"} = "F";
            s.injectEvent(ev_in);
            ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Alt, ev.type);
            assertEq("F", ev.ch);

            # test Alt injection via injectEvents
            hash<Ncurses::InputEvent> ev_a();
            ev_a{"type"} = Ncurses::InputType::Alt;
            ev_a{"ch"} = "a";
            hash<Ncurses::InputEvent> ev_b();
            ev_b{"type"} = Ncurses::InputType::Alt;
            ev_b{"ch"} = "b";
            s.injectEvents((ev_a, ev_b));
            auto ev1 = w.readEvent(500, 25);
            auto ev2 = w.readEvent(500, 25);
            assertTrue(exists ev1);
            assertTrue(exists ev2);
            assertEq(Ncurses::InputType::Alt, ev1.type);
            assertEq("a", ev1.ch);
            assertEq(Ncurses::InputType::Alt, ev2.type);
            assertEq("b", ev2.ch);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testReadEventBareEsc() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        Ncurses::Session s = makeSession(tt);
        try {
            Ncurses::Window w = s.screen();
            # inject bare ESC (no follow-up char)
            hash<Ncurses::InputEvent> ev_in();
            ev_in{"type"} = Ncurses::InputType::Char;
            ev_in{"ch"} = chr(27);
            s.injectEvent(ev_in);
            auto ev = w.readEvent(500, 25);
            assertTrue(exists ev);
            assertEq(Ncurses::InputType::Char, ev.type);
            assertEq(chr(27), ev.ch);
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testUseTty() {
        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(24, 80, "xterm-256color");
        tt.open();
        on_exit tt.close();
        string tty_path = tt.getSlavePath();
        setenv("TERM", "xterm-256color");
        Ncurses::Session s = new Ncurses::Session({
            "use_tty": True,
            "tty_path": tty_path,
            "unbuffered_stdio": True,
            "echo": False,
            "raw": True,
            "cbreak": False,
            "keypad": True,
            "mouse": False
        });
        try {
            assertTrue(s.isOpen());
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();

        Ncurses::Session s2 = new Ncurses::Session({
            "use_tty": True,
            "tty_path": tty_path,
            "unbuffered_stdio": False,
            "echo": False,
            "raw": True,
            "cbreak": False,
            "keypad": True,
            "mouse": False
        });
        try {
            assertTrue(s2.isOpen());
        } catch (hash<ExceptionInfo> ex) {
            s2.close();
            rethrow;
        }
        s2.close();
    }

    testNamedArguments() {
        assertEq(3, Ncurses::Ansi::len(text: "abc"));
        list<string> wrapped = Ncurses::Ansi::wrap(text: "alpha beta", width: 5,
            mode: Ncurses::WrapMode::Word);
        assertTrue(wrapped.size() >= 2);
        assertEq("x", Ncurses::Ansi::parse(text: "x")[0].text);

        Ncurses::TestTerminal tt = new Ncurses::TestTerminal(term_name: "xterm-256color", rows: 8, cols: 30);
        tt.open();
        tt.resize(cols: 32, rows: 8);
        Ncurses::Session s = new Ncurses::Session(options: {
            "test_terminal": tt,
            "echo": False,
            "raw": True,
            "cbreak": False,
            "keypad": True,
            "mouse": False,
            "use_colors": True,
            "use_default_colors": True,
            "cursor": 0
        });
        try {
            s.setMouse(enabled: False);
            s.setEscDelay(delay_ms: 25);
            Ncurses::Window w = new Ncurses::Window(session: s, rows: 6, cols: 20, y: 0, x: 0);

            w.clear();
            w.drawText(y: 0, x: 0, text: "abc", style: {});
            assertEq("abc", w.readText(y: 0, x: 0, length: 3));
            w.drawTextClipped(y: 0, x: 1, text: "xy", style: {});
            assertEq("axy", w.readText(y: 0, x: 0, length: 3));
            w.fillRect(y: 1, x: 0, rows: 1, cols: 3, character: "*", style: {});
            w.drawHLine(y: 2, x: 0, length: 3, character: "-", style: {});
            w.drawVLine(y: 1, x: 5, length: 3, character: "|", style: {});
            w.addChar(y: 3, x: 0, character: "Z", style: {});
            w.moveCursor(y: 4, x: 0);
            w.write(text: "w", style: {});
            hash<Ncurses::Position> pos = w.saveCursor();
            w.restoreCursor(position: pos);
            w.setLeaveOk(enabled: True);
            w.setWrapMode(mode: Ncurses::WrapMode::Hard);
            w.enableScroll(enabled: True);
            w.enableKeypad(enabled: True);
            w.scroll(lines: 0);
            w.clearLine(y: 5, style: {});
            list<string> window_lines = w.readLines(cols: 5);
            assertEq(6, window_lines.size());
            assertEq(5, window_lines[0].length());

            w.box(style: {});
            w.border(left_side: "|", right_side: "|", top_side: "-", bottom_side: "-",
                top_left: "+", top_right: "+", bottom_left: "+", bottom_right: "+", style: {});
            w.drawTextInside(y: 0, x: 0, text: "I", style: {});
            w.clearInsideLine(y: 1, style: {});
            w.drawTextInsideLine(y: 1, text: "inside", style: {});
            w.drawAnsiText(y: 4, x: 1, text: "plain", style: {});
            w.drawAnsiTextInside(y: 2, x: 0, text: "ansi", style: {});
            w.drawAnsiTextInsideLine(y: 3, text: "line", style: {});
            w.setBackground(style: {});

            Ncurses::Window sw = w.subWindow(rows: 1, cols: 5, y: 0, x: 0);
            sw.write(text: "sub", style: {});
            sw.refresh();

            Ncurses::Window pane = new Ncurses::Window(session: s, rows: 3, cols: 10, y: 1, x: 1);
            Ncurses::Panel p = new Ncurses::Panel(window: pane);
            p.move(y: 2, x: 2);
            p.setWrapMode(mode: Ncurses::WrapMode::Word);
            p.show();
            p.top();
            p.update();
            Ncurses::Panel p2 = new Ncurses::Panel(session: s, rows: 3, cols: 10, y: 1, x: 1);
            p2.bottom();
            p2.hide();

            s.injectInput(data: "q");
            auto ev = w.readEvent(poll_ms: 10, timeout_ms: 100);
            assertTrue(exists ev);
            assertEq("q", ev.ch);
            hash<Ncurses::InputEvent> ev_r();
            ev_r.type = Ncurses::InputType::Char;
            ev_r.ch = "r";
            s.injectEvent(event: ev_r);
            ev = w.readEvent(timeout_ms: 100, poll_ms: 10);
            assertTrue(exists ev);
            assertEq("r", ev.ch);
            hash<Ncurses::InputEvent> ev_s();
            ev_s.type = Ncurses::InputType::Char;
            ev_s.ch = "s";
            list<hash<Ncurses::InputEvent>> events = (ev_s,);
            s.injectEvents(events: events);
            ev = w.readEvent(timeout_ms: 100, poll_ms: 10);
            assertTrue(exists ev);
            assertEq("s", ev.ch);

            assertEq(5, s.withLock(callback: int sub (int a, int b) { return a + b; }, callback_args: (2, 3)));
            list<string> screen_lines = s.snapshot(cols: 5);
            assertEq(8, screen_lines.size());
            assertEq(5, screen_lines[0].length());
        } catch (hash<ExceptionInfo> ex) {
            s.close();
            rethrow;
        }
        s.close();
    }

    testUnicodeAnsiWidthAndWrapping() {
        string japanese = "ステップの例";
        assertEq(12, Ncurses::Ansi::len(japanese),
            "ANSI width uses terminal display columns");
        assertEq(12, Ncurses::Ansi::len(
                "\x1b[31m" + japanese + "\x1b[0m"),
            "ANSI styling does not affect display width");

        list<string> wrapped = Ncurses::Ansi::wrap(
            japanese, 4, Ncurses::WrapMode::Hard);
        assertEq(3, wrapped.size(),
            "six double-width characters wrap into three four-column lines");
        string reconstructed = "";
        foreach string line in (wrapped) {
            assertTrue(Ncurses::Ansi::len(line) <= 4,
                "every Japanese line respects the column limit");
            reconstructed += (map $1.text,
                Ncurses::Ansi::parse(line)).join("");
        }
        assertEq(japanese, reconstructed,
            "wrapping preserves every UTF-8 character");

        string family = "👨‍👩‍👧‍👦";
        wrapped = Ncurses::Ansi::wrap(
            "A" + family + "B", char_width(family),
            Ncurses::WrapMode::Hard);
        list<string> plain = map (map $1.text,
            Ncurses::Ansi::parse($1)).join(""), wrapped;
        assertTrue(inlist(family, plain),
            "wrapping does not split a joined emoji grapheme");

        string combining = "éé";
        wrapped = Ncurses::Ansi::wrap(
            combining, 1, Ncurses::WrapMode::Hard);
        assertEq(2, wrapped.size(),
            "combining sequences wrap as complete graphemes");
        foreach string line in (wrapped) {
            assertEq(1, Ncurses::Ansi::len(line),
                "combining-mark line occupies one column");
        }
    }
}
