# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires ncurses
%requires NcursesUi
%requires QUnit
%include "test/TestHarness.qc"
%exec-class MouseActionsTest
class MouseActionsTest inherits Test {
    constructor() : Test("MouseActionsTest", "1.0", \ARGV) {
        addTestCase("button and checkbox hit only their visible row and label", \labels());
        addTestCase("mouse labels respect padding ancestors target windows and disabled state", \clipping());
        addTestCase("attachment mouse operations share cancellation exception and completion guards", \attachments());
        addTestCase("attachment targets follow normalized wrapped and scrolled source spans", \wrapping());
        addTestCase("completion popup mouse keyboard acceptance failure and dismissal", \completion());
        addTestCase("terminal press and release select timeline events and toggle files once", \pressRelease());
        addTestCase("file preview is keyboard reachable without changing directory navigation", \filePane());
        set_return_value(main());
    }
    private hash<Ncurses::InputEvent> click(int y, int x) {
        return <Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse,
            "mouse": <Ncurses::MouseEvent>{"y": y, "x": x, "button_state": Ncurses::BUTTON1_CLICKED}};
    }
    filePane() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close();
        NcursesUi::Application app(th.session()); on_exit app.close();
        NcursesUi::FileBrowserWidget browser(th.session(), "examples/gallery/fixtures");
        browser.setFrameValues(0, 0, 12, 40); browser.createPanel(); app.setRoot(browser);
        app.getFocusManager().setFocus(browser.getFileList()); app.drawAll();
        assertTrue(browser.getStatusText().find("F7:Pane") >= 0);
        hash<Ncurses::InputEvent> pane = <Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_F(7)"};
        app.processEvent(pane); assertEq(1, browser.getFocusedPane()); assertEq(browser.getPreviewWidget(), app.getFocusManager().getCurrentFocus());
        app.processEvent(pane); assertEq(0, browser.getFocusedPane()); assertEq(browser.getFileList(), app.getFocusManager().getCurrentFocus());
        browser.getPreviewWidget().setEnabled(False); app.processEvent(pane); assertEq(0, browser.getFocusedPane());
        browser.getPreviewWidget().setEnabled(True); browser.getFileList().setSelectedIndex(1);
        string directory = browser.getCurrentDir(); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\t"});
        assertEq(directory, browser.getCurrentDir()); assertEq(0, browser.getFocusedPane());
        app.processEvent(pane); app.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_END"});
        assertEq(browser.getPreviewWidget(), app.getFocusManager().getCurrentFocus());
    }
    pressRelease() {
        NcursesUi::TestHarness th(12, 50); on_exit th.close();
        NcursesUi::TimelineWidget timeline(); timeline.setFrameValues(0, 0, 6, 50);
        timeline.appendEvent(<NcursesUi::TimelineEvent>{"id": "first", "title": "First", "timestamp": date("2026-01-02T03:04:05Z")});
        timeline.appendEvent(<NcursesUi::TimelineEvent>{"id": "second", "title": "Second", "timestamp": date("2026-01-02T03:04:05Z")});
        timeline.drawTree(th.screen());
        hash<Ncurses::InputEvent> press = click(1, 2); press.mouse.button_state = Ncurses::BUTTON1_PRESSED;
        assertTrue(timeline.processEvent(press).handled); assertEq("second", timeline.getSelectedEventId());
        hash<Ncurses::InputEvent> release = press; release.mouse.button_state = Ncurses::BUTTON1_RELEASED;
        timeline.processEvent(release); assertEq("second", timeline.getSelectedEventId());
        NcursesUi::FileSelectionModel model((<NcursesUi::FileSelectionEntry>{"id": "sample", "name": "sample.txt", "path": "fixture/sample.txt"},), True);
        NcursesUi::FileSelectionWidget files(model); files.setFrameValues(6, 0, 6, 50); files.drawTree(th.screen());
        press.mouse.y = 6; release.mouse.y = 6; files.processEvent(press); assertEq(1, model.getSelected().size());
        files.processEvent(release); assertEq(1, model.getSelected().size());
        files.processEvent(press); files.processEvent(release); assertEq(0, model.getSelected().size());
    }
    completion() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close();
        NcursesUi::Application app(th.session()); on_exit app.close();
        NcursesUi::TextEditorWidget editor(); editor.setText("draft"); app.setRoot(editor); app.getFocusManager().setFocus(editor);
        th.session().setCursor(1); app.drawAll();
        NcursesUi::CompletionPopupWidget popup(th.session(), ({"label": "alpha"}, {"label": "beta"}));
        on_exit { popup.setOnSelect(NOTHING); popup.setOnDismiss(NOTHING); popup.destroyPanel(); }
        popup.positionAt(1, 2, 12, 40); popup.createPanel(); app.pushPopup(popup); app.drawAll();
        hash<NcursesUi::Rect> rect = popup.contentRect(); int accepted = 0;
        popup.setOnSelect(sub (hash<auto> item) { assertEq("beta", item.label); ++accepted; });
        assertTrue(popup.processEvent(click(rect.y + 1, rect.x)).handled); assertEq(1, popup.getHighlightIndex()); assertEq(0, accepted);
        assertFalse(popup.processEvent(click(rect.y - 1, rect.x)).handled); assertEq(1, popup.getHighlightIndex());
        popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\r"}); assertEq(1, accepted);
        popup.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_ENTER"}); assertEq(2, accepted);
        hash<Ncurses::InputEvent> double = click(rect.y + 1, rect.x); double.mouse.button_state = Ncurses::BUTTON1_DOUBLE_CLICKED;
        popup.processEvent(double); assertEq(3, accepted);
        popup.setOnSelect(sub (hash<auto> item) { throw "COMPLETION-MOUSE-ERROR", item.label; });
        assertThrows("COMPLETION-MOUSE-ERROR", sub () { popup.processEvent(double); }); assertEq(1, popup.getHighlightIndex());
        hash<Ncurses::InputEvent> wheel = click(rect.y, rect.x); wheel.mouse.button_state = Ncurses::BUTTON4_PRESSED;
        popup.processEvent(wheel); assertEq(0, popup.getHighlightIndex());
        popup.setEnabled(False); assertFalse(popup.processEvent(click(rect.y + 1, rect.x)).handled); assertEq(0, popup.getHighlightIndex()); popup.setEnabled(True);
        NcursesUi::CompletionPopupWidget empty(th.session(), ()); empty.positionAt(1, 2, 12, 40);
        assertFalse(empty.processEvent(click(empty.contentRect().y, empty.contentRect().x)).handled);
        popup.setOnDismiss(sub () { app.popModal(); popup.destroyPanel(); });
        app.processEvent(click(11, 39)); app.drawAll(); assertFalse(app.getDispatcher().hasModal()); assertEq(editor, app.getFocusManager().getCurrentFocus());
        assertEq(1, th.session().capture().cursor.visibility);
    }
    labels() {
        NcursesUi::TestHarness th(10, 40); on_exit th.close();
        NcursesUi::ButtonWidget button("界é"); button.setFrameValues(1, 2, 5, 30);
        int calls = 0; button.setOnActivate(sub (string id) { ++calls; }); button.drawTree(th.screen());
        assertFalse(button.processEvent(click(2, 3)).handled); assertFalse(button.processEvent(click(1, 9)).handled);
        assertTrue(button.processEvent(click(1, 8)).handled); assertEq(1, calls);
        button.setLabel("X"); button.drawTree(th.screen()); assertFalse(button.processEvent(click(1, 8)).handled);
        NcursesUi::CheckboxWidget box("界é"); box.setFrameValues(7, 2, 2, 30); box.drawTree(th.screen());
        assertFalse(box.processEvent(click(6, 3)).handled); assertFalse(box.processEvent(click(8, 3)).handled);
        assertFalse(box.processEvent(click(7, 9)).handled); assertFalse(box.isChecked());
        assertTrue(box.processEvent(click(7, 8)).handled); assertTrue(box.isChecked());
        assertTrue(box.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": "KEY_ENTER"}).handled);
        assertFalse(box.isChecked());
        assertTrue(box.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Char, "ch": "\r"}).handled);
        assertTrue(box.isChecked());
        assertFalse(box.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Mouse}).handled);
    }
    clipping() {
        NcursesUi::TestHarness th(12, 40); on_exit th.close();
        NcursesUi::Widget parent(); parent.setFrameValues(1, 2, 3, 9);
        NcursesUi::ButtonWidget button("Run preview"); button.setFrameValues(1, 2, 8, 30);
        button.setPadding(<NcursesUi::Insets>{"top": 1, "left": 1}); parent.addChild(button);
        int calls = 0; button.setOnActivate(sub (string id) { ++calls; }); parent.drawTree(th.screen());
        assertFalse(button.processEvent(click(1, 3)).handled); assertFalse(button.processEvent(click(2, 2)).handled);
        assertFalse(button.processEvent(click(2, 11)).handled); assertTrue(button.processEvent(click(2, 10)).handled);
        assertEq(1, calls); button.setEnabled(False); button.processEvent(click(2, 3)); assertEq(1, calls);
        button.setEnabled(True); parent.setVisible(False); parent.drawTree(th.screen()); button.processEvent(click(2, 3)); assertEq(1, calls);
        parent.setVisible(True); parent.drawTree(th.screen()); button.processEvent(click(2, 3)); assertEq(2, calls);
        parent.setEnabled(False); parent.drawTree(th.screen()); th.refresh();
        assertTrue(!!(th.session().capture().cells[2 * 40 + 3].attrs & Ncurses::Attr::Dim));
        NcursesUi::CheckboxWidget box("Option"); box.setFrameValues(0, 0, 10, 30);
        Ncurses::Window small(th.session(), 1, 5, 0, 0); box.drawTree(small);
        assertFalse(box.processEvent(click(0, 5)).handled); assertTrue(box.processEvent(click(0, 4)).handled);
        box.setEnabled(False); box.drawTree(small); assertFalse(box.processEvent(click(0, 4)).handled);
        small.noutrefresh(); th.session().doupdate();
        assertTrue(!!(th.session().capture().cells[0].attrs & Ncurses::Attr::Dim));
    }
    private hash<NcursesUi::AttachmentInfo> info() {
        return <NcursesUi::AttachmentInfo>{"id": "sample", "name": "sample.txt", "path": "fixture/sample.txt",
            "type": "text/plain", "text_preview": "Preview 界é"};
    }
    private hash<Ncurses::InputEvent> actionClick(NcursesUi::AttachmentWidget widget, string label) {
        list<string> rows = widget.getSummaryLines(); int line = 0;
        while (line < rows.size() && rows[line].find(label) < 0) { ++line; }
        @assert(line < rows.size());
        NcursesUi::LineListContent content = cast<NcursesUi::LineListContent>(widget.getContent());
        hash<Ncurses::Position> pos = content.sourceToVisual(line, rows[line].find(label));
        hash<NcursesUi::Rect> view = widget.getViewportRect();
        return click(view.y + pos.y - widget.getScrollY(), view.x + pos.x - widget.getScrollX());
    }
    attachments() {
        NcursesUi::TestHarness th(20, 60); on_exit th.close();
        NcursesUi::AttachmentWidget widget(info()); widget.setFrameValues(0, 0, 20, 60);
        int opens = 0; int exports = 0;
        widget.setHandler(NcursesUi::FileOperation::Open, bool sub (hash<NcursesUi::AttachmentInfo> value) { ++opens; return True; });
        widget.setHandler(NcursesUi::FileOperation::Export, bool sub (hash<NcursesUi::AttachmentInfo> value) { ++exports; return False; });
        widget.drawTree(th.screen()); hash<Ncurses::InputEvent> open = actionClick(widget, "Enter/O");
        assertNothing(widget.processEvent(click(open.mouse.y, 13)).action); assertEq(0, opens); assertEq(0, exports);
        assertEq("attachment", widget.processEvent(open).action); assertEq(1, opens); assertEq(NcursesUi::ActionState::Completed, widget.getState());
        widget.processEvent(open); assertEq(1, opens); widget.reset(); widget.drawTree(th.screen());
        widget.processEvent(actionClick(widget, "E: Export")); assertEq(1, exports); assertEq(NcursesUi::ActionState::Cancelled, widget.getState());
        widget.setHandler(NcursesUi::FileOperation::Export, bool sub (hash<NcursesUi::AttachmentInfo> value) { throw "MOUSE-EXPORT-ERROR", "Retained"; });
        widget.drawTree(th.screen()); hash<Ncurses::InputEvent> export = actionClick(widget, "E: Export");
        assertThrows("MOUSE-EXPORT-ERROR", sub () { widget.processEvent(export); });
        assertEq(NcursesUi::ActionState::Failed, widget.getState()); assertEq("Retained", widget.getError()); assertEq(info(), widget.getAttachment());
        widget.setEnabled(False); assertFalse(widget.processEvent(export).handled);
        widget.setEnabled(True); widget.setVisible(False); assertFalse(widget.processEvent(export).handled);
    }
    wrapping() {
        NcursesUi::TestHarness th(8, 30); on_exit th.close();
        hash<NcursesUi::AttachmentInfo> value = info(); value.name = "Title\nSecond"; value.text_preview = "One\r\n\t界é\nThree";
        NcursesUi::AttachmentWidget widget(value); widget.setFrameValues(1, 2, 4, 12);
        int saves = 0; widget.setHandler(NcursesUi::FileOperation::Open, bool sub (hash<NcursesUi::AttachmentInfo> value) { return False; });
        widget.setHandler(NcursesUi::FileOperation::Save, bool sub (hash<NcursesUi::AttachmentInfo> value) { ++saves; return True; });
        widget.drawTree(th.screen()); widget.scrollTo(NcursesUi::ScrollDirection::End); widget.drawTree(th.screen());
        assertTrue(widget.getScrollY() > 0); hash<Ncurses::InputEvent> save = actionClick(widget, "S: Save");
        assertTrue(NcursesUi::Geometry::rectContains(widget.getViewportRect(), save.mouse.y, save.mouse.x));
        assertFalse(widget.processEvent(click(0, 2)).handled); assertFalse(widget.processEvent(click(7, 2)).handled);
        assertEq("attachment", widget.processEvent(save).action); assertEq(1, saves);
        widget.reset(); widget.setHandler(NcursesUi::FileOperation::Save, NOTHING); widget.drawTree(th.screen());
        widget.processEvent(save); assertEq(1, saves);
    }
}
