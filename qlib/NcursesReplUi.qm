%modern

%requires ncurses
%requires(reexport) QoreHistory

module NcursesReplUi {
    version = "1.0";
    desc = "Helpers for building ncurses-based REPL UIs";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

/** @mainpage NcursesReplUi Module

    @tableofcontents

    @section ncursesrepluiintro NcursesReplUi Module Introduction

    The NcursesReplUi module provides helper classes for building ncurses-based
    REPL (Read-Eval-Print Loop) user interfaces. It is used by the \c qrepl
    tool and can be used independently for custom REPL applications.

    To use the module:
    @code{.py} %requires NcursesReplUi @endcode

    @section ncursesrepluiinputbuffer InputBuffer

    @ref NcursesReplUi::InputBuffer "InputBuffer" manages a text buffer with
    cursor tracking. It supports insertion, deletion, cursor movement, and
    Emacs-style kill operations. Movement, deletion, and range replacement use
    extended grapheme boundaries. Cursor indices remain Qore character offsets,
    preserving existing ASCII/source-index callers. An external index inside a
    cluster rounds down; replacement ranges expand to whole clusters. Use
    @ref NcursesReplUi::TextPosition "TextPosition" to convert offsets to terminal
    columns or mouse cells back to source offsets. The same conversions are used
    by wrapped content, text inputs, combo boxes, and qrepl's input buffer.

    @par Example:
    @code{.py}
NcursesReplUi::InputBuffer buf();

# type some text
buf.insertChar("H");
buf.insertChar("i");
# buf.getText() == "Hi", buf.getCursor() == 2

# move cursor and insert
buf.moveHome();
buf.insertChar(">");
# buf.getText() == ">Hi", buf.getCursor() == 1

# delete backward
buf.moveEnd();
buf.backspace();
# buf.getText() == ">H"
    @endcode

    @section ncursesrepluihistory History

    @ref NcursesReplUi::History "History" is a backward-compatibility alias for
    @ref QoreHistory::History "QoreHistory::History". New code should use
    QoreHistory::History directly.

    @par Example:
    @code{.py}
QoreHistory::History hist();

hist.add("print 1 + 2");
hist.add("print 'hello'");

*string prev = hist.prev();
# prev == "print 'hello'"
prev = hist.prev();
# prev == "print 1 + 2"

*string nxt = hist.next();
# nxt == "print 'hello'"
    @endcode

    @section ncursesrepluilayoutcalc LayoutCalc

    @ref NcursesReplUi::LayoutCalc "LayoutCalc" computes basic layout
    dimensions for a REPL UI with output and input panes.

    @par Example:
    @code{.py}
hash<auto> layout = NcursesReplUi::LayoutCalc::calcLayout(24, 80);
# layout.main_cols == 52, layout.info_cols == 28
# layout.output_rows == 21, layout.input_rows == 3
    @endcode

    @section ncursesrepluiscrollcalc ScrollCalc

    @ref NcursesReplUi::ScrollCalc "ScrollCalc" provides scroll position
    calculation helpers for bottom-anchored scrolling views.

    @par Example:
    @code{.py}
# 100 lines of content, 20 visible lines, scrolled up 5 lines from bottom
int clamped = NcursesReplUi::ScrollCalc::clampScroll(100, 20, 5);
# clamped == 5

int start_idx = NcursesReplUi::ScrollCalc::scrollStart(100, 20, 5);
# start_idx == 75 (show lines 75-94)
    @endcode

    @since ncurses 1.0
*/

public namespace NcursesReplUi {

/** Shared conversions between Unicode character offsets, extended grapheme
    boundaries, and terminal display columns. Character offsets retain Qore
    string indexing semantics; they are neither byte offsets nor cluster indices.
    @since ncurses 1.0
*/
public class TextPosition {
    /** Returns the nearest grapheme boundary in the requested direction.
        @param text plain source text
        @param offset character offset, clamped to the source length
        @param forward True to round up; False to round down
        @return character offset at a complete grapheme boundary
    */
    static int snapOffset(string text, int offset, bool forward = False) {
        offset = max(0, min(offset, text.length()));
        int start = 0;
        foreach string cluster in ((text =~ x/(\X)/g) ?? ()) {
            int end = start + cluster.length();
            if (offset == start) {
                return start;
            }
            if (offset < end) {
                return forward ? end : start;
            }
            start = end;
        }
        return start;
    }

    /** Maps a source character offset to terminal columns.
        @param text plain source text
        @param offset character offset; positions within a cluster round down
        @return display columns before the snapped position
    */
    static int columnForOffset(string text, int offset) {
        return char_width(text.substr(0, snapOffset(text, offset)));
    }

    /** Maps a terminal cell to the start of its source grapheme.
        @param text plain source text
        @param col display column, clamped to the text extent
        @return source character offset (the length for cells beyond the text)
    */
    static int offsetForColumn(string text, int col) {
        col = max(0, col);
        int offset = 0;
        int used = 0;
        foreach string cluster in ((text =~ x/(\X)/g) ?? ()) {
            int width = char_width(cluster);
            if (used + width > col) {
                break;
            }
            used += width;
            offset += cluster.length();
        }
        return offset;
    }
}

/** Input buffer with cursor tracking at extended grapheme boundaries.

    Cursor positions remain zero-based Qore character offsets for compatibility.
    External positions within a cluster round down. Editing never splits a
    combining sequence, emoji modifier, regional-indicator pair, or ZWJ sequence.
    Replacement ranges expand to complete clusters; the resulting cursor rounds
    up if inserted text joins a neighboring cluster.

    @par Example
    @code{.py}
    NcursesReplUi::InputBuffer input();
    input.setText("é界");
    input.moveLeft();
    # character offset 2, terminal column 1
    input.backspace();
    # complete decomposed accent removed; text is now "界"
    @endcode

    @since %ncurses 1.0
*/
public class InputBuffer {
    private {
        string text = "";
        int cursor = 0;
    }

    /** Clears the buffer.
        @since %ncurses 1.0
    */
    nothing reset() {
        text = "";
        cursor = 0;
    }

    /** Sets the buffer content and moves the cursor to the end.
        @since %ncurses 1.0
    */
    nothing setText(string t) {
        text = t;
        cursor = text.length();
    }

    /** Returns the current buffer text.
        @since %ncurses 1.0
    */
    string getText() {
        return text;
    }

    /** Returns the current cursor position as a Qore character offset.
        @since %ncurses 1.0
    */
    int getCursor() {
        return cursor;
    }

    /** Sets the cursor position in Qore character offsets.
        @param pos the new position, clamped to the text and rounded down to a
            grapheme boundary; ASCII and already valid positions are unchanged
        @since %ncurses 1.0
    */
    nothing setCursor(int pos) {
        cursor = NcursesReplUi::TextPosition::snapOffset(text, pos);
    }

    /** Replaces a range, expanding partial selections to complete graphemes.
        @param start first character offset (inclusive)
        @param end last character offset (exclusive); reversed ranges are accepted
        @param replacement text to insert
        @note An empty range inserts at the preceding grapheme boundary.
        @since ncurses 1.0
    */
    nothing replaceRange(int start, int end, string replacement) {
        int first = NcursesReplUi::TextPosition::snapOffset(text, min(start, end));
        int last = start == end ? first
            : NcursesReplUi::TextPosition::snapOffset(text, max(start, end), True);
        string next = text.substr(0, first) + replacement + text.substr(last);
        int next_cursor = NcursesReplUi::TextPosition::snapOffset(next, first + replacement.length(), True);
        text = next;
        cursor = next_cursor;
    }

    /** Inserts text at the cursor, preserving complete graphemes.
        @param ch text to insert (empty input leaves the buffer unchanged)
        @since %ncurses 1.0
    */
    nothing insertChar(string ch) {
        if (ch != "") {
            replaceRange(cursor, cursor, ch);
        }
    }

    /** Deletes the grapheme before the cursor.
        @since %ncurses 1.0
    */
    nothing backspace() {
        if (cursor > 0) {
            replaceRange(cursor - 1, cursor, "");
        }
    }

    /** Deletes the grapheme at the cursor.
        @since %ncurses 1.0
    */
    nothing deleteChar() {
        if (cursor < text.length()) {
            replaceRange(cursor, cursor + 1, "");
        }
    }

    /** Moves the cursor left by one extended grapheme.
        @since %ncurses 1.0
    */
    nothing moveLeft() {
        setCursor(max(0, cursor - 1));
    }

    /** Moves the cursor right by one extended grapheme.
        @since %ncurses 1.0
    */
    nothing moveRight() {
        if (cursor < text.length()) {
            cursor = NcursesReplUi::TextPosition::snapOffset(text, cursor + 1, True);
        }
    }

    /** Moves the cursor to the start.
        @since %ncurses 1.0
    */
    nothing moveHome() {
        cursor = 0;
    }

    /** Moves the cursor to the end.
        @since %ncurses 1.0
    */
    nothing moveEnd() {
        cursor = text.length();
    }

    /** Deletes from the cursor to the end of the line.
        @since %ncurses 1.0
    */
    nothing killToEnd() {
        if (cursor >= text.length()) {
            return;
        }
        text = text.substr(0, cursor);
    }

    /** Deletes from the start of the line to the cursor.
        @since %ncurses 1.0
    */
    nothing killToStart() {
        if (cursor <= 0) {
            return;
        }
        text = text.substr(cursor);
        cursor = 0;
    }

    /** Clears the entire line.
        @since %ncurses 1.0
    */
    nothing killLine() {
        text = "";
        cursor = 0;
    }

    /** Auto-dedents the current line by removing one indent prefix.

        If the buffer content consists of only whitespace followed by "}", removes
        one occurrence of @a indent_str from the front of the buffer.

        @param indent_str the indent string to remove (e.g. "    " for 4-space indent)
        @return True if a dedent was performed
        @since %ncurses 1.0
    */
    bool autoDedent(string indent_str) {
        if (indent_str == "") {
            return False;
        }
        # check if buffer is whitespace + "}"
        string trimmed = regex_subst(text, "^\\s*", "");
        if (trimmed != "}") {
            return False;
        }
        # check if the buffer starts with the indent string
        if (text.length() < indent_str.length()) {
            return False;
        }
        if (text.substr(0, indent_str.length()) != indent_str) {
            return False;
        }
        # remove one indent level from the front
        text = text.substr(indent_str.length());
        # adjust cursor
        if (cursor > indent_str.length()) {
            cursor -= indent_str.length();
        } else {
            cursor = 0;
        }
        # move cursor to end (after the "}")
        cursor = text.length();
        return True;
    }

    /** Moves the cursor to the beginning of the previous word.

        Skips whitespace backward, then skips non-whitespace backward,
        mimicking the standard readline Alt+B behavior.

        @since %ncurses 1.0
    */
    nothing moveWordLeft() {
        cursor = wordBoundary(False);
    }

    /** Moves over non-whitespace, then whitespace, to the next word boundary.
        @since %ncurses 1.0
    */
    nothing moveWordRight() {
        cursor = wordBoundary(True);
    }

    /** Deletes to the next word boundary without splitting graphemes.
        @since %ncurses 1.0
    */
    nothing deleteWordForward() {
        replaceRange(cursor, wordBoundary(True), "");
    }

    /** Deletes the previous word without splitting graphemes.
        @since %ncurses 1.0
    */
    nothing deleteWordBack() {
        replaceRange(wordBoundary(False), cursor, "");
    }

    private int wordBoundary(bool forward) {
        list<string> clusters = (text =~ x/(\X)/g) ?? ();
        list<int> offsets = (0,);
        int index = 0;
        int offset = 0;
        foreach string cluster in (clusters) {
            offset += cluster.length();
            offsets += offset;
            if (offset <= cursor) {
                ++index;
            }
        }
        if (forward) {
            while (index < clusters.size() && !wordSpace(clusters[index])) {
                ++index;
            }
            while (index < clusters.size() && wordSpace(clusters[index])) {
                ++index;
            }
        } else {
            while (index > 0 && wordSpace(clusters[index - 1])) {
                --index;
            }
            while (index > 0 && !wordSpace(clusters[index - 1])) {
                --index;
            }
        }
        return offsets[index];
    }

    private static bool wordSpace(string cluster) {
        return cluster.substr(0, 1) == " " || cluster.substr(0, 1) == "\t";
    }

    /** Processes a keyboard event and applies the corresponding editing action.

        Handles all standard readline-style key bindings:
        - Printable characters: insert at cursor
        - Backspace/Delete: delete char before/at cursor
        - Left/Right arrows: move cursor
        - Home/End: move to start/end
        - Ctrl+Left/Right, Alt+Left/Right: word navigation
        - Ctrl+A/E: home/end
        - Ctrl+B/F: left/right
        - Ctrl+K/U: kill to end/start
        - Ctrl+W, Ctrl+Backspace: delete word back
        - Ctrl+D: delete char at cursor
        - Ctrl+Delete, Alt+D: delete word forward
        - Alt+B/F: word left/right

        @param ev the input event from the ncurses event loop
        @return True if the event was handled (buffer was modified or cursor moved)

        @since %ncurses 1.0
    */
    bool processEvent(hash<Ncurses::InputEvent> ev) {
        if (ev.type == Ncurses::InputType::Char) {
            string ch = ev.ch ?? "";
            int code = ord(ch);
            if (code == 0x7f || code == 0x08) {
                # Backspace
                backspace();
                return True;
            } else if (code == 0x01) {
                # Ctrl+A — home
                moveHome();
                return True;
            } else if (code == 0x05) {
                # Ctrl+E — end
                moveEnd();
                return True;
            } else if (code == 0x0b) {
                # Ctrl+K — kill to end
                killToEnd();
                return True;
            } else if (code == 0x15) {
                # Ctrl+U — kill to start
                killToStart();
                return True;
            } else if (code == 0x17) {
                # Ctrl+W — delete word back
                deleteWordBack();
                return True;
            } else if (code == 0x02) {
                # Ctrl+B — left
                moveLeft();
                return True;
            } else if (code == 0x06) {
                # Ctrl+F — right
                moveRight();
                return True;
            } else if (code == 0x04) {
                # Ctrl+D — delete char at cursor
                deleteChar();
                return True;
            } else if (code >= 32) {
                # Printable character
                insertChar(ch);
                return True;
            }
        } else if (ev.type == Ncurses::InputType::Alt) {
            string ch = ev.ch ?? "";
            string lch = ch.lwr();
            if (lch == "b") {
                moveWordLeft();
                return True;
            } else if (lch == "f") {
                moveWordRight();
                return True;
            } else if (lch == "d") {
                deleteWordForward();
                return True;
            }
        } else if (ev.type == Ncurses::InputType::Key) {
            string name = ev.name ?? "";
            if (name == "kLFT3" || name == "kLFT5") {
                # Alt+Left or Ctrl+Left — word left
                moveWordLeft();
                return True;
            } else if (name == "kRIT3" || name == "kRIT5") {
                # Alt+Right or Ctrl+Right — word right
                moveWordRight();
                return True;
            } else if (name == "KEY_LEFT") {
                moveLeft();
                return True;
            } else if (name == "KEY_RIGHT") {
                moveRight();
                return True;
            } else if (name == "KEY_HOME") {
                moveHome();
                return True;
            } else if (name == "KEY_END") {
                moveEnd();
                return True;
            } else if (name == "KEY_BACKSPACE") {
                backspace();
                return True;
            } else if (name == "kDC5") {
                # Ctrl+Delete — delete word forward
                deleteWordForward();
                return True;
            } else if (name == "KEY_DC") {
                deleteChar();
                return True;
            }
        }
        return False;
    }
}

/** Command history helper.

    @deprecated Use @ref QoreHistory::History "QoreHistory::History" directly.
    This class is a backward-compatibility alias.

    @since %ncurses 1.0
*/
public class History inherits QoreHistory::History {
    #! Backward-compatible constructor
    constructor(*hash<auto> opts) : QoreHistory::History(opts) {
    }
}

/** Static layout calculation helpers.
    @since %ncurses 1.0
*/
public class LayoutCalc {
    /** Calculates basic layout sizes.
        @param rows total terminal rows
        @param cols total terminal columns
        @param info_cols preferred info panel width
        @param input_rows preferred input panel height

        @return hash with keys: main_cols, info_cols, input_rows, output_rows

        @since %ncurses 1.0
    */
    static hash<auto> calcLayout(int rows, int cols, int info_cols = 28, int input_rows = 3) {
        int min_main = 24;
        int min_info = 18;
        int info = info_cols;
        if (cols - info < min_main) {
            info = max(0, cols - min_main);
        }
        if (info < min_info) {
            info = 0;
        }
        int in_rows = input_rows < 3 ? 3 : input_rows;
        int out_rows = rows - in_rows;
        return {
            "main_cols": cols - info,
            "info_cols": info,
            "input_rows": in_rows,
            "output_rows": out_rows,
        };
    }
}

/** Static scroll calculation helpers.
    @since %ncurses 1.0
*/
public class ScrollCalc {
    /** Clamps a scroll offset to valid bounds.
        @param total_lines total number of lines
        @param visible_lines number of visible lines
        @param scroll current scroll offset from bottom (0 means bottom)

        @return clamped scroll offset

        @since %ncurses 1.0
    */
    static int clampScroll(int total_lines, int visible_lines, int scroll) {
        if (visible_lines <= 0) {
            return 0;
        }
        int max_scroll = max(0, total_lines - visible_lines);
        if (scroll < 0) {
            return 0;
        }
        if (scroll > max_scroll) {
            return max_scroll;
        }
        return scroll;
    }

    /** Calculates the start index for a scrolled view.
        @param total_lines total number of lines
        @param visible_lines number of visible lines
        @param scroll scroll offset from bottom (0 means bottom)

        @return starting index in the line list

        @since %ncurses 1.0
    */
    static int scrollStart(int total_lines, int visible_lines, int scroll) {
        if (visible_lines <= 0) {
            return 0;
        }
        int s = ScrollCalc::clampScroll(total_lines, visible_lines, scroll);
        int start = total_lines - visible_lines - s;
        if (start < 0) {
            return 0;
        }
        return start;
    }
}

} # namespace NcursesReplUi
