#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.

# qrepl — Full-screen ncurses REPL for Qore
#
# This is the primary usage example for the NcursesUi toolkit. It demonstrates:
# - Application + BoxLayout for the root layout (menu bar, output pane, status bar)
# - TranscriptWidget for searchable output with stable selection and tail following
# - MenuBarWidget with Alt+key hotkeys and dropdown commands
# - StatusBarWidget with live status segments
# - Output capture via File::getPipe() + a background reader thread
# - Modal dialogs (exit confirmation, file browser, animated About)
# - TextEditorWidget for multiline drafts, atomic paste, selection and undo

%requires ncurses
%requires QoreRepl
%requires NcursesReplUi
%requires NcursesUi
%requires NcursesQore

%modern

%exec-class QRepl

# Full-screen ncurses REPL application.
#
# Architecture:
# - Uses NcursesUi::Application as the event loop and drawing coordinator
# - Root widget is a vertical BoxLayout: MenuBarWidget (top), ScrollableWidget
#   (middle, expanding), TextEditorWidget, StatusBarWidget (bottom)
# - Output blocks retain source identities across wrapping and retention
# - The editable draft has its own viewport and shared caret/completion geometry
# - Commands are dispatched through QoreRepl::QoreRepl for evaluation
# - stdout/stderr are captured via File::getPipe() and a background thread
#   that reads the pipe and appends captured output to the output pane
# - Modal panels handle exit confirmation, file browser, and the animated
#   About dialog with a spinning Qore coin
class QRepl {
    private {
        #! the application
        NcursesUi::Application app;
        #! the REPL engine
        QoreRepl::QoreRepl repl;
        NcursesQore::CodeSupport code_support;
        NcursesUi::EditorAssistance assistance;
        NcursesUi::BackgroundTask evaluation;
        NcursesUi::Dialogs dialogs;
        bool more_input = False;
        bool quit_after_evaluation = False;
        bool owns_app = True;
        bool closed = False;
        int tick_subscription;
        int last_hint_cursor = -1;
        #! current prompt
        string current_prompt;
        #! base prompt width (for aligning continuation prompts)
        int base_prompt_width;

        #! root widget (vertical box layout)
        NcursesUi::Widget root();
        #! streaming output and separately retained editable draft
        NcursesUi::TranscriptWidget output_widget();
        NcursesUi::TextEditorWidget editor();
        NcursesUi::LineListContent output_content = output_widget.getTranscriptContent();
        string clipboard = "";
        bool persistent_history = False;
        #! status bar
        NcursesUi::StatusBarWidget status_bar();
        #! menu bar
        NcursesUi::MenuBarWidget menu_bar();

        #! inline input buffer
        NcursesUi::EditorBuffer buffer = editor.getBuffer();
        #! command history
        QoreHistory::History history();
        #! last status text
        string last_status = "Ready";
        #! last execution error
        *string last_exec_error;
        #! mouse enabled
        bool mouse_enabled = True;
        #! output title
        string output_title = "REPL";

        #! output capture state
        bool capture_enabled = False;
        hash<auto> output_capture = {};
        *QReplOutputCapture capture_reader;
        bool use_tty_enabled = False;


        #! Alt+key → command map built from menu item hotkeys
        hash<string, string> alt_commands = {};

        #! current inline hint text (dim text after cursor)
        *string current_hint;
        #! last buffer text for hint change detection
        string last_hint_input = "";

        #! debug log file
    }

