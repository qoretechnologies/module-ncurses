    # Sets up the UI layout (menu bar, output pane, status bar), initializes
    # the REPL engine and output capture, displays the welcome message, and
    # starts the main event loop.
    constructor(*Ncurses::Session session, bool start = True, *NcursesUi::Application application, *QoreRepl::QoreRepl evaluator, bool capture = False) {
        if (!session) { parse_args(); }
        persistent_history = !session;

        repl = evaluator ?? new QoreRepl::QoreRepl({"history_file": NOTHING});
        code_support = new NcursesQore::CodeSupport(repl);
        current_prompt = repl.getPrompt();
        base_prompt_width = display_prompt(current_prompt).length();

        Ncurses::Session s = session ?? make_session();
        app = application ?? new NcursesUi::Application(s); owns_app = !application;
        dialogs = new NcursesUi::Dialogs(app);
        evaluation = new NcursesUi::BackgroundTask(app, "evaluate", "Evaluate Qore");
        assistance = new NcursesUi::EditorAssistance(app, editor,
            hash<NcursesUi::AssistanceResponse> sub (hash<NcursesUi::AssistanceRequest> request) { return code_support.complete(request); });

        init_ui(); app.setReadTimeout(-1, 25);
        if (!session || capture) { if (capture) { use_tty_enabled = True; } init_output_capture(); }

        # load persistent history
        if (persistent_history && exists ENV.HOME) {
            history.load(ENV.HOME + "/.qore-repl-history");
        }

        refresh_history();
        push_output("Qore Ncurses REPL (QoreRepl backend)");
        output_title = "Qore REPL";
        push_output("Enter: evaluate | Tab: complete | F1: help | Ctrl-Q: quit");

        # start the first prompt line
        new_prompt_line();


        if (start) { set_return_value(run()); }
    }

    # Public accessors support embedding with a caller-owned terminal and event loop.
    NcursesUi::Application getApplication() { return app; }
    NcursesUi::TextEditorWidget getEditor() { return editor; }
    NcursesUi::TranscriptWidget getTranscript() { return output_widget; }

    # Deterministic embedding/test barrier; interactive handlers never join a worker.
    nothing joinEvaluation() { evaluation.join(); app.processPending(); }
    hash<NcursesUi::EventResult> processEvent(hash<Ncurses::InputEvent> event) { return handle_global_key(event); }
    bool isEvaluating() { return evaluation.isRunning(); }
    nothing close() { close_session(); }

    private nothing refresh_history() { buffer.setHistory(map $1.text, history.getItems()); }

    private nothing parse_args() {
        int i = 0;
        while (i < ARGV.size()) {
            string arg = ARGV[i];
            if (arg == "-h" || arg == "--help") {
                printf("qrepl - full-screen Qore REPL (ncurses UI)\n");
                printf("Usage: qrepl [--help|-h]\n");
                printf("Enter=eval, Alt-Enter=newline, Tab=completion/help, F1=key help\n");
                printf("Ctrl-P/N=history, Ctrl-R=filtered history, Ctrl-Q/Alt-Q=quit\n");
                printf("Ctrl-S=search output, F3/Shift-F3=next/previous match, F6=output/editor\n");
                printf("PageUp/Down=scroll output, Ctrl-End=latest, Ctrl-Z/Y=undo/redo\n");
                printf("Ctrl: ^A home, ^E end, ^K kill-to-end, ^U kill-to-start, ^W word-back\n");
                thread_exit;
            }
            ++i;
        }
    }

    private Ncurses::Session make_session() {
        try {
            use_tty_enabled = True;
            return new Ncurses::Session({"use_tty": True, "esc_delay": 25, "mouse": True,
                "colors": True, "raw": True, "cursor": 1, "bracketed_paste": True});
        } catch (hash<ExceptionInfo> ex) {
            # fallback without TTY
        }
        use_tty_enabled = False;
        return new Ncurses::Session({"esc_delay": 25, "mouse": True, "colors": True,
            "raw": True, "cursor": 1, "bracketed_paste": True});
    }

    private nothing init_ui() {
        # set up menu bar (connect to app for dropdown popups)
        menu_bar.setApplication(app);
        menu_bar.addMenu("File", (
            {"label": "Browse...", "command": "file_browser", "hotkey": "Alt+O"},
            {"label": "Load...", "command": "/load"},
            {"label": "Save...", "command": "/save"},
            {"separator": True},
            {"label": "Pwd", "command": "/pwd"},
            {"separator": True},
            {"label": "Quit", "command": "/quit", "hotkey": "Alt+Q"},
        ));
        menu_bar.addMenu("Edit", (
            {"label": "Clear Output", "command": "clear_output"},
            {"label": "Reset", "command": "/reset"},
        ));
        menu_bar.addMenu("View", (
            {"label": "Search Output...", "command": "search_output"},
            {"label": "Latest Output", "command": "latest_output"},
            {"separator": True},
            {"label": "Variables", "command": "/vars"},
            {"label": "Functions", "command": "/functions"},
            {"label": "Classes", "command": "/classes"},
            {"label": "Namespaces", "command": "/namespaces"},
            {"label": "Modules", "command": "/modules"},
            {"separator": True},
            {"label": "History", "command": "/history"},
            {"label": "Timing", "command": "/timing"},
        ));
        menu_bar.addMenu("Help", (
            {"label": "Keyboard Help", "command": "ui_help", "hotkey": "Alt+H"},
            {"label": "Qore Commands", "command": "/help"},
            {"separator": True},
            {"label": "About", "command": "about", "hotkey": "Alt+A"},
        ));
        menu_bar.setOnCommand(sub (string cmd) {
            handle_menu_command(cmd);
        });

        # build Alt+key → command map from menu item hotkeys
        foreach hash<auto> menu in (menu_bar.getMenus()) {
            foreach hash<auto> item in (menu.items) {
                if (item.separator) {
                    continue;
                }
                *string hotkey = item.hotkey;
                if (exists hotkey && hotkey.size() > 0) {
                    string hk_char = hotkey.substr(-1).lwr();
                    alt_commands{hk_char} = item.command;
                }
            }
        }

        # Independent output and draft viewports preserve reading position during edits.
        output_widget.setRetentionLimit(10000);
        editor.setAutoHeight(1, 6);
        editor.setHighlighter(string sub (string source) { return code_support.highlight(source); });
        editor.setVSizePolicy(NcursesUi::SizePolicy::Fixed);
        editor.setClipboard(sub (string text) { clipboard = text; }, string sub () { return clipboard; });
        output_widget.setOnCopy(sub (string text) { clipboard = text; });
        output_widget.setVSizePolicy(NcursesUi::SizePolicy::Expanding);
        output_widget.setShowScrollbar(True);

        # set up status bar
        update_status();

        # Build the transcript, bounded editor and status layout.
        root.addChild(menu_bar);
        root.addChild(output_widget);
        root.addChild(editor);
        root.addChild(status_bar);

        # layout: vertical box
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        app.getFocusManager().setFocus(editor);

        # global key handler
        if (owns_app) {
            app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) { return processEvent(ev); });
        }

        # tick callback for periodic updates
        tick_subscription = app.addOwnedTickCallback(sub () {
            on_tick();
        });
    }

    # Initializes stdout/stderr capture via File::getPipe() and a background
    # reader thread. Captured output is buffered and drained into the output
    # pane after each REPL evaluation completes.
    private nothing init_output_capture() {
        if (!use_tty_enabled) {
            return;
        }
        try {
            output_capture = start_output_capture();
            capture_enabled = True;
        } catch (hash<ExceptionInfo> ex) {
            capture_enabled = False;
            push_output("Warning: output capture disabled: " + QoreRepl::QoreRepl::formatError(ex));
            return;
        }
        # C-level redirect (fflush + dup2 + setvbuf) is optional — the Qore-level
        # redirect in start_output_capture() is sufficient when Qore's print_node
        # includes fflush(); these calls provide a belt-and-suspenders safety net
        try {
            Ncurses::Session s = app.getSession();
            s.redirectStdout(output_capture.pipe.write);
            s.redirectStderr(output_capture.pipe.write);
        } catch (hash<ExceptionInfo> ex) {
            # not fatal — Qore-level redirect already active
        }
    }

    private hash<auto> start_output_capture() {
        hash<PipeInfo> pipe = File::getPipe();
        File stdout_restore(); File stderr_restore();
        stdout_restore.open2("/proc/self/fd/1", O_WRONLY);
        stderr_restore.open2("/proc/self/fd/2", O_WRONLY);
        Ncurses::Session terminal = app.getSession();
        QReplOutputCapture reader(pipe.read, sub () { terminal.wakeup(); });
        on_error {
            stdout.redirect(stdout_restore); stderr.redirect(stderr_restore);
            reader.close(); pipe.write.close(); pipe.read.close();
        }
        stdout.redirect(pipe.write); stderr.redirect(pipe.write); capture_reader = reader;
        return {"pipe": pipe, "stdout_restore": stdout_restore, "stderr_restore": stderr_restore};
    }

    private nothing drain_pending_output() {
        if (capture_reader) {
            list<string> lines = capture_reader.drain();
            if (lines) { output_widget.appendLines(lines); update_status(); }
        }
    }

    /** Flushes producer buffers before requesting an acknowledged capture barrier. */
    private nothing flush_capture() {
        if (capture_enabled) { app.getSession().flushStdio(); }
    }

    private nothing push_output(string line) { output_widget.appendLine(line); }

    /** Updates the draft's prompt and bounded layout without changing transcript position. */
    private nothing update_prompt_line() {
        editor.setPrompt(display_prompt(current_prompt));
        string text = buffer.getText();
        if (text != last_hint_input || buffer.getCursor() != last_hint_cursor) {
            last_hint_input = text; last_hint_cursor = buffer.getCursor(); update_hints(); update_status();
        }
        app.layoutRoot();
    }

    private nothing new_prompt_line() { update_prompt_line(); }

    # Evaluation owns the backend until its completion reaches the UI thread.
    # The submitted revision protects edits made while the worker runs.
    private nothing on_input_submit() {
        if (evaluation.isRunning()) { return; }
        string text = buffer.getText(); if (text == "") { return; }
        if (text.size() >= 2 && text[0] == "!") {
            *string expanded = history.expand(text);
            if (!exists expanded) { push_output(text + ": event not found"); last_status = "Error"; update_status(); return; }
            text = expanded;
        }
        if (trim(text) =~ /^\/(quit|exit|q)$/) { show_quit_dialog(); return; }
        if (text == "clear_output") { output_widget.clear(); buffer.setText(""); last_status = "Cleared"; update_status(); new_prompt_line(); return; }
        start_evaluation(text, True);
    }

    private nothing start_evaluation(string text, bool submitted = False) {
        if (evaluation.isRunning()) { return; }
        assistance.close(); current_hint = NOTHING;
        int revision = buffer.getRevision();
        output_widget.appendBlock(split("\n", display_prompt(current_prompt) + text, False, True), "input");
        last_status = "Evaluating..."; last_exec_error = NOTHING; update_status(); app.drawAll();
        evaluation.start(auto sub () {
            *hash<auto> result;
            try { result = repl.eval(text); }
            catch (hash<ExceptionInfo> ex) { result = {"error": ex}; }
            # The reader acknowledges a finite producer prefix before the result is posted.
            flush_capture(); if (capture_reader) { capture_reader.flush(); }
            hash<auto> outcome = {"prompt": repl.getPrompt(), "more": repl.needsMoreInput(), "indent": repl.getIndentLevel(),
                "continuation": !exists result, "exit": result.exit, "timing": result.timing};
            if (result.error) { outcome.error = QoreRepl::QoreRepl::formatError(result.error); }
            else if (exists result.value) { outcome.text = result.is_eval ? sprintf("%y", result.value) : string(result.value); }
            return outcome;
        }, sub (hash<NcursesUi::TaskResult> completed) { finish_evaluation(text, submitted, revision, completed); });
    }

    private nothing finish_evaluation(string text, bool submitted, int revision, hash<NcursesUi::TaskResult> completed) {
        drain_pending_output();
        hash<auto> result = completed.error ? {"error": QoreRepl::QoreRepl::formatError(completed.error)} : completed.value;
        current_prompt = result.prompt ?? current_prompt; more_input = !!result.more;
        last_exec_error = result.error;
        if (result.error) {
            output_widget.appendBlock(split("\n", "Error: " + result.error, False, True), "error"); last_status = "Error";
        } else {
            if (exists result.text) { output_widget.appendBlock(split("\n", string(result.text), False, True), "result"); }
            if (result.timing) { push_output("[" + result.timing + "]"); }
            last_status = result.continuation ? "Continue..." : "OK";
            if (submitted && !result.exit) {
                history.add(text); refresh_history();
                if (buffer.getRevision() == revision) { buffer.setText(more_input ? strmul("    ", int(result.indent)) : ""); }
            }
        }
        update_hints(); update_prompt_line(); update_status();
        if (quit_after_evaluation) { app.quit(); }
        else if (result.exit) { show_quit_dialog(); }
    }

    # Routes menu commands to their handlers (file browser, about dialog,
    # clear output, quit). For REPL commands, saves the input buffer state,
    # executes the command, waits for output capture, and restores the buffer.
    private nothing handle_menu_command(string cmd) {
        if (cmd == "file_browser" || cmd == "/load") {
            show_file_browser();
            return;
        }
        if (cmd == "/save") { show_save_dialog(); return; }
        if (cmd == "ui_help") { show_help(); return; }
        if (cmd == "about") {
            show_about_dialog();
            return;
        }
        if (cmd == "search_output") { show_search(False); return; }
        if (cmd == "latest_output") { output_widget.returnToLatest(); update_status(); return; }
        if (cmd == "clear_output") {
            output_widget.clear();
            last_status = "Cleared";
            update_status();
            new_prompt_line();
            return;
        }
        if (cmd == "/quit") { show_quit_dialog(); return; }
        # Menu evaluation never changes the draft, selection or undo history.
        start_evaluation(cmd);
    }

    private hash<NcursesUi::EventResult> handle_global_key(hash<Ncurses::InputEvent> ev) {
        if (app.getDispatcher().hasModal()) { return <NcursesUi::EventResult>{"handled": False}; }
        string ch = ev.ch ?? ""; string name = ev.name ?? ""; bool handled = True;
        bool editing = True;
        if (ev.type == Ncurses::InputType::Char && (ch == "\x1b" || ch == "\x11")) {
            if (menu_bar.isDropdownOpen()) { menu_bar.closeMenu(); }
            else { show_quit_dialog(); }
            editing = False;
        } else if (ev.type == Ncurses::InputType::Char && ch == "\x0c") { root.markDirty(); editing = False; }
        else if (ev.type == Ncurses::InputType::Char && ch == "\x13") { show_search(False); editing = False; }
        else if (ev.type == Ncurses::InputType::Char && ch == "\x12") { show_search(True); editing = False; }
        else if (ev.type == Ncurses::InputType::Key && name == "KEY_F(1)") { show_help(); editing = False; }
        else if (ev.type == Ncurses::InputType::Key && name == "KEY_F(6)") {
            app.getFocusManager().setFocus(output_widget.hasFocus() ? editor : output_widget); editing = False;
        } else if (ev.type == Ncurses::InputType::Key && (name == "KEY_F(3)" || name == "KEY_F(15)")) {
            output_widget.findNext(name != "KEY_F(15)"); editing = False;
        } else if (ev.type == Ncurses::InputType::Key && name == "kEND5") { output_widget.returnToLatest(); editing = False; }
        else if (ev.type == Ncurses::InputType::Key && name == "KEY_F(2)") {
            mouse_enabled = !mouse_enabled; app.getSession().setMouse(mouse_enabled); editing = False;
        } else if (ev.type == Ncurses::InputType::Key && (name == "KEY_PPAGE" || name == "KEY_NPAGE")) {
            output_widget.scrollTo(name == "KEY_PPAGE" ? NcursesUi::ScrollDirection::PageUp : NcursesUi::ScrollDirection::PageDown);
            editing = False;
        } else if (ev.type == Ncurses::InputType::Mouse) {
            # Route hit testing and wheel events to the actual viewport under the pointer.
            return <NcursesUi::EventResult>{"handled": False};
        } else if (output_widget.hasFocus() && (ev.type == Ncurses::InputType::Key
                || (ev.type == Ncurses::InputType::Char && (ch == "n" || ch == "N" || ch == "\x03")))) {
            handled = output_widget.processEvent(ev).handled; editing = False;
        } else if (ev.type == Ncurses::InputType::Char && (ch == "\n" || ch == "\r")
                || ev.type == Ncurses::InputType::Key && name == "KEY_ENTER") { on_input_submit(); }
        else if (ev.type == Ncurses::InputType::Char && ch == "\t") { handle_tab_completion(); editing = False; }
        else if (ev.type == Ncurses::InputType::Char && (ch == "\x10" || ch == "\x0e")) { buffer.historyMove(ch == "\x0e"); }
        else if (ev.type == Ncurses::InputType::Key && (name == "KEY_UP" || name == "KEY_DOWN")
                && buffer.getText().find("\n") < 0) { buffer.historyMove(name == "KEY_DOWN"); }
        else if (ev.type == Ncurses::InputType::Char && (ch == "\x01" || ch == "\x05")) {
            editor.processEvent(<Ncurses::InputEvent>{"type": Ncurses::InputType::Key, "name": ch == "\x01" ? "KEY_HOME" : "KEY_END"});
        } else if (ev.type == Ncurses::InputType::Char && (ch == "\x0b" || ch == "\x15")) { buffer.killToBoundary(ch == "\x0b"); }
        else if (ev.type == Ncurses::InputType::Char && ch == "\x17") { buffer.eraseWord(False); }
        else if (ev.type == Ncurses::InputType::Char && (ch == "\x02" || ch == "\x06")) { buffer.moveHorizontal(ch == "\x06"); }
        else if (ev.type == Ncurses::InputType::Char && ch == "\x04") { buffer.erase(True); }
        else if (ev.type == Ncurses::InputType::Key && (name == "kLFT3" || name == "kLFT5" || name == "kRIT3" || name == "kRIT5")) {
            buffer.moveWord(name == "kRIT3" || name == "kRIT5");
        } else if (ev.type == Ncurses::InputType::Key && name == "kDC5") { buffer.eraseWord(True); }
        else if (ev.type == Ncurses::InputType::Alt && ch.lwr() == "b") { buffer.moveWord(False); }
        else if (ev.type == Ncurses::InputType::Alt && ch.lwr() == "d") { buffer.eraseWord(True); }
        else if (ev.type == Ncurses::InputType::Alt && ch != "\n" && ch != "\r") {
            *string cmd = alt_commands{ch.lwr()};
            if (cmd) { handle_menu_command(cmd); } else { handled = menu_bar.processAltKey(ch); }
            editing = False;
        } else {
            handled = editor.processEvent(ev).handled;
            if (handled && ev.type == Ncurses::InputType::Char && ch == "}" && more_input) {
                NcursesReplUi::InputBuffer dedent(); dedent.setText(buffer.getText());
                if (dedent.autoDedent("    ")) { buffer.replace(0, buffer.getText().length(), dedent.getText()); }
            }
        }
        if (handled) {
            if (editing) { app.getFocusManager().setFocus(editor); }
            update_prompt_line(); update_status();
        }
        return <NcursesUi::EventResult>{"handled": handled};
    }

    private nothing show_search(bool history_search) {
        dialogs.prompt(history_search ? "Search history" : "Search output",
            <NcursesUi::FormField>{"name": "query", "label": "Find", "help": "Enter text to find; Escape cancels.", "default_value": ""},
            sub (auto value) {
                if (history_search) { buffer.historyMove(False, string(value)); }
                else { output_widget.setSearch(string(value)); output_widget.findNext(); }
                update_prompt_line(); update_status();
            }, "Find");
    }

    private nothing update_hints() {
        current_hint = NOTHING;
        if (evaluation.isRunning()) { return; }
        string prefix = buffer.getText().substr(0, buffer.getCursor());
        if (prefix == "") { return; }
        try { current_hint = code_support.hint(prefix); }
        catch (hash<ExceptionInfo> ex) { @debug("Qore hints: %s", ex.desc); }
    }

    private nothing handle_tab_completion() {
        if (evaluation.isRunning()) { return; }
        try { assistance.request(True); }
        catch (hash<ExceptionInfo> ex) { last_status = "Help unavailable"; update_status(); }
    }

    private nothing show_quit_dialog() {
        bool running = evaluation.isRunning();
        string message = running ? "Evaluation is running. Quit when it finishes?" :
            (buffer.getText() != "" ? "Exit the REPL and discard the current draft?" : "Exit the REPL?");
        dialogs.confirm("Quit", message, sub () {
            if (evaluation.isRunning()) { quit_after_evaluation = True; update_status(); }
            else { app.quit(); }
        }, running ? "Finish and quit" : "Quit");
    }

    private nothing show_help() {
        dialogs.message("Keyboard help", "Enter: evaluate; Alt-Enter: newline\nTab: completion/signature help; popup Tab: documentation\n"
            + "Ctrl-P/N or single-line Up/Down: history\nCtrl-R: search history; Ctrl-S: search output\nF3 / Shift-F3: next / previous match\n"
            + "F6: switch editor/output; PageUp/Down: read output\nCtrl-End: latest output; Ctrl-Z/Y: undo/redo\nCtrl-Left/Right: word movement; Alt-F: File menu\n"
            + "Ctrl-Q or Alt-Q: quit; Escape: close a dialog\nEvaluation keeps the UI responsive. New submissions and assistance wait for it to finish.");
    }

    private nothing show_save_dialog() {
        if (evaluation.isRunning()) { dialogs.message("Evaluation running", "Save is available when evaluation finishes."); return; }
        dialogs.prompt("Save session history", <NcursesUi::FormField>{"name": "path", "label": "Filename", "required": True,
            "help": "Save evaluated commands as a Qore file.", "default_value": "",
            "validate": *string sub (auto value) {
                string path = string(value);
                if (trim(path) == "") { return "Enter a filename."; }
                if (path != trim(path) || path =~ /[\r\n\x00]/) { return "Use a path without surrounding whitespace or control characters."; }
                return NOTHING;
            }}, sub (auto value) {
                string path = string(value);
                if (stat(path)) { dialogs.confirm("Replace file", "Replace " + path + "?", sub () { start_evaluation("/save " + path); }, "Replace"); }
                else { start_evaluation("/save " + path); }
            }, "Save");
    }

    /** Opens the About dialog with animated Qore spinning coin. */
    private nothing show_about_dialog() {
        Ncurses::Session sess = app.getSession();
        hash<Ncurses::Size> sz = sess.screen().size();

        # build version info lines for the right side
        list<string> info_lines = AboutDialogWidget::buildVersionInfo();
        if (sz.rows < 12 || sz.cols < 50) { dialogs.message("About Qore REPL", join("\n", info_lines)); return; }

        # dialog dimensions: border(2) + padding(2) + art + gap(2) + info area
        int info_width = 0;
        foreach string line in (info_lines) {
            if (line.length() > info_width) {
                info_width = line.length();
            }
        }
        int dlg_width = AnimFrameWidth + 2 + info_width + 4;
        # ensure at least tall enough for art + button row
        int dlg_height = AnimFrameHeight + 4;
        # fall back to narrow layout if terminal is too small
        if (dlg_width > sz.cols - 2) {
            dlg_width = AnimFrameWidth + 4;
            dlg_height = AnimFrameHeight + 7;
        }
        dlg_width = min(dlg_width, sz.cols - 2);
        dlg_height = min(dlg_height, sz.rows - 2);
        int dy = (sz.rows - dlg_height) / 2;
        int dx = (sz.cols - dlg_width) / 2;

        AboutDialogWidget dlg(sess, self);
        dlg.setTitle("About Qore REPL");
        dlg.resize(NcursesUi::Geometry::makeRect(dy, dx, dlg_height, dlg_width));
        dlg.setOnDismiss(sub () {
            app.popModal();
            dlg.destroyPanel();
            # restore default read timeout
            app.setReadTimeout(-1, 25);
        });
        dlg.createPanel();
        app.pushModal(dlg);

        # set faster read timeout for ~30fps animation
        app.setReadTimeout(33, 25);
    }

    private nothing on_tick() {
        if (capture_enabled) { drain_pending_output(); }
        update_prompt_line(); update_status();
    }

    private nothing update_status() {
        hash<auto> normal = {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue};
        hash<auto> emphasis = {"fg": Ncurses::Color::Yellow, "bg": Ncurses::Color::Blue, "attrs": Ncurses::Attr::Bold};
        list<hash<auto>> segments = (
            {"text": quit_after_evaluation ? "Finishing, then quit" : last_status, "compact": evaluation.isRunning() ? "Running" : last_status,
                "priority": evaluation.isRunning() ? 110 : 80, "style": {"fg": status_color(last_status), "bg": Ncurses::Color::Blue, "attrs": Ncurses::Attr::Bold}},
            {"text": output_widget.hasFocus() ? "Output [F6: editor]" : "Editor [Tab: help]", "compact": output_widget.hasFocus() ? "Output" : "Editor", "priority": 60, "style": normal}
        );
        if (!output_widget.isFollowing()) {
            segments += {"text": "Paused +" + output_widget.getUnreadCount() + " [Ctrl-End: latest]",
                "compact": "Paused +" + output_widget.getUnreadCount(), "priority": 100, "style": emphasis};
        }
        if (current_hint) { segments += {"text": current_hint, "priority": 40, "style": emphasis}; }
        segments += ({"text": "F1: keys", "priority": 20, "style": normal}, {"text": output_title, "priority": 0, "align": "right", "style": normal});
        if (status_bar.getSegments() != segments) { status_bar.setSegments(segments); }
    }

    private nothing show_file_browser() {
        if (evaluation.isRunning()) { dialogs.message("Evaluation running", "Load is available when evaluation finishes."); return; }
        dialogs.openFile(getcwd(), sub (string path) { start_evaluation("/load " + path); });
    }

    private int run() {
        try {
            app.run();
        } catch (hash<ExceptionInfo> ex) {
            # app.run() already calls close() on exception to restore the terminal;
            # print the error so the user can see what happened
            close_session();
            stderr.printf("qrepl: unhandled exception in event loop:\n");
            stderr.printf("  %s: %s\n", ex.err, ex.desc);
            if (exists ex.arg) {
                stderr.printf("  arg: %y\n", ex.arg);
            }
            stderr.printf("  at %s:%d (%s)\n", ex.file ?? "<unknown>", ex.line, ex.type ?? "");
            # print full chain
            *hash<ExceptionInfo> next = ex.next;
            while (exists next) {
                stderr.printf("  chained: %s: %s at %s:%d\n",
                    next.err, next.desc, next.file ?? "<unknown>", next.line);
                next = next.next;
            }
            return 1;
        }
        close_session();
        return 0;
    }

    private nothing close_session() {
        if (closed) { return; } closed = True;
        app.removeTickCallback(tick_subscription); if (!owns_app) { app.setRootLayout(NOTHING); } if (owns_app) { app.setGlobalKeyHandler(NOTHING); }
        on_exit { if (owns_app) { app.close(); } }
        on_exit restore_output();
        on_exit dialogs.close();
        on_exit assistance.close();
        on_exit editor.setHighlighter(NOTHING);
        evaluation.close();
        # save persistent history
        if (persistent_history && exists ENV.HOME) {
            try {
                history.save(ENV.HOME + "/.qore-repl-history");
            } catch (hash<ExceptionInfo> ex) {
                # ignore save errors during shutdown
            }
        }

    }

    private nothing restore_output() {
        if (!capture_enabled) { return; } capture_enabled = False;
        on_exit output_capture.pipe.read.close();
        on_exit output_capture.pipe.write.close();
        on_exit { if (capture_reader) { capture_reader.close(); capture_reader = NOTHING; } }
        # Restore both Qore handles even when the native session was already closed.
        on_exit stderr.redirect(output_capture.stderr_restore);
        stdout.redirect(output_capture.stdout_restore);
        Ncurses::Session session = app.getSession();
        if (session.isOpen()) {
            on_exit session.redirectStderr(output_capture.stderr_restore);
            session.redirectStdout(output_capture.stdout_restore);
        }
    }

    private static int status_color(string status) {
        if (status == "OK" || status == "Ready" || status == "Cleared") {
            return Ncurses::Color::Green;
        }
        if (status == "Error") {
            return Ncurses::Color::Red;
        }
        if (status == "Evaluating...") {
            return Ncurses::Color::Yellow;
        }
        if (status == "Exit") {
            return Ncurses::Color::Magenta;
        }
        if (status == "ESC!" || status == "Ctrl+Q!") {
            return Ncurses::Color::Cyan;
        }
        return Ncurses::Color::White;
    }

    private string display_prompt(string prompt) {
        if (!prompt || prompt == "") {
            return ">>> ";
        }
        string result = prompt;
        if (result.substr(-1) != " ") {
            result += " ";
        }
        # pad shorter prompts (e.g. continuation "...> ") to align with base prompt
        # "...> " (5 chars) becomes "    > " (6 chars) to match "qore> "
        if (base_prompt_width > 0 && result.length() < base_prompt_width) {
            int pad = base_prompt_width - 2;  # space for "> " suffix
            result = strmul(" ", pad) + "> ";
        }
        return result;
    }
}

/** Animated About dialog panel for the Qore REPL.

    Displays the Qore spinning coin animation with version info on the right,
    matching the improved layout from qore --version-animation.
    Dismisses on Escape, Enter, Space, or any mouse click.

    @since ncurses 1.0
*/
class AboutDialogWidget inherits NcursesUi::PanelWidget {
    private {
        #! reference to the QRepl instance (for animation data access)
        QRepl repl_ref;
        #! dismiss callback
        *code on_dismiss;
        #! animation start time in microseconds
        int start_us;
        #! color slot for Qore brand color
        const QoreBrandColorSlot = 250;
        #! art style — set up with the Qore brand color in the constructor
        hash<auto> art_style;
        #! info label style
        hash<auto> info_style = {"fg": Ncurses::Color::Cyan, "attrs": Ncurses::Attr::Bold};
        #! dim info style
        hash<auto> dim_style = {"fg": Ncurses::Color::White};
        #! button style
        hash<auto> btn_style = {"fg": Ncurses::Color::Yellow, "bg": Ncurses::Color::Blue,
            "attrs": Ncurses::Attr::Bold};
    }

    constructor(Ncurses::Session s, QRepl repl)
            : PanelWidget(s) {
        repl_ref = repl;
        start_us = clock_getmicros();
        setFocusable(True);
        # define the exact Qore brand color RGB(255, 50, 140) if the terminal supports it
        int color_slot = 204;
        if (s.canChangeColor() && s.maxColors() > QoreBrandColorSlot) {
            # ncurses uses 0-1000 range for RGB
            # R: 255/255*1000 = 1000, G: 50/255*1000 ≈ 196, B: 140/255*1000 ≈ 549
            s.initColor(QoreBrandColorSlot, 1000, 196, 549);
            color_slot = QoreBrandColorSlot;
        }
        art_style = {"fg": color_slot, "attrs": Ncurses::Attr::Bold};
    }

    nothing setOnDismiss(*code cb) {
        on_dismiss = cb;
    }

    #! Build version info lines for display alongside the animation
    static list<string> buildVersionInfo() {
        list<string> info = ();
        info += sprintf("QORE for %s %s", Qore::PlatformOS, Qore::PlatformCPU);
        info += sprintf("version %s", Qore::VersionString);
        info += sprintf("build host: %s", Qore::BuildHost);
        info += sprintf("C++ compiler: %s", Qore::Compiler);
        info += sprintf("CFLAGS: %s", Qore::CFLAGS);
        info += sprintf("LDFLAGS: %s", Qore::LDFLAGS);
        info += "";
        info += "press any key to close";
        return info;
    }

    nothing draw(Ncurses::Window w) {
        PanelWidget::draw(w);

        hash<NcursesUi::Rect> cr = localContentRect();

        # calculate current frame: 6-second cycle at ANIM_FRAME_COUNT frames
        int elapsed = clock_getmicros() - start_us;
        int frame_us = 6000000 / QRepl::AnimFrameCount;
        int frame_idx = (elapsed / frame_us) % QRepl::AnimFrameCount;
        list<string> frame = QRepl::AnimFrames[frame_idx];

        # determine layout: wide (info on right) vs narrow (info below)
        list<string> info_lines = buildVersionInfo();
        int info_width = 0;
        foreach string line in (info_lines) {
            if (line.length() > info_width) {
                info_width = line.length();
            }
        }
        bool wide_layout = (cr.cols >= QRepl::AnimFrameWidth + 2 + info_width);

        if (wide_layout) {
            # --- wide layout: art on left, info on right ---
            int art_x = cr.x;
            int art_y = cr.y;

            # draw animation art
            for (int r = 0; r < frame.size() && art_y + r < cr.y + cr.rows; ++r) {
                string line = frame[r];
                int draw_y = art_y + r;
                w.drawHLine(draw_y, cr.x, cr.cols, " ");
                for (int c = 0; c < line.size() && art_x + c < cr.x + cr.cols; ++c) {
                    string ch = line.substr(c, 1);
                    if (ch != " ") {
                        w.drawText(draw_y, art_x + c, ch, art_style);
                    }
                }
            }

            # draw info text to the right, vertically centered
            int info_x = cr.x + QRepl::AnimFrameWidth + 2;
            int info_start = (QRepl::AnimFrameHeight - info_lines.size()) / 2;
            if (info_start < 0) {
                info_start = 0;
            }
            for (int i = 0; i < info_lines.size(); ++i) {
                int iy = art_y + info_start + i;
                if (iy >= cr.y + cr.rows) {
                    break;
                }
                string text = info_lines[i];
                if (info_x + text.length() > cr.x + cr.cols) {
                    text = text.substr(0, cr.x + cr.cols - info_x);
                }
                if (text.length() > 0) {
                    # use bright style for first two lines, dim for rest
                    hash<auto> style = (i < 2) ? info_style : dim_style;
                    w.drawText(iy, info_x, text, style);
                }
            }
        } else {
            # --- narrow layout: art centered, info below ---
            int art_x = cr.x + (cr.cols - QRepl::AnimFrameWidth) / 2;
            int art_y = cr.y;

            for (int r = 0; r < frame.size() && art_y + r < cr.y + cr.rows; ++r) {
                string line = frame[r];
                int draw_y = art_y + r;
                w.drawHLine(draw_y, cr.x, cr.cols, " ");
                for (int c = 0; c < line.size() && art_x + c < cr.x + cr.cols; ++c) {
                    string ch = line.substr(c, 1);
                    if (ch != " ") {
                        w.drawText(draw_y, art_x + c, ch, art_style);
                    }
                }
            }

            # version text below art
            int ver_y = art_y + QRepl::AnimFrameHeight + 1;
            if (ver_y < cr.y + cr.rows) {
                string ver_text = "Qore v" + Qore::VersionString;
                int ver_x = cr.x + (cr.cols - ver_text.length()) / 2;
                w.drawText(ver_y, ver_x, ver_text, info_style);
            }

            # Close button
            int btn_y = ver_y + 2;
            if (btn_y < cr.y + cr.rows) {
                string btn_text = "[ Close ]";
                int btn_x = cr.x + (cr.cols - btn_text.length()) / 2;
                w.drawText(btn_y, btn_x, btn_text, btn_style);
            }
        }

        # request continuous redraws for animation
        markDirty();
    }

    hash<NcursesUi::EventResult> processEvent(hash<Ncurses::InputEvent> ev) {
        if (ev.type == Ncurses::InputType::Char) {
            dismiss(); return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
        } else if (ev.type == Ncurses::InputType::Mouse) {
            int bs = ev.mouse.button_state;
            if (bs & Ncurses::BUTTON1_CLICKED || bs & Ncurses::BUTTON1_PRESSED) {
                dismiss();
                return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
            }
            # consume all mouse events
            return <NcursesUi::EventResult>{"handled": True};
        } else if (ev.type == Ncurses::InputType::Key || ev.type == Ncurses::InputType::Alt) {
            # any key dismisses
            dismiss();
            return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
        }
        return <NcursesUi::EventResult>{"handled": True};
    }

    private nothing dismiss() {
        if (on_dismiss) {
            on_dismiss();
        }
    }
}

# Owns a pipe reader thread. Producers flush stdio before flush(); UI methods are
# serialized by the caller. The worker never accesses terminal widgets.
class QReplOutputCapture {
    private {
        ReadOnlyFile input;
        EventNotifier wake();
        Counter active(1);
        Mutex mutex();
        Condition changed();
        int requested = 0;
        int acknowledged = 0;
        *code<nothing()> notify;
        bool stopping = False;
        bool finished = False;
        *hash<ExceptionInfo> failure;
        list<string> pending = ();
        # Worker-owned bytes: decode only complete logical lines, preserving split UTF-8.
        binary tail = binary();
    }
    constructor(ReadOnlyFile input, *code<nothing()> on_output) {
        self.input = input; notify = on_output;
        on_error active.dec();
        background run();
    }
    # Snapshot the request, then the pipe byte count. Acknowledgement covers that
    # finite prefix; later writes cannot postpone control handling indefinitely.
    nothing flush() {
        int request;
        {
            mutex.lock(); on_exit mutex.unlock(); checkFailure();
            if (finished || stopping) { throw "QREPL-CAPTURE-CLOSED", "Capture has stopped"; }
            request = ++requested;
        }
        wake.notify();
        mutex.lock(); on_exit mutex.unlock();
        while (acknowledged < request && !finished) { changed.wait(mutex); }
        checkFailure();
        if (acknowledged < request) { throw "QREPL-CAPTURE-CLOSED", "Capture ended before the requested barrier"; }
    }
    list<string> drain() {
        mutex.lock(); on_exit mutex.unlock(); checkFailure();
        list<string> result = pending; pending = (); return result;
    }
    nothing close() {
        {
            mutex.lock(); on_exit mutex.unlock(); stopping = True;
        }
        wake.notify(); active.waitForZero();
    }
    private nothing checkFailure() {
        if (failure) { throw failure.err, failure.desc, failure.arg; }
    }
    private nothing run() {
        on_exit {
            { mutex.lock(); on_exit mutex.unlock(); finished = True; changed.broadcast(); }
            active.dec();
        }
        try {
            while (True) {
                Socket::poll((<SocketPollInfo>{"socket": input, "events": SOCK_POLLIN},
                    <SocketPollInfo>{"socket": wake, "events": SOCK_POLLIN}), -1);
                wake.acknowledge();
                int request; bool stop;
                { mutex.lock(); on_exit mutex.unlock(); request = requested; stop = stopping; }
                list<string> complete = (); bool eof = False;
                int remaining = Ncurses::Session::pendingOutputBytes(input);
                # A readable empty pipe means EOF; a byte arriving after the snapshot
                # may be read here too, but never extends this finite drain budget.
                if (!remaining && input.isDataAvailable(0)) { remaining = 1; }
                while (remaining > 0) {
                    *binary bytes = input.readShortBinary(min(4096, remaining), 0);
                    if (!bytes || !bytes.size()) { eof = True; break; }
                    remaining -= bytes.size(); tail += bytes; int start = 0; int end;
                    while ((end = tail.find(<0a>, start)) >= 0) {
                        complete += decode(tail.substr(start, end - start)); start = end + 1;
                    }
                    if (start) { tail = tail.substr(start); }
                }
                if (request > acknowledged || stop || eof) {
                    if (tail.size()) { complete += decode(tail) + "\x1b[7m%\x1b[0m"; tail = binary(); }
                }
                {
                    mutex.lock(); on_exit mutex.unlock(); pending += complete;
                    acknowledged = request; changed.broadcast();
                }
                if (complete && notify) { notify(); }
                if (stop || eof) { break; }
            }
        } catch (hash<ExceptionInfo> ex) {
            mutex.lock(); on_exit mutex.unlock(); failure = ex;
        }
    }
    private static string decode(binary data) {
        string text = binary_to_string(data, "UTF-8");
        if (!(text =~ /\A(?:\X)*\z/)) { return "[invalid UTF-8 output: " + data.toHex() + "]"; }
        return text;
    }
}
