    # Sets up the UI layout (menu bar, output pane, status bar), initializes
    # the REPL engine and output capture, displays the welcome message, and
    # starts the main event loop.
    constructor() {
        parse_args();

        current_prompt = repl.getPrompt();
        base_prompt_width = display_prompt(current_prompt).length();

        Ncurses::Session s = make_session();
        app = new NcursesUi::Application(s);

        init_ui();
        init_output_capture();

        # load persistent history
        if (exists ENV.HOME) {
            history.load(ENV.HOME + "/.qore-repl-history");
        }

        push_output("Qore Ncurses REPL (QoreRepl backend)");
        hash<auto> qore_info = get_qore_library_info();
        *string qore_version = qore_info{"VersionString"};
        if (qore_version) {
            output_title = "REPL for Qore " + qore_version;
        }
        push_output("Type /help for commands, Ctrl+Q or Esc to quit");

        # start the first prompt line
        new_prompt_line();

        time_text = now().format("HH:mm:SS");
        last_tick = clock_getmillis();

        set_return_value(run());
    }

    private nothing parse_args() {
        int i = 0;
        while (i < ARGV.size()) {
            string arg = ARGV[i];
            if (arg == "-h" || arg == "--help") {
                printf("qrepl - full-screen Qore REPL (ncurses UI)\n");
                printf("Usage: qrepl [--help|-h]\n");
                printf("Controls: Enter=eval, Up/Down=history, Left/Right=cursor, Home/End\n");
                printf("Ctrl: ^A home, ^E end, ^K kill-to-end, ^U kill-to-start, ^W word-back\n");
                thread_exit;
            }
            ++i;
        }
    }

    private Ncurses::Session make_session() {
        try {
            use_tty_enabled = True;
            return new Ncurses::Session({"use_tty": True, "esc_delay": 25, "mouse": True,
                "colors": True, "raw": True, "cursor": 1});
        } catch (hash<ExceptionInfo> ex) {
            # fallback without TTY
        }
        use_tty_enabled = False;
        return new Ncurses::Session({"esc_delay": 25, "mouse": True, "colors": True,
            "raw": True, "cursor": 1});
    }

    private nothing init_ui() {
        # set up menu bar (connect to app for dropdown popups)
        menu_bar.setApplication(app);
        menu_bar.addMenu("File", (
            {"label": "Browse...", "command": "file_browser", "hotkey": "Alt+O"},
            {"label": "Load...", "command": "/load"},
            {"label": "Save...", "command": "/save"},
            {"separator": True},
            {"label": "Pwd", "command": "/pwd"},
            {"separator": True},
            {"label": "Quit", "command": "/quit", "hotkey": "Alt+Q"},
        ));
        menu_bar.addMenu("Edit", (
            {"label": "Clear Output", "command": "clear_output"},
            {"label": "Reset", "command": "/reset"},
        ));
        menu_bar.addMenu("View", (
            {"label": "Variables", "command": "/vars"},
            {"label": "Functions", "command": "/functions"},
            {"label": "Classes", "command": "/classes"},
            {"label": "Namespaces", "command": "/namespaces"},
            {"label": "Modules", "command": "/modules"},
            {"separator": True},
            {"label": "History", "command": "/history"},
            {"label": "Timing", "command": "/timing"},
        ));
        menu_bar.addMenu("Help", (
            {"label": "Help", "command": "/help"},
            {"separator": True},
            {"label": "About", "command": "about", "hotkey": "Alt+A"},
        ));
        menu_bar.setOnCommand(sub (string cmd) {
            handle_menu_command(cmd);
        });

        # build Alt+key → command map from menu item hotkeys
        foreach hash<auto> menu in (menu_bar.getMenus()) {
            foreach hash<auto> item in (menu.items) {
                if (item.separator) {
                    continue;
                }
                *string hotkey = item.hotkey;
                if (exists hotkey && hotkey.size() > 0) {
                    string hk_char = hotkey.substr(-1).lwr();
                    alt_commands{hk_char} = item.command;
                }
            }
        }

        # set up output widget (combined output + inline input)
        output_widget.setContent(output_content);
        output_widget.setVSizePolicy(NcursesUi::SizePolicy::Expanding);
        output_widget.setShowScrollbar(True);

        # set up status bar
        update_status();

        # build widget tree (no separate input widget)
        root.addChild(menu_bar);
        root.addChild(output_widget);
        root.addChild(status_bar);

        # layout: vertical box
        NcursesUi::BoxLayout layout(NcursesUi::Orientation::Vertical);
        app.setRootLayout(layout);
        app.setRoot(root);

        # set focus to output widget
        app.getFocusManager().setFocus(output_widget);

        # global key handler
        app.setGlobalKeyHandler(hash<NcursesUi::EventResult> sub (hash<Ncurses::InputEvent> ev) {
            return handle_global_key(ev);
        });

        # tick callback for periodic updates
        app.addTickCallback(sub () {
            on_tick();
        });
    }

    # Initializes stdout/stderr capture via File::getPipe() and a background
    # reader thread. Captured output is buffered and drained into the output
    # pane after each REPL evaluation completes.
    private nothing init_output_capture() {
        if (!use_tty_enabled) {
            return;
        }
        try {
            output_capture = start_output_capture();
            capture_running = True;
            capture_enabled = True;
        } catch (hash<ExceptionInfo> ex) {
            capture_enabled = False;
            push_output("Warning: output capture disabled: " + QoreRepl::QoreRepl::formatError(ex));
            return;
        }
        # C-level redirect (fflush + dup2 + setvbuf) is optional — the Qore-level
        # redirect in start_output_capture() is sufficient when Qore's print_node
        # includes fflush(); these calls provide a belt-and-suspenders safety net
        try {
            Ncurses::Session s = app.getSession();
            s.redirectStdout(output_capture.pipe.write);
            s.redirectStderr(output_capture.pipe.write);
        } catch (hash<ExceptionInfo> ex) {
            # not fatal — Qore-level redirect already active
        }
    }

    private hash<auto> start_output_capture() {
        hash<PipeInfo> pipe = File::getPipe();
        File stdout_restore();
        File stderr_restore();
        stdout_restore.open("/proc/self/fd/1", O_WRONLY);
        stderr_restore.open("/proc/self/fd/2", O_WRONLY);
        stdout.redirect(pipe.write);
        stderr.redirect(pipe.write);
        background output_capture_thread(pipe.read);
        return {
            "pipe": pipe,
            "stdout_restore": stdout_restore,
            "stderr_restore": stderr_restore,
        };
    }

    private nothing output_capture_thread(ReadOnlyFile read_file) {
        while (capture_running) {
            try {
                *binary b = read_file.readShortBinary(4096, 200);
                # data available (readShortBinary may also throw FILE-READ-TIMEOUT)
                if (exists b && length(b) > 0) {
                    string chunk = binary_to_string(b);
                    if (chunk != "") {
                        enqueue_output_chunk(chunk);
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "FILE-READ-TIMEOUT") {
                    # timeout - check if eval completed with unterminated output
                    output_mutex.lock();
                    on_exit output_mutex.unlock();
                    if (eval_complete) {
                        if (capture_tail != "") {
                            # append reverse-video "%" indicator (ANSI SGR 7 = reverse)
                            pending_output += capture_tail
                                + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                            capture_tail = "";
                        }
                        eval_complete = False;
                        # signal main thread that post-eval capture is done
                        eval_flushed_cond.signal();
                    }
                    continue;
                }
                if (capture_running) {
                    break;
                }
            }
        }
    }

    private nothing enqueue_output_chunk(string chunk) {
        output_mutex.lock();
        on_exit output_mutex.unlock();

        string full = capture_tail + chunk;
        list<string> lines = full.split("\n");

        if (full.size() > 0 && full.substr(-1) == "\n") {
            # complete lines
            foreach string line in (lines) {
                if (line != "") {
                    pending_output += line;
                }
            }
            capture_tail = "";
        } else {
            # last part is incomplete
            for (int i = 0; i < lines.size() - 1; ++i) {
                if (lines[i] != "") {
                    pending_output += lines[i];
                }
            }
            capture_tail = lines[lines.size() - 1];
        }

        # if eval already completed, flush immediately and signal main thread
        if (eval_complete) {
            if (capture_tail != "") {
                pending_output += capture_tail
                    + chr(0x1b) + "[7m%" + chr(0x1b) + "[0m";
                capture_tail = "";
            }
            eval_complete = False;
            eval_flushed_cond.signal();
        }
    }

    private nothing drain_pending_output() {
        list<string> drain = ();
        output_mutex.lock();
        on_exit output_mutex.unlock();
        if (pending_output.size() > 0) {
            drain = pending_output;
            pending_output = ();
        }

        foreach string line in (drain) {
            push_output(line);
        }
        # update cursor position after inserting lines before the prompt
        if (drain.size() > 0 && prompt_line_idx >= 0) {
            update_prompt_line();
        }
    }

    /** Clears eval_complete before starting a new eval to prevent stale
        flag from causing premature flushing of in-progress eval output.
    */
    private nothing clear_eval_complete() {
        if (capture_enabled) {
            output_mutex.lock();
            on_exit output_mutex.unlock();
            eval_complete = False;
        }
    }

    /** Flushes C stdio buffers to the capture pipe after eval.
        Uses Session::flushStdio() if available, falls back to Qore's
        builtin flush() which calls fflush(stdout).
    */
    private nothing flush_capture() {
        if (capture_enabled) {
            try {
                app.getSession().flushStdio();
            } catch (hash<ExceptionInfo> ex) {
                flush();
            }
        }
    }

    /** Signals the capture thread that an eval has completed so it can
        flush any unterminated output with the no-newline indicator.
    */
    private nothing signal_eval_complete() {
        if (capture_enabled) {
            output_mutex.lock();
            on_exit output_mutex.unlock();
            eval_complete = True;
        }
    }

    /** Waits for the capture thread to finish processing post-eval pipe data.
        The capture thread signals eval_flushed_cond after it has either flushed
        capture_tail or confirmed it is empty.
    */
    private nothing await_capture_flush() {
        if (!capture_enabled) {
            return;
        }
        output_mutex.lock();
        on_exit output_mutex.unlock();
        # if the capture thread already consumed eval_complete, nothing to wait for
        if (!eval_complete) {
            return;
        }
        # wait for capture thread to signal (up to 500ms — one full timeout cycle)
        eval_flushed_cond.wait(output_mutex, 500);
    }

    private nothing push_output(string line) {
        if (prompt_line_idx >= 0) {
            # insert before the live prompt line
            output_content.insertLine(prompt_line_idx, line);
            prompt_line_idx += 1;
        } else {
            output_content.appendLine(line);
        }
        output_widget.scrollTo(NcursesUi::ScrollDirection::End);
        output_widget.markDirty();
    }

    private nothing push_output_lines(string text, string prefix = "") {
        list<string> lines = text.split("\n");
        foreach string line in (lines) {
            push_output(prefix + line);
        }
    }

    /** Updates the live prompt line in output_content with current buffer text. */
    private nothing update_prompt_line() {
        string prompt_text = display_prompt(current_prompt);
        string buf_text = buffer.getText();
        # refresh hints when the buffer text changes
        if (buf_text != last_hint_input) {
            last_hint_input = buf_text;
            update_hints();
            update_status();
        }
        string line = prompt_text + buf_text;
        if (prompt_line_idx >= 0) {
            output_content.setLine(prompt_line_idx, line);
        }
        # position cursor on the prompt line
        int cursor_col = prompt_text.length() + buffer.getCursor();
        output_widget.setCursorLine(prompt_line_idx, cursor_col);
        output_widget.markDirty();
    }

    /** Starts a new prompt line at the end of output. */
    private nothing new_prompt_line() {
        string prompt_text = display_prompt(current_prompt);
        string line = prompt_text + buffer.getText();
        output_content.appendLine(line);
        prompt_line_idx = output_content.lineCount() - 1;
        output_widget.scrollTo(NcursesUi::ScrollDirection::End);
        update_prompt_line();
    }

    # Handles Enter key: retrieves the current input buffer text, adds it to
    # history, executes it through the REPL engine, waits for output capture
    # to flush, and starts a new prompt line.
    private nothing on_input_submit() {
        string text = buffer.getText();
        buffer.reset();
        current_hint = NOTHING;
        last_hint_input = "";

        if (text == "") {
            # just start a new prompt line for empty input
            new_prompt_line();
            return;
        }

        # History expansion (!! !n !-n !prefix !$)
        if (text.size() >= 2 && text[0] == "!") {
            *string expanded = history.expand(text);
            if (exists expanded) {
                text = expanded;
            } else {
                # No match — show error like bash and abort (don't eval or add to history)
                prompt_line_idx = -1;
                output_widget.clearCursorLine();
                push_output(text + ": event not found");
                last_status = "Error";
                update_status();
                new_prompt_line();
                return;
            }
        }

        history.add(text);

        # freeze the current prompt line (it becomes output)
        prompt_line_idx = -1;
        output_widget.clearCursorLine();

        if (text == "clear_output") {
            output_content.clear();
            output_widget.setScrollY(0);
            output_widget.markDirty();
            last_status = "Cleared";
            update_status();
            new_prompt_line();
            return;
        }

        string prompt = current_prompt;
        string shown_prompt = display_prompt(prompt);
        clear_eval_complete();
        exec_line(text, prompt, shown_prompt);

        # signal capture thread and wait for it to finish processing pipe data
        signal_eval_complete();
        await_capture_flush();
        drain_pending_output();

        # auto-indent on continuation: pre-fill buffer with indent
        if (repl.needsMoreInput()) {
            int indent = repl.getIndentLevel();
            if (indent > 0) {
                buffer.setText(strmul("    ", indent));
            }
        }

        # start a new prompt line after execution
        new_prompt_line();
    }

    private bool exec_line(string line, string prompt, string shown_prompt) {
        last_status = "Evaluating...";
        update_status();

        *hash<auto> result;
        try {
            result = repl.eval(line);
        } catch (hash<ExceptionInfo> ex) {
            # flush C stdio buffers to pipe before handling error
            flush_capture();
            string err_msg = QoreRepl::QoreRepl::formatError(ex);
            push_output_lines(err_msg, "  ");
            last_status = "Error";
            last_exec_error = err_msg;
            current_prompt = repl.getPrompt();
            update_status();
            return False;
        }
        # flush C stdio buffers to ensure print() output reaches the capture pipe
        flush_capture();

        # NOTHING means continuation (incomplete input) - update prompt and wait for more
        if (!exists result) {
            current_prompt = repl.getPrompt();
            last_status = "...";
            update_status();
            return False;
        }

        if (result.exit) {
            last_status = "Exit";
            update_status();
            app.quit();
            return True;
        }

        if (result.error) {
            string err_msg = QoreRepl::QoreRepl::formatError(result.error);
            push_output_lines(err_msg, "  ");
            last_status = "Error";
            last_exec_error = err_msg;
        } else if (exists result.value) {
            if (result.is_eval) {
                # evaluated expression - format as Qore value
                push_output("  " + sprintf("%y", result.value));
            } else {
                # command output (e.g. /help) - display as plain text
                push_output_lines(string(result.value), "  ");
            }
            last_status = "OK";
            last_exec_error = NOTHING;
        } else {
            last_status = "OK";
            last_exec_error = NOTHING;
        }

        if (result.timing) {
            push_output(sprintf("  [%s]", result.timing));
        }

        current_prompt = repl.getPrompt();
        update_status();
        return False;
    }

    # Routes menu commands to their handlers (file browser, about dialog,
    # clear output, quit). For REPL commands, saves the input buffer state,
    # executes the command, waits for output capture, and restores the buffer.
    private nothing handle_menu_command(string cmd) {
        if (cmd == "file_browser") {
            show_file_browser();
            return;
        }
        if (cmd == "about") {
            show_about_dialog();
            return;
        }
        if (cmd == "clear_output") {
            output_content.clear();
            output_widget.setScrollY(0);
            output_widget.markDirty();
            last_status = "Cleared";
            update_status();
            prompt_line_idx = -1;
            new_prompt_line();
            return;
        }
        if (cmd == "/quit") {
            last_status = "Exit";
            update_status();
            app.quit();
            return;
        }

        # save the user's current input
        string saved_text = buffer.getText();
        int saved_cursor = buffer.getCursor();

        # show the command in output (insert before prompt line)
        string prompt = current_prompt;
        string shown_prompt = display_prompt(prompt);
        push_output(shown_prompt + cmd);

        # freeze the current prompt, execute as REPL command
        buffer.reset();
        prompt_line_idx = -1;
        output_widget.clearCursorLine();

        clear_eval_complete();
        exec_line(cmd, prompt, shown_prompt);
        signal_eval_complete();
        await_capture_flush();
        drain_pending_output();

        # restore the user's input and start a new prompt line
        buffer.setText(saved_text);
        buffer.setCursor(saved_cursor);
        new_prompt_line();
    }

    private hash<NcursesUi::EventResult> handle_global_key(hash<Ncurses::InputEvent> ev) {
        # if a modal is open, let the dispatcher route to the modal
        if (app.getDispatcher().hasModal()) {
            return <NcursesUi::EventResult>{"handled": False};
        }

        if (ev.type == Ncurses::InputType::Char) {
            string ch = ev.ch ?? "";
            int code = ord(ch);
            if (code == 0x1b) {
                # Escape
                # if menu dropdown is open, close it
                if (menu_bar.isDropdownOpen()) {
                    menu_bar.closeMenu();
                    return <NcursesUi::EventResult>{"handled": True, "action": "close_menu"};
                }
                # nothing open - show quit confirmation
                show_quit_dialog();
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            } else if (code == 0x11) {
                # Ctrl+Q - show quit confirmation (reliable alternative to Escape)
                show_quit_dialog();
                return <NcursesUi::EventResult>{"handled": True, "action": "quit_dialog"};
            } else if (code == 0x0c) {
                # Ctrl+L - redraw
                root.markDirty();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x0a) {
                # Enter - submit input
                on_input_submit();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x7f || code == 0x08) {
                # Backspace
                buffer.backspace();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x01) {
                # Ctrl+A - move to start
                buffer.moveHome();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x05) {
                # Ctrl+E - move to end
                buffer.moveEnd();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x0b) {
                # Ctrl+K - kill to end
                buffer.killToEnd();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x15) {
                # Ctrl+U - kill to start
                buffer.killToStart();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x17) {
                # Ctrl+W - delete word back
                buffer.deleteWordBack();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x02) {
                # Ctrl+B - move left
                buffer.moveLeft();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x06) {
                # Ctrl+F - move right
                buffer.moveRight();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x04) {
                # Ctrl+D - delete char at cursor
                buffer.deleteChar();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code == 0x09) {
                # Tab - code completion
                handle_tab_completion();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (code >= 32) {
                # printable character
                buffer.insertChar(ch);
                # auto-dedent when typing "}" on a whitespace-only line during continuation
                if (ch == "}" && repl.needsMoreInput()) {
                    buffer.autoDedent("    ");
                }
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            }
        } else if (ev.type == Ncurses::InputType::Alt) {
            string ch = ev.ch ?? "";
            if (ch != "") {
                # standard editing keys (Alt+B/F/D) take priority over menu hotkeys
                string lch = ch.lwr();
                if (lch == "b") {
                    # Alt+B - move word left
                    buffer.moveWordLeft();
                    update_prompt_line();
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (lch == "f") {
                    # Alt+F - move word right
                    buffer.moveWordRight();
                    update_prompt_line();
                    return <NcursesUi::EventResult>{"handled": True};
                } else if (lch == "d") {
                    # Alt+D - delete word forward
                    buffer.deleteWordForward();
                    update_prompt_line();
                    return <NcursesUi::EventResult>{"handled": True};
                }
                # check item-level hotkeys (Alt+O → file_browser, Alt+H → /help, etc.)
                *string cmd = alt_commands{lch};
                if (exists cmd) {
                    handle_menu_command(cmd);
                    return <NcursesUi::EventResult>{"handled": True, "action": "menu_command"};
                }
                # fall back to opening menu by label first character
                if (menu_bar.processAltKey(ch)) {
                    return <NcursesUi::EventResult>{"handled": True, "action": "open_menu"};
                }
            }
        } else if (ev.type == Ncurses::InputType::Key) {
            string name = ev.name ?? "";
            if (name == "KEY_F(2)") {
                # F2 - toggle mouse
                mouse_enabled = !mouse_enabled;
                app.getSession().setMouse(mouse_enabled);
                update_status();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "kLFT3" || name == "kLFT5") {
                # Alt+Left or Ctrl+Left - move word left
                buffer.moveWordLeft();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "kRIT3" || name == "kRIT5") {
                # Alt+Right or Ctrl+Right - move word right
                buffer.moveWordRight();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_LEFT") {
                buffer.moveLeft();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_RIGHT") {
                buffer.moveRight();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_UP") {
                # history previous
                *string prev = history.prev();
                if (exists prev) {
                    buffer.setText(prev);
                    update_prompt_line();
                }
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_DOWN") {
                # history next
                *string nxt = history.next();
                if (exists nxt) {
                    buffer.setText(nxt);
                    update_prompt_line();
                }
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_HOME") {
                buffer.moveHome();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_END") {
                buffer.moveEnd();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_BACKSPACE") {
                buffer.backspace();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "kDC5") {
                # Ctrl+Delete - delete word forward
                buffer.deleteWordForward();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_DC") {
                buffer.deleteChar();
                update_prompt_line();
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_PPAGE") {
                # Page Up - scroll output
                output_widget.scrollTo(NcursesUi::ScrollDirection::PageUp);
                return <NcursesUi::EventResult>{"handled": True};
            } else if (name == "KEY_NPAGE") {
                # Page Down - scroll output
                output_widget.scrollTo(NcursesUi::ScrollDirection::PageDown);
                return <NcursesUi::EventResult>{"handled": True};
            }
        } else if (ev.type == Ncurses::InputType::Mouse) {
            int bs = ev.mouse.button_state;
            if (bs & Ncurses::BUTTON4_PRESSED || bs & Ncurses::BUTTON4_CLICKED) {
                # mouse wheel up - scroll output
                output_widget.scrollTo(NcursesUi::ScrollDirection::Up, 3);
                return <NcursesUi::EventResult>{"handled": True};
            } else if (bs & Ncurses::BUTTON5_PRESSED || bs & Ncurses::BUTTON5_CLICKED) {
                # mouse wheel down - scroll output
                output_widget.scrollTo(NcursesUi::ScrollDirection::Down, 3);
                return <NcursesUi::EventResult>{"handled": True};
            }
        }
        return <NcursesUi::EventResult>{"handled": False};
    }

    /** Updates the inline hint text based on the current buffer content.
        Calls repl.getHints() and stores the result for display in the prompt line.
    */
    private nothing update_hints() {
        string input = buffer.getText();
        if (input == "") {
            current_hint = NOTHING;
            return;
        }
        try {
            current_hint = repl.getHints(input);
        } catch (hash<ExceptionInfo> ex) {
            @debug("update_hints: %s: %s", ex.err, ex.desc);
            current_hint = NOTHING;
        }
    }

    /** Handles Tab key for code completion.

        Gets completion details from QoreRepl, and either auto-inserts
        the single completion or shows a popup for multiple completions.
    */
    private nothing handle_tab_completion() {
        string input = buffer.getText().substr(0, buffer.getCursor());
        if (input == "") {
            return;
        }

        *list<hash<auto>> completions;
        try {
            completions = repl.getCompletionDetails(input);
        } catch (hash<ExceptionInfo> ex) {
            # completion not available - ignore
            return;
        }

        if (!exists completions || !completions.size()) {
            return;
        }

        # find the word start for replacement
        int word_start = input.length();
        while (word_start > 0) {
            string ch = input.substr(word_start - 1, 1);
            if (ch == " " || ch == "\t" || ch == "(" || ch == ")" || ch == ","
                    || ch == ";" || ch == "{" || ch == "}" || ch == ":"
                    || ch == "." || ch == "=" || ch == "+" || ch == "-"
                    || ch == "*" || ch == "/" || ch == "!" || ch == "<"
                    || ch == ">" || ch == "&" || ch == "|" || ch == "^"
                    || ch == "~" || ch == "?" || ch == "@" || ch == "#"
                    || ch == "%" || ch == "[" || ch == "]") {
                break;
            }
            word_start -= 1;
        }
        string prefix = input.substr(word_start);

        if (completions.size() == 1) {
            # single completion - auto-insert
            insert_completion(completions[0], word_start, prefix);
            return;
        }

        # multiple completions - show popup
        show_completion_popup(completions, word_start, prefix);
    }

    /** Inserts a completion into the buffer, replacing the prefix.
        @param item the completion item
        @param word_start the position where the prefix starts
        @param prefix the current prefix being replaced
    */
    private nothing insert_completion(hash<auto> item, int word_start, string prefix) {
        string label = item.label ?? "";
        if (label == "") {
            return;
        }

        # build the replacement text
        string replacement = label;
        if (item.isCallable) {
            if (item.hasKey("noArgsOnly") && item.noArgsOnly) {
                replacement += "()";
            } else {
                replacement += "(";
            }
        } else if (item.kind == "namespace") {
            replacement += "::";
        }

        # replace prefix with completion
        string text = buffer.getText();
        string new_text = text.substr(0, word_start) + replacement + text.substr(word_start + prefix.length());
        int new_cursor = word_start + replacement.length();
        buffer.setText(new_text);
        buffer.setCursor(new_cursor);
        update_prompt_line();
    }

    /** Shows a completion popup with multiple items.
        @param completions the list of completion items
        @param word_start the position where the prefix starts
        @param prefix the current prefix
    */
    private nothing show_completion_popup(list<hash<auto>> completions, int word_start, string prefix) {
        Ncurses::Session sess = app.getSession();
        hash<Ncurses::Size> sz = sess.screen().size();

        NcursesUi::CompletionPopupWidget popup(sess, completions);

        # position below the cursor
        string prompt_text = display_prompt(current_prompt);
        int cursor_screen_col = prompt_text.length() + buffer.getCursor();

        # the prompt is on the last line of visible content
        hash<NcursesUi::Rect> ow_frame = output_widget.getFrame();
        int anchor_y;
        if (prompt_line_idx >= 0) {
            # try to get the screen row of the prompt line
            int visible_start = output_widget.getScrollY();
            int line_in_view = prompt_line_idx - visible_start;
            anchor_y = ow_frame.y + line_in_view;
        } else {
            anchor_y = ow_frame.y + ow_frame.rows - 1;
        }
        # clamp anchor_y to the visible output area
        if (anchor_y < ow_frame.y) {
            anchor_y = ow_frame.y;
        } else if (anchor_y > ow_frame.y + ow_frame.rows - 1) {
            anchor_y = ow_frame.y + ow_frame.rows - 1;
        }
        int anchor_x = ow_frame.x + cursor_screen_col;

        popup.positionAt(anchor_y, anchor_x, sz.rows, sz.cols);

        popup.setOnSelect(sub (hash<auto> item) {
            app.popModal();
            popup.destroyPanel();
            insert_completion(item, word_start, prefix);
        });

        popup.setOnDismiss(sub () {
            app.popModal();
            popup.destroyPanel();
        });

        popup.createPanel();
        app.pushModal(popup);
    }

    private nothing show_quit_dialog() {
        @debug("show_quit_dialog called");
        Ncurses::Session sess = app.getSession();
        hash<Ncurses::Size> sz = sess.screen().size();

        NcursesUi::DialogWidget dlg = NcursesUi::DialogWidget::confirm(
            sess, "Quit", "Exit the REPL?",
            sub (int idx, string label) {
                if (idx == 0) {
                    # OK - quit
                    app.popModal();
                    dlg.destroyPanel();
                    last_status = "Exit";
                    update_status();
                    app.quit();
                } else {
                    # Cancel - dismiss
                    app.popModal();
                    dlg.destroyPanel();
                }
            });
        dlg.setOnDismiss(sub () {
            app.popModal();
            dlg.destroyPanel();
        });
        dlg.centerOn(sz.rows, sz.cols);
        dlg.createPanel();
        app.pushModal(dlg);
    }

    /** Opens the About dialog with animated Qore spinning coin. */
    private nothing show_about_dialog() {
        Ncurses::Session sess = app.getSession();
        hash<Ncurses::Size> sz = sess.screen().size();

        # build version info lines for the right side
        list<string> info_lines = AboutDialogWidget::buildVersionInfo();

        # dialog dimensions: border(2) + padding(2) + art + gap(2) + info area
        int info_width = 0;
        foreach string line in (info_lines) {
            if (line.length() > info_width) {
                info_width = line.length();
            }
        }
        int dlg_width = AnimFrameWidth + 2 + info_width + 4;
        # ensure at least tall enough for art + button row
        int dlg_height = AnimFrameHeight + 4;
        # fall back to narrow layout if terminal is too small
        if (dlg_width > sz.cols - 2) {
            dlg_width = AnimFrameWidth + 4;
            dlg_height = AnimFrameHeight + 7;
        }
        dlg_width = min(dlg_width, sz.cols - 2);
        dlg_height = min(dlg_height, sz.rows - 2);
        int dy = (sz.rows - dlg_height) / 2;
        int dx = (sz.cols - dlg_width) / 2;

        AboutDialogWidget dlg(sess, self);
        dlg.setTitle("About Qore REPL");
        dlg.resize(NcursesUi::Geometry::makeRect(dy, dx, dlg_height, dlg_width));
        dlg.setOnDismiss(sub () {
            app.popModal();
            dlg.destroyPanel();
            # restore default read timeout
            app.setReadTimeout(100, 25);
        });
        dlg.createPanel();
        app.pushModal(dlg);

        # set faster read timeout for ~30fps animation
        app.setReadTimeout(33, 25);
    }

    private nothing on_tick() {
        # drain captured output
        if (capture_enabled) {
            drain_pending_output();
        }

        # update time every second
        int now_ms = clock_getmillis();
        if (now_ms - last_tick >= 1000) {
            last_tick = now_ms;
            time_text = now().format("HH:mm:SS");
            update_status();
        }
    }

    private nothing update_status() {
        hash<auto> status_style = {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue};
        hash<auto> time_style = {"fg": Ncurses::Color::White, "bg": Ncurses::Color::Blue};
        hash<auto> hint_style = {"fg": Ncurses::Color::Cyan, "bg": Ncurses::Color::Blue,
            "attrs": Ncurses::Attr::Dim};

        int color = status_color(last_status);
        hash<auto> label_style = {"fg": color, "bg": Ncurses::Color::Blue,
            "attrs": Ncurses::Attr::Bold};

        list<hash<auto>> segs = (
            {"text": pad_status_label(last_status), "style": label_style},
            {"text": " " + output_title + " ", "style": status_style},
        );

        # show hint in status bar when available
        if (exists current_hint && current_hint != "") {
            segs += {"text": current_hint + " ", "style": hint_style};
        } else {
            segs += {"text": " Lines: " + output_content.lineCount() + " ", "style": status_style};
        }

        segs += (
            {"text": time_text + " ", "align": "right", "style": time_style},
            {"text": mouse_enabled ? "Mouse:ON  " : "Mouse:OFF ", "align": "right", "style": status_style},
        );
        status_bar.setSegments(segs);
    }

    /** Opens the split-pane file browser modal. */
    private nothing show_file_browser() {
        Ncurses::Session sess = app.getSession();
        hash<Ncurses::Size> sz = sess.screen().size();

        # size to ~80% of screen, centered
        int fb_rows = max(10, sz.rows * 80 / 100);
        int fb_cols = max(40, sz.cols * 80 / 100);
        int fb_y = (sz.rows - fb_rows) / 2;
        int fb_x = (sz.cols - fb_cols) / 2;

        NcursesUi::FileBrowserWidget fb(sess, getcwd());
        fb.setFrame(NcursesUi::Geometry::makeRect(fb_y, fb_x, fb_rows, fb_cols));
        fb.setClosable(True);

        fb.setOnLoad(sub (hash<auto> item) {
            app.popModal();
            fb.destroyPanel();
            # execute /load <path> via REPL
            string text = "/load " + item.path;
            string prompt = current_prompt;
            string shown_prompt = display_prompt(prompt);
            if (prompt_line_idx >= 0) {
                output_content.setLine(prompt_line_idx, shown_prompt + text);
            }
            buffer.reset();
            prompt_line_idx = -1;
            output_widget.clearCursorLine();
            clear_eval_complete();
            exec_line(text, prompt, shown_prompt);
            signal_eval_complete();
            await_capture_flush();
            drain_pending_output();
            new_prompt_line();
        });

        fb.setOnDismiss(sub () {
            app.popModal();
            fb.destroyPanel();
        });

        fb.createPanel();
        app.pushModal(fb);
    }

    private int run() {
        try {
            app.run();
        } catch (hash<ExceptionInfo> ex) {
            # app.run() already calls close() on exception to restore the terminal;
            # print the error so the user can see what happened
            close_session();
            stderr.printf("qrepl: unhandled exception in event loop:\n");
            stderr.printf("  %s: %s\n", ex.err, ex.desc);
            if (exists ex.arg) {
                stderr.printf("  arg: %y\n", ex.arg);
            }
            stderr.printf("  at %s:%d (%s)\n", ex.file ?? "<unknown>", ex.line, ex.type ?? "");
            # print full chain
            *hash<ExceptionInfo> next = ex.next;
            while (exists next) {
                stderr.printf("  chained: %s: %s at %s:%d\n",
                    next.err, next.desc, next.file ?? "<unknown>", next.line);
                next = next.next;
            }
            return 1;
        }
        close_session();
        return 0;
    }

    private nothing close_session() {
        # save persistent history
        if (exists ENV.HOME) {
            try {
                history.save(ENV.HOME + "/.qore-repl-history");
            } catch (hash<ExceptionInfo> ex) {
                # ignore save errors during shutdown
            }
        }

        if (capture_enabled) {
            capture_running = False;
            try {
                if (output_capture.pipe) {
                    output_capture.pipe.write.close();
                }
            } catch (hash<ExceptionInfo> ex) {
                # ignore
            }
            try {
                Ncurses::Session s = app.getSession();
                if (output_capture.stdout_restore) {
                    stdout.redirect(output_capture.stdout_restore);
                    s.redirectStdout(output_capture.stdout_restore);
                }
                if (output_capture.stderr_restore) {
                    stderr.redirect(output_capture.stderr_restore);
                    s.redirectStderr(output_capture.stderr_restore);
                }
            } catch (hash<ExceptionInfo> ex) {
                # ignore
            }
        }
        try {
            app.close();
        } catch (hash<ExceptionInfo> ex) {
            # ignore
        }
    }

    /** Pads a status label to a fixed width so the status bar layout stays stable.
        @param label the status text (e.g. "OK", "Error", "Evaluating...")
        @param width the fixed width including surrounding spaces (default 17 for " Evaluating... ")
        @return the padded string
    */
    private static string pad_status_label(string label, int width = 17) {
        string text = " " + label + " ";
        if (text.length() < width) {
            text += strmul(" ", width - text.length());
        }
        return text;
    }

    private static int status_color(string status) {
        if (status == "OK" || status == "Ready" || status == "Cleared") {
            return Ncurses::Color::Green;
        }
        if (status == "Error") {
            return Ncurses::Color::Red;
        }
        if (status == "Evaluating...") {
            return Ncurses::Color::Yellow;
        }
        if (status == "Exit") {
            return Ncurses::Color::Magenta;
        }
        if (status == "ESC!" || status == "Ctrl+Q!") {
            return Ncurses::Color::Cyan;
        }
        return Ncurses::Color::White;
    }

    private string display_prompt(string prompt) {
        if (!prompt || prompt == "") {
            return ">>> ";
        }
        string result = prompt;
        if (result.substr(-1) != " ") {
            result += " ";
        }
        # pad shorter prompts (e.g. continuation "...> ") to align with base prompt
        # "...> " (5 chars) becomes "    > " (6 chars) to match "qore> "
        if (base_prompt_width > 0 && result.length() < base_prompt_width) {
            int pad = base_prompt_width - 2;  # space for "> " suffix
            result = strmul(" ", pad) + "> ";
        }
        return result;
    }
}

/** Animated About dialog panel for the Qore REPL.

    Displays the Qore spinning coin animation with version info on the right,
    matching the improved layout from qore --version-animation.
    Dismisses on Escape, Enter, Space, or any mouse click.

    @since ncurses 2.0
*/
class AboutDialogWidget inherits NcursesUi::PanelWidget {
    private {
        #! reference to the QRepl instance (for animation data access)
        QRepl repl_ref;
        #! dismiss callback
        *code on_dismiss;
        #! animation start time in microseconds
        int start_us;
        #! color slot for Qore brand color
        const QoreBrandColorSlot = 250;
        #! art style — set up with the Qore brand color in the constructor
        hash<auto> art_style;
        #! info label style
        hash<auto> info_style = {"fg": Ncurses::Color::Cyan, "attrs": Ncurses::Attr::Bold};
        #! dim info style
        hash<auto> dim_style = {"fg": Ncurses::Color::White};
        #! button style
        hash<auto> btn_style = {"fg": Ncurses::Color::Yellow, "bg": Ncurses::Color::Blue,
            "attrs": Ncurses::Attr::Bold};
    }

    constructor(Ncurses::Session s, QRepl repl)
            : PanelWidget(s) {
        repl_ref = repl;
        start_us = clock_getmicros();
        setFocusable(True);
        # define the exact Qore brand color RGB(255, 50, 140) if the terminal supports it
        int color_slot = 204;
        if (s.canChangeColor() && s.maxColors() > QoreBrandColorSlot) {
            # ncurses uses 0-1000 range for RGB
            # R: 255/255*1000 = 1000, G: 50/255*1000 ≈ 196, B: 140/255*1000 ≈ 549
            s.initColor(QoreBrandColorSlot, 1000, 196, 549);
            color_slot = QoreBrandColorSlot;
        }
        art_style = {"fg": color_slot, "attrs": Ncurses::Attr::Bold};
    }

    nothing setOnDismiss(*code cb) {
        on_dismiss = cb;
    }

    #! Build version info lines for display alongside the animation
    static list<string> buildVersionInfo() {
        list<string> info = ();
        info += sprintf("QORE for %s %s", Qore::PlatformOS, Qore::PlatformCPU);
        info += sprintf("version %s", Qore::VersionString);
        info += sprintf("build host: %s", Qore::BuildHost);
        info += sprintf("C++ compiler: %s", Qore::Compiler);
        info += sprintf("CFLAGS: %s", Qore::CFLAGS);
        info += sprintf("LDFLAGS: %s", Qore::LDFLAGS);
        info += "";
        info += "press any key to close";
        return info;
    }

    nothing draw(Ncurses::Window w) {
        PanelWidget::draw(w);

        hash<NcursesUi::Rect> cr = localContentRect();

        # calculate current frame: 6-second cycle at ANIM_FRAME_COUNT frames
        int elapsed = clock_getmicros() - start_us;
        int frame_us = 6000000 / QRepl::AnimFrameCount;
        int frame_idx = (elapsed / frame_us) % QRepl::AnimFrameCount;
        list<string> frame = QRepl::AnimFrames[frame_idx];

        # determine layout: wide (info on right) vs narrow (info below)
        list<string> info_lines = buildVersionInfo();
        int info_width = 0;
        foreach string line in (info_lines) {
            if (line.length() > info_width) {
                info_width = line.length();
            }
        }
        bool wide_layout = (cr.cols >= QRepl::AnimFrameWidth + 2 + info_width);

        if (wide_layout) {
            # --- wide layout: art on left, info on right ---
            int art_x = cr.x;
            int art_y = cr.y;

            # draw animation art
            for (int r = 0; r < frame.size() && art_y + r < cr.y + cr.rows; ++r) {
                string line = frame[r];
                int draw_y = art_y + r;
                w.drawHLine(draw_y, cr.x, cr.cols, " ");
                for (int c = 0; c < line.size() && art_x + c < cr.x + cr.cols; ++c) {
                    string ch = line.substr(c, 1);
                    if (ch != " ") {
                        w.drawText(draw_y, art_x + c, ch, art_style);
                    }
                }
            }

            # draw info text to the right, vertically centered
            int info_x = cr.x + QRepl::AnimFrameWidth + 2;
            int info_start = (QRepl::AnimFrameHeight - info_lines.size()) / 2;
            if (info_start < 0) {
                info_start = 0;
            }
            for (int i = 0; i < info_lines.size(); ++i) {
                int iy = art_y + info_start + i;
                if (iy >= cr.y + cr.rows) {
                    break;
                }
                string text = info_lines[i];
                if (info_x + text.length() > cr.x + cr.cols) {
                    text = text.substr(0, cr.x + cr.cols - info_x);
                }
                if (text.length() > 0) {
                    # use bright style for first two lines, dim for rest
                    hash<auto> style = (i < 2) ? info_style : dim_style;
                    w.drawText(iy, info_x, text, style);
                }
            }
        } else {
            # --- narrow layout: art centered, info below ---
            int art_x = cr.x + (cr.cols - QRepl::AnimFrameWidth) / 2;
            int art_y = cr.y;

            for (int r = 0; r < frame.size() && art_y + r < cr.y + cr.rows; ++r) {
                string line = frame[r];
                int draw_y = art_y + r;
                w.drawHLine(draw_y, cr.x, cr.cols, " ");
                for (int c = 0; c < line.size() && art_x + c < cr.x + cr.cols; ++c) {
                    string ch = line.substr(c, 1);
                    if (ch != " ") {
                        w.drawText(draw_y, art_x + c, ch, art_style);
                    }
                }
            }

            # version text below art
            int ver_y = art_y + QRepl::AnimFrameHeight + 1;
            if (ver_y < cr.y + cr.rows) {
                string ver_text = "Qore v" + Qore::VersionString;
                int ver_x = cr.x + (cr.cols - ver_text.length()) / 2;
                w.drawText(ver_y, ver_x, ver_text, info_style);
            }

            # Close button
            int btn_y = ver_y + 2;
            if (btn_y < cr.y + cr.rows) {
                string btn_text = "[ Close ]";
                int btn_x = cr.x + (cr.cols - btn_text.length()) / 2;
                w.drawText(btn_y, btn_x, btn_text, btn_style);
            }
        }

        # request continuous redraws for animation
        markDirty();
    }

    hash<NcursesUi::EventResult> processEvent(hash<Ncurses::InputEvent> ev) {
        if (ev.type == Ncurses::InputType::Char) {
            int code = ord(ev.ch ?? "");
            if (code == 0x1b || code == 0x0a || code == 0x20) {
                # Escape, Enter, or Space — dismiss
                dismiss();
                return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
            }
        } else if (ev.type == Ncurses::InputType::Mouse) {
            int bs = ev.mouse.button_state;
            if (bs & Ncurses::BUTTON1_CLICKED || bs & Ncurses::BUTTON1_PRESSED) {
                dismiss();
                return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
            }
            # consume all mouse events
            return <NcursesUi::EventResult>{"handled": True};
        } else if (ev.type == Ncurses::InputType::Key || ev.type == Ncurses::InputType::Alt) {
            # any key dismisses
            dismiss();
            return <NcursesUi::EventResult>{"handled": True, "action": "dismiss"};
        }
        return <NcursesUi::EventResult>{"handled": True};
    }

    private nothing dismiss() {
        if (on_dismiss) {
            on_dismiss();
        }
    }
}
